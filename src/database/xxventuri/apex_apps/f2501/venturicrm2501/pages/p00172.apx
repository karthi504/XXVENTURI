    pageItem P172_ID (
        type: hidden
        layout {
            sequence: 10
            region: @product-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P172_MONTHLY_VOLUME (
        type: numberField
        label {
            label: Monthly Volume
            alignment: left
        }
        settings {
            minValue: 1
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @product-details
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--indicatorAsterisk
            ]
            width: 20
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: MONTHLY_VOLUME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_ORDER_FREQUENCY (
        type: textField
        label {
            label: Order Frequency
            alignment: left
        }
        layout {
            sequence: 100
            region: @product-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 36
        }
        validation {
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: ORDER_FREQUENCY
            used: always
        }
        security {
            encryptSessionState: false
        }

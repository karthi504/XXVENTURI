            region: @product-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_UNIT_OF_MEASURES (
        type: selectList
        label {
            label: Unit Of Measures
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select unit_name  as d,UNIT_ID as r from XXEBA_SALES_Units
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @product-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: UNIT_OF_MEASURES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_UPDATED_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 170
            region: @product-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: UPDATED_BY
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_UPDATE_DATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @product-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: UPDATE_DATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P172_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P172_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P172_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation p172-creation-date-must-be-timestamp (
        name: P172_CREATION_DATE must be timestamp
        execution {
            sequence: 120
        }
        validation {
            type: itemIsAValidTimestamp
            item: P172_CREATION_DATE
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P172_CREATION_DATE
        }
    )

    validation p172-update-date-must-be-timestamp (
        name: P172_UPDATE_DATE must be timestamp
        execution {
            sequence: 140
        }
        validation {
            type: itemIsAValidTimestamp
            item: P172_UPDATE_DATE
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P172_UPDATE_DATE
        }
    )

    validation product-duplicate-create (
        name: product_duplicate_create
        execution {
            sequence: 150
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  lv_acc_count NUMBER;
                BEGIN
                  SELECT COUNT(*) 
                  INTO lv_acc_count
                  FROM XXEBA_SALES_ACC_PRODUCTS
                  WHERE Customer_ID = :P172_CUSTOMER_ID
                  AND product_id    = :P172_PRODUCT_ID;
                  IF lv_acc_count   > 0 THEN
                    RETURN 'Sorry! This Product already exists.';
                  END IF;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation product-duplicate-update (
        name: product_duplicate_update
        execution {
            sequence: 160
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  lv_acc_count NUMBER;
                BEGIN
                  SELECT COUNT(*)
                  INTO lv_acc_count
                  FROM XXEBA_SALES_ACC_PRODUCTS
                  WHERE Customer_ID = :P172_CUSTOMER_ID
                  AND product_id    = :P172_PRODUCT_ID
                  AND ID!=:P172_ID;
                  IF lv_acc_count   > 0 THEN
                    RETURN 'Sorry! This Product already exists.';
                  END IF;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 70935196988183562
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-xxeba-sales-acc-products (
        name: Fetch Row from XXEBA_SALES_ACC_PRODUCTS
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_ACC_PRODUCTS
            pkColumn: ID
            pkItem: P172_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 70934037792183561
        }
    )

    process process-row-of-xxeba-sales-acc-products (
        name: Process Row of XXEBA_SALES_ACC_PRODUCTS
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_ACC_PRODUCTS
            pkColumn: ID
            pkItem: P172_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 70934395187183561
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 70934783376183561
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: goto 94
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 94
                action: resetPagination
            }
        }
    )

)


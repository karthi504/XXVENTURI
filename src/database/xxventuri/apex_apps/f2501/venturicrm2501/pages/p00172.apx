    pageItem P172_PART_NUMBER (
        type: textField
        label {
            label: Customer Part#
            alignment: left
        }
        layout {
            sequence: 110
            region: @product-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: PART_NUMBER
            used: always

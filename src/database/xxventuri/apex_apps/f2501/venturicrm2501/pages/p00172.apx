page 172 (
    name: Product Details
    title: Product Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region product-details (
        name: Product Details
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P172_ANNUAL_PUR_POTENTIAL_AMT (
        type: textField
        label {
            label: Annual Purchase Potential (Rs.)
            alignment: left
        }
        layout {
            sequence: 30
            region: @product-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            formatMask: 999999999
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: ANNUAL_PUR_POTENTIAL_AMT
            used: always
        }
    )

    pageItem P172_BRAND_ID (
        type: selectList
        label {
            label: Brand Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select B.BRAND_NAME as d,B.BRAND_ID as r from XXEBA_SALES_PRODUCT_BRANDS B,EBA_SALES_PRODUCTS  P
                where B.BRAND_ID =P.BRAND_ID and P.ID= :P172_PRODUCT_ID
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P172_PRODUCT_ID
            itemsToSubmit: P172_PRODUCT_ID
        }
        layout {
            sequence: 60
            region: @product-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: mnw220
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_CREATED_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 150
            region: @product-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: CREATED_BY
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_CREATION_DATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @product-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: CREATION_DATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_CUSTOMER_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @product-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_HSN_CODE (
        type: textField
        label {
            label: HSN Code
            alignment: left
        }
        layout {
            sequence: 90
            region: @product-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 42
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: HSN_CODE
            used: always
        }
        security {
            encryptSessionState: false

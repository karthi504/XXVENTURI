    )

    pageItem P172_PRODDUCT_GROUP_ID (
        type: selectList
        label {
            label: Product Group
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.product_family as d,
                      g. id as r
                  from eba_sales_product_families g,EBA_SALES_PRODUCTS p
                where g.id=p.PRODUCT_FAMILY_ID and  p.id=:P172_PRODUCT_ID
                 order by 1
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P172_PRODUCT_ID
            itemsToSubmit: P172_PRODUCT_ID
        }
        layout {
            sequence: 50
            region: @product-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--indicatorAsterisk
            ]
            height: 1
        }
        advanced {
            cssClasses: mnw210
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_GROUP_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_PRODUCT_ID (
        type: plugin/select2
        label {
            label: Product
            alignment: left
        }
        settings {
            width: 100%
            lazyLoading: attributeValue
            lazyAppendRowCount: 15
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.PRODUCT_NAME||' ['||p.CATALOGUE_NO||']'  display_value, p.ID return_value 
                from eba_sales_PRODUCTS p, eba_sales_verifications  v
                where p.ID =v.PRODUCT_ID and p.STATUS='Y'
                order by 1
                
                
                ```
        }
        layout {
            sequence: 40
            region: @product-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_REMARKS (
        type: textarea
        label {
            label: Remarks
            alignment: left
        }
        layout {
            sequence: 120
            region: @product-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 36
            height: 3
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: REMARKS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P172_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {

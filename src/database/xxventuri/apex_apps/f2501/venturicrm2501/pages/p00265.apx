page 265 (
    name: Outstanding Report
    title: Outstanding Report
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region accounts-receivable (
        name: Accounts Receivable
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select R.CUSTOMER_ID,
                ( select CUSTOMER_NAME from CRM_ACCOUNTS_V where CUSTOMER_ID = R.CUSTOMER_ID) CUSTOMER_NAME,
                INVOICE_NUMBER,
                INVOICE_DATE,
                INV_PENDING_AMOUNT,
                case when LASTPAYMT_RECDATE is not null 
                then  TO_CHAR(LASTPAYMT_RECDATE,'DD-MON-YYYY')
                  else 'null' end as LASTPAYMT_RECDATE_T,
                R.BATCH_NUMBER,
                (select DEFAULT_REP_ID from eba_sales_customers where row_key= R.CUSTOMER_ID) as DEFAULT_REP_ID,
                case when R.invoice_date + (
                SELECT
                nvl(sc.credit_terms_rec, 0)
                FROM
                xxeba_sales_customer_details sc
                WHERE
                sc.customer_id = (SELECT
                cus.id
                FROM
                eba_sales_customers cus
                WHERE
                cus.row_key = R.customer_id))-sysdate > 0 then 1
                else 0
                end Overdue
                from XXEBA_TALLY_RECEIVABLES_T R
                where R.BATCH_NUMBER = (select max(cnt.batch_number) from XXEBA_TALLY_RECEIVABLES_T CNT)
                --AND LASTPAYMT_RECDATE is not null
                AND
                ( (select DEFAULT_REP_ID from eba_sales_customers where row_key= R.CUSTOMER_ID ) in (SELECT upper(r.ID)
                FROM eba_sales_salesreps r
                START WITH r.id = :USER_ID
                CONNECT BY PRIOR r.id= r.REP_MANAGER_ID)
                or
                EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE
                and SR.ROLE_NAME in ('Administrator','Sales Co-Ordinator')))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 891197644750746412
        }
        description {
            description: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }

        column BATCH_NUMBER (
            type: plainText
            heading {
                heading: Batch number
                alignment: center
            }
            layout {
                sequence: 72
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column CUSTOMER_ID (
            type: plainText
            heading {
                heading: Customer ID
                alignment: center
            }
            layout {
                sequence: 22
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 82
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column DEFAULT_REP_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Default Rep.
            }
            lov {
                lov: @xx-sales-rep-lov
            }
            layout {
                sequence: 102
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column INVOICE_DATE (
            type: plainText
            heading {
                heading: Invoice Date
                alignment: center
            }
            layout {
                sequence: 42
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-YYYY
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: M
            }
        )

        column INVOICE_NUMBER (
            type: plainText
            heading {
                heading: Invoice No.
                alignment: center
            }
            layout {
                sequence: 32
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column INV_PENDING_AMOUNT (
            type: plainText
            heading {
                heading: Pending Amount
                alignment: center
            }
            layout {
                sequence: 92
                columnAlignment: end
            }
            appearance {
                formatMask: 99G99G99G99G990D00
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column LASTPAYMT_RECDATE_T (
            type: plainText
            heading {
                heading: Lastpaymt Recdate T
                alignment: center
            }
            layout {
                sequence: 122
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: V
            }
        )

        column OVERDUE (
            type: plainText
            heading {
                heading: Overdue
                alignment: center
            }
            layout {
                sequence: 112
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: U
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 4106770 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CUSTOMER_NAME (
                sequence: 1
            )

            displayColumn DEFAULT_REP_ID (
                sequence: 5
            )

            displayColumn INVOICE_DATE (
                sequence: 3
            )

            displayColumn INVOICE_NUMBER (
                sequence: 2
            )

            displayColumn INV_PENDING_AMOUNT (
                sequence: 4
            )

            sort (
                column: INVOICE_DATE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: CUSTOMER_ID
                sort {
                    sequence: 2
                }
            )

            sort (
                column: INVOICE_NUMBER
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: PENDING_AMOUNT
            )

            highlight ir-condition (
                name: Payment Overdue
                condition {
                    column: OVERDUE
                    value: 0
                }
                colors {
                    background: #e70a0a
                    text: #ffffff
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    region outstanding-report (
        name: Outstanding Report
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1220
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

)


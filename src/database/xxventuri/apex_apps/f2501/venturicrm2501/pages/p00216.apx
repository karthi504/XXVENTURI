    dynamicAction new-standard-report-call (
        name: New Standard Report Call
        execution {
            sequence: 170
        }
        when {
            event: click
            selectionType: button
            button: @print-standard-report-new
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    -- DECLARE
                    --     -- printout_id number;
                    --     repName   VARCHAR2(100);
                    --     parameters VARCHAR2(200);
                    --     l_url         varchar(2000);
                    --     l_encoded_params  VARCHAR2(500);
                    
                    -- BEGIN
                          
                    --      repName := 'trial_report';--'trial_report_test' ;
                    --      parameters := '&p1='|| :P216_TRIAL_ID;--'&p1='|| :P216_TRIAL_ID;  --'&p1=' || :P102_INVOICE_ID; --150767867570635958499198728626191154832
                    --     --  printout_id := 475;
                    --      BEGIN
                    --          l_encoded_params := apex_util.url_encode(parameters);
                    
                    --       -- l_url:= 'https://products.4iapps.com/ords/r/fouraai/pmo/print-jasper-report?p1017_parameters='||l_encoded_params||'&p1017_report_name='||repName||'&session='||:APP_SESSION;
                    
                    --       l_url:= 'https://products.4iapps.com/ords/r/venturitool/venturicrm2501/print-jasper-report?p200_parameters='||l_encoded_params||'&p200_report_name='||repName||'&session='||:APP_SESSION;
                    
                    --        -- l_url:=  'http://10.1.4.103:8090/jri/report??_repName=trial_report&_repFormat=pdf&_dataSource=prod1&_outFilename=&_repLocale=en_US&_repEncoding=&p1=152208566895275465963509523632900479218';
                    
                    --         -- l_url:= 'http://10.1.4.103:8090/jri/report/venturitool/venturicrm2501/print-jasper-report?p200_parameters='||l_encoded_params||'&p200_report_name='||repName||'&session='||:APP_SESSION;
                             
                    --          --http://10.1.4.103:8090/jri/report
                    
                    --          --'&session='||:APP_SESSION;
                    
                    --        --  '&p200_printout_id='||printout_id||
                    
                    -- ---         l_url:= 'https://products.4iapps.com/ords/r/venturitool/venturicrm2501/print-jasper-report?p200_parameters='||parameters||'&p200_report_name='||repName||'&session='||:APP_SESSION;
                    
                    --      --   l_url:= 'https://products.4iapps.com/ords/r/fouraai/pmo/print-jasper-report?p200_parameters='||l_encoded_params||'&p200_report_name='||repName||'&session='||:APP_SESSION;
                    
                    
                    --          :P216_URL := l_url;
                           
                    -- --    EXCEPTION WHEN OTHERS THEN
                    --        --xxfs_pm_error_log_pkg.record_log('ERROR','Preprint_invoice','Preprint_invoice Process');  
                    --     END;
                       
                    -- END;
                    
                    
                    
                    
                    
                    DECLARE
                        repName           VARCHAR2(100);
                        parameters        VARCHAR2(200);
                        l_url             VARCHAR2(2000);
                        l_encoded_params  VARCHAR2(500);
                    BEGIN
                    
                        -- IF :P216_REPORT_TYPE = 'TRIAL' THEN
                        --     repName := 'trial_report';
                        
                        -- IF :P216_REPORT_TYPE = 'TRIAL' THEN
                        --     repName := 'trial_report';
                        -- ELSE repName := 'trial_report_test';
                        -- END IF;
                    
                    
                    IF :P216_PRODUCT_CLASS_ID = 3 then
                    
                        repName := 'trial_blade_report';
                    
                    ELSE    repName := 'trial_report_test';
                    END IF;
                    
                    
                    
                        parameters := '&p1=' || :P216_TRIAL_ID;
                    
                        l_encoded_params := apex_util.url_encode(parameters);
                    
                        l_url := 'https://products.4iapps.com/ords/r/venturitool/venturicrm2501/print-jasper-report?p200_parameters=' ||
                                  l_encoded_params || 
                                  '&p200_report_name=' || repName || 
                                  '&session=' || :APP_SESSION;
                    
                        -- Set to output URL item (used in frontend)
                        :P216_URL := l_url;
                    
                    EXCEPTION
                        WHEN OTHERS THEN
                            xxfs_pm_error_log_pkg.record_log(
                                'ERROR', 
                                'REPORT_PROCESS'||l_url||repName, 
                                'Error generating report URL: ' || SQLERRM
                            );
                    END;
                    
                    
                    
                    
                    
                    
                    ```
                itemsToSubmit: P216_TRIAL_ID
                itemsToReturn: P216_URL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        INSERT INTO xxeba_trial_printouts_t 
                        (
                            PRINTOUT_DATE,
                            PRINTOUT_FLAG,
                            EMPLOYEE_ID,
                            TRIAL_ID
                        ) VALUES 
                        (
                            SYSDATE,
                            'S',
                            :USER_ID,
                            :p216_trial_id
                        );
                    END;
                    ```
                itemsToSubmit: P216_TRIAL_ID
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR ctri IS
                        SELECT
                            COUNT(*) AS no_of_records
                        FROM
                            eba_sales_deals deal,
                            (
                                SELECT
                                    id salesrep_id_01
                                FROM
                                    eba_sales_salesreps r
                                START WITH
                                    r.id = :user_id
                                CONNECT BY
                                    PRIOR r.id = r.rep_manager_id
                            ) rep
                        WHERE
                            deal.salesrep_id_01 = rep.salesrep_id_01
                            AND deal_name IS NOT NULL
                            AND source_type = 'D'
                            AND deal.id = :p216_deal_id;
                    
                        rtri         ctri%rowtype;
                        v_is_admin   CHAR(1);
                        v_admin_print_count NUMBER;
                    BEGIN
                        BEGIN
                            SELECT
                                'Y'
                            INTO v_is_admin
                            FROM
                                eba_sales_salesreps        r,
                                eba_sales_salesrep_roles   sr
                            WHERE
                                r.id = :user_id
                                AND sr.id = r.rep_role
                                AND sr.role_name = 'Administrator';
                    
                        EXCEPTION
                            WHEN no_data_found THEN
                                v_is_admin := 'N';
                        END;
                    
                        OPEN ctri;
                        FETCH ctri INTO rtri;
                        CLOSE ctri;
                        
                        IF v_is_admin = 'Y' THEN
                            SELECT
                                COUNT(*)
                            INTO v_admin_print_count
                            FROM
                                xxeba_trial_printouts_t
                            WHERE
                                employee_id = :user_id
                                AND trial_id = :p216_trial_id
                                AND printout_flag = 'S';
                            
                            IF v_admin_print_count < 2 THEN
                                :P216_NO_OF_STANDARD_PRINTOUTS := v_admin_print_count + 1;
                            ELSE
                                :P216_NO_OF_STANDARD_PRINTOUTS := v_admin_print_count;
                            END IF;
                        ELSE
                            IF rtri.no_of_records > 0 THEN
                                SELECT
                                    COUNT(*)
                                INTO :P216_NO_OF_STANDARD_PRINTOUTS
                                FROM
                                    xxeba_trial_printouts_t
                                WHERE
                                    employee_id = :user_id
                                    AND trial_id = :p216_trial_id
                                    AND printout_flag = 'S';
                            ELSIF rtri.no_of_records = 0 THEN 
                                :P216_NO_OF_STANDARD_PRINTOUTS := 1;  
                            END IF;
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: P216_TRIAL_ID
                itemsToReturn: P216_NO_OF_STANDARD_PRINTOUTS
                showProcessing: true
            }
            execution {
                sequence: 70
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    window.open($v('P216_URL'),'_blank');
                    
                    //window.location.href = $v('P216_URL');
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: printReport('P216_TRIAL_ID','P216_DATA_SOURCE','P216_URL','P216_PRODUCT_CLASS');
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

    )


    process fetch-row-from-xxeba-trial-details (
        name: Fetch Row from XXEBA_TRIAL_DETAILS
        type: autoRowFetch
        source {
            tableName: XXEBA_TRIAL_DETAILS
            pkColumn: TRIAL_ID
            pkItem: P216_TRIAL_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 243089898517259583
        }
    )

    process indirect-saving (
        name: Indirect Saving
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  CURSOR ctri
                  IS
                    SELECT NO_OF_SHIFT_PER_DAY,
                      NO_OF_COMPONENTS_PROD_PER_HOUR,
                      EXIST_NO_OF_CUTTING_EDGES,
                      EXIST_AVERAGE_LIFE_PER_EDGE,
                      EXIST_UNIT_PRICE,
                      RECOM_UNIT_PRICE,
                      IDS_MACHINE_HOUR_PER_RATE,
                      EXIST_CYCLE_TIME,
                      RECOM_CYCLE_TIME,
                      RESULT_AVG_LIFE_EDGE,
                      IDS_TOOL_CHANGING_TIME,
                      IDS_SAVE_ON_INVENT_CARRY_COST,
                      IDS_SAVING_ON_MACHINE_HR_ANNUM,
                      NEW_TRIAL_OR_EXISTING
                    FROM XXEBA_TRIAL_DETAILS
                    WHERE trial_id = :P216_TRIAL_ID ;
                  rtri ctri%rowtype;
                  
                  CURSOR cresult
                  IS
                    SELECT SUM(NVL(RESULT_TOOL_LIFE, 0))RESULT_TOOL_LIFE
                    FROM XXEBA_TRIAL_EDGE_RESULTS
                    WHERE trial_id = :P216_TRIAL_ID;
                  rresult cresult %rowtype;
                  
                  CURSOR cres
                  IS
                    SELECT RESULT_CYLE_TIME_DIFFERENCE
                    FROM XXEBA_TRIAL_DETAILS
                    WHERE trial_id = :P216_TRIAL_ID;
                  rres cres%rowtype;
                  
                  v_monthly_consuption             NUMBER;
                  v_INVENTCARRYCOST_EXIST          NUMBER;
                  v_monthly_calculated             NUMBER;
                  v_tool_life                      NUMBER;
                  v_carry_cost_propose             NUMBER;
                  v_save_on_invent_carry_cost      NUMBER;
                  v_saving_on_machine_hr_annum     NUMBER;
                  V_DS_EXIST_TOTAL_TOOL_IND_TIME NUMBER;
                  V_DS_RECOMMEND_TOOL_INDEX_TIME   NUMBER;
                  V_DS_DIFF_EXIST_IND_TIME_RECOM NUMBER;
                  V_DS_SAVING_ON_MAC_HR_ANNUM1 NUMBER;
                  V_DS_COMPONENTS_PRODUCED         NUMBER;
                  V_DS_EXIST_TOOL_CHANGE_TIME      NUMBER;
                  V_DS_RECOM_TOOL_CHANGE_TIME      NUMBER;
                  V_DS_DIFF_EXIST_TL_RECOM_TOOL  NUMBER;
                  V_DS_SAVE_ON_MACHINE_HR_ANNUM2 NUMBER;
                  V_TOTAL_SAVING                   NUMBER;
                BEGIN
                  OPEN ctri;
                  FETCH ctri INTO rtri;
                  CLOSE ctri;
                  
                  OPEN cresult;
                  FETCH cresult INTO rresult;
                  CLOSE cresult;
                  
                  OPEN cres;
                  FETCH cres INTO rres;
                  CLOSE cres;
                  
                  /* 24-Oct-18 Thamaraiselvan Added */
                  if rtri.EXIST_NO_OF_CUTTING_EDGES > 0 and rtri.EXIST_AVERAGE_LIFE_PER_EDGE > 0 then
                      v_monthly_consuption := ( ( (rtri.NO_OF_SHIFT_PER_DAY * 8) * rtri.NO_OF_COMPONENTS_PROD_PER_HOUR) * 25) / (rtri.EXIST_NO_OF_CUTTING_EDGES * rtri.EXIST_AVERAGE_LIFE_PER_EDGE);
                  end if;
                
                  v_inventcarrycost_exist := ((v_monthly_consuption * 2 ) * rtri.EXIST_UNIT_PRICE);
                  v_tool_life             := rresult.RESULT_TOOL_LIFE;
                  
                  if v_tool_life > 0 then  /* 24-Oct-18 Thamaraiselvan Added */
                      v_monthly_calculated    := ( ( (rtri.NO_OF_SHIFT_PER_DAY * 8) * rtri.NO_OF_COMPONENTS_PROD_PER_HOUR) * 25) / v_tool_life;
                  end if;
                
                  v_carry_cost_propose := (v_monthly_calculated * 2) * rtri.RECOM_UNIT_PRICE ;
                  v_save_on_invent_carry_cost := ( (v_monthly_consuption * rtri.EXIST_UNIT_PRICE) - (v_monthly_calculated * rtri.RECOM_UNIT_PRICE) ) * 24/100;
                  v_saving_on_machine_hr_annum := ((((rres.RESULT_CYLE_TIME_DIFFERENCE * rtri.NO_OF_COMPONENTS_PROD_PER_HOUR ) / 3600) * rtri.IDS_MACHINE_HOUR_PER_RATE) * (rtri.NO_OF_SHIFT_PER_DAY * 8) ) * 300;
                
                IF rtri.NEW_TRIAL_OR_EXISTING = 'N' then
                  v_monthly_consuption         := NULL;
                  v_inventcarrycost_exist      := NULL;
                  v_inventcarrycost_exist      := NULL;
                  v_saving_on_machine_hr_annum := NULL;
                END IF;
                
                  UPDATE XXEBA_TRIAL_DETAILS
                  SET IDS_MONTHLY_CONSUMPTION_EXIST = ROUND(v_monthly_consuption),
                    IDS_INVENT_CARRYCOST_EXIST      = ROUND(v_inventcarrycost_exist),
                    IDS_MONTHLY_CONSUMPTION_CALC    = ROUND(v_monthly_calculated),
                    IDS_INVENT_CARRY_COST_PROPOSE   = ROUND(v_carry_cost_propose),
                    IDS_SAVE_ON_INVENT_CARRY_COST   = ROUND(v_save_on_invent_carry_cost),
                    IDS_SAVING_ON_MACHINE_HR_ANNUM  = ROUND(v_saving_on_machine_hr_annum)
                  WHERE trial_id                    = :P216_TRIAL_ID;
                  
                  if rtri.EXIST_CYCLE_TIME > 0  and rtri.EXIST_AVERAGE_LIFE_PER_EDGE  > 0 then
                      V_DS_EXIST_TOTAL_TOOL_IND_TIME := ((((rtri.NO_OF_SHIFT_PER_DAY       * 8)* 3600) / rtri.EXIST_CYCLE_TIME)/ rtri.EXIST_AVERAGE_LIFE_PER_EDGE ) * 300;
                  end if;
                  
                  if rtri.RECOM_CYCLE_TIME > 0 and rtri.RESULT_AVG_LIFE_EDGE > 0 then 
                      V_DS_RECOMMEND_TOOL_INDEX_TIME   := ((((rtri.NO_OF_SHIFT_PER_DAY       * 8)* 3600) / rtri.RECOM_CYCLE_TIME) / rtri.RESULT_AVG_LIFE_EDGE) * 300;
                  end if;
                  
                  V_DS_DIFF_EXIST_IND_TIME_RECOM := V_DS_EXIST_TOTAL_TOOL_IND_TIME - V_DS_RECOMMEND_TOOL_INDEX_TIME;
                  V_DS_SAVING_ON_MAC_HR_ANNUM1   := (V_DS_DIFF_EXIST_IND_TIME_RECOM / 3600) * rtri.IDS_MACHINE_HOUR_PER_RATE;
                  
                  if rtri.RECOM_CYCLE_TIME > 0 then
                      V_DS_COMPONENTS_PRODUCED         := V_DS_DIFF_EXIST_IND_TIME_RECOM   / rtri.RECOM_CYCLE_TIME;
                  end if;
                  
                  if rtri.EXIST_NO_OF_CUTTING_EDGES > 0 and  rtri.EXIST_AVERAGE_LIFE_PER_EDGE > 0 then
                      V_DS_EXIST_TOOL_CHANGE_TIME      := ((7200 * rtri.NO_OF_COMPONENTS_PROD_PER_HOUR) / (rtri.EXIST_NO_OF_CUTTING_EDGES * rtri.EXIST_AVERAGE_LIFE_PER_EDGE)) * rtri.IDS_TOOL_CHANGING_TIME;
                  end if;
                  
                  if rresult.RESULT_TOOL_LIFE > 0 then
                      V_DS_RECOM_TOOL_CHANGE_TIME      := ((7200 * rtri.NO_OF_COMPONENTS_PROD_PER_HOUR) / rresult.RESULT_TOOL_LIFE ) * rtri.IDS_TOOL_CHANGING_TIME;
                  end if;
                  
                  V_DS_DIFF_EXIST_TL_RECOM_TOOL  := V_DS_EXIST_TOOL_CHANGE_TIME        - V_DS_RECOM_TOOL_CHANGE_TIME;
                  V_DS_SAVE_ON_MACHINE_HR_ANNUM2 := (V_DS_DIFF_EXIST_TL_RECOM_TOOL   / 3600) * rtri.IDS_MACHINE_HOUR_PER_RATE;
                  V_TOTAL_SAVING                 := rtri.IDS_SAVE_ON_INVENT_CARRY_COST + rtri.IDS_SAVING_ON_MACHINE_HR_ANNUM + V_DS_SAVING_ON_MAC_HR_ANNUM1 + V_DS_SAVE_ON_MACHINE_HR_ANNUM2;
                
                IF rtri.NEW_TRIAL_OR_EXISTING = 'N' then
                
                 V_DS_EXIST_TOTAL_TOOL_IND_TIME := NULL;
                 V_DS_DIFF_EXIST_IND_TIME_RECOM := NULL;
                 V_DS_SAVING_ON_MAC_HR_ANNUM1   := NULL;
                 V_DS_COMPONENTS_PRODUCED       := NULL;
                 V_DS_EXIST_TOOL_CHANGE_TIME    := NULL;
                 V_DS_DIFF_EXIST_TL_RECOM_TOOL  := NULL;
                 V_DS_SAVE_ON_MACHINE_HR_ANNUM2 := NULL;
                 V_TOTAL_SAVING                 := NULL;
                 
                END IF;
                
                  UPDATE XXEBA_TRIAL_DETAILS
                  SET DS_EXIST_TOTAL_TOOL_INDEX_TIME = ROUND(V_DS_EXIST_TOTAL_TOOL_IND_TIME),
                    DS_RECOMMEND_TOOL_INDEX_TIME     = ROUND(V_DS_RECOMMEND_TOOL_INDEX_TIME),
                    DS_DIFF_EXIST_INDEX_TIME_RECOM   = ROUND(V_DS_DIFF_EXIST_IND_TIME_RECOM),
                    DS_SAVING_ON_MACHINE_HR_ANNUM1   = ROUND(V_DS_SAVING_ON_MAC_HR_ANNUM1),
                    DS_COMPONENTS_PRODUCED           = ROUND(V_DS_COMPONENTS_PRODUCED),
                    DS_EXIST_TOOL_CHANGE_TIME        = ROUND(V_DS_EXIST_TOOL_CHANGE_TIME),
                    DS_RECOM_TOOL_CHANGE_TIME        = ROUND(V_DS_RECOM_TOOL_CHANGE_TIME),
                    DS_DIFF_EXIST_TOOL_RECOM_TOOL    = ROUND(V_DS_DIFF_EXIST_TL_RECOM_TOOL),
                    DS_SAVING_ON_MACHINE_HR_ANNUM2   = ROUND(V_DS_SAVE_ON_MACHINE_HR_ANNUM2),
                    TOTAL_SAVING                     = ROUND(V_TOTAL_SAVING)
                  WHERE trial_id                     = :P216_TRIAL_ID;
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 307881708084932745
        }
    )

    process insert-existing-tool-life (
        name: Insert Existing Tool Life
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_edge NUMBER := 1;
                  V_NO_OF_RECORDS    NUMBER;
                  V_COUNT            NUMBER;
                BEGIN
                
                select count(*) into V_NO_OF_RECORDS FROM xxeba_trial_exists_results_t where trial_id = :p216_trial_id;
                
                    IF :p216_exist_no_of_cutting_edges IS NOT NULL AND V_NO_OF_RECORDS = 0 THEN
                     FOR i IN 1..:p216_exist_no_of_cutting_edges 
                        LOOP
                            INSERT INTO xxeba_trial_exists_results_t (
                                trial_id,
                                result_edge_number,
                                result_tool_life
                            ) VALUES (
                                :p216_trial_id,
                                v_edge,
                                NULL
                            );
                
                            v_edge := v_edge + 1;
                        END LOOP;
                    END IF;
                    
                    IF V_NO_OF_RECORDS > 0 THEN 
                        
                      V_COUNT:= apex_application.g_f02.COUNT;
                      FOR i IN 1 .. apex_application.g_f02.COUNT
                          LOOP
                           -- raise_application_error(-20001, apex_application.g_f01(i));
                            UPDATE xxeba_trial_exists_results_t
                            SET RESULT_TOOL_LIFE           = apex_application.g_f02(i)
                            WHERE RESULT_EDGE_NUMBER       = apex_application.g_f01(i)
                            AND TRIAL_ID                   = :p216_trial_id;
                          END LOOP;
                    END IF;
                    
                EXCEPTION
                    WHEN OTHERS THEN
                        raise_application_error(-20001, sqlerrm);
                END;      
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 360882888037721554
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,SAVE_B
        }
    )


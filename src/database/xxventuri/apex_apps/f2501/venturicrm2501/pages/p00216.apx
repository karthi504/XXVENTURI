        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR ctri IS
                        SELECT
                            COUNT(*) AS no_of_records
                        FROM
                            eba_sales_deals deal,
                            (
                                SELECT
                                    id salesrep_id_01
                                FROM
                                    eba_sales_salesreps r
                                START WITH
                                    r.id = :user_id
                                CONNECT BY
                                    PRIOR r.id = r.rep_manager_id
                            ) rep

    pageItem P216_DATA_SOURCE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @trial-details
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT TRIM(CHAR_VALUE) 
                  FROM XXEBA_SALES_PARAMETERS_T
                 WHERE UPPER(CODE) = UPPER('DATA_SOURCE_NAME')
                   AND STATUS = 'Y';
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P216_DEAL_ID (
        type: plugin/select2
        label {
            label: Opportunities
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    deal.deal_name   d,
                    deal.id          r
                FROM
                    eba_sales_deals deal,
                    (
                        SELECT
                           id salesrep_id_01
                        FROM
                            eba_sales_salesreps r
                        START WITH
                            r.id = :user_id
                        CONNECT BY
                            PRIOR r.id = r.rep_manager_id
                    ) rep
                WHERE
                    deal.SALESREP_ID_01 = rep.salesrep_id_01
                    AND deal_name IS NOT NULL
                    AND source_type = 'D'
                ORDER BY
                    1;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @trial-details
            slot: regionBody
            alignment: left
            column: 1
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: DEAL_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                SELECT 
                  DEAL_NAME d,
                  id r
                FROM eba_sales_deals
                WHERE DEAL_NAME IS NOT NULL 
                      and SOURCE_TYPE ='D'
                ORDER BY 1
                ```
        }
    )


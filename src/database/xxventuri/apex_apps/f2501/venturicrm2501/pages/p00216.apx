    process set-blade-columns-to-cutting-tools (
        name: Set Blade columns to Cutting Tools
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                IF :P216_PRODUCT_CLASS = 'Blades' then
                :P216_EXIST_TOOL_CHANGING_CRITE  := :P216_EXIST_BLADE_TOOL_CHANGE_C;
                :P216_EXIST_UNIT_PRICE           := :P216_EXIST_BLADE_UNIT_PRICE;
                :P216_EXIST_SPINDLE_SPEED        := :P216_EXIST_BLADE_SPINDLE_SPEED;
                :P216_EXIST_CUTTING_SPEED        := :P216_EXIST_BLADE_CUTTING_SPEED;
                :P216_EXIST_CYCLE_TIME           := :P216_EXIST_BLADE_CYCLE_TIME;
                
                :P216_RECOM_TOOL_CHANGING_CRITE  := :P216_RECOM_BLADE_TOOL_CHANGE_C;
                :P216_RECOM_UNIT_PRICE           := :P216_RECOM_BLADE_UNIT_PRICE;
                
                :P216_RECOM1_TOOL_CHANGING_CRIT   := :P216_RECOM1_BLADE_TOOL_CHANGE;
                :P216_RECOM1_UNIT_PRICE           := :P216_RECOM1_BLADE_UNIT_PRICE;
                /* Cutting Parameters for Balde Recommendation */ 
                :P216_RECOM_SPINDLE_SPEED        := :P216_RECOM_BLADE_SPINDLE_SPEED;
                :P216_RECOM_CUTTING_SPEED        := :P216_RECOM_BLADE_CUTTING_SPEED;
                :P216_RECOM_CYCLE_TIME           := :P216_RECOM_BLADE_CYCLE_TIME;
                /* Cutting Parameters for Balde Recommendation1 */ 
                :P216_RECOM1_SPINDLE_SPEED        := :P216_RECOM1_BLADE_SPINDLE_S;
                :P216_RECOM1_CUTTING_SPEED        := :P216_RECOM1_BLADE_CUTTING_S;
                :P216_RECOM1_CYCLE_TIME           := :P216_RECOM1_BLADE_CYCLE_TIME;
                END IF;
                end;
                ```
        }
        execution {
            sequence: 10
        }

            executionMappingIdentifier: 250215035961664763
        }
    )

    process set-blade-values (
        name: Set Blade Values
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  CURSOR ctrial
                  IS
                    SELECT 
                      EXIST_TOOL_CHANGING_CRITERIA,
                      EXIST_UNIT_PRICE,
                      EXIST_SPINDLE_SPEED,
                      EXIST_CUTTING_SPEED,
                      EXIST_CYCLE_TIME,      
                      RECOM_TOOL_CHANGING_CRITERIA,
                      RECOM_UNIT_PRICE,
                      RECOM_SPINDLE_SPEED,
                      RECOM_CUTTING_SPEED,
                      RECOM_CYCLE_TIME,
                      RECOM1_SPINDLE_SPEED,
                      RECOM1_CUTTING_SPEED,
                      RECOM1_CYCLE_TIME

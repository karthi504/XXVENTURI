        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            
            
            ```
    }
    css {
        inline:
            ```css
            .p-text-label{
                text-align: right;
                height: 2.2rem;
            
            }
            
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <!DOCTYPE html>
            <html>
               <body>
                  <script>
                     function printReport(p_trial_report,p_datasource,p_url,p_product_class) 
                     {
                         var v_trial_report = document.getElementById(p_trial_report).value;
                         var v_datasource = document.getElementById(p_datasource).value;
                         var v_url = document.getElementById(p_url).value;
                         var v_product_class = document.getElementById(p_product_class).value;
                         if (v_product_class == 'Blades')
                         {
                           window.open(""+v_url+"report?_repName=trial_blade_report&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_trial_report+"");       
                         }
                         else
                             {
                               window.open(""+v_url+"report?_repName=trial_report_test&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_trial_report+"");    
                             }
                     
                     }
                     
            
             function printReport1(p_trial_report,p_datasource,p_url,p_product_class) 
                     {
                         var v_trial_report = document.getElementById(p_trial_report).value;
                         var v_datasource = document.getElementById(p_datasource).value;
                         var v_url = document.getElementById(p_url).value;
                         var v_product_class = document.getElementById(p_product_class).value;
                         if (v_product_class == 'Blades')
                         {
                           window.open(""+v_url+"report?_repName=trial_blade_report&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_trial_report+"");       
                         }
                         else
                             {
                               window.open(""+v_url+"report?_repName=trial_report&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_trial_report+"");    
                             }
                     
                     }
            
            
            
                      function printGraphicalReport(p_trial_report,p_datasource,p_url,p_product_class) 
                     {
                         var v_trial_report = document.getElementById(p_trial_report).value;
                         var v_datasource = document.getElementById(p_datasource).value;
                         var v_url = document.getElementById(p_url).value;
                         var v_product_class = document.getElementById(p_product_class).value;
                         if (v_product_class == 'Blades')
                         {
                           window.open(""+v_url+"report?_repName=trial_blade_report_chart&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_trial_report+"");       
                         }
                         else
                             {
                             window.open(""+v_url+"report?_repName=trial_report_chart&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_trial_report+"");       
                             }
                     }
                      
                                function printproposal(p_trial_report,p_datasource,p_url,p_product_class) 
                     {
                         var v_trial_report = document.getElementById(p_trial_report).value;
                         var v_datasource = document.getElementById(p_datasource).value;
                         var v_url = document.getElementById(p_url).value;
                         var v_product_class = document.getElementById(p_product_class).value;
                         if (v_product_class == 'Blades')
                         {
                           window.open(""+v_url+"report?_repName=trial_cost_saving_proposal&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_trial_report+"");       
                         }
                         else
                      {
                           window.open(""+v_url+"report?_repName=trial_cost_saving_proposal&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_trial_report+"");       
                             }
                     }
                  </script>
               </body>
            </html>
            ```

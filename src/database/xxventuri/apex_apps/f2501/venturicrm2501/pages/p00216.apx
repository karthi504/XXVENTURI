    dynamicAction set-recom-depth-of-cut-2 (
        name: Set Recom Depth of Cut1
        execution {
            sequence: 240
        }
        when {
            selectionType: items
            items: [
                P216_EXIST_TOTAL_MATERIAL_REMO
                P216_EXIST_NO_OF_PASSES
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode

    button print-existing-detail (
        buttonName: PRINT_EXISTING_DETAIL
        label: Print Existing Detail
        layout {
            sequence: 60
            region: @trial-details
            slot: top
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P216_TRIAL_RESULT
        }
        comments {
            comments:
                ```
                declare
                
                cursor ctri is SELECT
                  count(*) as no_of_records
                FROM
                    eba_sales_deals deal,
                    (
                        SELECT
                           id salesrep_id_01
                        FROM
                            eba_sales_salesreps r
                        START WITH
                            r.id = :user_id
                        CONNECT BY
                            PRIOR r.id = r.rep_manager_id
                    ) rep
                WHERE
                    deal.SALESREP_ID_01 = rep.salesrep_id_01
                    AND deal_name IS NOT NULL
                    AND source_type = 'D'
                    AND deal.id  = :P216_DEAL_ID;
                    rtri ctri%rowtype;
                    
                    begin
                      IF :P216_TRIAL_RESULT is not null THEN
                          OPEN ctri;
                          FETCH CTRI into RTRI;
                          CLOSE CTRI;
                         IF rtri.no_of_records > 0 THEN
                           RETURN TRUE;
                         ELSE
                           RETURN FALSE;
                         END IF;             
                      ELSE
                          RETURN FALSE;
                      END IF;
                    
                    end;
                ```
        }
    )


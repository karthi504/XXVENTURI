        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments:
                ```
                declare
                
                cursor ctri is SELECT
                  count(*) as no_of_records
                FROM
                    eba_sales_deals deal,
                    (
                        SELECT
                           id salesrep_id_01
                        FROM
                            eba_sales_salesreps r
                        START WITH
                            r.id = :user_id
                        CONNECT BY
                            PRIOR r.id = r.rep_manager_id
                    ) rep
                WHERE
                    deal.SALESREP_ID_01 = rep.salesrep_id_01
                    AND deal_name IS NOT NULL
                    AND source_type = 'D'
                    AND deal.id  = :P216_DEAL_ID;
                    rtri ctri%rowtype;
                    
                    begin
                      IF :P216_TRIAL_RESULT is not null THEN
                          OPEN ctri;
                          FETCH CTRI into RTRI;
                          CLOSE CTRI;
                         IF rtri.no_of_records > 0 THEN
                           RETURN TRUE;
                         ELSE
                           RETURN FALSE;
                         END IF;             
                      ELSE
                          RETURN FALSE;
                      END IF;
                    
                    end;
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 70
            region: @trial-details
            slot: top
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    cursor ctri is
                    SELECT
                    count(*) as no_of_records
                    FROM
                        eba_sales_deals deal,
                        (
                            SELECT
                               id salesrep_id_01
                            FROM
                                eba_sales_salesreps r
                            START WITH
                                r.id = :user_id
                            CONNECT BY
                                PRIOR r.id = r.rep_manager_id
                        ) rep
                    WHERE
                        deal.SALESREP_ID_01 = rep.salesrep_id_01
                        AND deal_name IS NOT NULL
                        AND source_type = 'D'
                        AND deal.id = :p216_deal_id;
                        rtri ctri%rowtype;
                    
                    is_admin CHAR(1);
                BEGIN
                    BEGIN
                        SELECT
                            'Y'
                        INTO is_admin
                        FROM
                            eba_sales_salesreps        r,
                            eba_sales_salesrep_roles   sr
                        WHERE
                            r.id = :user_id
                            AND sr.id = r.rep_role
                            AND sr.role_name IN (
                                'Administrator'
                            );
                
                    EXCEPTION
                        WHEN no_data_found THEN
                            is_admin := 'N';
                    END;
                
                    OPEN ctri;
                    FETCH ctri into rtri;
                    CLOSE ctri;
                    IF ( ( :p216_trial_id IS NOT NULL AND :p216_status <> 'C' AND rtri.no_of_records > 0  ) OR ( is_admin = 'Y' )) THEN
                        RETURN true;
                    ELSE
                        RETURN false;
                    END IF;
                
                END;
                ```
        }
    )


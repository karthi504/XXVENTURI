    dynamicAction set-cost-per-component (
        name: Set Cost Per Component
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P216_EXIST_UNIT_PRICE
                P216_EXIST_AVERAGE_LIFE_PER_ED
                P216_EXIST_NO_OF_CUTTING_EDGES
                P216_EXIST_NO_OF_FLUTES
            ]
        }
        comments {
            comments: P216_NEW_TRIAL_OR_EXISTING
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    /* Old Formula
                    BEGIN
                    :P216_EXIST_COST_PER_COMPONENT := round((:P216_EXIST_UNIT_PRICE / :P216_EXIST_AVERAGE_LIFE_PER_ED), 2) * :P216_EXIST_NO_OF_CUTTING_EDGES;
                    END;
                    */
                    
                    -- BEGIN
                    --     IF :P216_EXIST_AVERAGE_LIFE_PER_ED > 0 and  :P216_EXIST_NO_OF_CUTTING_EDGES > 0 and :P216_EXIST_NO_OF_FLUTES > 0 then
                    --         :P216_EXIST_COST_PER_COMPONENT := round( ( :P216_EXIST_UNIT_PRICE / (:P216_EXIST_AVERAGE_LIFE_PER_ED * :P216_EXIST_NO_OF_CUTTING_EDGES * :P216_EXIST_NO_OF_FLUTES)), 2);
                    --     END IF;
                    -- END;
                    
                    --Added by Dinesh R on 06-Sep-2025
                    BEGIN
                        IF :P216_EXIST_AVERAGE_LIFE_PER_ED > 0 and  :P216_EXIST_NO_OF_CUTTING_EDGES > 0 and :P216_EXIST_NO_OF_FLUTES > 0 then
                            :P216_EXIST_COST_PER_COMPONENT := round( ( (:P216_EXIST_UNIT_PRICE * :P216_EXIST_NO_OF_FLUTES ) / (:P216_EXIST_AVERAGE_LIFE_PER_ED * :P216_EXIST_NO_OF_CUTTING_EDGES)), 2);
                        END IF;
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    P216_EXIST_UNIT_PRICE
                    P216_EXIST_AVERAGE_LIFE_PER_ED
                    P216_EXIST_NO_OF_CUTTING_EDGES
                    P216_EXIST_NO_OF_FLUTES
                ]
                itemsToReturn: P216_EXIST_COST_PER_COMPONENT
                showProcessing: true
            }
            execution {
                sequence: 10
            }
            comments {
                comments: P216_NEW_TRIAL_OR_EXISTING
            }
        )

    )


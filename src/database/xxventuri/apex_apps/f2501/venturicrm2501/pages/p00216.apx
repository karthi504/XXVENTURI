    dynamicAction disable-enable-cost-saving-print-out-buttons (
        name: Disable / Enable Cost Saving Print Out Buttons
        execution {
            sequence: 230
        }
        when {
            selectionType: items
            items: P216_NO_OF_COST_PRINTOUTS
        }
        clientSideCondition {
            type: item>value
            item: P216_NO_OF_COST_PRINTOUTS
            value: 0
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @cost-saving-proposal
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @cost-saving-proposal
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )


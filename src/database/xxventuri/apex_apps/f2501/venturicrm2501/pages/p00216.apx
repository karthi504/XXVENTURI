    region existing-tool-life (
        name: Existing Tool Life
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                   APEX_ITEM.DISPLAY_AND_SAVE(1,RESULT_EDGE_NUMBER)  result_edge_number,
                       APEX_ITEM.TEXT(
                    p_idx         => 2,
                    p_value       => RESULT_TOOL_LIFE,
                    p_size        => 50,
                    p_maxlength   => 50,
                    p_attributes  => 'class="p-text-label"',
                    p_item_id     => null,
                    p_item_label  => NULL)RESULT_TOOL_LIFE
                FROM
                    xxeba_trial_exists_results_t
                WHERE
                    trial_id = :p216_trial_id
                ```
            pageItemsToSubmit: P216_TRIAL_ID
        }
        layout {
            sequence: 20
            parentRegion: @existing-tool
            slot: subRegions
            columnSpan: 6
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P216_EXIST_NO_OF_CUTTING_EDGES
        }
        reportLayout {
            numberOfRows: 26
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }

        column RESULT_EDGE_NUMBER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Edge
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column RESULT_TOOL_LIFE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Tool Life
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )


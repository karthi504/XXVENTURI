                                SELECT
                                    id salesrep_id_01
                                FROM
                                    eba_sales_salesreps r
                                START WITH
                                    r.id = :user_id
                                CONNECT BY
                                    PRIOR r.id = r.rep_manager_id
                            ) rep
                        WHERE
                            deal.salesrep_id_01 = rep.salesrep_id_01
                            AND deal_name IS NOT NULL
                            AND source_type = 'D'
                            AND deal.id = :p216_deal_id;
                    
                        rtri         ctri%rowtype;
                        v_is_admin   CHAR(1);
                    BEGIN
                        FOR i IN 1..2 LOOP 
                            BEGIN
                                SELECT
                                    'Y'
                                INTO v_is_admin
                                FROM
                                    eba_sales_salesreps        r,
                                    eba_sales_salesrep_roles   sr
                                WHERE
                                    r.id = :user_id
                                    AND sr.id = r.rep_role
                                    AND sr.role_name = 'Administrator';
                    
                            EXCEPTION
                                WHEN no_data_found THEN
                                    v_is_admin := 'N';
                            END;
                    
                            OPEN ctri;
                            FETCH ctri INTO rtri;
                            CLOSE ctri;
                            
                            IF v_is_admin != 'Y' AND rtri.no_of_records > 0 THEN
                                SELECT
                                    COUNT(*)
                                INTO :P216_NO_OF_STANDARD_PRINTOUTS
                                FROM
                                    xxeba_trial_printouts_t
                                WHERE
                                    employee_id = :user_id
                                    AND trial_id = :p216_trial_id
                                    AND printout_flag = 'S';
                            ELSIF rtri.no_of_records = 0 THEN 
                                   :P216_NO_OF_STANDARD_PRINTOUTS  := 1;  
                            END IF;
                        END LOOP;
                    END;
                    
                    ```
                itemsToSubmit: P216_TRIAL_ID
                itemsToReturn: P216_NO_OF_STANDARD_PRINTOUTS
                showProcessing: true
            }
            execution {
                sequence: 50
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    window.open($v('P216_URL'),'_blank');
                    
                    //window.location.href = $v('P216_URL');
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: printReport1('P216_TRIAL_ID','P216_DATA_SOURCE','P216_URL','P216_PRODUCT_CLASS');
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction report-call-for-graphical-report (
        name: Report Call for Graphical Report
        execution {
            sequence: 190
        }
        when {
            event: click
            selectionType: button
            button: @print-graphical-report
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        repName           VARCHAR2(100);
                        parameters        VARCHAR2(200);
                        l_url             VARCHAR2(2000);
                        l_encoded_params  VARCHAR2(500);
                    BEGIN
                    
                        -- IF :P216_REPORT_TYPE = 'TRIAL' THEN
                        --     repName := 'trial_report';
                        
                        -- IF :P216_REPORT_TYPE = 'TRIAL' THEN
                        --     repName := 'trial_report';
                        -- ELSE repName := 'trial_report_test';
                        -- END IF;
                    
                    
                    IF :P216_PRODUCT_CLASS_ID <> 3 then
                    
                        repName := 'trial_report_chart'; 
                    
                    ELSE    repName := 'trial_blade_report_chart';
                    END IF;
                    
                    
                    
                        parameters := '&p1=' || :P216_TRIAL_ID;
                    
                        l_encoded_params := apex_util.url_encode(parameters);
                    
                        l_url := 'https://products.4iapps.com/ords/r/venturitool/venturicrm2501/print-jasper-report?p200_parameters=' ||
                                  l_encoded_params || 
                                  '&p200_report_name=' || repName || 
                                  '&session=' || :APP_SESSION;
                    
                        -- Set to output URL item (used in frontend)
                        :P216_URL := l_url;
                    
                    EXCEPTION
                        WHEN OTHERS THEN
                            xxfs_pm_error_log_pkg.record_log(
                                'ERROR', 
                                'REPORT_PROCESS'||l_url||repName, 
                                'Error generating report URL: ' || SQLERRM
                            );
                    END;
                    ```
                itemsToSubmit: P216_TRIAL_ID
                itemsToReturn: P216_URL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        INSERT INTO xxeba_trial_printouts_t 
                        (
                            PRINTOUT_DATE,
                            PRINTOUT_FLAG,
                            EMPLOYEE_ID,
                            TRIAL_ID
                        ) VALUES 
                        (
                            SYSDATE,
                            'G',
                            :USER_ID,
                            :p216_trial_id
                        );
                    END;
                    ```
                itemsToSubmit: P216_TRIAL_ID
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR ctri IS
                        SELECT
                            COUNT(*) AS no_of_records
                        FROM
                            eba_sales_deals deal,
                            (
                                SELECT
                                    id salesrep_id_01
                                FROM
                                    eba_sales_salesreps r
                                START WITH
                                    r.id = :user_id
                                CONNECT BY
                                    PRIOR r.id = r.rep_manager_id
                            ) rep
                        WHERE
                            deal.salesrep_id_01 = rep.salesrep_id_01
                            AND deal_name IS NOT NULL
                            AND source_type = 'D'
                            AND deal.id = :p216_deal_id;
                    
                        rtri         ctri%rowtype;
                        v_is_admin   CHAR(1);
                    BEGIN
                        BEGIN
                            SELECT
                                'Y'
                            INTO v_is_admin
                            FROM
                                eba_sales_salesreps        r,
                                eba_sales_salesrep_roles   sr
                            WHERE
                                r.id = :user_id
                                AND sr.id = r.rep_role
                                AND sr.role_name = 'Administrator';
                    
                        EXCEPTION
                            WHEN no_data_found THEN
                                v_is_admin := 'N';
                        END;
                    
                            OPEN ctri;
                            FETCH ctri INTO rtri;
                            CLOSE ctri;
                            
                            IF v_is_admin != 'Y' AND rtri.no_of_records > 0 THEN
                                SELECT
                                    COUNT(*)
                                INTO :P216_NO_OF_GRAPHICAL_PRINTOUTS
                                FROM
                                    xxeba_trial_printouts_t
                                WHERE
                                    employee_id = :user_id
                                    AND trial_id = :p216_trial_id
                                    AND printout_flag = 'G';
                            ELSIF rtri.no_of_records = 0 THEN 
                                   :P216_NO_OF_GRAPHICAL_PRINTOUTS  := 1;                
                    
                            END IF;
                    END;
                    ```
                itemsToSubmit: P216_TRIAL_ID
                itemsToReturn: P216_NO_OF_GRAPHICAL_PRINTOUTS
                showProcessing: true
            }
            execution {
                sequence: 50
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    window.open($v('P216_URL'),'_blank');
                    
                    //window.location.href = $v('P216_URL');
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: printGraphicalReport('P216_TRIAL_ID','P216_DATA_SOURCE','P216_URL','P216_PRODUCT_CLASS');
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction report-call-for-standard-report (
        name: Report Call for Standard Report
        execution {
            sequence: 160
        }
        when {
            event: click
            selectionType: button
            button: @print-standard-report-old
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        INSERT INTO xxeba_trial_printouts_t 
                        (
                            PRINTOUT_DATE,
                            PRINTOUT_FLAG,
                            EMPLOYEE_ID,
                            TRIAL_ID
                        ) VALUES 
                        (
                            SYSDATE,
                            'S',
                            :USER_ID,
                            :p216_trial_id
                        );
                    END;
                    ```
                itemsToSubmit: P216_TRIAL_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR ctri IS
                        SELECT
                            COUNT(*) AS no_of_records
                        FROM
                            eba_sales_deals deal,
                            (
                                SELECT
                                    id salesrep_id_01
                                FROM
                                    eba_sales_salesreps r
                                START WITH
                                    r.id = :user_id
                                CONNECT BY
                                    PRIOR r.id = r.rep_manager_id
                            ) rep
                        WHERE
                            deal.salesrep_id_01 = rep.salesrep_id_01
                            AND deal_name IS NOT NULL
                            AND source_type = 'D'
                            AND deal.id = :p216_deal_id;
                    
                        rtri         ctri%rowtype;
                        v_is_admin   CHAR(1);
                        v_admin_print_count NUMBER;
                    BEGIN
                        BEGIN
                            SELECT
                                'Y'
                            INTO v_is_admin
                            FROM
                                eba_sales_salesreps        r,
                                eba_sales_salesrep_roles   sr
                            WHERE
                                r.id = :user_id
                                AND sr.id = r.rep_role
                                AND sr.role_name = 'Administrator';
                    
                        EXCEPTION
                            WHEN no_data_found THEN
                                v_is_admin := 'N';
                        END;
                    
                        OPEN ctri;
                        FETCH ctri INTO rtri;
                        CLOSE ctri;
                        
                        IF v_is_admin = 'Y' THEN
                            SELECT
                                COUNT(*)
                            INTO v_admin_print_count
                            FROM
                                xxeba_trial_printouts_t
                            WHERE
                                employee_id = :user_id
                                AND trial_id = :p216_trial_id
                                AND printout_flag = 'S';
                            
                            IF v_admin_print_count < 2 THEN
                                :P216_NO_OF_STANDARD_PRINTOUTS := v_admin_print_count + 1;
                            ELSE
                                :P216_NO_OF_STANDARD_PRINTOUTS := v_admin_print_count;
                            END IF;
                        ELSE
                            IF rtri.no_of_records > 0 THEN
                                SELECT
                                    COUNT(*)
                                INTO :P216_NO_OF_STANDARD_PRINTOUTS
                                FROM
                                    xxeba_trial_printouts_t
                                WHERE
                                    employee_id = :user_id
                                    AND trial_id = :p216_trial_id
                                    AND printout_flag = 'S';
                            ELSIF rtri.no_of_records = 0 THEN 
                                :P216_NO_OF_STANDARD_PRINTOUTS := 1;  
                            END IF;
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: P216_TRIAL_ID
                itemsToReturn: P216_NO_OF_STANDARD_PRINTOUTS
                showProcessing: true
            }
            execution {
                sequence: 30
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: printReport('P216_TRIAL_ID','P216_DATA_SOURCE','P216_URL','P216_PRODUCT_CLASS');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )


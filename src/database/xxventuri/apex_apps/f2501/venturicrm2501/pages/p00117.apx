            sequence: 20
            region: @view-products
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Are you sure want to clear the data?', 'CLEAR_DATA');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button download-template (
        buttonName: DOWNLOAD_TEMPLATE
        label: Download Template
        layout {
            sequence: 30
            region: @upload-file-region
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 117
                clearCache: 117
                action: resetPagination
                request: APPLICATION_PROCESS=DOWNLOAD_TEMPLATE
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button load-file (
        buttonName: LOAD_FILE
        label: Get Data
        layout {

    pageItem P117__UPLOAD_FILE (
        type: fileUpload
        label {
            label: Select File to Import
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
        }
        layout {
            sequence: 10
            region: @upload-file-region
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button cancel (
        buttonName: Cancel
        label: Cancel
        layout {
            sequence: 20
            region: @upload-file-region
            slot: belowBox
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
    )

    button cancel-2 (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @view-products
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 33
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button clear-data (
        buttonName: CLEAR_DATA
        label: Clear

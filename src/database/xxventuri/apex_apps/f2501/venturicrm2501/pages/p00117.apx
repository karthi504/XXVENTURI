            region: @upload-file-region
            slot: regionBody
            startNewRow: false
            column: 6
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: style="margin-top: 4px;"
        }
    )

    button save-data (
        buttonName: Save_data
        label: Import
        layout {
            sequence: 30
            region: @view-products
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //alert();
                    $('.ui-dialog', window.parent.document).hide();
                    //window.parent.document.getElementsByClassName('ui-dialog')[0].style.display = "none";
                    $('.ui-widget-overlay', window.parent.document).hide();
                    //window.parent.document.getElementsByClassName('ui-widget-overlay')[0].style.display = "none";
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process clear-collection (
        name: Clear Collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    APEX_COLLECTION.TRUNCATE_COLLECTION(
                        p_collection_name => 'SALES_PRODUCTS_COLLECTION');
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 274158265774343881
        }
        serverSideCondition {
            whenButtonPressed: @clear-data
        }
    )

    process load-report-data (
        name: Load Report Data
        type: plugin/excel2collection
        settings {
            browseItem: P117__UPLOAD_FILE
            collectionName: SALES_PRODUCTS_COLLECTION
            csvSeparator: ;
            csvEnclosedBy: "
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Uploaded sucessfully!!!!
        }
        advanced {
            executionMappingIdentifier: 69868064480609796
        }
        serverSideCondition {
            whenButtonPressed: @load-file
        }
    )

    process save-collection (
        name: Save_collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_count           NUMBER :=0;
                  lv_product_cost   VARCHAR2(255);
                  lv_max_discount_pct number;
                  v_collection_name VARCHAR2(255);
                  CURSOR C1
                  IS
                    SELECT SEQ_ID ,
                      C001 PRODUCT_CODE ,
                      C002 ORDERING_CODE ,
                      C003 UNIT_PRICE ,
                      C004 CURRENCY,
                      C005 PRODUCT_COST,
                      C006 DISCOUNT_PCT
                    FROM APEX_COLLECTIONS
                    WHERE COLLECTION_NAME = 'SALES_PRODUCTS_COLLECTION'
                    AND SEQ_ID            >1;    
                   r1 c1%rowtype;
                  
                  CURSOR C2 (p_product_code VARCHAR2, p_order_code VARCHAR2)
                  IS
                    SELECT --PRODUCT_NAME,
                      --CATALOGUE_NO
                      count(*) no_of_records
                    FROM EBA_SALES_PRODUCTS
                    WHERE --PRODUCT_NAME =trim(p_product_code)-- AND  /* Bharath Raju Date: 27-Apr-2021*/
                    CATALOGUE_NO   = trim(p_order_code);
                  r2 c2%rowtype;
                  
                BEGIN
                
                  v_collection_name := 'SALES_PRODUCTS_COLLECTION';
                    
                  select nvl(NUM_VALUE,0) into lv_max_discount_pct  from XXEBA_SALES_PARAMETERS_T where CODE='MAX_DISCOUNT' AND STATUS='Y';
                  FOR r1 IN C1
                  LOOP
                    BEGIN
                      IF r1.PRODUCT_CODE IS NULL AND r1.ORDERING_CODE IS NULL THEN
                        APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Invalid Product');
                        --v_count:=v_count+1;
                      elsif  r1.PRODUCT_CODE IS NOT NULL or r1.ORDERING_CODE IS NOT NULL THEN
                        FOR r2 IN c2(r1.PRODUCT_CODE, r1.ORDERING_CODE)
                            LOOP        
                          IF r2.no_of_records = 0 THEN
                          APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Product Not Found');
                          --v_count:=v_count+1;
                          END IF;  
                         IF r2.no_of_records <> 0 and  r1.PRODUCT_COST is not null and r1.DISCOUNT_PCT is not null THEN
                                    APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Not Updated');
                          END IF;
                         
                          
                          IF r2.no_of_records <> 0 and r1.DISCOUNT_PCT is null and r1.PRODUCT_COST is not null THEN
                          
                          IF TO_NUMBER(trim(r1.UNIT_PRICE)) > TO_NUMBER(trim(r1.PRODUCT_COST)) THEN 
                          UPDATE EBA_SALES_PRODUCTS
                          SET PRODUCT_PRICE        = TO_NUMBER(NVL(trim(r1.UNIT_PRICE),0)),
                            CURRENCY_TYPE          = r1.CURRENCY,
                            PRODUCT_COST           = TO_NUMBER(NVL(trim(r1.PRODUCT_COST),0)),
                            PRODUCT_CURRENCY_TYPE  = r1.CURRENCY,
                            DISCOUNT_PCT           = null
                          WHERE --trim(PRODUCT_NAME) = trim(r1.PRODUCT_CODE) /* Bharath Raju Date: 27-Apr-2021*/
                        --  AND 
                          CATALOGUE_NO         = trim(r1.ORDERING_CODE);          
                          APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Updated');
                          ELSIF TO_NUMBER(trim(r1.UNIT_PRICE)) <= TO_NUMBER(trim(r1.PRODUCT_COST)) THEN 
                          APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Actual Price should be greater than Product Cost.');
                          END IF;
                          
                		  ELSIF r2.no_of_records <> 0 and r1.DISCOUNT_PCT is not null and r1.PRODUCT_COST is null  THEN
                     
                		  lv_product_cost := round((nvl(nvl(r1.UNIT_PRICE,0),0) - (nvl(r1.UNIT_PRICE,0)) * ((nvl(r1.DISCOUNT_PCT,0) / 100))),2);
                          IF to_number(r1.DISCOUNT_PCT) <= to_number(lv_max_discount_pct) and to_number(r1.DISCOUNT_PCT) >=1 THEN
                          UPDATE EBA_SALES_PRODUCTS
                          SET PRODUCT_PRICE        = TO_NUMBER(NVL(trim(r1.UNIT_PRICE),0)),
                            CURRENCY_TYPE          = r1.CURRENCY,
                            PRODUCT_COST           = TO_NUMBER(NVL(trim(lv_product_cost),0)),--- TO_NUMBER(NVL(trim(r1.PRODUCT_COST),0)),
                            PRODUCT_CURRENCY_TYPE  = r1.CURRENCY,
                            DISCOUNT_PCT           = r1.DISCOUNT_PCT
                          WHERE --trim(PRODUCT_NAME) = trim(r1.PRODUCT_CODE) /* Bharath Raju Date: 27-Apr-2021*/
                          --AND
                          CATALOGUE_NO         = trim(r1.ORDERING_CODE);          
                          APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Updated');
                          ELSIF to_number(r1.DISCOUNT_PCT) <= 0 THEN
                          APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Discount % is not between the valid range of 1 and '||lv_max_discount_pct||'.');
                          ELSIF to_number(r1.DISCOUNT_PCT) > to_number(lv_max_discount_pct)  THEN
                           APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Discount % is not between the valid range of 1 and '||lv_max_discount_pct||'.');
                       
                          END IF;
                         -- v_count:=v_count+1;
                        END IF;                
                      END LOOP;      
                      END IF;      
                      
                    EXCEPTION
                    WHEN OTHERS THEN
                    
                      APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'SALES_PRODUCTS_COLLECTION', p_seq => r1.SEQ_ID, p_attr_number => 8, p_attr_value => 'Not Updated');
                     -- v_count:=v_count+1;
                    END;
                  END LOOP;
                --  raise_application_error(-20001, v_count);
                EXCEPTION WHEN OTHERS THEN
                RAISE_APPLICATION_ERROR(-20001, SQLERRM);
                END; 
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Imported successfully!!!!!
        }
        advanced {
            executionMappingIdentifier: 140469918181708645
        }
        serverSideCondition {
            whenButtonPressed: @save-data
        }
    )

)


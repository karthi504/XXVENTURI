    region view-products (
        name: View Products
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SEQ_ID ,C001  PRODUCT_CODE , C002  ORDERING_CODE , C003  UNIT_PRICE , C004  CURRENCY ,C005 PRODUCT_COST, C006 DISCOUNT_PCT, C008 Result 
                		FROM APEX_COLLECTIONS
                		WHERE COLLECTION_NAME = 'SALES_PRODUCTS_COLLECTION' and SEQ_ID>1; 
                       
                ```
        }
        layout {
            sequence: 1220
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 127646810068679009
        }


    dynamicAction open-modal-dialog (
        name: Open Modal Dialog
        execution {
            sequence: 130
        }
        when {
            selectionType: items
            items: [
                P108_PRICE
                P108_QUANTITY
            ]
        }
        clientSideCondition {
            type: item!=value
            item: P108_SOURCE_PAGE
            value: 173
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  CURSOR crlm
                  IS
                    SELECT ROLE_NAME
                    FROM EBA_SALES_SALESREPS REP,
                      EBA_SALES_SALESREP_ROLES RLM
                    WHERE rep.REP_ROLE = rlm.id
                    AND rep.id = :USER_ID;
                  rrlm crlm%rowtype;
                  
                BEGIN
                
                  OPEN crlm;
                  FETCH crlm INTO rrlm;
                  CLOSE crlm;
                  
                  IF rrlm.ROLE_NAME = 'Administrator' THEN
                    RETURN TRUE;
                  ELSE
                    RETURN FALSE;
                  END IF;
                EXCEPTION
                WHEN OTHERS THEN
                  RETURN FALSE;
                END;
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ((parseInt($v('P108_PRICE')) < parseInt($v('P108_MINIMUM_PRICE'))) && (($v('P108_PRICE') != '' ) && ($v('P108_QUANTITY')  != '' )))
                        {
                            
                            
                          if ($v('P108_ID') == '' ) 
                           {
                             javascript:apex.confirm('Unit Price is lesser than the minimum price of this Product. Press OK to proceed', 'CREATE');
                           }
                            
                            else
                                {
                                    javascript:apex.confirm('Unit Price is lesser than the minimum price of this Product. Press OK to proceed', 'SAVE');
                                }
                                
                        }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


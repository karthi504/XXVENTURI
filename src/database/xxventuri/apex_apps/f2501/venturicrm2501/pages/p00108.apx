page 108 (
    name: Product Details
    title: Product Details
    pageGroup: @opportunities
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    css {
        inline:
            ```css
            .apex-button-group input:checked+label {
                background-color: #e95b54;
                color: #fafafa;
            }
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script>
            function isCharKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 33 && (charCode < 65 || charCode > 91)&& (charCode < 97 || charCode > 122))
                        return false;
            
                     return true;
                  }
            function isNumberKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 31 && (charCode < 48 || charCode > 57))
                        return false;
            
                     return true;
                  }
            </script>
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region product-details (
        name: Product Details
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P108_ACCOUNT_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @product-details
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                if :P108_SOURCE_PAGE=173 then 
                return :P173_CUSTOMER_NAME;
                else
                return :P80_ACCOUNT;
                end if;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )


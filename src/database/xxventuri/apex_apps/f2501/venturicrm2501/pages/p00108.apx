    dynamicAction set-tcv (
        name: Set TCV
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: [
                P108_CONTRACT_TERM
                P108_QUOTE_PRICE
            ]
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P108_CONTRACT_TERM') > '' && $v('P108_QUOTE_PRICE') > ''
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    if :P108_CONTRACT_TERM < 12 then
                        :P108_TCV := replace(replace(:P108_QUOTE_PRICE,',',null),'$',null) / ((:P108_CONTRACT_TERM * 12) / :P108_CONTRACT_TERM);
                    elsif :P108_CONTRACT_TERM = 12 then
                        :P108_TCV := replace(replace(:P108_QUOTE_PRICE,',',null),'$',null);
                    elsif :P108_CONTRACT_TERM > 12 then
                        :P108_TCV := replace(replace(:P108_QUOTE_PRICE,',',null),'$',null) * (:P108_CONTRACT_TERM / 12);
                    end if;
                    
                    :P108_TCV := to_char(:P108_TCV,'FML999G999G999G999G999');
                    
                    return :P108_TCV;
                    ```
                itemsToSubmit: [
                    P108_CONTRACT_TERM
                    P108_QUOTE_PRICE
                ]
            }
            affectedElements {
                selectionType: items
                items: P108_TCV
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P108_TCV
            }
            execution {
                sequence: 30
            }
        )

    )


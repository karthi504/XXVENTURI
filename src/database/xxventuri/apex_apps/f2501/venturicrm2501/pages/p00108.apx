    validation check-delivery-date-while-edit (
        name: Check Delivery Date While Edit
        execution {
            sequence: 90
        }
        validation {
            plsqlExpression: trunc(to_date(:P108_CLOSE_DATE_1)) >= trunc(sysdate)
        }
        error {
            errorMessage: Delivery Date should be greater than OR equal to current date.
            displayLocation: inlineInNotification
            associatedItem: @P108_CLOSE_DATE_1
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation check-sysdate (
        name: Check Sysdate
        execution {
            sequence: 50
        }
        validation {
            plsqlExpression: trunc(to_date(:P108_CLOSE_DATE)) >= trunc(sysdate)
        }
        error {
            errorMessage: Delivery Date should be greater than OR equal to current date.
            displayLocation: inlineWithField
            associatedItem: @P108_CLOSE_DATE
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation delivery-date-validation-for-same-product (
        name: Delivery date validation for same product
        execution {
            sequence: 60
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                     product_id  NUMBER;
                    v_error_text  VARCHAR2(1000) := NULL;
                BEGIN
                  FOR c IN
                  (SELECT seq_id s_no,n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  LOOP
                  IF c.order_products_id = :P108_PRODUCT_ID THEN
                    IF  c.Delivery_date = :P108_CLOSE_DATE  THEN
                    v_error_text :='Sorry! Same Delivery Date is available for this product '||c.product_name||'.';
                     
                    END IF;
                    END IF;
                  END LOOP;
                  RETURN v_error_text; 
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation minimum-price (
        name: minimum_price
        execution {
            sequence: 70
        }
        validation {
            plsqlExpression: to_number(:P108_MINIMUM_PRICE) <= :P108_PRICE
        }
        error {
            errorMessage: 'Sorry! Unit Price is lesser than the minimum price of this Product.'
            displayLocation: inlineInNotification
            associatedItem: @P108_PRICE
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  CURSOR crlm
                  IS
                    SELECT ROLE_NAME
                    FROM EBA_SALES_SALESREPS REP,
                      EBA_SALES_SALESREP_ROLES RLM
                    WHERE rep.REP_ROLE = rlm.id
                    AND rep.id = :USER_ID;
                  rrlm crlm%rowtype;
                  
                BEGIN
                
                  OPEN crlm;
                  FETCH crlm INTO rrlm;
                  CLOSE crlm;
                
                IF :P108_SOURCE_PAGE != 173 then
                  IF rrlm.ROLE_NAME = 'Administrator' THEN
                    RETURN FALSE;
                  ELSE
                    RETURN TRUE;
                  END IF;
                END IF;  
                EXCEPTION
                WHEN OTHERS THEN
                  RETURN TRUE;
                END;
                ```
        }
    )

    validation new (
        name: New
        execution {
            sequence: 100
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                   v_pr_family  VARCHAR2(500);
                   v_family_id  VARCHAR2(500);
                BEGIN
                   -- First SELECT statement
                   BEGIN 
                      SELECT p.PRODUCT_FAMILY_ID  
                      INTO v_pr_family
                      FROM eba_sales_PRODUCTS p,
                           eba_sales_product_families pd 
                      WHERE pd.id = p.PRODUCT_FAMILY_ID
                      AND p.id  = :P108_PRODUCT_ID;
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                         v_pr_family := NULL;
                   END;
                
                   -- Second SELECT statement
                   BEGIN
                      SELECT pd.ID  
                      INTO v_family_id
                      FROM eba_sales_PRODUCTS p,
                           eba_sales_product_families pd 
                      WHERE pd.id = p.PRODUCT_FAMILY_ID
                      AND p.id  = :P108_PRODUCT_ID;
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                         v_family_id := NULL;
                   END;
                
                   -- Comparison and returning result
                   IF v_pr_family <> v_family_id THEN
                      RETURN FALSE;
                   ELSE
                      RETURN TRUE;
                   END IF;
                
                EXCEPTION
                   WHEN OTHERS THEN
                      RETURN FALSE; -- Return FALSE in case of any unexpected error
                END;
                ```
        }
        error {
            errorMessage: Not the same family!
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    validation p108-product-id-not-duplicated (
        name: P108_PRODUCT_ID not duplicated
        execution {

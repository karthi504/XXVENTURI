    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE    
                    
                BEGIN  
                        
                        FOR c IN (
                       SELECT n001 id, n002  margin, c001  product_name, c002 currency_type, n004 brand_id,  c003 MINIMUM_ORDER_QUANTITY , c005 PRODUCT_FAMILY_ID FROM apex_collections WHERE collection_name = 'PRODUCT_COLLECTION')
                         LOOP
                      
                           INSERT INTO EBA_SALES_PRODUCTS ( ID, 
                											 margin, 
                											 PRODUCT_NAME, 
                											  PRODUCT_PRICE, 
                											 CURRENCY_TYPE, 
                											 BRAND_ID,
                                                             MINIMUM_ORDER_QUANTITY,
                                                             PRODUCT_FAMILY_ID
                											)
                                                      VALUES (:P108_ID,
                                                              c.margin,
                                                              c.product_name,
                                                              :P108_PRICE,
                                                              c.currency_type,
                											  c.brand_id,
                                                              c.MINIMUM_ORDER_QUANTITY,
                                                              c.PRODUCT_FAMILY_ID
                                                              );
                   
                
                        END LOOP; 
                
                END;
                 
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 342348247726012109
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }

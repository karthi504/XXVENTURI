    pageItem P108_PRODUCT_ID (
        type: popupLov
        label {
            label: "Product "
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    v_all_product varchar2(4000);
                    v_cust_product varchar2(4000);
                begin
                    v_cust_product := 'SELECT DISTINCT p.PRODUCT_NAME || '' ['' || p.CATALOGUE_NO || '']'' AS display_value, 
                                              p.ID AS return_value
                                       FROM eba_sales_PRODUCTS p 
                                       JOIN eba_sales_verifications v ON p.ID = v.PRODUCT_ID
                                       JOIN XXEBA_SALES_PRODUCT_TYPES PT ON p.PRODUCT_TYPE_ID = PT.PRODUCT_TYPE_ID
                                        AND p.status = ''Y''
                                       WHERE 
                                       EXISTS (
                                           SELECT 1
                                            FROM  EBA_SALES_SALESREP_ROLES SR
                                            JOIN EBA_SALES_SALESREPS R ON  R.REP_ROLE = SR.ID
                                           JOIN EBA_SALES_PRODUCT_FAMILIES PF ON R.ID = PF.MANAGER_ID
                                           JOIN eba_sales_products SP on PF.ID = SP.PRODUCT_FAMILY_ID
                                          where R.id = :user_id
                                          AND SR.ROLE_NAME in (''Administrator'',''Sales Manager'',''Sales Co-Ordinator'',
                                                              ''Sales Engineer'')
                                       ) 
                                       OR p.PRODUCT_FAMILY_ID IN (
                                           SELECT ID 
                                           FROM EBA_SALES_PRODUCT_FAMILIES f
                                           WHERE EXISTS (
                                               SELECT 1 
                                               FROM EBA_SALES_SALESREPS r
                                               WHERE INSTR('':'' || f.SALES_TEAM || '':'', '':'' || r.id || '':'') > 0
                                               AND UPPER(r.user_name) = UPPER(:APP_USER)
                                           )
                                       )
                                       AND p.ID IN (
                                           SELECT PRODUCT_ID 
                                           FROM XXEBA_SALES_ACC_PRODUCTS 
                                           WHERE CUSTOMER_ID = :P108_ACCOUNT_ID
                                       )
                                     --  AND p.status = ''Y''
                                       ORDER BY 1';
                
                
                    v_all_product := 'SELECT p.PRODUCT_NAME || '' ['' || p.CATALOGUE_NO || '']'' AS display_value, 
                                             p.ID AS return_value 
                                      FROM eba_sales_PRODUCTS p
                                    JOIN eba_sales_verifications v ON p.ID = v.PRODUCT_ID
                                      JOIN XXEBA_SALES_PRODUCT_TYPES PT ON p.PRODUCT_TYPE_ID = PT.PRODUCT_TYPE_ID
                                      AND p.status = ''Y''
                                      WHERE 
                                      EXISTS (
                                          SELECT 1
                                          FROM EBA_SALES_SALESREPS R
                                          JOIN EBA_SALES_SALESREP_ROLES SR ON SR.ID = R.REP_ROLE
                                        --    JOIN EBA_SALES_PRODUCT_FAMILIES PF ON R.ID = PF.MANAGER_ID
                                        --    WHERE PF.ID = p.PRODUCT_FAMILY_ID
                                          WHERE R.id = :USER_ID
                                          AND SR.ROLE_NAME = ''Administrator'' --,''Sales Manager'',''Sales Co-Ordinator'',
                                                              --''Sales Engineer'')
                                      )
                                      OR p.PRODUCT_FAMILY_ID IN (
                                          SELECT ID 
                                          FROM EBA_SALES_PRODUCT_FAMILIES f
                                          WHERE EXISTS (
                                              SELECT 1 
                                              FROM EBA_SALES_SALESREPS r
                                              WHERE INSTR('':'' || f.SALES_TEAM || '':'', '':'' || r.id || '':'') > 0
                                              AND UPPER(r.user_name) = UPPER(:APP_USER)
                                          )
                                      )
                                     -- AND p.status = ''Y''
                                      ORDER BY 1';
                
                    if :P108_ACCT_ALL_PRODUCT = 'Y' then
                        return v_cust_product;
                    elsif :P108_ACCT_ALL_PRODUCT = 'N' then
                        return v_all_product;
                    else
                        return 'SELECT ''1'', ''2'' FROM dual';
                    end if;
                EXCEPTION
                    WHEN OTHERS THEN  
                        RAISE_APPLICATION_ERROR(-20001, 'A custom error occurred.');
                end;
                
                ```
            displayExtraValues: false
            nullDisplayValue: - Select Product -
        }
        cascadingLov {
            parentItems: [
                P108_ACCT_ALL_PRODUCT
                P108_ACCOUNT_ID
            ]
            itemsToSubmit: [
                P108_ACCT_ALL_PRODUCT
                P108_ACCOUNT_ID
            ]
            parentRequired: false
        }
        layout {
            sequence: 80
            region: @product-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        advanced {
            customAttributes: style="min-width:505px"
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_ID
            used: always
        }
        security {
            encryptSessionState: false
        }

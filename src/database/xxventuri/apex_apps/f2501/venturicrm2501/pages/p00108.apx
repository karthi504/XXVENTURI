    validation quantity-validations (
        name: Quantity Validations
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE 
                lv_pack_qty number;
                lv_remainder number;
                begin
                
                SELECT PACK_QUANTITY INTO lv_pack_qty    FROM EBA_SALES_PRODUCTS WHERE ID=:P108_PRODUCT_ID ;
                
                
                if  lv_pack_qty is null then
                
                
                    if :P108_QTY > 0 then
                    
                    if to_number(:P108_QUANTITY) < to_number(:P108_QTY)  then
                        return 'Sorry! Order Quantity of '||:P108_QUANTITY||' is less than its Minimum Order Quantity of  '||:P108_QTY||'.';
                    end if;
                
                end if;
                
                
                else 
                select  MOD(to_number(:P108_QUANTITY), to_number(lv_pack_qty)) into lv_remainder from dual;
                
                  if lv_remainder <> 0  then 
                        ---return 'Sorry! Order Quantity of '||:P108_QUANTITY||' is not equal to its  Product pack  Quantity of  '||lv_pack_qty||'.';
                          return 'Sorry! Order Quantity should be multiples of Pack  Quantity.';
                   end if;
                end if ;
                
                
                end;
                ```
        }
        error {
            displayLocation: inlineInNotification
            associatedItem: @P108_QUANTITY
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation validation-for-family-id (
        name: Validation for Family ID
        execution {
            sequence: 110
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                CURSOR fam_cur IS
                SELECT 
                      C005
                FROM 
                    APEX_COLLECTIONS 
                WHERE 
                     COLLECTION_NAME ='PRODUCT_COLLECTION';
                
                
                BEGIN
                
                FOR I IN fam_cur
                LOOP
                IF UPPER(REPLACE(I.C005,' ','')) != UPPER(REPLACE(:P108_FAM_ID,' ',''))  THEN 
                
                 RETURN 'Sorry! This product belongs to a different Product Group. Please raise a separate Sales Order';
                
                END IF;
                END LOOP;
                
                EXCEPTION WHEN OTHERS THEN NULL;
                
                
                END ;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    computation p108-product-sold-as (
        itemName: P108_PRODUCT_SOLD_AS
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                select case
                           when sold_as = 'SUBSCRIPTION' then
                               'Cloud ' || initcap(sold_as)
                           when sold_as = 'PURCHASE' then
                               'On-Premise ' || initcap(sold_as)
                       end sold_as
                  from eba_sales_products
                 where id = :P108_PRODUCT_ID;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P108_PRODUCT_ID
        }
    )

    computation p108-quote-price (
        itemName: P108_QUOTE_PRICE
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: replace(replace(:P108_QUOTE_PRICE,'$',null),',',null);
        }
    )

    computation p108-tcv-return (
        itemName: P108_TCV_RETURN
        execution {
            sequence: 20
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: replace(replace(nvl(:P108_TCV,:P108_QUOTE_PRICE),'$',null),',',null);
        }
    )

    process add-collection-create (
        name: Add collection Create
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                	v_collection_name   		VARCHAR2 (30) := 'PRODUCT_COLLECTION';
                    v_product_name                varchar2(500);
                     l_margin                      number;
                BEGIN
                
                
                SELECT    --trunc((pf.margin_percentage * (p.Product_cost/100)),2) as total_cost,
                   trunc((((:P108_PRICE - PRODUCT_COST    )/PRODUCT_COST) * 100),2) AS MARGIN into l_margin
                FROM 
                    eba_sales_products 
                     where  ID = :P108_PRODUCT_ID;
                
                
                
                select PRODUCT_NAME||'['||CATALOGUE_NO||']' into v_product_name from EBA_SALES_PRODUCTS where ID = :P108_PRODUCT_ID;
                            apex_collection.add_member (p_collection_name      => v_collection_name,
                                                        p_n001                 => :P108_PRODUCT_ID,
                                                        p_n002                 => l_margin,
                                                        p_c001                 => v_product_name,
                                                        p_n003                 => :P108_PRICE,
                                                        p_c002                 => :P108_CURRENCY_TYPE,
                                                        p_n004                 => :P108_BRAND_ID,
                                                        p_c003                 => :P108_QUANTITY,
                                                        p_c004                 => :P108_CLOSE_DATE,
                                                        p_c005                 => :P108_FAM_ID
                                                       );
                
                
                BEGIN
                --insert into xx_test values (1,'Before Update',0);
                
                    UPDATE EBA_SALES_PRODUCTS 
                    SET MARGIN = (
                        SELECT 
                            trunc((((:P108_PRICE - PRODUCT_COST) / PRODUCT_COST) * 100), 2)
                        FROM 
                            eba_sales_products 
                        WHERE 
                            ID = :P108_PRODUCT_ID
                    ),
                    PRODUCT_GROUP = 
                (SELECT    
                    PF.PRODUCT_FAMILY 
                FROM 
                    eba_sales_products SP ,
                    eba_sales_product_families PF
                     where  SP.PRODUCT_FAMILY_ID = PF.ID
                     AND SP.ID = :P108_PRODUCT_ID)
                
                    WHERE ID = :P108_PRODUCT_ID;
                
                --insert into xx_test values (2,'After Update',l_margin);
                  
                END;
                
                END;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 90365136287670436
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: item=value
            item: P108_SOURCE_PAGE
            value: 173
        }
    )


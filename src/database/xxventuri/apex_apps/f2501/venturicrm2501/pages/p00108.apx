    button create (
        buttonName: CREATE
        label: Add Product
        layout {
            sequence: 50
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: if (($v('P108_MIN_PRICE_FLAG') == 'Y') && $v('P108_SOURCE_PAGE') == 173)      apex.confirm('Unit Price is lesser than Minimum Price. This requires Administrator Approval to add this Product in this Order. Do you wish to continue ?', 'CREATE');  javascript: if (($v('P108_MIN_PRICE_FLAG') == 'N') && $v('P108_SOURCE_PAGE') == 173) apex.submit('CREATE');   javascript: if ($v('P108_SOURCE_PAGE') == 80) apex.submit('CREATE');  javascript: if ($v('P108_SOURCE_PAGE') == 103) apex.submit('CREATE');
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P108_ID
        }
    )

    button delete (
        buttonName: DELETE

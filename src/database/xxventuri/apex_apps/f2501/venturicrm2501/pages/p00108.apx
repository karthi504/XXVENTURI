                    select PF.PRODUCT_FAMILY, P.PRODUCT_PRICE, P.CURRENCY_TYPE, P.PRODUCT_COST, P.BRAND_ID,
                          nvl(P.PRODUCT_COST+(P.PRODUCT_COST*(PF.MARGIN_PERCENTAGE/100)),0) Minimum_Price, MINIMUM_ORDER_QUANTITY, 

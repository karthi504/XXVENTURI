    process send-mail (
        name: "Send Mail "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_rep_name           VARCHAR2(500);
                  v_rep_id             NUMBER;
                  v_leave_type         VARCHAR2(500);
                  v_permission_type_id NUMBER;
                  v_permission_reason       VARCHAR2(100);
                  v_from_period        VARCHAR2(100);
                  v_to_period          VARCHAR2(100);
                  v_contact_number     NUMBER;
                  v_number_days        NUMBER;
                  v_to_mails           VARCHAR2(1000);
                  v_cc_mails           VARCHAR2(1000);
                  v_subject            VARCHAR2(500);
                  v_manager_mail_id    VARCHAR2(1000);
                  v_manager_id         NUMBER;
                  v_rep_mail_id        VARCHAR2(500);
                  v_approver_name      VARCHAR2(500);
                  v_manager_name       VARCHAR2(500);
                  v_body               CLOB;
                  v_body_html          CLOB;
                  v_crlf               VARCHAR2(2) := chr(13)||chr(10);
                  v_from_mail_alias    VARCHAR2(100);
                
                BEGIN
                
                BEGIN
                SELECT   REQUEST_ID,
                         SALES_REP_ID,
                         PERMISSION_REASON
                INTO     v_permission_type_id,
                         v_rep_id,
                         v_permission_reason
                FROM XXEBA_SALES_PERMISSIONS_T  
                WHERE PERMISSION_STATUS ='S'
                AND REQUEST_ID =:P260_REQUEST_ID;
                END;
                BEGIN
                    SELECT REP_FIRST_NAME
                      ||' '
                      ||REP_LAST_NAME,
                      REP_MANAGER_ID,
                      REP_EMAIL
                    INTO v_rep_name,
                      v_manager_id,
                      v_rep_mail_id
                    FROM EBA_SALES_SALESREPS
                    WHERE ID = v_rep_id;
                  END;
                  BEGIN
                    SELECT REP_FIRST_NAME
                      ||' '
                      ||REP_LAST_NAME,
                      REP_EMAIL
                    INTO v_manager_name,
                      v_manager_mail_id
                    FROM EBA_SALES_SALESREPS
                    WHERE ID =v_manager_id;
                  END;
                
                  BEGIN
                    SELECT TRIM(CHAR_VALUE)
                    INTO v_from_mail_alias
                    FROM XXEBA_SALES_PARAMETERS_T
                    WHERE CODE = 'FROM_MAIL_ALIAS'
                    AND STATUS = 'Y';
                  END;
                  
                  
                  v_body      := 'To view the content of this message, please use an HTML enabled mail client.'|| v_crlf;
                  v_body      := v_body||'Leave details';
                  v_body_html := '<html><head>           
                
                <style type="text/css">                
                body{font-family: Tahoma, Arial, Helvetica, sans-serif;                    
                font-size:10pt;                    
                color:#002060;                    
                margin:30px;                    
                background-color:#ffffff;}                
                span.sig{font-style:italic;                    
                font-weight:bold;                    
                color:#811919;}             
                </style>          
                
                </head><body>Dear '||NVL(v_manager_name,'Manager')||',';
                  v_body_html := v_body_html || '<br/><br/>'||v_rep_name||'  has submitted the below permission request for your Approval.      
                <br/><br/>';
                  v_subject   := v_rep_name||'''s Permission Request has been sent for your Approval';
                  
                  v_body_html := v_body_html || '<table border="0">
                  <tr height="20"><td>Rep Name</td><td width="15">:</td><td>'|| v_rep_name || '</td></tr>
                  <tr height="20"><td>Permission Date</td><td width="15">:</td><td>' || :P260_PERMISSION_DATE||'</td></tr>
                  <tr height="20"><td>From Time </td><td width="15">:</td><td>' ||:P260_FROM_TIME ||'</td></tr>
                  <tr height="20"><td>To Time</td><td width="15">:</td><td>' || :P260_TO_TIME ||'</td></tr>
                  <tr height="20"><td>Total Hours</td><td width="15">:</td><td>' || :P260_TOTAL_HOURS || '</td></tr>
                  <tr height="20"><td>Reason</td><td width="15">:</td><td>' || v_permission_reason || '</td></tr></table>
                  <br/>' || 'Regards,<br/>' ||v_rep_name|| v_crlf;
                  
                 IF v_manager_id != 137298143222070397625267765568033924482 then
                 
                  apex_mail.send (p_to =>v_manager_mail_id, 
                                  p_cc => v_rep_mail_id||','||'rajan@venturitool.com',
                                  p_bcc => NULL,
                                  p_from =>v_from_mail_alias,
                                  p_subj => v_subject,
                                  p_body => v_body,
                                  p_body_html => v_body_html 
                  );
                   apex_mail.push_queue(p_smtp_hostname => '4iapps-com.mail.protection.outlook.com', p_smtp_portno => 25);  
                  else
                  apex_mail.send (p_to =>v_manager_mail_id, 
                                  p_cc => v_rep_mail_id,
                                  p_bcc => NULL,
                                  p_from =>v_from_mail_alias,
                                  p_subj => v_subject,
                                  p_body => v_body,
                                  p_body_html => v_body_html 
                  );
                 apex_mail.push_queue(p_smtp_hostname => '4iapps-com.mail.protection.outlook.com', p_smtp_portno => 25);  
                  END IF;
                EXCEPTION
                WHEN OTHERS THEN
                  xxfs_pm_error_log_pkg.record_log('ERROR','MSK_Tools_leave_Email',NULL,5);
                END;
                ```

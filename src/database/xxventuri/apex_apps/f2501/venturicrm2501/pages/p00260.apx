    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-total-hours (
        name: Set Total Hours
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P260_FROM_TIME
                P260_TO_TIME
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT extract (hour FROM (to_timestamp(:P260_TO_TIME, 'HH24:MI')-to_timestamp(:P260_FROM_TIME, 'HH24:MI')))||':'||
                                trim(to_char(extract (minute FROM (to_timestamp(:P260_TO_TIME, 'HH24:MI')-to_timestamp(:P260_FROM_TIME, 'HH24:MI'))),'00')) AS minutes
                    FROM dual
                    
                    
                    ```
                itemsToSubmit: [
                    P260_FROM_TIME
                    P260_TO_TIME
                ]
            }
            affectedElements {
                selectionType: items
                items: P260_TOTAL_HOURS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation check-hours (
        name: Check Hours
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: exists (select 1 from dual where to_number(REPLACE(:P260_TOTAL_HOURS,':','.')) <= 2)
        }
        error {
            errorMessage: Permission has been allowed for a maximum of 2 Hours only.
            associatedItem: @P260_TOTAL_HOURS
        }
        serverSideCondition {
            type: itemIsNull
            item: P260_REQUEST_ID
        }
    )

    validation check-hours-negative (
        name: "Check Hours Negative "
        execution {
            sequence: 20
        }
        validation {
            language: sql
            sqlExpression: exists (select 1 from dual where to_number(REPLACE(:P260_TOTAL_HOURS,':','.')) > 0)
        }
        error {
            errorMessage: Permission has been not allowed for negative Hours.
            associatedItem: @P260_TOTAL_HOURS
        }
        serverSideCondition {
            type: itemIsNull
            item: P260_REQUEST_ID
        }
    )

    validation check-permission-count (
        name: Check Permission Count
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_permission_count number;
                
                begin 
                   
                   select count(*) into v_permission_count 
                     from XXEBA_SALES_PERMISSIONS_T 
                   where SALES_REP_ID = :P260_SALES_REP_ID 
                       and PERMISSION_DATE =  to_date(:P260_PERMISSION_DATE)
                       and nvl(PERMISSION_STATUS,'S') not in ('R');
                       
                   if v_permission_count > 0 then
                        return 'Permission has been already applied for the selected date.';
                   else
                       select count(*) into v_permission_count 
                         from XXEBA_SALES_PERMISSIONS_T 
                       where SALES_REP_ID = :P260_SALES_REP_ID 
                           and to_char(PERMISSION_DATE, 'MMYY') =  to_char(to_date(:P260_PERMISSION_DATE), 'MMYY')
                           and nvl(PERMISSION_STATUS,'S') not in ('R');
                
                        if v_permission_count >= 3 then
                            return 'Sorry! only 3 permissions are allowed during a month.';
                        else
                            return null;
                       end if;
                   end if;
                EXCEPTION when others then
                  return SQLERRM;
                end;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P260_REQUEST_ID
        }
    )

    validation comments-validations (
        name: Comments Validations
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                    if :P260_APPROVER_COMMENTS is null then
                        return 'Comments must have a some values';
                    end if;
                    return null;
                end;
                ```
        }
        error {
            associatedItem: @P260_APPROVER_COMMENTS
        }
        serverSideCondition {
            whenButtonPressed: @reject
        }
    )

    validation leave-exists-validation (
        name: Leave Exists Validation
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Declare 
                    lv_leave_count NUMBER;
                BEGIN
                    select count(*) into lv_leave_count from XXEBA_SALES_LEAVE_REQUESTS_T where SALES_REP_ID =:P260_SALES_REP_ID
                    and LEAVE_STATUS in ('S','A') and :P260_PERMISSION_DATE between FROM_DATE and TO_DATE;
                    if lv_leave_count > 0 then 
                    return 'Sorry! Leave request has been already applied for the selected date.';
                    end if ;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process approve-process (
        name: Approve Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  UPDATE xxeba_sales_permissions_t
                  SET approved_by       = :USER_ID ,
                    permission_status        ='A',
                    approver_comments   =:P257_APPROVER_COMMENTS,
                    approved_date       = sysdate
                  WHERE request_id=:P260_REQUEST_ID;
                END;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Action processed.

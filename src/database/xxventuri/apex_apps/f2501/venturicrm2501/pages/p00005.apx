            sqlQuery:
                ```sql
                select PRODUCT_NAME||' ['||CATALOGUE_NO||']' as product from eba_sales_PRODUCTS  where status='Y'
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @product
            slot: regionBody
            alignment: left

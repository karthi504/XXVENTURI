    validation moq-pack-validation (
        name: MOQ/Pack  Validation
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF :P5_STOCK_UOM_NAME  = 'Pack' THEN
                  IF :P5_PACK_QUANTITY IS NULL THEN
                    RETURN 'Pack Quantity must have some value';
                  ELSE
                    RETURN NULL;
                  END IF;
                END IF;
                
                
                IF :P5_STOCK_UOM_NAME  = 'Nos' THEN
                  IF :P5_MINIMUM_ORDER_QUANTITY IS NULL THEN
                    RETURN 'Order Quantity must have some value';
                  ELSE
                    RETURN NULL;
                  END IF;
                END IF;
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation order-quantity-for-multiples (
        name: Order quantity for multiples
        execution {
            sequence: 70
        }
        validation {
            plsqlExpression: MOD(:P5_MINIMUM_ORDER_QUANTITY, :P5_PACK_QUANTITY) = 0
        }
        error {
            errorMessage:
                ```
                Order Quantity must be a multiple of Pack Quantity.
                
                ```
            associatedItem: @P5_MINIMUM_ORDER_QUANTITY
        }
    )

    validation ordering-code-validation-create (
        name: Ordering Code Validation Create
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Begin
                For rec  in (select CATALOGUE_NO from EBA_SALES_PRODUCTS )
                loop
                IF UPPER(trim(:P5_CATALOGUE_NO))=UPPER(trim(rec.CATALOGUE_NO)) then 
                return 'Sorry! Ordering Code already exists.';
                End if;
                End LOOP;
                End;
                ```
        }
        error {
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
    )

    validation ordering-code-validation-update (
        name: Ordering Code Validation Update
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Begin
                For rec  in (select CATALOGUE_NO from EBA_SALES_PRODUCTS where id != :P5_ID and status!='X')
                loop
                IF trim(:P5_CATALOGUE_NO)=trim(rec.CATALOGUE_NO) then 
                return 'Sorry! Ordering Code already exists.';
                End if;
                End LOOP;
                End;
                ```
        }
        error {
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
    )

    validation pack-quantity-for-multiple-tens (
        name: Pack quantity for multiple tens
        execution {
            sequence: 60
        }
        validation {
            plsqlExpression:
                ```plsql
                :P5_PACK_QUANTITY >= 10 
                AND MOD(:P5_PACK_QUANTITY, 5) = 0
                ```
        }
        error {
            errorMessage: Pack quantity must be equal to or more than 10
            associatedItem: @P5_PACK_QUANTITY
        }
        serverSideCondition {
            type: never
        }
    )

    validation product-name-validation (
        name: Product Name Validation
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_product_name EBA_SALES_PRODUCTS.product_name%TYPE;
                BEGIN
                  FOR rec IN (SELECT product_name FROM EBA_SALES_PRODUCTS)
                  LOOP
                    IF UPPER(TRIM(:P5_product_name)) = UPPER(TRIM(rec.product_name)) THEN 
                      RETURN 'Sorry! Product Name already exists.';
                    END IF;
                  END LOOP;
                END;
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
    )

    validation product-price-validation (
        name: Product Price Validation
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF to_number(:P5_PRODUCT_COST)  > to_number(:P5_PRODUCT_PRICE) THEN
                RETURN 'Actual Price  should be greater than Product Cost';
                END IF;
                ```
        }
        error {
            displayLocation: inlineInNotification
            associatedItem: @P5_PRODUCT_PRICE
        }
    )


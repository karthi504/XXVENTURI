    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create Product
        layout {
            sequence: 40
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P5_ID is not null and :P5_STATUS='Y'
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction clear-stock-uom-name (
        name: "Clear Stock UOM Name "
        execution {
            sequence: 5
        }
        when {
            selectionType: items
            items: P5_STOCK_UOM
        }
        clientSideCondition {
            type: itemIsNull
            item: P5_STOCK_UOM
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P5_STOCK_UOM is null then 
                     :P5_STOCK_UOM_NAME := null;
                    end if;
                    ```
                itemsToSubmit: P5_STOCK_UOM
                itemsToReturn: P5_STOCK_UOM_NAME
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-product-cost (
        name: Disable - Product Cost
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P5_DISCOUNT_PCT
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P5_DISCOUNT_PCT
        }
        serverSideCondition {
            type: never
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P5_PRODUCT_COST
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: P5_PRODUCT_COST
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction hide-show-pack-qty (
        name: Hide/ Show pack qty
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P5_STOCK_UOM_NAME
        }
        clientSideCondition {
            type: item=value
            item: P5_STOCK_UOM_NAME
            value: Pack
        }
        serverSideCondition {
            type: never
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P5_PACK_QUANTITY_1
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items

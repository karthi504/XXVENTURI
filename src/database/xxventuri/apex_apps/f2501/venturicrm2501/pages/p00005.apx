            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            cssClasses: mnw50
        }
        source {
            type: databaseColumn
            databaseColumn: CURRENCY_TYPE
            used: always
        }
        default {
            type: static
            staticValue: INR
        }
        security {
            encryptSessionState: false
        }
    )


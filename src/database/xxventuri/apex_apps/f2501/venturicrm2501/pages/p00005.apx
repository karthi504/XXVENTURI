    dynamicAction new (
        name: New
        execution {
            sequence: 100
        }
        when {
            selectionType: items
            items: P5_UNIT_OF_MEASURE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                    select unit_name ,UNIT_ID 
                    into :P5_STOCK_UOM_NAME,:P5_STOCK_UOM 
                    from XXEBA_SALES_Units where UNIT_ID = :P5_UNIT_OF_MEASURE;
                    
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                     :P5_STOCK_UOM_NAME:= NULL;
                     :P5_STOCK_UOM :=NULL;
                     END;
                    ```
                itemsToSubmit: P5_UNIT_OF_MEASURE
                itemsToReturn: [
                    P5_STOCK_UOM
                    P5_STOCK_UOM_NAME
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction no-space (
        name: No Space
        execution {
            sequence: 110
        }
        when {
            event: keyup
            selectionType: items
            items: P5_CATALOGUE_NO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var val = $v("P5_CATALOGUE_NO"); 
                    $s("P5_CATALOGUE_NO", val.replace(/\s+/g, '')); // Removes spaces dynamically
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P5_CATALOGUE_NO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-product-cost (
        name: Set Product Cost
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P5_ID
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P5_ID
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                    lv_product_cost number;
                    BEGIN
                      select PRODUCT_COST into lv_product_cost from EBA_SALES_PRODUCTS where ID=:P5_ID ;
                      :P5_PRODUCT_COST := lv_product_cost ;
                      RETURN :P5_PRODUCT_COST;
                    END;
                    ```
                itemsToSubmit: P5_ID
            }
            affectedElements {
                selectionType: items
                items: P5_PRODUCT_COST
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-stock-uom-namae (
        name: SET STOCK UOM NAMAE
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P5_STOCK_UOM
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    Begin
                    if :P5_STOCK_UOM is not null then
                    select unit_name into :P5_STOCK_UOM_NAME from XXEBA_SALES_Units where UNIT_ID = :P5_STOCK_UOM;
                    end if;
                    end;
                    ```
                itemsToSubmit: P5_STOCK_UOM
                itemsToReturn: P5_STOCK_UOM_NAME
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-value (
        name: Set Value
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: [
                P5_PRODUCT_PRICE
                P5_DISCOUNT_PCT
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                      if nvl(:P5_DISCOUNT_PCT,0) > 0 then
                          :P5_PRODUCT_COST := round((nvl(nvl(:P5_PRODUCT_PRICE,0),0) - (nvl(:P5_PRODUCT_PRICE,0)) * ((nvl(:P5_DISCOUNT_PCT,0) / 100))),2);
                      else
                          :P5_PRODUCT_COST := nvl(:P5_PRODUCT_COST,0);
                      end if;
                    
                    RETURN :P5_PRODUCT_COST;
                    
                    END;
                    ```
                itemsToSubmit: [
                    P5_PRODUCT_PRICE
                    P5_DISCOUNT_PCT
                ]
            }
            affectedElements {
                selectionType: items
                items: P5_PRODUCT_COST
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


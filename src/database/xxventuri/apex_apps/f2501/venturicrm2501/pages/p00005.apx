    pageItem P5_TAGS (
        type: plugin/tagEntry
        label {
            label: Tags
            alignment: left
        }
        settings {
            validationFailureMessage: Tags may not contain the following characters: : ; \ / ? &
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select tag
                from eba_sales_tags_type_sum
                where content_type = 'PRODUCT'
                
                ```
        }
        layout {
            sequence: 290
            region: @product
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 89
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: TAGS
            used: always
        }
        serverSideCondition {

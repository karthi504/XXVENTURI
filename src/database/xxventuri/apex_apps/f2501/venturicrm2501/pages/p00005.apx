        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select unit_name  as d,UNIT_ID as r from XXEBA_SALES_Units
                /*where unit_name='Nos'*/
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {

page 5 (
    name: Product Details
    title: Product Details
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function ReadOnlySelectList()
            
            {
            
            var l_request = html_GetElement('P5_DISCOUNT_PCT').value;
            
            var l_select=html_GetElement('P5_PRODUCT_COST');
            
            if (! l_request) l_select.disabled="true";
               alert($x('P5_DISCOUNT_PCT').value+'-'+$x('P5_PRODUCT_COST').value);
            
            }
                
                 
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript">
            <!--
            
             htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            //-->
            </script>
            
            
            ```
    }
    security {
        authorizationScheme: @xxeba-admin-coordinator
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }
    config {
        buildOption: @products
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region product (
        name: Product
        type: staticContent
        source {
            htmlCode:
                ```html
                
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            renderComponents: belowContent
        }
        settings {
            outputAs: text
        }
    )

    pageItem P5_BRAND_ID (
        type: selectList
        label {
            label: "Brand Name "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: "select BRAND_NAME as d,BRAND_ID as r from XXEBA_SALES_PRODUCT_BRANDS  where status='Y' order by 1 "
            displayExtraValues: false
            nullDisplayValue: - Select Brand -
        }
        layout {
            sequence: 80
            region: @product
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--indicatorAsterisk
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: mnw180
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P5_CATALOGUE_ATTACHMENT (
        type: fileUpload
        label {
            label: Catalogue Attachment
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
            displayDownloadLink: false
        }
        storage {
            mimeTypeColumn: ATT_MIMETYPE
            filenameColumn: ATT_FILENAME
            charSetColumn: "ATT_CHARSET  "
            bobLastUpdatedColumn: ATT_LAST_UPDATE
        }
        layout {
            sequence: 270
            region: @product
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: CATALOGUE_ATTACHMENT
            used: always
        }
    )


    process stock-uom-update (
        name: Stock UOM Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P5_ID IS NOT NULL AND :P5_STOCK_UOM_NAME='Nos' THEN
                 UPDATE EBA_SALES_PRODUCTS SET STOCK_UOM = NULL, PACK_QUANTITY = NULL WHERE ID=:P5_ID;
                END IF;
                
                IF :P5_ID IS NOT NULL AND :P5_STOCK_UOM_NAME='Pack' THEN
                 UPDATE EBA_SALES_PRODUCTS SET  MINIMUM_ORDER_QUANTITY = NULL WHERE ID=:P5_ID;
                END IF;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 363318459921602971
        }
        serverSideCondition {
            whenButtonPressed: @save
            type: never
        }
    )


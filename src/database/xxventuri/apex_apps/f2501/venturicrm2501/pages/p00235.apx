    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P235_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P235_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P235_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation duplicate-product-validations-create (
        name: Duplicate_product_validations-Create
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  lv_count NUMBER;
                BEGIN
                  SELECT COUNT(*)
                  INTO lv_count
                  FROM XXEBA_SALES_COMPETITOR_PRODUCT
                  WHERE upper(trim(PRODUCT_NAME))= upper(trim(:P235_PRODUCT_NAME)) and customer_id = :P235_CUSTOMER_ID;
                   IF lv_count  > 0 THEN
                     RETURN 'Sorry! Product already exists.';
                   END IF;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation duplicate-product-validations-update (
        name: Duplicate_product_validations-Update
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  lv_count NUMBER;
                BEGIN
                  SELECT COUNT(*)
                  INTO lv_count
                  FROM XXEBA_SALES_COMPETITOR_PRODUCT
                  WHERE ID !=:P235_ID AND upper(trim(PRODUCT_NAME))= upper(trim(:P235_PRODUCT_NAME)) and customer_id = :P235_CUSTOMER_ID;
                   IF lv_count > 0 THEN
                     RETURN 'Sorry! Product already exists.';
                   END IF;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process fetch-row-from-xxeba-sales-competitor-product (
        name: Fetch Row from XXEBA_SALES_COMPETITOR_PRODUCT
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_COMPETITOR_PRODUCT
            pkColumn: ID
            pkItem: P235_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 32422248223427266
        }
    )

    process process-row-of-xxeba-sales-competitor-product (
        name: Process Row of XXEBA_SALES_COMPETITOR_PRODUCT
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_COMPETITOR_PRODUCT
            pkColumn: ID
            pkItem: P235_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 32422707975427266
        }
    )

    branch (
        name: Go to 94
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 94
                items: {
                    P94_ID: &P235_CUSTOMER_ID.
                }
                action: resetPagination
            }
        }
    )

)


    process insert-sales-orders (
        name: Insert Sales Orders
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_seq_num      NUMBER;
                  v_order_number VARCHAR2(50);
                  v_account     NUMBER;
                BEGIN
                  --   if :P173_ORDER_ID is null or :P173_COPY_ORDER = 'S' then
                  -- Generate Sequence Number
                  v_seq_num      :=XXFS_PM_LEAVE_REQUESTS_SEQ.nextval();
                  v_order_number := TO_CHAR(sysdate,'YY')||trim(TO_CHAR(v_seq_num,'00000'));
                
                
                 
                
                
                  --raise_application_error(-20010,v_order_number);
                  --  update XXEBA_SALES_ORDER set ORDER_REPEAT = 'N' where ORDER_ID = :P173_ORDER_ID; -- If copy order change repeated status
                  INSERT
                  INTO XXEBA_SALES_ORDER
                    (
                      ORDER_NUMBER,
                      DEAL_ID,
                      CUSTOMER_ID,
                      TERRITORY_ID,
                      SALES_REP,
                      PO_NUMBER,
                      PO_DATE ,
                      REFERENCE ,
                      BILLING_LOCATION,
                      DELIVERY_LOCATION,
                      ORDER_FREQUENCY,
                      NEXT_ORDER_DATE,
                      ORDER_DATE,
                      ORDER_REPEAT,
                      REMARKS,
                      CREATED_BY,
                      UPDATED_BY,
                      SOURCE_APPLICATION,
                      ORDER_TYPE_ID,
                      ACCOUNT_OWNER_ID
                     
                    )
                    VALUES
                    (
                      to_number(v_order_number),
                      :P173_OPP_ID,
                      :P173_CUSTOMER_NAME,
                      :P173_TERRITORY_ID,
                      :P173_REP_ID,
                      :P173_PO_NUMBER,
                      :P173_PO_DATE,
                      :P173_REFERENCE,
                      :P173_CUSTOMER_LOCATION,
                      :P173_DELIVERY_LOCATION,
                      :P173_ORDER_FREQUENCY,
                      :P173_NEXT_ORDER_DATE,
                      :P173_ORDER_DATE,
                      'Y',
                      :P173_REMARKS,
                      Nvl(V('APP_USER'), USER),
                      Nvl(V('APP_USER'), USER),
                      'W',
                      :P173_ORDER_TYPE,
                      :P173_ACCOUNT_OWNER
                      
                      
                    )
                  RETURNING ORDER_ID
                  INTO :P173_ORDER_ID;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 90674346124487428
        }
    )

    process load-collection-data (
        name: Load Collection Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 /*
                   *****************************************************************************
                   **
                   **  Page Details	   : Page 23 (TimeSheet page)
                   **  object type     : PLSQL Block
                   **  description     : This block content used to create collections data for 
                   **   					TimeSheet.
                   **						 
                   **						
                   **
                   **  change history
                   **   
                   **  date                 name                   version        modification
                   **  -------            -------                  -------        ------------
                   ** 03-20-2017	      4iapps 				 	 1.0         Block created.
                   **   
                   **
                   ** 
                   *****************************************************************************
                 */
                 
                DECLARE
                	v_collection_name   		VARCHAR2 (30) := 'PRODUCT_COLLECTION';
                   
                BEGIN
                	IF apex_collection.collection_exists
                										(p_collection_name      => v_collection_name)
                	THEN
                		apex_collection.delete_collection
                										(p_collection_name      => v_collection_name);
                	END IF;
                		apex_collection.create_or_truncate_collection
                										(p_collection_name      => v_collection_name);
                    if :P173_COPY_ORDER = 'S' then
                        FOR prc IN (select null ORDER_PRODUCTS_ID, ORDER_ID, PRODUCT_NAME, PRODUCT_PRICE, CURRENCY_TYPE, BRAND_ID, QUANTITY, DELIVERY_DATE,null PRODUCT_FAMILY_ID,MARGIN from XXEBA_ORDER_PRODUCTS
                                         where ORDER_ID = :P173_ORDER_ID)
                       LOOP
                            apex_collection.add_member (p_collection_name      => v_collection_name,
                                                        p_n001                 => prc.ORDER_PRODUCTS_ID,
                                                        p_n002                 => prc.ORDER_ID,
                                                        p_c001                 => prc.PRODUCT_NAME,
                                                        p_n003                 => prc.PRODUCT_PRICE,
                                                        p_c002                 => prc.CURRENCY_TYPE,
                                                        p_n004                 => prc.BRAND_ID,
                                                        p_c003                 => prc.QUANTITY,
                                                        p_c004                 => prc.DELIVERY_DATE,
                                                        p_n005                 => prc.MARGIN
                                                       );
                	   END LOOP;
                 
                    else
                    
                        FOR prc IN (select ORDER_PRODUCTS_ID, ORDER_ID, PRODUCT_NAME, PRODUCT_PRICE, CURRENCY_TYPE, BRAND_ID, QUANTITY, DELIVERY_DATE,null PRODUCT_FAMILY_ID,MARGIN from XXEBA_ORDER_PRODUCTS
                                             where ORDER_ID = :P173_ORDER_ID
                                            union all 
                                            select null ORDER_PRODUCTS_ID, null ORDER_ID, P.PRODUCT_NAME, DP.PRODUCT_PRICE, DP.CURRENCY_TYPE, DP.PRODUCT_BRAND_ID, DP.QUANTITY, DP.CLOSE_DATE,P.PRODUCT_FAMILY_ID,P.MARGIN
                                             from EBA_SALES_DEAL_PRODUCTS DP,
                                                      EBA_SALES_PRODUCTS P
                                           where DP.DEAL_ID = :P173_DEAL_ID
                                               and DP.PRODUCT_ID = P.ID
                                               and :P173_ORDER_ID is null)
                       LOOP
                                apex_collection.add_member (p_collection_name      => v_collection_name,
                                                            p_n001                 => prc.ORDER_PRODUCTS_ID,
                                                            p_n002                 => prc.ORDER_ID,
                                                            p_c001                 => prc.PRODUCT_NAME,
                                                            p_n003                 => prc.PRODUCT_PRICE,
                                                            p_c002                 => prc.CURRENCY_TYPE,
                                                            p_n004                 => prc.BRAND_ID,
                                                            p_c003                 => prc.QUANTITY,
                                                            p_c004                 => prc.DELIVERY_DATE,
                                                           p_n005                 => prc.MARGIN
                                                           );
                       END LOOP;
                    end if;
                   
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 90675531707487434
        }

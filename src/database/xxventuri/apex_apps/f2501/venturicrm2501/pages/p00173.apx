    validation product-price-null-validation (
        name: Product Price Null validation
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Declare
                    v_error_text    varchar2(1000) := null;
                Begin
                    FOR c IN (SELECT n001 order_products_id, n002  order_id, c001  product_name, n003 product_price, c002 currency_type, n004 brand_id, c004 Delivery_date FROM apex_collections WHERE collection_name = 'PRODUCT_COLLECTION')
                    LOOP
                        if trim(c.product_price) is null then
                            v_error_text := v_error_text||'Price can not be null for '||c.product_name||'<br>';
                        end if;
                         if to_date(trim(c.Delivery_date), 'DD-Mon-YYYY') < trunc(sysdate) then
                            v_error_text := v_error_text||'Delivery Date should be greater than OR equal to current date for'||c.product_name||'<br>';
                         --     return to_date(c.Delivery_date, 'DD-Mon-YYYY');
                       end if;
                    END LOOP;
                    
                    return v_error_text;
                   
                End;
                ```
        }
    )

    validation quantity-validations (
        name: Quantity Validations
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  minimum_quantity VARCHAR2(100); /* VARCHAR2(20) into VARCHAR2(100)  Modified on 01-SEP-18*/
                  v_error_text VARCHAR2(4000) := NULL; /* v_error_text  VARCHAR2(4000)  Modified on 01-SEP-18 */
                  pack_quantity VARCHAR2(100);
                  lv_remainder  NUMBER;
                BEGIN
                  FOR c IN
                  (SELECT n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    c003 quantity,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  LOOP
                    SELECT MINIMUM_ORDER_QUANTITY,
                      PACK_QUANTITY
                    INTO minimum_quantity,
                      pack_quantity
                    FROM EBA_SALES_PRODUCT_FAMILIES PF,
                      EBA_SALES_PRODUCTS P
                    WHERE P.PRODUCT_FAMILY_ID      = PF.ID
                    AND P.ID                       =c.order_products_id;
                    
                    IF to_number(trim(c.quantity)) < 1 THEN
                      v_error_text                :='Sorry! Quantity is less than one.';
                    END IF;
                    
                    IF minimum_quantity IS NOT NULL  THEN
                      
                      IF to_number(trim(c.quantity)) < to_number(minimum_quantity) THEN
                        v_error_text                :='Sorry! Order Quantity of '||trim(c.quantity)||' is less than its Minimum Order Quantity of  '||minimum_quantity ||'.';
                      END IF;
                      
                    ELSIF  pack_quantity IS NOT NULL and  minimum_quantity is null  THEN
                      SELECT MOD(to_number(c.quantity), to_number(pack_quantity))
                      INTO lv_remainder
                      FROM dual;
                      
                      IF lv_remainder <> 0 THEN
                        RETURN 'Sorry! Order Quantity should be multiples of Pack Quantity '|| pack_quantity ||'.';
                      END IF;
                      
                    END IF ;
                  END LOOP;
                  RETURN v_error_text;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation unit-price-validations (
        name: Unit Price Validations
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  minimum_price NUMBER;
                    v_error_text  VARCHAR2(1000) := NULL;
                BEGIN
                  FOR c IN
                  (SELECT n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  LOOP
                    SELECT NVL(P.PRODUCT_COST+(P.PRODUCT_COST*(PF.MARGIN_PERCENTAGE/100)),0)
                    INTO minimum_price
                    FROM EBA_SALES_PRODUCT_FAMILIES PF,
                      EBA_SALES_PRODUCTS P
                    WHERE P.PRODUCT_FAMILY_ID = PF.ID
                    AND P.ID                  =c.order_products_id;
                    IF trim(c.product_price) < round(minimum_price)  THEN
                     v_error_text :='Sorry! Unit Price is lesser than the minimum price of this Product.';
                     
                    END IF;
                  END LOOP;
                  RETURN v_error_text; 
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    process add-product-to-account-master (
        name: Add_Product_to_Account_Master
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  lv_group_id  NUMBER ;
                  lv_acc_count NUMBER;
                BEGIN
                  FOR c IN
                  (SELECT n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c003 quantity,
                    c004 delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  LOOP
                    SELECT g.id
                    INTO lv_group_id
                    FROM eba_sales_product_families g,
                      EBA_SALES_PRODUCTS p
                    WHERE g.id=p.PRODUCT_FAMILY_ID
                    AND p.id  = c.order_products_id;
                    SELECT COUNT(*)
                    INTO lv_acc_count
                    FROM XXEBA_SALES_ACC_PRODUCTS
                    WHERE Customer_ID = :P173_CUSTOMER_NAME
                    AND product_id    =c.order_products_id;
                    IF lv_acc_count   = 0 THEN
                      INSERT
                      INTO XXEBA_SALES_ACC_PRODUCTS
                        (
                          CUSTOMER_ID,
                          PRODUCT_GROUP_ID,
                          MONTHLY_VOLUME,
                          UNIT_OF_MEASURES,
                          BRAND_ID,
                          PRODUCT_ID
                        )
                        VALUES
                        (
                          :P173_CUSTOMER_NAME,
                          lv_group_id,
                          to_number(c.quantity),
                          1001,
                          c.brand_id,
                          c.order_products_id
                        );
                    END IF;
                  END LOOP;
                END;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 266970167008382187
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )


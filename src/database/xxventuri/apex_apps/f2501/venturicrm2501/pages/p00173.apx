    button add (
        buttonName: ADD
        label: Add
        layout {
            sequence: 10
            region: @products
            slot: edit
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--simple
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 108
                items: {
                    P108_SOURCE_PAGE: 173
                }
                clearCache: 108
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 102
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create Order
        layout {
            sequence: 40
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P173_ORDER_ID is null or nvl(:P173_COPY_ORDER,'N') = 'S'
        }
    )

    button create-repeat (
        buttonName: CREATE_REPEAT
        label: Create Repeat Order
        layout {
            sequence: 20
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 173
                items: {
                    P173_ORDER_ID: &P173_ORDER_ID.
                    P173_COPY_ORDER: S
                    P173_ORDER_DATE: &P173_NEXT_ORDER_DATE.
                }
                clearCache: 103
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P173_ORDER_ID is not null and nvl(:P173_COPY_ORDER,'N') != 'S'
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P173_ORDER_ID is not null and nvl(:P173_COPY_ORDER,'N') != 'S'
        }
    )

    dynamicAction delete-product-row (
        name: DELETE_PRODUCT_ROW
        execution {
            sequence: 50
        }
        when {
            event: custom
            customEvent: DELETE_PRODUCT_ROW
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    	v_collection_name  		VARCHAR2 (30) := 'PRODUCT_COLLECTION';
                    BEGIN
                    APEX_COLLECTION.DELETE_MEMBER (
                        v_collection_name ,
                        :P173_SEQ_ID);
                    END;
                    ```
                itemsToSubmit: P173_SEQ_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @products
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New_1
        execution {
            sequence: 80
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @products
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var total_amount = 0;
                    $('#order_product table tr td:nth-child(10) input[name="f10"]').each(function(){
                           var amount=$(this).val();
                        // alert(t);
                        total_amount = parseInt(total_amount)+parseInt(amount);
                        });
                     //alert(total_amount);
                    $("#P173_AMOUNT").val(total_amount);
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


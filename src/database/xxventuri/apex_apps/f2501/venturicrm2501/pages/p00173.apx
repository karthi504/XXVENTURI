    process special-price-status-update (
        name: Special Price Status Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                lv_count number :=0 ;
                minimum_price number;
                
                BEGIN
                  FOR c IN
                  (SELECT n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  LOOP
                    SELECT NVL(P.PRODUCT_COST+(P.PRODUCT_COST*(PF.MARGIN_PERCENTAGE/100)),0) 
                    INTO minimum_price
                    FROM EBA_SALES_PRODUCT_FAMILIES PF,
                      EBA_SALES_PRODUCTS P
                    WHERE P.PRODUCT_FAMILY_ID = PF.ID
                    AND P.ID                  =c.order_products_id;
                    IF trim(c.product_price) < round(minimum_price)  THEN
                    lv_count := lv_count+1;
                     END IF;
                  END LOOP;
                  IF lv_count > 0 then
                  UPDATE XXEBA_SALES_ORDER SET STATUS='N',UPDATED_BY=Nvl(V('APP_USER'), USER) WHERE ORDER_ID =:P173_ORDER_ID;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 69128854449427986
        }
    )


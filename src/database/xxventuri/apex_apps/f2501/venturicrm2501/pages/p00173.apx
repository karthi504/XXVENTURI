    dynamicAction set-value (
        name: Set Value
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P173_CUSTOMER_NAME
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      SELECT T.TERRITORY_NAME,
                        SR.REP_FIRST_NAME
                        ||' '
                        ||SR.REP_LAST_NAME Rep_name,
                        C.DEFAULT_REP_ID,
                        C.CUSTOMER_TERRITORY_ID
                      INTO :P173_TERRITORY_NAME,
                           :P173_SALES_REP,
                           :P173_REP_ID,
                           :P173_TERRITORY_ID
                      FROM EBA_SALES_CUSTOMERS C,
                        EBA_SALES_TERRITORIES T,
                        EBA_SALES_SALESREPS SR
                      WHERE C.CUSTOMER_TERRITORY_ID = T.ID
                      AND C.DEFAULT_REP_ID          = SR.ID
                      AND C.ID                      = :P173_CUSTOMER_NAME;
                    
                    
                    
                    END;
                    ```
                itemsToSubmit: P173_CUSTOMER_NAME
                itemsToReturn: [
                    P173_TERRITORY_NAME
                    P173_SALES_REP
                    P173_REP_ID
                    P173_TERRITORY_ID
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            comments {
                comments:
                    ```
                    BEGIN
                      SELECT T.TERRITORY_NAME,
                        SR.REP_FIRST_NAME
                        ||' '
                        ||SR.REP_LAST_NAME Rep_name,
                        C.DEFAULT_REP_ID,
                        C.CUSTOMER_TERRITORY_ID
                       -- C.ROW_KEY
                      INTO :P173_TERRITORY_NAME,
                           :P173_SALES_REP,
                           :P173_REP_ID,
                           :P173_TERRITORY_ID
                          -- :P173_ROW_KEY
                      FROM EBA_SALES_CUSTOMERS C,
                        EBA_SALES_TERRITORIES T,
                        EBA_SALES_SALESREPS SR
                      WHERE C.CUSTOMER_TERRITORY_ID = T.ID
                      AND C.DEFAULT_REP_ID          = SR.ID
                      AND C.ID                      = :P173_CUSTOMER_NAME;
                    
                    
                     --- SELECT TO_CHAR( nvl(get_amount_pkg.get_overdue_amount (:P173_ROW_KEY),0), '999G999G999G999G990D00') INTO :P173_OVERDUE_AMOUNT FROM DUAL;
                    
                    END;
                    ```
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    APEX_UTIL.SET_SESSION_STATE (
                        'P173_CUSTOMER_NAME',
                        :P173_CUSTOMER_NAME);
                    ```
                itemsToSubmit: P173_CUSTOMER_NAME
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction update-product-row (
        name: UPDATE_PRODUCT_ROW
        execution {
            sequence: 40
        }
        when {
            event: custom
            customEvent: UPDATE_PRODUCT_ROW
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    /*
                       *****************************************************************************
                       **
                       **  Page Details	   : Page 23 (TimeSheet page)
                       **  object type     : PLSQL Block
                       **  description     : This block content used to create collections data for 
                       **   					TimeSheet.			
                       **
                       **  change history
                       **   
                       **  date                 name                   version        modification
                       **  -------            -------                  -------        ------------
                       ** 03-20-2017	      4iapps 				 	 1.0         Block created.
                       **   
                       *****************************************************************************
                     */
                     
                    DECLARE
                        l_seq_id		   		apex_application_global.vc_arr2;
                        l_products_id		apex_application_global.n_arr;
                        l_order_id		   	  apex_application_global.n_arr;
                    	l_product_name	apex_application_global.vc_arr2;
                        l_product_price   apex_application_global.n_arr;
                        l_currency_type  apex_application_global.vc_arr2;
                        l_brand_id          apex_application_global.n_arr;
                    
                         l_delivery_date    apex_application_global.vc_arr2;
                         l_quantity            apex_application_global.vc_arr2;
                       -- l_product_family_id    apex_application_global.n_arr;
                    	v_collection_name  		VARCHAR2 (30) := 'PRODUCT_COLLECTION';
                    	
                    	v_start_date			VARCHAR2 (30);
                    	v_end_date				VARCHAR2 (30);
                    	
                    BEGIN
                        l_seq_id(1)  := :P173_SEQ_ID;
                    	l_products_id(1) := to_number(:P173_ORDER_PRODUCTS_ID);
                        l_order_id(1) := to_number(:P173_ORDER_ID_HID);
                        l_product_name(1)  := :P173_PRODUCT_NAME;
                        l_product_price(1) := to_number(:P173_PRODUCT_PRICE);
                    	l_currency_type(1)    := :P173_CURRENCY_TYPE; 
                    	l_brand_id(1)   := to_number(:P173_BRAND_ID);
                        
                        l_delivery_date(1)   := TO_CHAR(TO_DATE(:P173_DELIVERY_DATE,'DD-Mon-RRRR'),'DD-Mon-RRRR');  --DD/MM/RRRR
                        l_quantity(1)   := :P173_QUANTITY;
                       -- l_product_family_id(1)    := to_number(:P173_PRODUCT_FAMILY_ID);
                        
                         APEX_COLLECTION.UPDATE_MEMBERS (
                            p_collection_name => v_collection_name,
                            p_seq    => l_seq_id,
                            p_n001  => l_products_id,
                            p_n002  => l_order_id,
                            p_c001  => l_product_name,
                            p_n003  => l_product_price,
                            p_c002  => l_currency_type,
                            p_n004  => l_brand_id,
                            p_c003  => l_quantity,
                            p_c004  => l_delivery_date
                           -- p_n005  => l_product_family_id
                            );  
                    		
                    END;
                    ```
                itemsToSubmit: [
                    P173_SEQ_ID
                    P173_ORDER_PRODUCTS_ID
                    P173_ORDER_ID_HID
                    P173_PRODUCT_NAME
                    P173_PRODUCT_PRICE
                    P173_CURRENCY_TYPE
                    P173_BRAND_ID
                    P173_DELIVERY_DATE
                    P173_QUANTITY
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation delivery-date-validation-for-same-product (
        name: Delivery Date validation for same product
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                     product_id  NUMBER;
                    v_error_text  VARCHAR2(1000) := NULL;
                BEGIN
                  FOR c1 IN
                  (SELECT seq_id s_no,n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                 LOOP
                  FOR c2 IN (SELECT seq_id s_no,n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION')
                  LOOP 
                  if c2.order_products_id=c1.order_products_id and c2.Delivery_date=c1.Delivery_date and c2.s_no <>c1.s_no then 
                  v_error_text :='Sorry! Same Delivery Date is available for this product '||c2.product_name||'.';
                   end if;
                   end loop;
                  END LOOP;
                  RETURN v_error_text; 
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )


    region products (
        name: Products
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    ROWNUM row_num,
                    n005 as margin,
                    --APEX_ITEM.TEXT(11, n002, 50, 50, 'class="p-text-label-ro" style="text-align: right;" readonly', 'pr02_'||seq_id) AS margin_text,
                    APEX_ITEM.HIDDEN(1, seq_id, NULL, 'pr01_'||seq_id) AS seq_id,
                    APEX_ITEM.HIDDEN(2, n001, NULL, 'pr02_'||seq_id) AS order_products_id,
                    APEX_ITEM.HIDDEN(3, n002, NULL, 'pr03_'||seq_id) AS order_id,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) AS Minimum_Price
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n001) 
                        THEN APEX_ITEM.TEXT(4, c001, 50, 50, 'class="p-text-label" style="color:red;border:none;background-color:snow;" disabled', 'pr04_'||seq_id)
                        ELSE APEX_ITEM.TEXT(4, c001, 50, 50, 'class="p-text-label" style="border:none;background-color:snow;" disabled', 'pr04_'||seq_id)
                    END) AS product_name,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) AS Minimum_Price
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n001) 
                        THEN APEX_ITEM.TEXT(5, n003, 10, 50, 'class="p-number-label" style="color:red" onkeypress="return isNumber(event)" onchange="change_price('||seq_id||')"', 'pr05_'||seq_id)
                        ELSE APEX_ITEM.TEXT(5, n003, 10, 50, 'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_price('||seq_id||')"', 'pr05_'||seq_id)
                    END) AS product_price,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) AS Minimum_Price
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n001) 
                        THEN APEX_ITEM.TEXT(6, c002, 5, 50, 'class="p-text-label" style="color:red" disabled', 'pr06_'||seq_id)
                        ELSE APEX_ITEM.TEXT(6, c002, 5, 50, 'class="p-text-label" disabled', 'pr06_'||seq_id)
                    END) AS currency_type,
                    APEX_ITEM.HIDDEN(7, n004, NULL, 'pr07_'||seq_id) AS brand_id,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) AS Minimum_Price
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n001) 
                        THEN APEX_ITEM.DATE_POPUP2(8, TO_DATE(c004, 'DD/MM/YYYY'), 'DD-Mon-YYYY', 10, 12, 'class="p-date-label" style="color:red" onchange="change_Delivery('||seq_id||')"', 'pr08_'||seq_id)
                        ELSE APEX_ITEM.DATE_POPUP2(8, TO_DATE(c004, 'DD/MM/YYYY'), 'DD-Mon-YYYY', 10, 12, 'class="p-date-label" onchange="change_Delivery('||seq_id||')"', 'pr08_'||seq_id)
                    END) AS delivery_date,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) AS Minimum_Price
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n001) 
                        THEN APEX_ITEM.TEXT(9, c003, 10, 50, 'class="p-number-label" style="color:red" onkeypress="return isNumber(event)" onchange="change_Quantity('||seq_id||')"', 'pr09_'||seq_id)
                        ELSE APEX_ITEM.TEXT(9, c003, 10, 50, 'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_Quantity('||seq_id||')"', 'pr09_'||seq_id)
                    END) AS quantity,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) AS Minimum_Price
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n001) 
                        THEN APEX_ITEM.TEXT(10, n003 * TO_NUMBER(c003), 5, 50, 'class="p-text-label" style="text-align:right;color:red" disabled', 'pr10_'||seq_id)
                        ELSE APEX_ITEM.TEXT(10, n003 * TO_NUMBER(c003), 5, 50, 'class="p-text-label" style="text-align:right;" disabled', 'pr10_'||seq_id)
                    END) AS total_amount,
                    '<span class="delete_order" onclick="delete_order('||seq_id||')"><i class="fa fa-trash" aria-hidden="true"></i><span>' AS delete_order
                    -- APEX_ITEM.HIDDEN(11, n005, NULL, 'pr11_'||seq_id) AS product_family_id
                FROM 
                    apex_collections
                WHERE 
                    collection_name = 'PRODUCT_COLLECTION';
                
                  
                
                ```
        }
        layout {
            sequence: 1210
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: order_product
            regionDisplaySelector: true
        }
        comments {
            comments:
                ```
                SELECT ROWNUM row_num,
                       APEX_ITEM.HIDDEN(1,seq_id,NULL,'pr01_'||seq_id) seq_id,
                       APEX_ITEM.HIDDEN(2,n001,NULL,'pr02_'||seq_id) ORDER_PRODUCTS_ID,
                       APEX_ITEM.HIDDEN(3,n002,NULL,'pr03_'||seq_id) ORDER_ID,
                	  (CASE WHEN n003 < (SELECT NVL(P.PRODUCT_COST+(P.PRODUCT_COST*(PF.MARGIN_PERCENTAGE/100)),0) Minimum_Price
                        FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                        WHERE P.PRODUCT_FAMILY_ID = PF.ID
                        AND P.ID =n001) 
                		THEN APEX_ITEM.TEXT(4,c001,50,50,'class=p-text-label" style="color:red;border:none;background-color:snow;" disabled  ','pr04_'||seq_id) 
                        ELSE
                        APEX_ITEM.TEXT(4,c001,50,50,'class=p-text-label" style="border:none;background-color:snow;" disabled ','pr04_'||seq_id) 
                        END) PRODUCT_NAME,
                          --APEX_ITEM.TEXT(4,c001,50,50,'class="p-text-label" disabled ','pr04_'||seq_id) PRODUCT_NAME,
                        (CASE WHEN n003 < (SELECT NVL(P.PRODUCT_COST+(P.PRODUCT_COST*(PF.MARGIN_PERCENTAGE/100)),0) Minimum_Price
                        FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                        WHERE P.PRODUCT_FAMILY_ID = PF.ID
                        AND P.ID =n001) 
                		THEN APEX_ITEM.TEXT(5,n003,10,50,'class="p-number-label" style="color:red" onkeypress="return isNumber(event)" onchange="change_price(' ||seq_id||')" ','pr05_' ||seq_id)     
                        ELSE
                        APEX_ITEM.TEXT(5,n003,10,50,'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_price(' ||seq_id||')" ','pr05_' ||seq_id)
                        END) PRODUCT_PRICE,
                        --APEX_ITEM.TEXT(5,n003,10,50,'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_price(' ||seq_id||')" ','pr05_' ||seq_id) PRODUCT_PRICE,
                        APEX_ITEM.TEXT(6,c002,5,50,'class="p-text-label" disabled ','pr06_' ||seq_id) CURRENCY_TYPE,
                        APEX_ITEM.HIDDEN(7,n004,NULL,'pr07_'||seq_id) BRAND_ID,
                        APEX_ITEM.DATE_POPUP2(8,TO_DATE(c004, 'DD/MM/YYYY'),'DD-Mon-YYYY',10,12,' class="p-date-label" onchange="change_Delivery('||seq_id||')"','pr08_'||seq_id) Delivery_date,
                        APEX_ITEM.TEXT(9,c003,10,50,'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_Quantity('||seq_id ||')" ','pr09_'||seq_id) Quantity,
                        APEX_ITEM.TEXT(10,n003*to_number(c003),5,50,'class="p-text-label" style="text-align: right;" disabled ','pr10_'||seq_id) TOTAL_AMOUNT,
                    '<span class="delete_order" onclick="delete_order('||seq_id||')"><i class="fa fa-trash" aria-hidden="true"></i><span>' delete_order
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                 
                ```
        }

    pageItem P173_CUSTOMER_NAME (
        type: popupLov
        label {
            label: Account
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                    customer_name AS d,
                    id            r
                FROM
                    eba_sales_customers
                WHERE
                    status = 'A'
                ORDER BY
                    1;
                ```
        }
        layout {
            sequence: 70
            region: @sales-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                select sc.CUSTOMER_NAME display_value, sc.ID return_value  
                from  
                eba_sales_CUSTOMERS  sc 
                where  sc.status='Y' AND
                   sc.ID in (select CUST_ID from EBA_SALES_VERIFICATIONS) 
                   AND
                  (upper(sc.DEFAULT_REP_ID) in (SELECT  upper(r.ID)                                
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS (select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR 
                                 where R.id = :USER_ID and SR.ID = R.REP_ROLE and upper(SR.ROLE_NAME) in ('ADMINISTRATOR', 'SALES CO-ORDINATOR'))
                    )                                
                order by 1;
                ```
        }
    )


    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            function change_price(seq_id)
            {
                updateTimeSheet(seq_id);
            }
            
            function change_Quantity(seq_id)
            {
                updateTimeSheet(seq_id);
            }
            
            function change_Delivery(seq_id)
            {
                updateTimeSheet(seq_id);
            }
            
            // Update collection function
            function updateTimeSheet(pSeqId) {
                //alert(pSeqId);
                //alert($("#pr09_"+pSeqId).val());
                $x('P173_SEQ_ID').value = $("#pr01_"+pSeqId).val();
                $x('P173_ORDER_PRODUCTS_ID').value = $("#pr02_"+pSeqId).val();
                $x('P173_ORDER_ID_HID').value = $("#pr03_"+pSeqId).val();
                $x('P173_PRODUCT_NAME').value = $("#pr04_"+pSeqId).val();
            	$x('P173_PRODUCT_PRICE').value = $("#pr05_"+pSeqId).val();
            	$x('P173_CURRENCY_TYPE').value = $("#pr06_"+pSeqId).val();
            	$x('P173_BRAND_ID').value = $("#pr07_"+pSeqId).val();
                $x('P173_DELIVERY_DATE').value = $("#pr08_"+pSeqId).val();
                $x('P173_QUANTITY').value = $("#pr09_"+pSeqId).val();
               // $x('P173_PRODUCT_FAMILY_ID').value = $("#pr11_"+pSeqId).val();
              
               // alert($x('P173_SEQ_ID').value+'-'+$x('P173_PRODUCT_PRICE').value);
                
            	$.event.trigger("UPDATE_PRODUCT_ROW"); // call update collection function 
            }
            
            function delete_order(pSeqId) {
                 if (confirm("Are you sure you want to delete this Product?")) {
                     $x('P173_SEQ_ID').value = $("#pr01_"+pSeqId).val();
                     $x('P173_DELETED_IDS').value = $x('P173_DELETED_IDS').value+','+$("#pr02_"+pSeqId).val();
                    $.event.trigger("DELETE_PRODUCT_ROW"); // call update collection function 
                } 
            }
            
            
            // number validation in hours field
            function isNumber(evt) {
                evt = (evt) ? evt : window.event;
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                    return false;
                }
                return true;
            }
            
            ```
    }

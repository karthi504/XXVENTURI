page 151 (
    name: Change Password
    title: Change Password
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script>
            function isCharKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 33 && (charCode < 65 || charCode > 91)&& (charCode < 97 || charCode > 122))
                        return false;
            
                     return true;
                  }
            function isNumberKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 31 && (charCode < 48 || charCode > 57))
                        return false;
            
                     return true;
                  }
            </script>
            ```
    }
    security {
        formAutoComplete: false
    }

    region change-password (
        name: Change Password
        type: staticContent
        layout {
            sequence: 1210
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P151_CHANGE (
        type: radioGroup
        label {
            label: Change Type
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Password,PIN
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @change-password
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Password
        }
        security {
            encryptSessionState: false
        }
    )


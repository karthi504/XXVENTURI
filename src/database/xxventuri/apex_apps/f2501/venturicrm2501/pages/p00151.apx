    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @change-password
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button change-pin (
        buttonName: CHANGE_PIN
        label: Change PIN
        layout {
            sequence: 30
            region: @change-password
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button save (
        buttonName: SAVE
        label: Change Password
        layout {
            sequence: 20
            region: @change-password
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction show-hide-pin (
        name: Show/Hide PIN
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: items
            items: P151_CHANGE
        }
        clientSideCondition {
            type: item=value
            item: P151_CHANGE
            value: PIN
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P151_CURRENT_PASSWORD
                    P151_NEW_PASSWORD
                    P151_CONFIRM_PASSWORD
                ]
            }
            execution {
                sequence: 30
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P151_CURRENT_MPIN
                    P151_NEW_MPIN
                    P151_CONFIRM_MPIN
                ]
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 40
            }
        )

        action native-hide-4 (
            action: hide
            affectedElements {
                selectionType: button
                button: @change-pin
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P151_CURRENT_MPIN
                    P151_NEW_MPIN
                    P151_CONFIRM_MPIN
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P151_CURRENT_PASSWORD
                    P151_NEW_PASSWORD
                    P151_CONFIRM_PASSWORD
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show-3 (
            action: show
            affectedElements {
                selectionType: button
                button: @change-pin
            }
            execution {
                sequence: 20
            }
        )

        action native-show-4 (
            action: show
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    validation password-validation (
        name: password_validation
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    digitarray varchar2(50);
                    punctarray varchar2(50);
                    chararray varchar2(100);
                    regular_expr varchar2(50);
                    password    varchar2(50);
                BEGIN
                    password := :P151_NEW_PASSWORD;
                    digitarray:= '[0123456789]';
                    chararray:= '[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ]';
                  --  punctarray:='[!"#$%&()``*+,-/:;<=>?_@]';
                 --   regular_expr:= '[ABCDEFGHIJKLMNOPQRSTUVWXYZ]';
                
                    if length(password)<6   THEN
                        return 'Password should contain atleast 6 characters';
                    
                   /* elsif regexp_instr(password,regular_expr) < 1   THEN
                    raise_application_error(-20006, 'Password must contain at least one upper case letter.'); 
                    elsif regexp_instr(password,punctarray) < 1   THEN
                    raise_application_error(-20006, 'Password should contain at least one punctuation');
                    */
                    
                    elsif regexp_instr(password,chararray) < 1   THEN
                        return 'Password should contain atleast one Alphabet.';
                        
                    elsif regexp_instr(password,digitarray) < 1   THEN
                       return 'Password should contain atleast one Number';
                    
                  --  else
                    --DBMS_OUTPUT.PUT_LINE('Password Success');
                    end if;
                    
                END;
                ```
        }
        error {
            displayLocation: inlineInNotification
            associatedItem: @P151_NEW_PASSWORD
        }
    )

    validation password-validations (
        name: Password Validations
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                    if :P151_CURRENT_PASSWORD is null  then
                        return 'Please fill out the Current Password';
                    end if;
                if :P151_NEW_PASSWORD is null  then
                        return 'Please fill out the New Password';
                    end if;
                
                if  :P151_CONFIRM_PASSWORD  is null  then
                        return 'Please fill out the Confirm Password ';
                    end if;
                
                end;
                ```
        }
        error {
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation pin-validation (
        name: PIN_validation
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  
                    pin   varchar2(50);
                BEGIN
                    pin := :P151_NEW_MPIN;
                  
                    if length(pin) > 4   THEN
                        return 'PIN should contain  4 digit only.';
                     end if;
                      if length(pin) < 4   THEN
                        return 'PIN should contain  atleast 4 digit.';
                     end if;
                    
                END;
                ```
        }
        error {
            displayLocation: inlineInNotification
            associatedItem: @P151_NEW_PASSWORD
        }
        serverSideCondition {
            whenButtonPressed: @change-pin
        }
    )

    validation pin-validations (
        name: PIN Validations
        execution {
            sequence: 40
        }
        validation {

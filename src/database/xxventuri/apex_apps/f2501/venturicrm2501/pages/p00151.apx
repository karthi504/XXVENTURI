        }
    )

    process check-and-change-password (
        name: check_and_change_password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  lv_current_password VARCHAR2(100);
                  lv_new_password     VARCHAR2(100);
                  lv_confirm_password VARCHAR2(100);
                BEGIN
                  IF :P151_CURRENT_PASSWORD = :P151_NEW_PASSWORD THEN
                    raise_application_error(-20100,'Current Password cannot be set as New Password');
                  END IF;
                  IF :P151_NEW_PASSWORD <> :P151_CONFIRM_PASSWORD THEN
                    raise_application_error(-20100,'New Password and Confirm Password does not match');
                  END IF;
                  --select PASSWORD into lv_current_password from EBA_SALES_SALESREPS where upper(USER_NAME) = upper(:APP_USER);
                  SELECT PASSWORD
                  INTO lv_current_password
                  FROM EBA_SALES_SALESREPS
                  WHERE ID = :USER_ID;
                  IF XXEBS_SALES_SECURITY_PKG.get_password_hash_value(:P151_CURRENT_PASSWORD) <> lv_current_password THEN
                    raise_application_error(-20100,'Current Password is incorrect');
                  ELSE
                    ---      update EBA_SALES_SALESREPS set password = :P151_NEW_PASSWORD where EMPLOYEE_CODE = :APP_USER;
                    UPDATE EBA_SALES_SALESREPS
                    SET PASSWORD = XXEBS_SALES_SECURITY_PKG.get_password_hash_value(:P151_NEW_PASSWORD)
                    WHERE ID     = :USER_ID;
                    -- update EBA_SALES_SALESREPS set PASSWORD = XXEBS_SALES_SECURITY_PKG.get_password_hash_value(:P151_NEW_PASSWORD)
                    -- where upper(USER_NAME) = upper(:APP_USER);
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Password changed successfully.
        }
        advanced {
            executionMappingIdentifier: 90060235856958107
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process check-and-change-pin (
        name: check_and_change_PIN
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  lv_current_pin  VARCHAR2(100);
                BEGIN
                  IF :P151_CURRENT_MPIN = :P151_NEW_MPIN THEN
                    raise_application_error(-20100,'Current PIN cannot be set as New PIN.');
                  END IF;
                  IF :P151_NEW_MPIN <> :P151_CONFIRM_MPIN THEN
                    raise_application_error(-20100,'New PIN and Confirm PIN does not match.');
                  END IF;
                  SELECT MPIN
                  INTO lv_current_pin
                  FROM EBA_SALES_SALESREPS
                  WHERE ID = :USER_ID;
                  IF :P151_CURRENT_MPIN <> lv_current_pin THEN
                    raise_application_error(-20100,'Current PIN is incorrect.');
                  ELSE
                    UPDATE EBA_SALES_SALESREPS
                    SET MPIN = :P151_NEW_MPIN
                    WHERE ID     = :USER_ID;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: PIN changed successfully.
        }
        advanced {
            executionMappingIdentifier: 319375778827401151
        }
        serverSideCondition {
            whenButtonPressed: @change-pin
        }
    )

    process close-dialog (

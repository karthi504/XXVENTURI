    button clear (
        buttonName: CLEAR
        label: Clear
        layout {
            sequence: 50
            region: @products-2
            slot: regionBody
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-eraser
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create Product
        layout {
            sequence: 10
            region: @products
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset
        layout {
            sequence: 20
            region: @products-2
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: [
                    &APP_PAGE_ID.
                    RIR
                ]
                action: resetPagination
                request: RIR
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button search (
        buttonName: SEARCH
        label: Search
        layout {
            sequence: 60
            region: @products-2
            slot: regionBody
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapRight
                t-Button--padBottom
            ]
            icon: fa-sm fa-search
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction clear (
        name: Clear
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @clear
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P4_PRODUCT_GROUP
                    P4_BRAND_NAME
                    P4_PRODUCT_TYPE
                    P4_PRODUCT_CLASS
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Action Processed.');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @products-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

)


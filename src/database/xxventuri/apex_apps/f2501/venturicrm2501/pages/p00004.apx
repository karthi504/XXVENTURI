page 4 (
    name: Products
    title: Products
    pageGroup: @administration
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            
            .t-Footer{
            	display:none;
            
            
            }
            ```
    }
    security {
        authorizationScheme: @xxeba-admin-coordinator
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Manage the domain of products available within this application. Opportunities can identify one or more products. This facilitates opportunity tracking by product. Click the <strong>Create Product</strong> button to create a new product. Click the pencil icon in the report to edit any specific product's details. Click the <strong>Reset</strong> button to reset the interactive report. Click the <strong>Actions ∨</strong> button to define the number of rows displayed per page, filter, format, download, and/or save the interactive report.
    }
    config {
        buildOption: @products
    }

    region products (
        name: Products
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region products-2 (
        name: Products
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                   select DISTINCT   UPPER(p.product_name) product_name,
                    p.id,  
                  --  P.ROW_KEY AS PRODUCT_ID,
                   p.BRAND_ID,
                  p.product_name as product_code,
                  p.PRODUCT_PRICE,p.CURRENCY_TYPE,p.UNIT_OF_MEASURE,p.PRODUCT_COST,p.PRODUCT_CURRENCY_TYPE,
                p.LEAD_TIME,
                p.MINIMUM_ORDER_QUANTITY,
                  p.row_key, 
                  p.product_sku,
                  p.product_family_id,
                  p.BRAND_ID as brand_name,
                  p.CATALOGUE_NO,
                  p.product_description,
                  p.tags,
                  p.location,
                  (
                    select count(*)
                    from eba_sales_links
                    where product_id = p.id
                  ) links,
                  (
                    select count(*)
                    from eba_sales_files
                    where product_id = p.id
                  ) attachments,
                  (
                    select count(*)
                    from eba_sales_comments
                    where product_id = p.id
                  ) comments,
                  (
                    select count(*)
                    from eba_sales_verifications
                    where product_id = p.id
                  ) validations,
                  (
                    select max(created)
                    from eba_sales_verifications
                    where product_id = p.id
                  ) last_validation,
                  (
                    select count(*)
                    from eba_sales_clicks
                    where product_id = p.id
                      and view_timestamp >= sysdate - 90
                  ) views_90_days,
                    (   select count(distinct(app_username))
                        from eba_sales_clicks
                        where product_id = p.id
                            and view_timestamp >= sysdate - 90
                    ) users_90_days,
                  p.created,
                  p.created_by,
                  p.updated,
                  p.updated_by,
                  (
                    SELECT COUNT(*)
                    FROM eba_sales_deals sd, eba_sales_deal_products dp
                    WHERE
                    sd.id = dp.deal_id
                    and dp.product_id = p.id 
                  ) opportunities,
                  (
                    SELECT COUNT(*)
                    FROM eba_sales_customers c, eba_sales_deals d, eba_sales_deal_products dp
                    WHERE c.id = d.customer_id
                    and d.id = dp.deal_id
                	and dp.product_id = p.id
                  ) customers
                from eba_sales_products p 
                
                where 
                  p.id = p.id + 0
                  and p.status='Y'
                  and (:P4_PRODUCT_GROUP is null or p.product_family_id = :P4_PRODUCT_GROUP)
                  and (:P4_BRAND_NAME is null or p.BRAND_ID = :P4_BRAND_NAME)
                  and (:P4_PRODUCT_CLASS is null or   p.PRODUCT_CLASS_ID = :P4_PRODUCT_CLASS)
                  and (:P4_PRODUCT_TYPE is null or p.PRODUCT_TYPE_ID = :P4_PRODUCT_TYPE)
                  and p.BRAND_ID NOT IN (1008,1027,1011,1006,1010,1012,1014,1031,1015,1023,1016)
                --   AND P.BRAND_ID IN (1000,1001,1005,1028,1032,1033)
                   ORDER BY p.UPDATED DESC
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                /*select ID,PRODUCT_NAME,BRAND_ID,
                	PRODUCT_DESCRIPTION  , 
                	PRODUCT_FAMILY_ID,
                	PRODUCT_SKU,PRODUCT_COST,PRODUCT_CURRENCY_TYPE ,PRODUCT_PRICE,CURRENCY_TYPE , 
                	TARIFF_CODE ,  (select count(*) from eba_sales_verifications where product_id =ID) validations,
                    CATALOGUE_NO , 
                	CATALOGUE_ATTACHMENT from eba_sales_products 
                    where STATUS='Y'*/
                	
                    
                 
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 5
                items: {
                    P5_ID: #ID#
                }
                clearCache: 5
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @edit-product
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        actionsMenu {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3737754719683478716
        }


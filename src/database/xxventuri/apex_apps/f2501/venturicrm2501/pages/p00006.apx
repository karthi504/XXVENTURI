page 6 (
    name: &REP_TITLE.s
    title: &REP_TITLE.s
    pageGroup: @administration
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-Footer{
            	display:none;
            }
            
            td[headers="PHOTO"] img
            {
                height: 85px; 
                width: 85px; 
                border: 3px solid #16C4E6; 
                border-radius: 7px;
            }
            ```
    }
    security {
        authorizationScheme: @xxeba-admin
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Manage your team. Click the pencil icon to edit a specific team member. Click the <strong>Create</strong> button to create a new team member. Click the <strong>Reset</strong> button to reset the interactive report. Click the <strong>Actions ∨</strong> button to define the number of rows displayed per page, filter, format, download, and/or save the interactive report.
    }

    region rep-title-s (
        name: &REP_TITLE.s
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.id, Null As Reset_Password,
                  r.rep_last_name,  
                dbms_lob.getlength(r.FILE_BLOB)  photo_blob,
                  r.rep_first_name,
                  r.rep_email,
                  (
                    select rep_first_name || ' ' || rep_last_name
                    from eba_sales_salesreps m
                    where m.id = r.rep_manager_id
                  ) as manager,
                  (rep_first_name || ' ' || rep_last_name)as Username,
                  r.rep_office,
                  r.rep_office_phone,
                  r.rep_cell_phone,
                  r.rep_pager,
                  srr.role_name role,
                  case
                    when srr.is_sales_rep = 'Y'
                    then 'Yes'
                    else 'No'
                  end is_sales_rep,
                  r.created,
                  r.created_by,
                  r.updated,
                  r.updated_by,
                  r.DEPARTMENT_ID,
                  'Brands' "Brands"
                from eba_sales_salesreps r
                left join eba_sales_salesrep_roles srr
                  on srr.id = r.rep_role where r.status='Y'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 7
                items: {
                    P7_ID: #ID#
                }
                clearCache: 7
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        actionsMenu {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3737702211060074440
        }


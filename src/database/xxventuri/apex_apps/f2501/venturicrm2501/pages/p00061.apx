page 61 (
    name: Product
    title: Product
    pageGroup: @products
    appearance {
        pageTemplate: @marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }
    help {
        helpText: Manage an product's details, links, attachments, and/or comments. You can also validate the product.
    }
    config {
        buildOption: @products
    }

    region brands (
        name: "Brands "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "BRAND_ID", NULL EDIT,
                "ENTITY_ID",
                "ENTITY_TYPE",
                "BRAND_NAME",
                "BRAND_CODE",
                "BRAND_PRICE",
                "UNIT_OF_MEASURE",
                "MINIMUM_ORDER_QTY",
                "LEAD_TIME",
                "BRAND_CURRENCY_TYPE",
                dbms_lob.getlength("BRAND_ATTACHMENT") "BRAND_ATTACHMENT",
                "BRAND_ATT_MIMETYPE",
                "BRAND_ATT_FILENAME",
                "BRAND_ATT_CHARSET",
                "BRAND_ATT_LAST_UPDATE",
                "CREATED_BY",
                "CREATED",
                "UPDATED_BY",
                "UPDATED"
                from "#OWNER#"."XXEBA_SALES_BRANDS" where  ENTITY_ID= :P61_ID
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }


    region product (
        name: Product
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.id,
                  p.product_name,
                  p.PRODUCT_COST||' '||CASE 
                  WHEN p.PRODUCT_COST IS Not NULL  THEN p.PRODUCT_CURRENCY_TYPE 
                  ELSE NULL  end as Product_cost,
                  p.product_family_id,
                  p.row_key, p.PRODUCT_PRICE ||' '||CASE 
                  WHEN p.PRODUCT_PRICE  IS Not NULL  THEN p.CURRENCY_TYPE
                  ELSE NULL  end as Product_price ,
                  p.product_sku,p.CATALOGUE_NO,p.UNIT_OF_MEASURE,p.LEAD_TIME,p.MINIMUM_ORDER_QUANTITY,p.STOCK_ID,p.BRAND_ID,
                  p.product_description,
                  p.created,
                  lower(p.created_by) created_by,
                  p.updated,
                  lower(p.updated_by) updated_by
                from eba_sales_products p
                where p.id = :P61_ID
                
                ```
        }
        layout {
            sequence: 10
            slot: masterDetail
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
            showNullValuesAs: -
        }

        column BRAND_ID (
            reportColumnQueryId: 13
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Brand Name
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery: "select BRAND_NAME as d,BRAND_ID as r from XXEBA_SALES_PRODUCT_BRANDS order by 1 "
            }
            layout {
                sequence: 5
            }
        )

        column CATALOGUE_NO (

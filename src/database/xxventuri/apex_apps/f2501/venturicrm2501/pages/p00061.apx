    region summary (
        name: Summary
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select d, 
                  c
                from (
                  select 'Accounts' d, 
                    count(*) c, 
                    1 s
                  from eba_sales_customers
                  where id in (
                    select customer_id
                    from eba_sales_deals
                    where id in (
                      select deal_id
                      from eba_sales_deal_products
                      where product_id = :P61_ID
                    )
                  )
                  union all
                  select 'Opportunities' d, count(*) c, 2 s
                  from eba_sales_deals
                  where id in (
                    select deal_id
                    from eba_sales_deal_products
                    where product_id = :P61_ID
                  )
                  union all
                  select 'Open Opportunities' d, count(*) c, 3 s
                  from eba_sales_deals
                  where deal_probability != 0 and deal_probability != 100
                    and id in (
                      select deal_id
                      from eba_sales_deal_products
                      where product_id = :P61_ID
                    )
                )
                order by s
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            topLabel: D
            value: C
            bottomLabel: D
        }
    )

    region usage-metrics-90-days (
        name: Usage Metrics - 90 days
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select count(*) c,
                  'Views' l,
                  1 disp
                from eba_sales_clicks
                where product_id = :P61_ID 
                  and view_timestamp > sysdate - 90
                union all
                select count(distinct(app_username)) c,
                    'Users' l,
                    2 disp
                from eba_sales_clicks
                where product_id = :P61_ID 
                    and view_timestamp > sysdate - 90
                order by disp
                ```
        }
        layout {
            sequence: 50
            slot: rightSideColumn
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @usage-metrics
        }
        settings {
            badgeStyle: circular
            value: C
            bottomLabel: L
            linkTarget: {
                page: 138
                items: {
                    P138_ENTITY_TYPE: PRODUCT
                    P138_ENTITY_ID: &P61_ID.
                }
                clearCache: 138
            }
            layout: 2Columns
        }
    )

    region validations (
        name: Validations
        type: plugin/contentValidator
        source {
            sqlQuery:
                ```sql
                select v.verified_by,
                  v.created
                from eba_sales_verifications v
                where product_id = :P61_ID
                order by v.created desc
                ```
        }
        layout {
            sequence: 40
            slot: rightSideColumn
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--hiddenOverflow
            ]
            cssClasses: js-validateRegion
        }
        config {
            buildOption: @validations
        }
        settings {
            validationLink: {
                page: 146
                items: {
                    P146_ENTITY_TYPE: PRODUCT
                    P146_ENTITY_ID: &P61_ID.
                }
                clearCache: 146
            }
            previousValidationsLink: {
                page: 147
                items: {
                    P147_ENTITY_TYPE: PRODUCT
                    P147_ENTITY_ID: &P61_ID.
                }
                clearCache: 147
                action: resetPagination
            }
        }
    )


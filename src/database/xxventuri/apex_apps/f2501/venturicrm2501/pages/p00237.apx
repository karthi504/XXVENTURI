    region product-class-wise-sales (
        name: Product Class-wise Sales 2020
        type: chart
        layout {
            sequence: 190
            parentRegion: @analytics
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: pie
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            title: Product Class
            hideAndShowBehavior: none
        }

        series top10-sales (
            name: Top10 Sales
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  SALES_YEAR, TOTAL_AMOUNT,PRODUCT_CLASS_NAME  from
                      (
                    SELECT 
                    TO_CHAR(INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                    SUM(to_number(NVL(TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                    PRODUCT_CLASS_NAME 
                    FROM XXEBA_TALLY_INVOICES_T T,EBA_SALES_PRODUCTS P ,XXEBA_PRODUCT_CLASS C
                    WHERE T.product_code=p.row_key
                      AND batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                      AND  C.ID =P.PRODUCT_CLASS_ID   
                    group by PRODUCT_CLASS_NAME ,to_char(INVOICE_DATE,'YYYY')order by PRODUCT_CLASS_NAME)
                    
                    where SALES_YEAR= to_char(sysdate,'YYYY')-1
                      --and rownum <=10;
                    ```
            }
            columnMapping {
                label: PRODUCT_CLASS_NAME
                value: TOTAL_AMOUNT
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )


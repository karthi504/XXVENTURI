    region product-group-wise-sales (
        name: Product Group-wise Sales 2019
        type: chart
        layout {
            sequence: 240
            parentRegion: @analytics
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: pie
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series group-wise-sales (
            name: Group Wise Sales
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  SALES_YEAR, TOTAL_AMOUNT,PRODUCT_FAMILY from
                      (
                    SELECT 
                    TO_CHAR(INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                    SUM(to_number(NVL(TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                    PRODUCT_FAMILY
                    FROM XXEBA_TALLY_INVOICES_T T,EBA_SALES_PRODUCTS P ,eba_sales_product_families  B
                    WHERE T.product_code=p.row_key
                      AND batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                      AND  P.PRODUCT_FAMILY_ID = B.ID  
                    group by PRODUCT_FAMILY,to_char(INVOICE_DATE,'YYYY')order by PRODUCT_FAMILY)
                    
                    where SALES_YEAR= to_char(sysdate,'YYYY') - 2;
                    ```
            }
            columnMapping {
                label: PRODUCT_FAMILY
                value: TOTAL_AMOUNT
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )


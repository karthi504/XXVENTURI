    region trials-trend-created-vs-passed (
        name: Trials Trend- Created vs Passed
        type: chart
        layout {
            sequence: 310
            parentRegion: @analytics
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series created (
            name: Created
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT no_of_records, year_wise,year_id
                    FROM
                      (SELECT distinct COUNT(*) no_of_records,
                        TO_CHAR(CREATED_DATE , 'YYYY') AS year_wise,
                        TO_CHAR(CREATED_DATE ,'YYYY') AS year_id
                      FROM XXEBA_TRIAL_DETAILS tri
                      WHERE tri.status != 'X'
                     /* AND ((created_by = :APP_USER
                      AND NOT EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)   in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                        AND upper(SR.user_name) = :APP_USER
                        ))
                            
                     OR (((created_by = :P1002_TRIAL_CREATED_PASSED_ID OR :P1002_TRIAL_CREATED_PASSED_ID IS NULL) and created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = :APP_USER
                      ))        
                      OR ((created_by                   = :P1002_TRIAL_CREATED_PASSED_ID
                      OR :P1002_TRIAL_CREATED_PASSED_ID IS NULL)
                      AND EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                        AND upper(SR.user_name) = :APP_USER
                        ) ) )*/
                      GROUP BY TO_CHAR(CREATED_DATE , 'YYYY'),
                        to_number(TO_CHAR(CREATED_DATE , 'YYYY'))
                      )
                     order by to_date (year_wise,'YYYY')  asc
                    ```
            }
            columnMapping {
                label: YEAR_WISE
                value: NO_OF_RECORDS
            }
            label {
                show: true
                position: insideBarEdge
                fontColor: WHITE
            }
        )

        series passed (
            name: Passed
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT no_of_records,year_wise,year_id
                    FROM
                      (SELECT distinct COUNT(*) no_of_records,
                        TO_CHAR(CREATED_DATE , 'YYYY')          AS year_wise,
                        to_number(TO_CHAR(CREATED_DATE , 'YYYY')) AS year_id
                      FROM XXEBA_TRIAL_DETAILS tri
                      WHERE TRIAL_RESULT = 'P'
                      AND STATUS != 'X'
                     /* AND ((created_by = :APP_USER
                      AND NOT EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                        AND upper(SR.user_name) = :APP_USER
                        ))
                           
                    OR (((created_by = :P1002_TRIAL_CREATED_PASSED_ID OR :P1002_TRIAL_CREATED_PASSED_ID IS NULL) and created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = :APP_USER
                      ))
                      OR ((created_by                   = :P1002_TRIAL_CREATED_PASSED_ID
                      OR :P1002_TRIAL_CREATED_PASSED_ID IS NULL)
                      AND EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                        AND upper(SR.user_name) = :APP_USER
                        ) ) )*/
                      GROUP BY TO_CHAR(CREATED_DATE , 'YYYY'),
                        to_number(TO_CHAR(CREATED_DATE , 'YYYY'))
                      )
                    order by to_date (year_wise,'YYYY')  asc
                    ```
            }
            columnMapping {
                label: YEAR_WISE
                value: NO_OF_RECORDS
            }
            label {
                show: true
                position: insideBarEdge
                fontColor: WHITE
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

        axis y-2 (
            name: y2
            minorTicks {
                show: false
            }
        )

    )

    pageItem P237_SALES_REP (
        type: selectList
        label {
            label: Sales Rep
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                  DECLARE
                  v_tl_sql     VARCHAR2(4000);
                  v_admin_sql  VARCHAR2(4000);
                  v_rep_mgr_id NUMBER;
                BEGIN
                
                  SELECT COUNT(REP_MANAGER_ID)
                  INTO v_rep_mgr_id
                  FROM eba_sales_salesreps
                  WHERE id        = :USER_ID;
                  
                  IF v_rep_mgr_id = 0 THEN
                    v_admin_sql  := 'SELECT rep_first_name  
                                      ||'' ''  
                                      ||rep_last_name d,  
                                      ID r
                                      FROM eba_sales_salesreps
                                      where status = ''Y''
                                      and id !=137299580992928658344444066683110435759
                                      order by 1 asc';
                    RETURN v_admin_sql;
                  elsif v_rep_mgr_id > 0 THEN
                    v_tl_sql        := ('SELECT rep_first_name  
                                        ||'' ''||rep_last_name d,  
                                        ID r
                                        FROM eba_sales_salesreps r                       
                                        START WITH r.id      = :USER_ID  
                                        CONNECT BY PRIOR r.id= r.REP_MANAGER_ID  
                                        order by 1 asc');
                    RETURN v_tl_sql;
                  END IF;
                END;
                ```
            displayExtraValues: false
            nullDisplayValue: All
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
            column: 4
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P237_TALLY_DATA_LAST_SYNC (
        type: displayOnly
        label {
            label: Tally Data-Last Sync:
            alignment: left
        }
        layout {
            sequence: 10
            region: @region-display
            slot: regionBody
            alignment: left
            column: 9
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                margin-top-none
                margin-bottom-none
            ]
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select to_char (max(UPDATED_DATE),'DD-Mon-YYYY HH24:MI:AM') from  XXEBA_TALLY_INVOICES_T ;
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P237_YEAR (
        type: selectList
        label {
            label: Year
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct to_char(ORDER_DATE,'YYYY')d, to_char(ORDER_DATE,'YYYY')r from XXEBA_SALES_ORDER order by 1 desc ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @order-booking-trend-sub-report
            slot: regionBody
            alignment: left
            column: 6
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P237_SALES_REP
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new-accounts-trend
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-report (
        name: refresh report
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P237_YAER
        }
    )

    dynamicAction refresh-report-2 (
        name: REFRESH REPORT
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P237_YAER_ORDERS
        }
    )

    dynamicAction region-refresh (
        name: Region  Refresh
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P237_YEAR
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @booking-vs-billing-trend
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


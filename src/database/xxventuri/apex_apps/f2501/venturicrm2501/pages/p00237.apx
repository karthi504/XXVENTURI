        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: thousand
        }
        legend {
            hideAndShowBehavior: none
        }

        series industrywise-count (
            name: Industrywise Count
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT territory_name,
                      COUNT(*) AS no_of_record
                    FROM xxeba_sales_order ord,
                      eba_sales_TERRITORIES ter
                    WHERE ord.territory_id = ter.id
                    AND ord.status !='X'
                    GROUP BY territory_name
                    ORDER BY 1;
                    ```
            }
            columnMapping {
                label: TERRITORY_NAME
                value: NO_OF_RECORD
            }
            label {
                show: true
                position: outsideBarEdge
                displayAs: percentage
            }
        )

    )

    region territory-wise-sales (
        name: Territory-wise Sales
        type: chart
        layout {
            sequence: 40
            parentRegion: @reports
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: pie
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: thousand
        }
        legend {
            hideAndShowBehavior: none
        }

        series industrywise-count (
            name: Industrywise Count
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ter.territory_name, sum(nvl(prd.quantity,0) * nvl(prd.product_price,0)) AS order_value
                    FROM xxeba_sales_order ord, XXEBA_ORDER_PRODUCTS prd, eba_sales_TERRITORIES ter
                    WHERE ord.territory_id = ter.id
                    AND ord.status !='X'
                    AND ord.order_id = prd.order_id
                    GROUP BY territory_name
                    ORDER BY 1;
                    ```
            }
            columnMapping {
                label: TERRITORY_NAME
                value: ORDER_VALUE
            }
            label {
                show: true
                position: outsideBarEdge
                displayAs: percentage
            }
        )

    )

    region top-10-booking (
        name: Top 10 Booking 2020
        type: chart
        layout {
            sequence: 110
            parentRegion: @analytics
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        chartAppearance {
            orientation: horizontal
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            show: false
        }

        series top10-orders (
            name: Top10 orders
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  CUSTOMER_NAME,ORDER_VALUE from (select  CUSTOMER_NAME, sum (ORDER_VALUE) ORDER_VALUE, to_char(order_date,'YYYY') order_year
                    
                    from XXEBA_SALES_ORDER SO,
                    	EBA_SALES_DEALS SD,
                    	EBA_SALES_CUSTOMERS SC,
                    	EBA_SALES_SALESREPS SR,
                       
                      --  XXEBA_TALLY_INVOICES_T tal,
                    	EBA_SALES_CUSTOMER_LOCATIONS CL,
                    	EBA_SALES_CUSTOMER_LOCATIONS CL2,
                           (select
                        ORDER_ID,
                        sum(order_value) order_value,
                        min(DELIVERY_DATE) as DELIVERY_DATE from
                        (
                        select
                        ORDER_ID,
                        QUANTITY,
                        PRODUCT_PRICE,
                        (QUANTITY * PRODUCT_PRICE)order_value,
                        DELIVERY_DATE
                        from
                        XXEBA_ORDER_PRODUCTS
                        )
                        group by ORDER_ID)value
                        
                    where SO.DEAL_ID = SD.ID  
                     -- and SO.CUSTOMER_ID = SC.ID(+)
                         and SO.CUSTOMER_ID = SC.ID
                     -- and SO.SALES_REP = SR.ID(+)
                      and SO.SALES_REP = SR.ID
                      and SO.DELIVERY_LOCATION = CL.ID(+)
                      and SO.BILLING_LOCATION = CL2.ID (+)
                      and SO.ORDER_ID = value.ORDER_ID(+)
                      AND (upper(SC.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                             FROM eba_sales_salesreps r
                                                            START WITH r.id = :USER_ID
                                                           CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                         or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                        or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Sales Co-Ordinator'))
                        and SO.STATUS  IN ('Y')
                    --and to_char(order_date,'YYYY')= nvl(:P237_YAER_ORDERS , to_char(sysdate,'YYYY')) 
                     and ORDER_VALUE is not null
                    group by CUSTOMER_NAME ,to_char(order_date,'YYYY')
                    order by ORDER_VALUE desc
                                                            
                    ) where order_year = to_char(sysdate,'YYYY')-1 and  rownum <=10
                    ```
            }
            columnMapping {
                label: CUSTOMER_NAME
                value: ORDER_VALUE
            }
        )

        axis x (
            name: x
            value {
                format: decimal
                decimalPlaces: 2
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 2
                pattern: Rs ##,##,##,###.##
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

    )


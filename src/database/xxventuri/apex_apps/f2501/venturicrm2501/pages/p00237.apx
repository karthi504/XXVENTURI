    region industry-wise-accounts (
        name: Industry-wise Accounts
        type: chart
        layout {
            sequence: 70
            parentRegion: @reports
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }

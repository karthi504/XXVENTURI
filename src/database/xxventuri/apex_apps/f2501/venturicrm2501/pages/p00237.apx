page 237 (
    name: Advanced Reports
    title: New Reports
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region advanced-reports (
        name: Advanced Reports
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1270
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region analytics (
        name: Analytics
        type: staticContent
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region booking-vs-billing-trend (
        name: Booking vs Billing Trend
        type: chart
        layout {
            sequence: 90
            parentRegion: @analytics
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: line
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series booking (
            name: Booking
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(ORDER_VALUE)/100000 total, to_char(order_date,'YYYY') year
                    from XXEBA_SALES_ORDER SO,
                    	EBA_SALES_DEALS SD,
                    	EBA_SALES_CUSTOMERS SC,
                    	EBA_SALES_SALESREPS SR,   
                      --  XXEBA_TALLY_INVOICES_T tal,
                    	EBA_SALES_CUSTOMER_LOCATIONS CL,
                    	EBA_SALES_CUSTOMER_LOCATIONS CL2,
                           (select
                        ORDER_ID,
                        sum(order_value) order_value,
                        min(DELIVERY_DATE) as DELIVERY_DATE from
                        (
                        select
                        ORDER_ID,
                        QUANTITY,
                        PRODUCT_PRICE,
                        (QUANTITY * PRODUCT_PRICE)order_value,
                        DELIVERY_DATE
                        from
                        XXEBA_ORDER_PRODUCTS
                        )
                        group by ORDER_ID)value    
                    where SO.DEAL_ID = SD.ID  
                     -- and SO.CUSTOMER_ID = SC.ID(+)
                         and SO.CUSTOMER_ID = SC.ID
                     -- and SO.SALES_REP = SR.ID(+)
                      and SO.SALES_REP = SR.ID
                      and SO.DELIVERY_LOCATION = CL.ID(+)
                      and SO.BILLING_LOCATION = CL2.ID (+)
                      and SO.ORDER_ID = value.ORDER_ID(+)
                      and to_char(SO.order_date,'YYYY') in (:P237_YEAR, :P237_YEAR-1) 
                      AND (upper(SC.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                             FROM eba_sales_salesreps r
                                                            START WITH r.id = :USER_ID
                                                           CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                         or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                        or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Sales Co-Ordinator'))
                        and SO.STATUS  IN ('Y')
                    group by to_char(order_date,'YYYY')
                    order by to_char(order_date,'YYYY')
                      
                    
                    ```
                pageItemsToSubmit: P237_YEAR
            }
            columnMapping {
                label: YEAR
                value: TOTAL
            }
            label {
                show: true
            }
        )

        series sales (
            name: Sales
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(TOTAL_AMOUNT)/100000 total, to_char(INVOICE_DATE ,'YYYY') year 
                      from XXEBA_TALLY_INVOICES_T 
                      where to_char(INVOICE_DATE,'YYYY') in (:P237_YEAR, :P237_YEAR-1) 
                         AND batch_sequence=(select max(BATCH_SEQUENCE) from XXEBA_TALLY_INVOICES_T )
                    group by to_char(INVOICE_DATE ,'YYYY')
                    order by to_char(INVOICE_DATE,'YYYY')
                    ```
                pageItemsToSubmit: P237_YEAR
            }
            columnMapping {
                label: YEAR
                value: TOTAL
            }
            appearance {
                color: #E3073A
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 2
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region brand-wise-sales (
        name: Brand-wise Sales 2019
        type: chart
        layout {
            sequence: 210
            parentRegion: @analytics
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: pie
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            hideAndShowBehavior: none
        }

        series top10-sales (
            name: Top10 Sales
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  SALES_YEAR, TOTAL_AMOUNT,BRAND_NAME from
                      (
                    SELECT 
                    TO_CHAR(INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                    SUM(to_number(NVL(TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                    BRAND_NAME
                    FROM XXEBA_TALLY_INVOICES_T T,EBA_SALES_PRODUCTS P ,XXEBA_SALES_PRODUCT_BRANDS  B
                    WHERE T.product_code=p.row_key
                      AND batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                      AND  P.BRAND_ID = B.BRAND_ID  
                    group by BRAND_NAME,to_char(INVOICE_DATE,'YYYY') order by BRAND_NAME )
                    
                    where SALES_YEAR= to_char(sysdate,'YYYY') - 2
                     -- and rownum <=10;
                    ```
            }
            columnMapping {
                label: BRAND_NAME
                value: TOTAL_AMOUNT
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )


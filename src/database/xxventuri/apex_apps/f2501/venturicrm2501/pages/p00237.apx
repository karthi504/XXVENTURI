    region product-class-wise-sales-order (
        name: Product Class-wise Sales Order
        type: chart
        layout {
            sequence: 60
            parentRegion: @reports
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chartAppearance {
            orientation: horizontal
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series product-class-wise-sales-order (
            name: " Product Class-wise Sales Order"
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT PRODUCT_CLASS_NAME,
                      COUNT(DISTINCT ORDER_ID) as no_of_record
                    FROM
                      (SELECT OP.product_id,
                        P.ID,
                        OP.ORDER_ID,
                        P.PRODUCT_NAME,
                        OP.PRODUCT_NAME,
                        P.PRODUCT_CLASS_ID,
                        PC.PRODUCT_CLASS_NAME
                      FROM eba_sales_products P,
                        XXEBA_ORDER_PRODUCTS OP,
                        XXEBA_PRODUCT_CLASS PC,XXEBA_SALES_ORDER SO
                      WHERE P.ID            =OP.PRODUCT_ID
                      AND SO.ORDER_ID      = OP.ORDER_ID
                      AND P.PRODUCT_CLASS_ID=PC.ID
                      AND SO.STATUS !='X'
                      )
                    GROUP BY PRODUCT_CLASS_NAME
                    ORDER BY 1;
                    
                    
                    ```
            }
            columnMapping {
                label: PRODUCT_CLASS_NAME
                value: NO_OF_RECORD
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )


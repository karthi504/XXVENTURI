            orientation: horizontal
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series industrywise-count (
            name: Industrywise Count
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT industry_name,
                      COUNT(*) AS no_of_record
                    FROM eba_sales_industries ind,
                      eba_sales_customers cus
                    WHERE ind.id = cus.industry_id
                    AND cus.status !='X'
                    GROUP BY industry_name;
                    ```
            }
            columnMapping {
                label: INDUSTRY_NAME
                value: NO_OF_RECORD
            }
            appearance {
                color: #F208CF
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )


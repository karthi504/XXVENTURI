    region top-sales-in-the-year-2 (
        name: Top Sales in the year 2021
        type: chart
        layout {
            sequence: 170
            parentRegion: @analytics
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chartAppearance {
            orientation: horizontal
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            show: false
        }

        series top10-sales (
            name: Top10 Sales
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select CUSTOMER_NAME, SALES_YEAR, TOTAL_AMOUNT from
                      (
                      select CUSTOMER_NAME, to_char(INVOICE_DATE,'YYYY') as SALES_YEAR, sum(to_number(nvl(TOTAL_AMOUNT,0))) as TOTAL_AMOUNT
                         from XXEBA_TALLY_INVOICES_T where batch_sequence=(select max(BATCH_SEQUENCE) from XXEBA_TALLY_INVOICES_T )
                          group by CUSTOMER_NAME, to_char(INVOICE_DATE,'YYYY')
                          order by TOTAL_AMOUNT desc)    
                      ----and to_char(INVOICE_DATE,'YYYY')=nvl(:P237_YAER,to_char(sysdate,'YYYY'))
                    where SALES_YEAR = to_char(sysdate,'YYYY')
                      and rownum <=10;
                    ```
            }
            columnMapping {
                label: CUSTOMER_NAME
                value: TOTAL_AMOUNT
            }
        )

        axis x (
            name: x
            value {
                format: decimal
                decimalPlaces: 2
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 2
                pattern: Rs ##,##,##,###.##
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

    )


    region new-accounts-trend (
        name: New Accounts Trend
        type: chart
        layout {
            sequence: 300
            parentRegion: @analytics
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
        }
        legend {
            show: false
        }

        series new-accounts (
            name: New Accounts
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select no_of_records,year_wise,year_id 
                    from 
                    (SELECT 
                     count(*) as no_of_records,
                    to_char(CREATED , 'YYYY') AS year_wise,
                    to_char(CREATED , 'YYYY') AS year_id
                    FROM eba_sales_customers
                    where 
                    STATUS != 'X'
                    AND STATUS = 'A'
                    AND DEFAULT_REP_ID =NVL(UPPER(:P237_SALES_REP), :USER_ID)
                     
                     AND NOT EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                      AND upper(SR.user_name) =  :APP_USER
                      )
                         
                     OR (((DEFAULT_REP_ID = NVL(UPPER(:P237_SALES_REP),:USER_ID) OR upper(:P237_SALES_REP) IS NULL) and created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = upper(:APP_USER)
                      ))  
                    OR ((DEFAULT_REP_ID = NVL(UPPER(:P237_SALES_REP),:USER_ID)
                    OR :P237_SALES_REP IS NULL)
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                      AND upper(SR.user_name) = :APP_USER
                      )
                      )
                      
                     
                     
                     
                     
                     
                    GROUP BY to_char(CREATED , 'YYYY'))
                    order by to_date (year_wise,'YYYY')  asc
                    
                    ```
                pageItemsToSubmit: P237_SALES_REP
            }
            columnMapping {
                label: YEAR_WISE
                value: NO_OF_RECORDS
            }
            appearance {
                color: #05F5CD
            }
            label {
                show: true
                fontColor: #911791
            }
        )

        axis x (
            name: x
            value {
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

    )


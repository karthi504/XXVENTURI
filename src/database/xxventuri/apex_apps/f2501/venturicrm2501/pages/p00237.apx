                sqlQuery:
                    ```sql
                    select  CUSTOMER_NAME,ORDER_VALUE from (select  CUSTOMER_NAME, sum (ORDER_VALUE) ORDER_VALUE, to_char(order_date,'YYYY') order_year
                    
                    from XXEBA_SALES_ORDER SO,
                    	EBA_SALES_DEALS SD,
                    	EBA_SALES_CUSTOMERS SC,
                    	EBA_SALES_SALESREPS SR,
                       
                      --  XXEBA_TALLY_INVOICES_T tal,
                    	EBA_SALES_CUSTOMER_LOCATIONS CL,
                    	EBA_SALES_CUSTOMER_LOCATIONS CL2,
                           (select
                        ORDER_ID,
                        sum(order_value) order_value,
                        min(DELIVERY_DATE) as DELIVERY_DATE from
                        (
                        select
                        ORDER_ID,
                        QUANTITY,
                        PRODUCT_PRICE,
                        (QUANTITY * PRODUCT_PRICE)order_value,
                        DELIVERY_DATE
                        from
                        XXEBA_ORDER_PRODUCTS
                        )
                        group by ORDER_ID)value
                        
                    where SO.DEAL_ID = SD.ID  
                     -- and SO.CUSTOMER_ID = SC.ID(+)
                         and SO.CUSTOMER_ID = SC.ID
                     -- and SO.SALES_REP = SR.ID(+)
                      and SO.SALES_REP = SR.ID
                      and SO.DELIVERY_LOCATION = CL.ID(+)
                      and SO.BILLING_LOCATION = CL2.ID (+)
                      and SO.ORDER_ID = value.ORDER_ID(+)
                      AND (upper(SC.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                             FROM eba_sales_salesreps r
                                                            START WITH r.id = :USER_ID
                                                           CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                         or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                        or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Sales Co-Ordinator'))
                        and SO.STATUS  IN ('Y')
                    --and to_char(order_date,'YYYY')= nvl(:P237_YAER_ORDERS , to_char(sysdate,'YYYY')) 
                     and ORDER_VALUE is not null
                    group by CUSTOMER_NAME ,to_char(order_date,'YYYY')
                    order by ORDER_VALUE desc
                                                            
                    ) where order_year = to_char(sysdate,'YYYY')  and customer_name <> '4i Apps Solutions' and  rownum <=10
                    ```
            }
            columnMapping {
                label: CUSTOMER_NAME
                value: ORDER_VALUE
            }
        )

        axis x (

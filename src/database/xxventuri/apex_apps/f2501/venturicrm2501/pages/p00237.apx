    region product-type-wise-sales-order (
        name: Product Type-wise Sales Order
        type: chart
        layout {
            sequence: 50
            parentRegion: @reports
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chartAppearance {
            orientation: horizontal
        }
        dataCursor {
            dimOnHover: false
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series product-type-wise-sales-order (
            name: Product Type-wise Sales Order
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT PRODUCT_TYPE,
                      COUNT(DISTINCT ORDER_ID) AS no_of_record
                    FROM
                      (SELECT OP.product_id,
                        P.ID,
                        OP.ORDER_ID,
                        P.PRODUCT_NAME,
                        OP.PRODUCT_NAME,
                        P.PRODUCT_TYPE_ID,
                        PT.PRODUCT_TYPE
                      FROM eba_sales_products P,
                        XXEBA_ORDER_PRODUCTS OP,
                        XXEBA_SALES_PRODUCT_TYPES PT,
                        XXEBA_SALES_ORDER SO
                      WHERE P.ID            =OP.PRODUCT_ID
                      AND P.PRODUCT_TYPE_ID =PT.PRODUCT_TYPE_ID
                      AND SO.ORDER_ID      = OP.ORDER_ID
                      AND SO.STATUS !='X'
                      )
                    GROUP BY PRODUCT_TYPE
                    ORDER BY 1;
                    
                    
                    
                    ```
            }
            columnMapping {
                label: PRODUCT_TYPE
                value: NO_OF_RECORD
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
            value {
                formatScaling: thousand
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: thousand
            }

    region sales-by-region (
        name: Sales by Region
        type: chart
        layout {
            sequence: 130
            parentRegion: @analytics
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            title: Region
            hideAndShowBehavior: none
        }

        series region (
            name: Region
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  SALES_YEAR, TOTAL_AMOUNT,TERRITORY_NAME from
                      (
                    SELECT 
                    TO_CHAR(t.INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                    SUM(to_number(NVL(t.TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                    tr.TERRITORY_NAME
                    FROM XXEBA_TALLY_INVOICES_T t , EBA_SALES_CUSTOMERS c, EBA_SALES_TERRITORIES tr
                    WHERE 
                    t.customer_id = c.ROW_KEY
                    and tr.id = c.CUSTOMER_TERRITORY_ID
                    and   t.batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                    group by TERRITORY_NAME,to_char(INVOICE_DATE,'YYYY'))
                    
                    --where rownum <=5 ; 
                    
                    ```
            }
            columnMapping {
                label: TERRITORY_NAME
                value: TOTAL_AMOUNT
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )

    region territory-wise-number-of-orders (
        name: Territory-wise Number of Orders
        type: chart
        layout {
            sequence: 30
            parentRegion: @reports
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @standard

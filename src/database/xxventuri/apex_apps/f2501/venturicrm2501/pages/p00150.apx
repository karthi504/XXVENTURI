    pageItem P150_FROM_DATE (
        type: datePickerJquery
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @new-customers
            slot: regionBody
            alignment: left
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            formatMask: DD-Mon-YYYY
            width: 15
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P150_TO_DATE (
        type: datePickerJquery
        label {
            label: "To "
            alignment: left
        }
        layout {
            sequence: 20
            region: @new-customers
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            formatMask: DD-Mon-YYYY
            width: 15
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
        security {
            encryptSessionState: false
        }
    )

    button go (
        buttonName: Go
        label: Go
        layout {
            sequence: 30
            region: @new-customers
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            customAttributes: style="margin-top: 4px; "
        }
    )

    dynamicAction region-refresh (
        name: Region Refresh
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @go
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new-customers
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


page 150 (
    name: New Customers
    title: New Customers
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region accounts (
        name: Accounts
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new-customers (
        name: New Customers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.id,
                  c.row_key,
                    case customer_is_key_account_yn
                      when 'Y' then 'Yes'
                      when 'N' then 'No'
                    end key_account,
                 -- c.customer_stock_symb,
                --  c.customer_duns,
                --  c.customer_sic,
                  c.customer_web_site,
                  --c.customer_facebook,
                  c.customer_linkedin,
                 -- c.customer_twitter,
                  c.customer_description,c.Account_source ,c.GST_NO, 
                  c.tags,
                  c.created,
                  lower(c.created_by) created_by,
                  c.updated,
                  lower(c.updated_by) updated_by,
                  t.id territory_id,
                  t.territory_name,
                  case
                    when c.default_rep_id is not null
                    then (
                      select rep_first_name || ' ' || rep_last_name
                      from eba_sales_salesreps sr
                      where sr.id = c.default_rep_id
                    )
                  end default_rep
                from eba_sales_customers c, eba_sales_territories t
                where  t.id = c.customer_territory_id and c.status='A'
                and c.CREATED BETWEEN :P150_FROM_DATE AND :P150_TO_DATE 
                ```
            pageItemsToSubmit: [
                P150_FROM_DATE
                P150_TO_DATE
            ]
        }
        layout {
            sequence: 20
            parentRegion: @accounts
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 253328675177977112
        }

        column ACCOUNT_SOURCE (
            type: plainText
            heading {
                heading: Source
            }
            layout {
                sequence: 127
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AB
            }
        )


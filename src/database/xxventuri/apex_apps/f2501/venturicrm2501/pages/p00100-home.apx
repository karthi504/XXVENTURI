    region repeat-sales-during-current-month (
        name: Repeat Sales During Current Month
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT month_wise.customer_name,
                       month_wise.product_name,
                       SUM(SP.QUANTITY * SP.PRODUCT_PRICE) AS order_value
                FROM (
                  SELECT DISTINCT so.customer_id,
                                  sc.customer_name,
                                  sp.product_name,
                                  op.product_id
                  FROM xxeba_sales_order so
                  JOIN eba_sales_customers sc ON so.customer_id = sc.id
                  JOIN xxeba_order_products op ON so.order_id = op.order_id
                  JOIN eba_sales_products sp ON op.product_id = sp.id
                  JOIN XXEBA_LIST_VALUES lv ON lv.LIST_ID = so.ORDER_TYPE_ID
                  WHERE lv.LIST_VALUE = 'Repeat Order'
                    AND lv.LIST_CODE = 'SALES_ORDER_TYPE'
                    AND TO_CHAR(TRUNC(so.created), 'Mon') = TO_CHAR(TRUNC(SYSDATE), 'Mon')
                    AND so.created >= TRUNC(CURRENT_DATE, 'MONTH')
                    AND so.created < ADD_MONTHS(TRUNC(CURRENT_DATE, 'MONTH'), 1)
                    AND ((so.sales_rep = NVL(:P100_REPEAT_SALES_ORDER, :USER_ID)
                          AND NOT EXISTS (
                            SELECT 1
                            FROM EBA_SALES_SALESREPS SR
                            JOIN EBA_SALES_SALESREP_ROLES R ON SR.REP_ROLE = R.ID
                            WHERE UPPER(R.ROLE_NAME) IN ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                              AND UPPER(SR.user_name) = :APP_USER
                          ))
                         OR ((so.sales_rep = NVL(:P100_REPEAT_SALES_ORDER, :USER_ID)
                              OR :P100_REPEAT_SALES_ORDER IS NULL)
                             AND so.created_by IN (
                               SELECT UPPER(user_name)
                               FROM eba_sales_salesreps r
                               START WITH r.id = :USER_ID
                               CONNECT BY PRIOR r.id = r.REP_MANAGER_ID
                             )
                             AND EXISTS (
                               SELECT 1
                               FROM EBA_SALES_SALESREPS SR
                               JOIN EBA_SALES_SALESREP_ROLES R ON SR.REP_ROLE = R.ID
                               WHERE UPPER(R.ROLE_NAME) = 'TEAM LEADER - SALES'
                                 AND UPPER(SR.user_name) = :APP_USER
                             ))
                         OR ((so.sales_rep = NVL(:P100_REPEAT_SALES_ORDER, :USER_ID)
                              OR :P100_REPEAT_SALES_ORDER IS NULL)
                             AND EXISTS (
                               SELECT 1
                               FROM EBA_SALES_SALESREPS SR
                               JOIN EBA_SALES_SALESREP_ROLES R ON SR.REP_ROLE = R.ID
                               WHERE UPPER(R.ROLE_NAME) = 'ADMINISTRATOR'
                                 AND UPPER(SR.user_name) = :APP_USER
                             ))
                    )
                  INTERSECT
                  SELECT so.customer_id,
                         sc.customer_name,
                         sp.product_name,
                         op.product_id
                  FROM xxeba_sales_order so
                  JOIN eba_sales_customers sc ON so.customer_id = sc.id
                  JOIN xxeba_order_products op ON so.order_id = op.order_id
                  JOIN eba_sales_products sp ON op.product_id = sp.id
                  JOIN XXEBA_LIST_VALUES lv ON lv.LIST_ID = so.ORDER_TYPE_ID
                  WHERE lv.LIST_VALUE = 'Repeat Order'
                    AND lv.LIST_CODE = 'SALES_ORDER_TYPE'
                    AND TO_CHAR(TRUNC(so.created), 'Mon') = TO_CHAR(TRUNC(SYSDATE), 'Mon')
                    AND so.status != 'X'
                    AND ((so.sales_rep = NVL(:P100_REPEAT_SALES_ORDER, :USER_ID)
                          AND NOT EXISTS (
                            SELECT 1
                            FROM EBA_SALES_SALESREPS SR
                            JOIN EBA_SALES_SALESREP_ROLES R ON SR.REP_ROLE = R.ID
                            WHERE UPPER(R.ROLE_NAME) = 'ADMINISTRATOR'
                              AND UPPER(SR.user_name) = :APP_USER
                          ))
                         OR ((so.sales_rep = NVL(:P100_REPEAT_SALES_ORDER, :USER_ID)
                              OR :P100_REPEAT_SALES_ORDER IS NULL)
                             AND EXISTS (
                               SELECT 1
                               FROM EBA_SALES_SALESREPS SR
                               JOIN EBA_SALES_SALESREP_ROLES R ON SR.REP_ROLE = R.ID
                               WHERE UPPER(R.ROLE_NAME) = 'ADMINISTRATOR'
                                 AND UPPER(SR.user_name) = :APP_USER
                             ))
                    )
                ) month_wise
                JOIN xxeba_sales_order so ON month_wise.customer_id = so.customer_id
                JOIN xxeba_order_products sp ON so.order_id = sp.order_id AND month_wise.product_id = sp.product_id
                WHERE TO_CHAR(TRUNC(so.created), 'Mon') = TO_CHAR(TRUNC(SYSDATE), 'Mon')
                  AND so.created >= TRUNC(CURRENT_DATE, 'MONTH')
                  AND so.created < ADD_MONTHS(TRUNC(CURRENT_DATE, 'MONTH'), 1)
                  AND ((so.sales_rep = NVL(:P100_REPEAT_SALES_ORDER, :USER_ID)
                        AND NOT EXISTS (
                          SELECT 1
                          FROM EBA_SALES_SALESREPS SR
                          JOIN EBA_SALES_SALESREP_ROLES R ON SR.REP_ROLE = R.ID
                          WHERE UPPER(R.ROLE_NAME) = 'ADMINISTRATOR'
                            AND UPPER(SR.user_name) = :APP_USER
                        ))
                       OR ((so.sales_rep = NVL(:P100_REPEAT_SALES_ORDER, :USER_ID)
                            OR :P100_REPEAT_SALES_ORDER IS NULL)
                           AND EXISTS (
                             SELECT 1
                             FROM EBA_SALES_SALESREPS SR
                             JOIN EBA_SALES_SALESREP_ROLES R ON SR.REP_ROLE = R.ID
                             WHERE UPPER(R.ROLE_NAME) = 'ADMINISTRATOR'
                               AND UPPER(SR.user_name) = :APP_USER
                           ))
                  )
                GROUP BY month_wise.customer_name,
                         month_wise.product_name;
                
                ```
            pageItemsToSubmit: P100_REPEAT_SALES_ORDER
        }
        layout {
            sequence: 320
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h480
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        reportLayout {
            numberOfRows: 51
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        download {
            csvExportEnabled: true
        }

        column CUSTOMER_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Customer
            }
            layout {
                sequence: 1
            }
        )

        column ORDER_VALUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Order Value
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column PRODUCT_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Product
            }
            layout {
                sequence: 2
            }
        )

    )


             margin-left: 22px;
                margin-top: 4px;
            }
            
            
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            <h2>About this Application</h2>
            <p>
            	Manage opportunities, track leads, manage accounts and contacts. Opportunities are organized by territory and account. For each opportunity you can track products, competition, team members, and add hypertext links and file attachments. Use interactive reports to slice and dice your pipeline. You can upload leads from spreadsheets and convert leads to opportunities.
            </p>
            ```
    }
    comments {
        comments:
            ```
            $(window).on("theme42ready", function() {
               if ($("body").hasClass("js-navExpanded")) {
               $("#t_Button_navControl").click();
              }
            });
            ```
    }

    region accounts-with-no-orders-for-past-two-months (
        name: Accounts with No Orders for Past Two Months
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    C.ID AS Account_Name,
                    C.DEFAULT_REP_ID,
                    S.SALES_REP AS Sales_Rep_Name,
                    MAX(S.ORDER_DATE) AS last_order_date
                FROM 
                    xxeba_sales_order s,
                    eba_sales_customers c 
                WHERE 
                    C.ID = S.customer_id
                    AND TO_CHAR(S.ORDER_DATE, 'Mon-yyyy') = TO_CHAR(SYSDATE, 'Mon-yyyy')
                    AND S.TALLY_REFERENCE_NUMBER IS NOT NULL 
                    AND S.customer_id NOT IN (
                        SELECT customer_id 
                        FROM xxeba_sales_order
                        WHERE TO_CHAR(ORDER_DATE, 'Mon-yyyy') = TO_CHAR(ADD_MONTHS(SYSDATE, -1), 'Mon-yyyy')
                        AND TALLY_REFERENCE_NUMBER IS NOT NULL 
                    )
                    AND C.STATUS <> 'X'
                  --  AND C.DEFAULT_REP_ID = S.ID
                    AND (
                        UPPER(C.DEFAULT_REP_ID) IN (
                            SELECT UPPER(r.ID)
                            FROM eba_sales_salesreps r
                            START WITH r.id = :USER_ID
                            CONNECT BY PRIOR r.id = r.REP_MANAGER_ID
                        )
                        OR EXISTS (
                            SELECT 'Y'
                            FROM EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR 
                            WHERE R.id = :USER_ID 
                            AND SR.ID = R.REP_ROLE 
                            AND SR.ROLE_NAME = 'Administrator'
                        )
                    )
                GROUP BY 
                    C.ID, S.SALES_REP, C.DEFAULT_REP_ID
                ORDER BY 
                    MAX(S.ORDER_DATE) DESC;
                
                ```
            pageItemsToSubmit: P100_NEW_ACCOUNT_WITHOUT_BILL
        }
        layout {
            sequence: 400
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 51
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }

        column ACCOUNT_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Account Name
            }
            lov {
                type: sharedComponent
                lov: @customers
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column DEFAULT_REP_ID (

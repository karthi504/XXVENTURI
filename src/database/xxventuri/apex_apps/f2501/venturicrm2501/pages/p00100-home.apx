    region sales-revenue (
        name: Sales Revenue
        type: chart
        layout {
            sequence: 280
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h480
                t-Region--scrollBody
                margin-top-md
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
        }
        legend {
            show: false
        }

        series top-5-sales-order (
            name: Top 5 Sales Order
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT SUM(order_value) order_value,
                      month_name,
                      month_id
                    FROM
                      (SELECT (QUANTITY * PRODUCT_PRICE)order_value,
                        TO_CHAR(SO.CREATED, 'Mon-YY')month_name,
                        TO_CHAR(SO.CREATED, 'MM-YY')month_id
                      FROM XXEBA_SALES_ORDER SO,
                        XXEBA_ORDER_PRODUCTS OP
                      WHERE SO.ORDER_ID   = OP.ORDER_ID
                      AND SO.CREATED     >= add_months(TRUNC(sysdate,'MM'),-5)
                      AND SO.TALLY_REFERENCE_NUMBER IS NOT NULL
                      AND SO.STATUS != 'X'
                      AND ((SO.created_by = :APP_USER
                      AND NOT EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                        AND upper(SR.user_name) = :APP_USER
                        ))
                    
                     OR (((SO.created_by = :P100_MONTHWISE_SALEREP OR :P100_MONTHWISE_SALEREP IS NULL) and SO.created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = :APP_USER
                      ))
                           
                      OR ((SO.created_by           = :P100_MONTHWISE_SALEREP
                      OR :P100_MONTHWISE_SALEREP IS NULL)
                      AND EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                        AND upper(SR.user_name) = :APP_USER
                        ) ) )
                      )
                    GROUP BY month_name,
                      month_id
                    ORDER BY to_date(month_name,'Mon-YY') asc
                    --month_id 
                    ```
                pageItemsToSubmit: P100_MONTHWISE_SALEREP
            }
            columnMapping {
                label: MONTH_NAME
                value: ORDER_VALUE
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
            value {
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 2
                pattern: ₹ ##,##,##,###.##
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

    )

    region sales-revenue-by-person (
        name: Sales Revenue by Person
        type: chart
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: 2564105947780700774
        }
        chart {
            type: donut
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No data to display
        }

        series sales-person-by-revenue (
            name: Sales Person by Revenue
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 
                    --sr.REP_LAST_NAME||', '|| 
                    sr.REP_FIRST_NAME||' - '||(select territory_name from eba_sales_territories t where t.id = c.customer_territory_id) label,
                           case when apex_util.get_build_option_status(
                                         p_application_id    => :APP_ID,
                                         p_build_option_name => 'Opportunity Amount Set at Product Level'
                                     ) = 'EXCLUDE' then
                               sum(d.deal_amount)
                           else
                               sum(nvl((select sum(nvl(dp.quote_price, 0.00)) from EBA_SALES_DEAL_PRODUCTS dp where dp.deal_id = d.id), 0))
                           end as value,
                           sr.id sales_rep_id
                      from EBA_SALES_SALESREPS sr,
                           EBA_SALES_DEALS d,
                           EBA_SALES_CUSTOMERS c
                     where d.SALESREP_ID_01 = sr.ID (+)
                       and d.customer_id = c.id 
                    --   and (nvl(:P46_QUARTER,'0') = '0' or d.qtr = :P46_QUARTER)
                    --   and (nvl(:P46_TERRITORY,'0') = '0' or c.customer_territory_id = :P46_TERRITORY)
                    -- and d.deal_close_date between (select min(first_day) from eba_sales_sales_periods where fiscal_year = :P100_FY_OCD) and (select max(last_day) from eba_sales_sales_periods where fiscal_year = :P100_FY_OCD)
                      and d.deal_close_date between to_date('01-01-'||nvl(:P100_FY_OCD,'17'), 'dd-mm-yy') and to_date('01-12-'||nvl(:P100_FY_OCD,'18'), 'dd-mm-yy')
                      and DEAL_PROBABILITY = 100  
                      AND (d.SALESREP_ID_01 in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                      
                     or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                      
                      group by 
                      --sr.REP_LAST_NAME||', '||
                      sr.REP_FIRST_NAME, sr.id, c.customer_territory_id
                    order by 3 desc
                    
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            link {
                type: redirectThisApp
                target: {
                    page: 42
                    items: {
                        IR_TERRITORY_NAME: &TERRITORY.
                        IRC_PRODUCT_QTR: FY&P100_FY_OCD.
                    }
                    clearCache: [
                        42
                        RIR
                    ]
                    action: resetPagination
                }
            }
            label {
                show: true
                position: aboveMarker
                displayAs: percentage
            }
        )

    )


    dynamicAction set-total-order-value-as-on-date (
        name: Set Total Order Value as on date
        execution {
            sequence: 240
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        SELECT TO_CHAR(SUM(NVL(PRD.PRODUCT_PRICE, 0) * NVL(PRD.QUANTITY, 0)), '99G99G99G990D00') 
                        INTO :P100_TOTAL_ORDERS_VALUE
                        FROM XXEBA_ORDER_PRODUCTS PRD, XXEBA_SALES_ORDER ORD
                        WHERE PRD.ORDER_ID = ORD.ORDER_ID
                          AND ORD.SALES_REP = :USER_ID
                          AND ORD.STATUS = 'Y'
                          AND PRD.STATUS = 'Y'
                          AND ORD.CREATED BETWEEN LAST_DAY(ADD_MONTHS(SYSDATE, -1)) + 1 AND SYSDATE;
                    
                        SELECT TO_CHAR(SUM(INVOICE_VALUE), '99G99G99G990D00')  
                        INTO :P100_INVOICE_VALUE
                        FROM (
                            SELECT DISTINCT INVOICE_ID, (-1 * INVOICE_VALUE) AS INVOICE_VALUE
                            FROM XXEBA_TALLY_INVOICES_T
                            WHERE SALES_ORDER_NUMBER IN (
                                SELECT ORDER_NUMBER
                                FROM XXEBA_ORDER_PRODUCTS PRD, XXEBA_SALES_ORDER ORD
                                WHERE PRD.ORDER_ID = ORD.ORDER_ID
                                  AND ORD.SALES_REP = :USER_ID
                                  AND ORD.STATUS = 'Y'
                                  AND PRD.STATUS = 'Y'
                                  AND ORD.CREATED BETWEEN LAST_DAY(ADD_MONTHS(SYSDATE, -1)) + 1 AND SYSDATE
                            )
                        );
                    
                    EXCEPTION
                        WHEN OTHERS THEN 
                            :P100_TOTAL_ORDERS_VALUE := 0;
                            :P100_INVOICE_VALUE := 0;  
                            xxfs_pm_error_log_pkg.record_log('ERROR', 'Total Order Value as on Date HOME PAGE: ' || :P100_TOTAL_ORDERS_VALUE, 'BLOCK 1', :APP_PAGE_ID);
                    END;
                    
                    ```
                itemsToReturn: [
                    P100_TOTAL_ORDERS_VALUE
                    P100_INVOICE_VALUE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-total-orders-as-on-date (
        name: Set Total Orders as on date
        execution {
            sequence: 230
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT
                        COUNT(*) INTO :P100_TOTAL_ORDERS_SCORE
                    FROM
                        XXEBA_SALES_ORDER
                    WHERE
                        SALES_REP = :USER_ID
                        AND STATUS = 'Y'
                        AND CREATED BETWEEN Last_Day(ADD_MONTHS(SYSDATE,-1))+1 AND SYSDATE;
                    EXCEPTION
                        WHEN OTHERS THEN 
                        :P100_TOTAL_ORDERS_SCORE:= NULL;
                        xxfs_pm_error_log_pkg.record_log('ERROR','Total Orders as on Date HOME PAGE: ' || :P100_TOTAL_ORDERS_SCORE,'BLOCK 1',:APP_PAGE_ID);
                    END;
                    ```
                itemsToReturn: P100_TOTAL_ORDERS_SCORE
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-total-score-as-on-date (
        name: Set Total Score as on date
        execution {
            sequence: 220
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_first_month_date	DATE;
                    v_sysdate 			DATE;
                    
                    BEGIN
                    v_first_month_date:= Last_Day(ADD_MONTHS(SYSDATE,-1))+1;
                    
                    select 
                    XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:USER_ID,'Identification',TO_DATE(TO_DATE(v_first_month_date,'DD-MM-YYYY'),'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:USER_ID,'First Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:USER_ID,'Repeat Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:USER_ID,'100% Plan',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:USER_ID,'90% Plan',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:USER_ID,'75% Plan',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:USER_ID,'<50%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))     
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_QUOTE_SUBMISSION(:USER_ID,'Tooling Up',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_QUOTE_SUBMISSION(:USER_ID,'Project',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(:USER_ID,'New Product',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(:USER_ID,'Project',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(:USER_ID,'Price Increase',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(:USER_ID,'First Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(:USER_ID,'Annual Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(:USER_ID,'Schedule Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(:USER_ID,'>50000',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(:USER_ID,'>100000',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(:USER_ID,'Repeat Sales Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:USER_ID,'<20%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:USER_ID,'>20%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:USER_ID,'>30%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:USER_ID,'>50%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    into  :P100_SCORE1 from dual;
                    
                    EXCEPTION WHEN OTHERS THEN
                     v_first_month_date:= NULL;
                     xxfs_pm_error_log_pkg.record_log('ERROR','SCORE 1 HOME PAGE: '||:P100_SCORE1,'BLOCK 1',:APP_PAGE_ID);
                    END;
                    ```
                itemsToReturn: P100_SCORE1
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_first_month_date	DATE;

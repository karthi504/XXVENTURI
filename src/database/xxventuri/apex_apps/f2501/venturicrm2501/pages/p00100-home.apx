        series revenue-by-territories (
            name: Revenue By Territories
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(d.deal_amount) as revenue,
                           t.territory_name as territory
                      from eba_sales_deals d,
                           eba_sales_territories t
                     where d.id in (select id
                                            from eba_sales_deals 
                                           where customer_id in (select id 
                                                                   from eba_sales_customers 
                                                                  where customer_territory_id = t.id)
                                         )
                       and (
                               nvl(:P100_FY_OCD, 0) = 0
                               or
                               d.deal_close_date between (select min(first_day) from eba_sales_sales_periods where fiscal_year = :P100_FY_OCD) and (select max(last_day) from eba_sales_sales_periods where fiscal_year = :P100_FY_OCD)
                           )
                           AND (d.SALESREP_ID_01 in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                      
                     or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                      
                     group by t.territory_name
                    ```
            }
            columnMapping {
                label: TERRITORY
                value: REVENUE
                labelTooltip: TERRITORY

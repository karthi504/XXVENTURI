                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(:USER_ID,'6 Months',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(:USER_ID,'Annual',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 

    pageItem P100_TL_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                SELECT count(*) into :P100_TL_COUNT
                FROM EBA_SALES_CUSTOMERS WHERE STATUS IN ('R','U') 
                AND ID  IN
                  (SELECT id
                  FROM EBA_SALES_CUSTOMERS
                  WHERE  upper(DEFAULT_REP_ID) IN
                    (SELECT upper(r.ID)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID
                    ) );
                    
                if :P100_TL_COUNT > 0 then 
                return :P100_TL_COUNT ;
                else 
                return null;
                end if;
                
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                SELECT count(*) into :P100_REC_COUNT
                FROM XXEBA_SALES_CUSTOMER_DETAILS
                WHERE (EXPECTED_BUSINESS IS NULL
                or CREDIT_LIMIT_REC      IS NULL
                or ASSIGNED_TO           IS NULL
                or RECOMMENDED_BY        IS NULL)
                and  CUSTOMER_ID          IN
                  (SELECT id
                  FROM EBA_SALES_CUSTOMERS
                  WHERE  upper(DEFAULT_REP_ID) IN
                    (SELECT upper(r.ID)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID
                    )  
                  ) ;
                ```
        }
    )


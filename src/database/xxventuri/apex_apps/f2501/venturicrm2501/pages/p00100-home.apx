    pageItem P100_SALES_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                select count(*) into  :P100_SALES_COUNT
                from XXEBA_SALES_ORDER where trunc(NEXT_ORDER_DATE) =trunc(sysdate) and SALES_REP=:USER_ID and STATUS = 'Y';
                if :P100_SALES_COUNT > 0 then 
                return :P100_SALES_COUNT;
                else 
                return null;
                end if;

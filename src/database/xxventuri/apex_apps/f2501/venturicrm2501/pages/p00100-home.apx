    region top-10-orders (
        name: Top 10 Orders
        type: chart
        layout {
            sequence: 260
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h480
                t-Region--scrollBody
                margin-bottom-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 400
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series top-10-sales-order (
            name: Top 10 Sales Order
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select customer_name,sum(Total_Price) as Total_Price 
                    from(
                    
                    SELECT
                    customer_name,
                        product_name,
                        product_price,
                        quantity,
                        Total_Price
                    FROM (
                        SELECT
                        so.order_date,
                        so.PO_DATE,
                            sc.customer_name,
                            product_id,
                            op.product_name,
                            op.product_price,
                            op.delivery_date,
                            op.quantity,
                            op.quantity * op.product_price AS Total_Price
                            -- ROW_NUMBER() OVER (PARTITION BY sc.customer_name ORDER BY op.quantity * op.product_price DESC) AS rn
                        FROM
                            xxeba_sales_order so
                            JOIN xxeba_order_products op ON so.order_id = op.order_id
                            JOIN eba_sales_customers sc ON so.customer_id = sc.id
                        WHERE
                            so.status in ( 'Y','N' ) 
                            AND    to_char(op.delivery_date,'Mon-yyyy') = to_char(sysdate,'Mon-yyyy')
                            and op.status ='Y'
                            AND (
                                (so.sales_rep = NVL(:p100_top_5_sales_orders, :user_id)
                                AND NOT EXISTS (
                                    SELECT 'Y'
                                    FROM
                                        eba_sales_salesreps sr,
                                        eba_sales_salesrep_roles r
                                    WHERE
                                        sr.status = 'Y'
                                        AND sr.rep_role = r.id
                                        AND UPPER(r.role_name) IN ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                                        AND UPPER(sr.user_name) = :app_user
                                ))
                                OR (
                                    (so.sales_rep = NVL(:p100_top_5_sales_orders, :user_id) OR :p100_top_5_sales_orders IS NULL)
                                    AND so.created_by IN (
                                        SELECT UPPER(user_name)
                                        FROM eba_sales_salesreps r
                                        START WITH r.id = :user_id
                                        CONNECT BY PRIOR r.id = r.rep_manager_id
                                    )
                                    AND EXISTS (
                                        SELECT 'Y'
                                        FROM
                                            eba_sales_salesreps sr,
                                            eba_sales_salesrep_roles r
                                        WHERE
                                            sr.rep_role = r.id
                                            AND UPPER(r.role_name) = 'TEAM LEADER - SALES'
                                            AND UPPER(sr.user_name) = :app_user
                                    )
                                )
                                OR (
                                    (so.sales_rep = NVL(:p100_top_5_sales_orders, :user_id) OR :p100_top_5_sales_orders IS NULL)
                                    AND EXISTS (
                                        SELECT 'Y'
                                        FROM
                                            eba_sales_salesreps sr,
                                            eba_sales_salesrep_roles r
                                        WHERE
                                            sr.status = 'Y'
                                            AND sr.rep_role = r.id
                                            AND UPPER(r.role_name) = 'ADMINISTRATOR'
                                            AND UPPER(sr.user_name) = :app_user
                                    )
                                )
                            )
                    ))
                    -- ORDER BY Total_Price DESC)
                    group by customer_name
                    order by Total_Price desc
                    ;
                    
                    ```
                pageItemsToSubmit: P100_TOP_5_SALES_ORDERS
            }
            columnMapping {
                label: CUSTOMER_NAME
                value: TOTAL_PRICE
            }
            appearance {
                color: #4AEB41
            }
            link {
                type: redirectThisApp
                target: {
                    page: 192
                    items: {
                        P192_CUSTOMER_NAME: &CUSTOMER_NAME.
                        P192_PRODUCT_ID: &PRODUCT_ID.
                    }
                    clearCache: 192
                    action: resetPagination
                }
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )


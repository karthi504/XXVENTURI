        column LEAVE_TYPE_ID (
            reportColumnQueryId: 20
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Leave Type
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  LIST_VALUE as d,
                    LIST_ID as r
                    from XXEBA_LIST_VALUES where LIST_CODE='LEAVE_TYPE' and STATUS='Y' order by DISPLAY_SEQUENCE
                    ```

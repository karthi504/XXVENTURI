    region high-profit-sales (
        name: High Profit Sales
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (
                  SELECT 
                    sc.customer_name,
                    sp.product_name,
                    op.quantity,
                    op.product_price,
                    (op.product_price * op.quantity) AS order_value,
                    ROUND(((op.product_price - sp.product_cost) / sp.product_cost) * 100, 2) AS profit_sales_percentage
                  FROM xxeba_sales_order so,
                       xxeba_order_products op,
                       eba_sales_products sp,
                       eba_sales_customers sc
                  WHERE so.order_id = op.order_id
                    AND op.product_id = sp.id
                    AND so.customer_id = sc.id
                    AND so.created >= ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -2)
                    AND so.status != 'X'
                ) 
                WHERE profit_sales_percentage >0;
                
                ```
        }
        layout {
            sequence: 360
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--scrollBody
                t-Form--slimPadding

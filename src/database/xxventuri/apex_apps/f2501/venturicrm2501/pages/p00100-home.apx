    pageItem P100_ORDER_APPROVAL_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                
                select 
                    count(*) into :P100_ORDER_APPROVAL_COUNT
                
                from XXEBA_SALES_ORDER SO,
                	EBA_SALES_DEALS SD,
                	EBA_SALES_CUSTOMERS SC,
                	EBA_SALES_SALESREPS SR,
                	EBA_SALES_CUSTOMER_LOCATIONS CL,
                	EBA_SALES_CUSTOMER_LOCATIONS CL2,
                --    XXEBA_ORDER_PRODUCTS OP , 
                --    EBA_SALES_PRODUCTS SP, 
                --    EBA_SALES_PRODUCT_FAMILIES SPF ,
                
                    (select
                    ORDER_ID,
                    sum(order_value) order_value,
                    min(DELIVERY_DATE) DELIVERY_DATE  from
                    (
                    select
                    ORDER_ID,
                    QUANTITY,
                    PRODUCT_PRICE,
                    (QUANTITY * PRODUCT_PRICE)order_value,
                    DELIVERY_DATE
                    from
                    XXEBA_ORDER_PRODUCTS
                
                
                
                    )
                    group by ORDER_ID)value
                    
                where SO.DEAL_ID = SD.ID  
                 -- and SO.CUSTOMER_ID = SC.ID(+)
                     and SO.CUSTOMER_ID = SC.ID
                 -- and SO.SALES_REP = SR.ID(+)
                  and SO.SALES_REP = SR.ID
                  and SO.DELIVERY_LOCATION = CL.ID(+)
                  and SO.BILLING_LOCATION = CL2.ID (+)
                  and SO.ORDER_ID = value.ORDER_ID(+)
                --   and SO.ORDER_ID = OP.ORDER_ID 
                --   AND OP.PRODUCT_ID = SP.ID 
                --   AND SP.PRODUCT_FAMILY_ID = SPF.ID
                
                
                  AND (upper(SC.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Sales Co-Ordinator'))
                    and SO.STATUS IN ('N');
                  
                if :P100_ORDER_APPROVAL_COUNT > 0 then 
                return :P100_ORDER_APPROVAL_COUNT;
                else 
                return null;
                end if;  
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P100_PRODUCTS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  lv_verified_p   NUMBER;
                  lv_all_products NUMBER;
                BEGIN
                  SELECT COUNT(ID)
                  INTO lv_verified_p
                  FROM EBA_SALES_products
                  WHERE ID IN (SELECT PRODUCT_ID FROM EBA_SALES_VERIFICATIONS) AND STATUS='Y' ;
                  SELECT COUNT(ID) INTO lv_all_products FROM EBA_SALES_products where  STATUS='Y';
                  :P100_PRODUCTS :=lv_all_products-lv_verified_p;
                if :P100_PRODUCTS > 0  then 
                      return :P100_PRODUCTS;
                else 
                return null;
                end if;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P100_REC_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                SELECT count(*) into :P100_REC_COUNT
                FROM EBA_SALES_CUSTOMERS C WHERE NOT EXISTS (select * from  XXEBA_SALES_CUSTOMER_DETAILS D
                where C.ID=D.CUSTOMER_ID) AND STATUS='Y'
                AND ID  IN
                  (SELECT id
                  FROM EBA_SALES_CUSTOMERS
                  WHERE  upper(DEFAULT_REP_ID) IN
                    (SELECT upper(r.ID)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID
                    ) );
                    
                if :P100_REC_COUNT > 0 then 
                return :P100_REC_COUNT ;
                else 
                return null;
                end if;
                
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                SELECT count(*) into :P100_REC_COUNT
                FROM XXEBA_SALES_CUSTOMER_DETAILS
                WHERE (EXPECTED_BUSINESS IS NULL
                or CREDIT_LIMIT_REC      IS NULL
                or ASSIGNED_TO           IS NULL
                or RECOMMENDED_BY        IS NULL)
                and  CUSTOMER_ID          IN
                  (SELECT id
                  FROM EBA_SALES_CUSTOMERS
                  WHERE  upper(DEFAULT_REP_ID) IN
                    (SELECT upper(r.ID)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID
                    )  
                  ) ;
                ```
        }
    )


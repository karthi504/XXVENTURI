    pageItem P100_SO_REJECTED_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                select count(*) into  :P100_SO_REJECTED_COUNT
                from XXEBA_SALES_ORDER where  SALES_REP=:USER_ID and STATUS = 'R' AND TRUNC(UPDATED) > TRUNC(SYSDATE-3);
                if :P100_SO_REJECTED_COUNT > 0 then 
                return :P100_SO_REJECTED_COUNT;
                else 
                return null;
                end if;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )


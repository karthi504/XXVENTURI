    dynamicAction alert-account-pending-approval (
        name: Alert- Account Pending Approval
        execution {
            sequence: 70
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item>value
            item: P100_UNVALIDATED
            value: 0
        }
        security {
            authorizationScheme: @xxeba-admin
        }

        action plugin-de-danielh-toastrnotifications (
            action: plugin/toastrNotifications
            settings {
                type: error
                text: &P100_UNVALIDATED. New Accounts Pending for your Approval.
                preventDuplicates: true
                timeout: 0
                showDuration: 300
                hideDuration: 1000
            }
            execution {
                sequence: 10
            }
        )

    )


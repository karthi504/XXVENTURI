page 100 (
    name: Opportunity Tracker
    alias: HOME
    title: Dashboard
    pageGroup: @home
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-Footer{
            	display:none;
            }
            
            #HOME_MENU ul li:nth-child(1) a{
            	border-left: 5px solid #309fdb;
            }
            
            #HOME_MENU ul li:nth-child(2) a{
            	border-left: 5px solid #13b6cf;
            }
            

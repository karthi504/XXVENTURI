    region revenue-by-product-family (
        name: Revenue By Product Family
        type: chart
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }

                sqlQuery:
                    ```sql
                    select months, count(*) from (
                                    select to_char(DEAL_CLOSE_DATE,'Mon-YYYY') Months, id from EBA_SALES_DEALS
                                        where DEAL_CLOSE_DATE between to_date('01-01-'||nvl(:P100_FY_OCD,'17'), 'dd-mm-yy') and to_date('01-12-'||nvl(:P100_FY_OCD,'18'), 'dd-mm-yy')
                        AND (SALESREP_ID_01 in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                      
                     or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                      
                                         order by DEAL_CLOSE_DATE)  
                    group by Months;
                    ```

        series revenue-by-quarter (
            name: Revenue By Quarter
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(sum(dp.quote_price), 0) as revenue,
                           dp.qtr as fiscal_quarter,
                           pf.product_family
                      from eba_sales_deal_products dp,
                           eba_sales_products p,
                           eba_sales_product_families pf
                     where dp.product_id = p.id
                       and p.product_family_id = pf.id
                       and dp.qtr is not null
                       and (
                               nvl(:P100_FY_PCD, 0) = 0
                               or
                               dp.close_date between (select min(first_day) from eba_sales_sales_periods where fiscal_year = :P100_FY_PCD) and (select max(last_day) from eba_sales_sales_periods where fiscal_year = :P100_FY_PCD)
                           )
                     group by dp.qtr, pf.product_family
                     order by substr(dp.qtr, -2), substr(dp.qtr, 2)
                    ```
            }
            columnMapping {
                seriesName: PRODUCT_FAMILY
                label: FISCAL_QUARTER
                value: REVENUE
            }
            link {
                type: redirectThisApp
                target: {
                    page: 135
                    items: {
                        IR_PRODUCT_QTR: &QTR.
                    }
                    clearCache: [
                        135
                        RIR
                    ]
                    action: resetPagination
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )


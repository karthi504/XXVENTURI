                end if;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                select count(*) into :P100_VERIFICATION_COUNT  from EBA_SALES_CUSTOMERS where ID  in ( select CUSTOMER_ID from XXEBA_SALES_CUSTOMER_DETAILS 
                where EXPECTED_BUSINESS   IS NOT NULL
                AND CREDIT_LIMIT_REC      IS NOT NULL
                AND  ASSIGNED_TO          IS NOT NULL
                AND RECOMMENDED_BY        IS NOT  NULL ) AND VERIFIED_BY is null ;
                ```
        }
    )


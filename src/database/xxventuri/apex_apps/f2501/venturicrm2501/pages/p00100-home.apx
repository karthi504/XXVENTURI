    region new-accounts-without-billing (
        name: New Accounts without Billing
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT customer_name, sc.created
                FROM eba_sales_customers sc,
                  (SELECT ID AS customer_id FROM eba_sales_customers
                   MINUS
                   SELECT so.customer_id FROM xxeba_sales_order so
                  ) no_sales
                WHERE sc.ID = no_sales.customer_id
                  AND sc.created >= ADD_MONTHS(SYSDATE, -2)
                  AND (
                    (sc.default_rep_id = (SELECT id 
                                          FROM EBA_SALES_SALESREPS 
                                          WHERE upper(user_name) = upper(:APP_USER)
                                          FETCH FIRST 1 ROWS ONLY)
                     AND NOT EXISTS
                       (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                             EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE = R.ID
                          AND Upper(R.ROLE_NAME) IN ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                          AND SR.ID = (SELECT id 
                                       FROM EBA_SALES_SALESREPS 
                                       WHERE upper(user_name) = upper(:APP_USER)
                                       FETCH FIRST 1 ROWS ONLY)
                       )
                    )
                    OR (
                      ((sc.default_rep_id = :P100_NEW_ACCOUNT_WITHOUT_BILL OR :P100_NEW_ACCOUNT_WITHOUT_BILL IS NULL)
                       AND sc.default_rep_id IN (SELECT id
                                                 FROM eba_sales_salesreps r
                                                 START WITH r.id = :USER_ID
                                                 CONNECT BY PRIOR r.id = r.REP_MANAGER_ID))
                      AND EXISTS
                        (SELECT 'Y'
                         FROM EBA_SALES_SALESREPS SR,
                              EBA_SALES_SALESREP_ROLES R
                         WHERE SR.REP_ROLE = R.ID
                           AND Upper(R.ROLE_NAME) = 'TEAM LEADER - SALES'
                           AND upper(SR.user_name) = :APP_USER
                        )
                    )
                    OR (
                      (sc.default_rep_id = :P100_NEW_ACCOUNT_WITHOUT_BILL OR :P100_NEW_ACCOUNT_WITHOUT_BILL IS NULL)
                      AND EXISTS
                        (SELECT 'Y'
                         FROM EBA_SALES_SALESREPS SR,
                              EBA_SALES_SALESREP_ROLES R
                         WHERE SR.REP_ROLE = R.ID
                           AND Upper(R.ROLE_NAME) = 'ADMINISTRATOR'
                           AND SR.ID = (SELECT id 
                                        FROM EBA_SALES_SALESREPS 
                                        WHERE upper(user_name) = upper(:APP_USER)
                                        FETCH FIRST 1 ROWS ONLY)
                        )
                    )
                  )
                  AND SC.status != 'X';
                
                ```
            pageItemsToSubmit: P100_NEW_ACCOUNT_WITHOUT_BILL
        }
        layout {
            sequence: 350
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h480
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 51
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }


    region leave-details (
        name: Leave Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                  L.LEAVE_REQUEST_ID, 
                  L.SALES_REP_ID,
                  L.FROM_DATE,
                  L.TO_DATE,
                  DECODE(TRIM(L.FROM_PERIOD),'FD','Full Day','FN','Forenoon','AN','Afternoon') AS FROM_PERIOD,
                  DECODE(TRIM(L.TO_PERIOD),'FD','Full Day','FN','Forenoon','AN','Afternoon') AS TO_PERIOD,
                  L.NO_OF_DAYS,
                  L.CONTACT_NUMBER,
                  L.CONTACT_ADDRESS,
                  L.LEAVE_REASON,
                  DECODE(TRIM(L.LEAVE_STATUS), 'S','Submitted', 'A','Approved', 'R','Rejected') AS LEAVE_STATUS,
                  L.STATUS,
                  L.CREATED_BY,
                  L.CREATION_DATE,
                  L.UPDATED_BY,
                  L.UPDATE_DATE,
                  L.APPROVED_BY,
                  L.APPROVED_DATE,
                  L.APPROVER_COMMENTS,
                  L.LEAVE_TYPE_ID
                FROM
                  XXEBA_SALES_LEAVE_REQUESTS_T L,
                  EBA_SALES_SALESREPS S
                WHERE
                  L.SALES_REP_ID = S.ID 
                 -- AND TO_CHAR(ADD_MONTHS(SYSDATE, 0), 'Mon-yy') BETWEEN L.FROM_DATE AND L.TO_DATE
                  AND L.TO_DATE >= trunc(ADD_MONTHS(SYSDATE, -24))
                  AND (UPPER(L.SALES_REP_ID) IN (
                        SELECT UPPER(r.ID)
                        FROM eba_sales_salesreps r
                        START WITH r.id = :USER_ID
                        CONNECT BY PRIOR r.id = r.REP_MANAGER_ID
                      ) 
                      OR EXISTS (
                        SELECT 'Y'
                        FROM EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR 
                        WHERE R.id = :USER_ID 
                          AND SR.ID = R.REP_ROLE 
                          AND SR.ROLE_NAME = 'Administrator'
                      )) ORDER BY L.FROM_DATE DESC ;
                
                
                ```
        }
        layout {
            sequence: 390
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--scrollBody
                t-Form--slimPadding
            ]

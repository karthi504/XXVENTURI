    pageItem P100_UNVALIDATED (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                lv_verified number;
                lv_all_customer number;
                begin
                SELECT count(*) into :P100_UNVALIDATED FROM EBA_SALES_CUSTOMERS WHERE STATUS='V';
                
                 if :P100_UNVALIDATED > 0  then 
                      return :P100_UNVALIDATED;
                else 
                return null;
                end if;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                select count(ID) into lv_verified from EBA_SALES_CUSTOMERS where ID in (select CUST_ID from EBA_SALES_VERIFICATIONS) AND STATUS='Y' ;
                select count(ID) into lv_all_customer from EBA_SALES_CUSTOMERS where  STATUS='Y' AND verified_by is not null ;
                    :P100_UNVALIDATED :=lv_all_customer-lv_verified;
                ```
        }
    )


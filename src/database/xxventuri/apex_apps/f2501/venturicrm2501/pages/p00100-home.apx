    region trials-material-value (
        name: Trials  Material Value
        type: chart
        layout {
            sequence: 310
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h480
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: No data to display
        }

        series unit-price-vs-fluets (
            name: Unit Price vs Fluets
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT * FROM (
                        SELECT 
                            TO_CHAR(CREATED_DATE, 'Month-yyyy') AS MONTH,
                            SUM((RECOM_NO_OF_FLUTES * RECOM_UNIT_PRICE) + (RECOM1_NO_OF_FLUTES * RECOM1_UNIT_PRICE)) AS TOTAL_AMOUNT
                        FROM 
                            XXEBA_TRIAL_DETAILS
                        WHERE 
                            STATUS = 'I'
                            -- AND CREATED_DATE >= ADD_MONTHS(TRUNC(SYSDATE, 'MONTH'), -5)
                        GROUP BY 
                            TO_CHAR(CREATED_DATE, 'Month-yyyy')
                        ORDER BY 
                            TO_DATE(MONTH, 'Month-yyyy') desc
                    ) WHERE ROWNUM <= 5
                    order by TO_DATE(MONTH, 'Month-yyyy')  ;
                    
                    ```
                pageItemsToSubmit: P100_TRIAL_UNIT_PRICE_FLUETS
            }
            columnMapping {
                label: MONTH
                value: TOTAL_AMOUNT
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
            value {
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 2
                pattern: Rs ##,##,##,###.##
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

    )


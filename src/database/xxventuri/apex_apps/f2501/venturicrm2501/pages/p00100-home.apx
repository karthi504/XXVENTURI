    region open-leads-by-status (
        name: Open Leads by Status
        type: chart
        layout {
            sequence: 150
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: i-h400
            renderComponents: belowContent
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @leads
        }
        chartLayout {
            height: 330
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
            showValue: false
        }
        legend {
            show: false
        }

        series leads-by-status (
            name: Leads by status
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select slsc.status_code,
                      slsc.display_order,
                      count(*) cnt
                    from eba_sales_leads sl, EBA_SALES_CUSTOMERS c, eba_sales_lead_status_codes slsc
                      where sl.lead_status_id = slsc.id and sl.ACCOUNT_ID=c.id and 
                    
                     (c.DEFAULT_REP_ID in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                      
                     or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                      
                    and sl.lead_status_id not in (1, 5)
                    group by slsc.status_code,
                      slsc.display_order
                    order by slsc.display_order
                    
                    
                    /*select slsc.status_code,
                      slsc.display_order,
                      count(*) cnt
                    from eba_sales_leads sl
                    join eba_sales_lead_status_codes slsc
                      on sl.lead_status_id = slsc.id
                    where sl.lead_status_id not in (1, 5)
                    group by slsc.status_code,
                      slsc.display_order
                    order by slsc.display_order*/
                    ```
            }
            columnMapping {
                label: STATUS_CODE
                value: CNT
            }
            label {
                show: true
            }

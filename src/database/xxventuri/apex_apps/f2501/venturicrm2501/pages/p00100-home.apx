                    BEGIN
                    v_first_month_date:= Last_Day(ADD_MONTHS(SYSDATE,-1))+1;
                    
                    select
                     XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(:USER_ID,'Monthly',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 

                    ```sql
                    select sum(deal_amount) as revenue,
                           qtr
                      from eba_sales_deals
                     where qtr is not null
                       and (
                               nvl(:P100_FY_OCD, 0) = 0
                               or
                               deal_close_date between (select min(first_day) from eba_sales_sales_periods where fiscal_year = :P100_FY_OCD) and (select max(last_day) from eba_sales_sales_periods where fiscal_year = :P100_FY_OCD)
                           )
                           AND (SALESREP_ID_01 in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                      
                     or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                      
                     group by qtr
                     order by substr(qtr, -2), substr(qtr, 2)
                    ```

page 211 (
    name: Data / Table Mapping
    title: Data / Table Mapping
    pageGroup: @administration
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
              .rc-content-main {height: 400px; overflow: auto !important;}
            </style> 
            ```
    }
    security {
        authorizationScheme: @administration-rights
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Map the Target Columns to the Source Columns. You may optionally add format masks to any column mappings before clicking the <strong>Next</strong> button.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region data-load-process-train (
        name: Data Load Process Train
        type: list
        source {
            list: @data-load-process-train-load-opportunities
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsSmall
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region data-table-mapping (
        name: Data / Table Mapping
        type: dataUploadColMapping
        layout {
            sequence: 20
            parentRegion: @data-load-process-train
            slot: wizardSubRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
            regionDisplaySelector: true
        }
        settings {
            dataLoadDefinition: @upload-opportunities
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @data-load-process-train
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @data-load-process-train
            slot: next
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--large
            ]
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 20
            region: @data-load-process-train
            slot: previous
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 210
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prepare-uploaded-data (
        name: Prepare Uploaded Data
        type: prepareUploadedData
        dataLoading {
            dataLoadDefinition: @upload-opportunities
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3241863092766929316
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 212
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)


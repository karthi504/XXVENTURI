            whenButtonPressed: @delete
        }
    )

    process insert-trial-edge-results (
        name: Insert trial Edge Results
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                -- 03-Aug-18 Thamaraiselvan Modified
                
                  CURSOR ccount
                  IS
                    SELECT COUNT(D.TRIAL_ID)no_of_records
                    FROM   XXEBA_TRIAL_EDGE_RESULTS D
                    WHERE  d.trial_id = :P218_TRIAL_ID;
                  rcount ccount%rowtype;
                  
                  CURSOR ccud
                  IS
                    SELECT RECOM_NO_OF_CUTTING_EDGES, 
                           RESULT_AVG_LIFE_EDGE, 
                           RESULT_AVG_CONTACT_TIME, 
                           RESULT_CYLE_TIME_DIFFERENCE, 
                           RESULT_PRODUCTIVITY_IMPROVED, 
                           TRIAL_RESULT,
                           EXIST_AVERAGE_LIFE_PER_EDGE,
                           nvl(EXIST_CYCLE_TIME, 0)EXIST_CYCLE_TIME,
                           RECOM_CYCLE_TIME,
                           nvl(RECOM_UNIT_PRICE, 0)RECOM_UNIT_PRICE,
                           nvl(RECOM1_UNIT_PRICE, 0)RECOM1_UNIT_PRICE,
                           RESULT_PERFORMANCE_IMPROVEMENT,
                           RESULT_COST_COMPONENT_AMOUNT,
                           RESULT_COST_SAVING_AMOUNT, 
                           RESULT_COST_SAVING_PERCENTAGE, 
                           RESULT_MATERIAL_REMOVAL_RATE,
                           EXIST_UNIT_PRICE,
                           (CASE
                            WHEN EXIST_NO_OF_CUTTING_EDGES  > 0
                            AND EXIST_NO_OF_CUTTING_EDGES   > 0
                            AND EXIST_AVERAGE_LIFE_PER_EDGE > 0
                            THEN ROUND((EXIST_UNIT_PRICE / (EXIST_NO_OF_CUTTING_EDGES * EXIST_NO_OF_FLUTES * EXIST_AVERAGE_LIFE_PER_EDGE)), 2)
                            END)EXIST_COST_PER_COMPONENT,
                           --(EXIST_UNIT_PRICE / EXIST_AVERAGE_LIFE_PER_EDGE )EXIST_COST_PER_COMPONENT,       /* Thamaraiselvan Added on 06-Dec-18 */    
                           NO_OF_COMPONENTS_PROD_PER_HOUR,
                           NO_OF_SHIFT_PER_DAY,
                           NO_OF_WORKING_DAYS_PER_WEEK,
                           (( NVL(RECOM_DEPTH_OF_CUT, 0) * NVL(RECOM_WIDTH_OF_CUT, 0) * NVL(RECOM_FEED_PER_TOOTH, 0)) / 1000) MATERIAL_REMOVAL_RATE,
                           (( NVL(RECOM1_DEPTH_OF_CUT, 0) * NVL(RECOM1_WIDTH_OF_CUT, 0) * NVL(RECOM1_FEED_PER_TOOTH, 0)) / 1000) RESULT1_MATERIAL_REMOVAL_RATE,
                           PRODUCT_CLASS_ID,
                           (select product_class_name from xxeba_product_class where id = PRODUCT_CLASS_ID)product_class_name,
                           EXIST_BLADE_AVG_LIFE_NO_OF_COM,
                           EXIST_BLADE_COST_CM2,
                           EXIST_AVERAGE_LIFE_PER_BLADE,
                           RESULT_CONTACT_TIME_PER_BLADE,
                           RESULT_BLADE_LIFE_IN_NOS,
                           RESULT_BLADE_COSTPER_SQ_CM,
                           RESULT_BLADE_LIFE_IN_CM2,
                           RECOM1_NO_OF_CUTTING_EDGES,
                           RECOM1_CYCLE_TIME,
                           RESULT1_AVG_LIFE_EDGE,
                           RESULT1_PERFORM_IMPROVEMENT,
                           RESULT1_AVG_CONTACT_TIME,
                           RESULT1_CYLE_TIME_DIFFERENCE,
                           RESULT1_PRODUCTIVITY_IMPROVED,
                           RESULT1_COST_COMPONENT_AMOUNT,
                           RESULT1_COST_SAVING_PERCENTAGE,
                           RESULT1_COST_SAVING_AMOUNT,
                           RESULT1_CONTACT_TIME_PER_BLADE,
                           RESULT1_BLADE_LIFE_IN_NOS,
                           RESULT1_BLADE_LIFE_IN_CM2,
                           RESULT1_BLADE_COSTPER_SQ_CM,
                           NEW_TRIAL_OR_EXISTING,
                           RECOM_NO_OF_FLUTES,
                           RECOM1_NO_OF_FLUTES
                    FROM   XXEBA_TRIAL_DETAILS
                    WHERE  trim(trial_id) = trim(:P218_TRIAL_ID);
                  rcud ccud%rowtype;
                  
                  v_edge NUMBER := 1;
                  
                BEGIN
                
                  OPEN ccount;
                  FETCH ccount INTO rcount;
                  CLOSE ccount;
                  
                  OPEN ccud;
                  FETCH ccud INTO rcud;
                  CLOSE ccud;
                  
                :P218_PRODUCT_CLASS_ID              := rcud.PRODUCT_CLASS_ID;
                :P218_PRODUCT_CLASS_NAME            := rcud.product_class_name;
                :P218_RECOM_NO_OF_CUTTING_EDGES     := rcud.RECOM_NO_OF_CUTTING_EDGES;
                :P218_RECOM1_NO_OF_CUTTING_EDGE     := rcud.RECOM1_NO_OF_CUTTING_EDGES;
                :P218_RESULT_AVG_LIFE_EDGE          := rcud.RESULT_AVG_LIFE_EDGE;
                :P218_RESULT1_AVG_LIFE_EDGE          := rcud.RESULT1_AVG_LIFE_EDGE;
                :P218_RESULT_AVG_CONTACT_TIME       := rcud.RESULT_AVG_CONTACT_TIME;
                :P218_RESULT_CYLE_TIME_DIFFEREN     := rcud.RESULT_CYLE_TIME_DIFFERENCE;
                :P218_TRIAL_RESULT					:= rcud.TRIAL_RESULT;
                :P218_RESULT_COST_COMP_AMOUNT       := rcud.RESULT_COST_COMPONENT_AMOUNT;
                :P218_RESULT_PERFOR_IMPROVEMENT     := rcud.RESULT_PERFORMANCE_IMPROVEMENT;
                :P218_RESULT_COST_SAVE_PERCENT      := rcud.RESULT_COST_SAVING_PERCENTAGE;
                :P218_EXIST_AVG_LIFE_PER_EDGE       := rcud.EXIST_AVERAGE_LIFE_PER_EDGE;
                :P218_EXIST_CYCLE_TIME              := rcud.EXIST_CYCLE_TIME;
                :P218_RECOM_CYCLE_TIME              := rcud.RECOM_CYCLE_TIME;
                :P218_RECOM1_CYCLE_TIME             := rcud.RECOM1_CYCLE_TIME;
                :P218_EXIST_UNIT_PRICE              := rcud.EXIST_UNIT_PRICE;
                :P218_RECOM_UNIT_PRICE              := rcud.RECOM_UNIT_PRICE;
                :P218_RECOM1_UNIT_PRICE              := rcud.RECOM1_UNIT_PRICE;
                :P218_EXIST_AVG_LIFE_PER_BLADE      := rcud.EXIST_AVERAGE_LIFE_PER_BLADE;
                --:P218_EXIST_BLADE_COST_CM2          := rcud.EXIST_BLADE_COST_CM2;
                :P218_RESULT_CYLE_TIME_DIFFEREN     := (rcud.EXIST_CYCLE_TIME - rcud.RECOM_CYCLE_TIME);
                :P218_RESULT1_CYLE_TIME_DIFFER      := (rcud.EXIST_CYCLE_TIME - rcud.RECOM1_CYCLE_TIME);
                :P218_RECOM_NO_OF_FLUTES            :=  rcud.RECOM_NO_OF_FLUTES;
                :P218_RECOM1_NO_OF_FLUTES           :=  rcud.RECOM1_NO_OF_FLUTES;
                
                IF rcud.NEW_TRIAL_OR_EXISTING = 'E' then
                    :P218_RESULT_PRODUCTIVITY_IMPRO     := round(((rcud.EXIST_CYCLE_TIME - rcud.RECOM_CYCLE_TIME) / :P218_RECOM_CYCLE_TIME) * 100);--ROUND(((rcud.EXIST_CYCLE_TIME - rcud.RECOM_CYCLE_TIME) / :P218_RECOM_CYCLE_TIME) * 100); 
                    :P218_RESULT1_PRODUCTI_IMPRO        := round(((rcud.EXIST_CYCLE_TIME - rcud.RECOM1_CYCLE_TIME) / :P218_RECOM1_CYCLE_TIME) * 100);--ROUND(((rcud.EXIST_CYCLE_TIME - rcud.RECOM_CYCLE_TIME) / :P218_RECOM_CYCLE_TIME) * 100); 
                END IF;
                
                :P218_EXIST_COST_PER_COMPONENT      := rcud.EXIST_COST_PER_COMPONENT;
                :P218_NO_OF_COMP_PROD_PER_HOUR      := rcud.NO_OF_COMPONENTS_PROD_PER_HOUR;
                :P218_NO_OF_SHIFT_PER_DAY           := rcud.NO_OF_SHIFT_PER_DAY;
                :P218_NO_OF_WORK_DAYS_PER_WEEK      := rcud.NO_OF_WORKING_DAYS_PER_WEEK;
                :P218_RESULT_MAT_REMOVAL_RATE       := rcud.MATERIAL_REMOVAL_RATE;
                :P218_RESULT1_MAT_REMOVAL_RATE      := rcud.RESULT1_MATERIAL_REMOVAL_RATE;
                :P218_RESULT_COST_SAVING_AMOUNT     := rcud.RESULT_COST_SAVING_AMOUNT;
                :P218_EXIST_BLADE_AVG_LIFE_COM      := rcud.EXIST_BLADE_AVG_LIFE_NO_OF_COM;
                :P218_RESULT1_PERFOR_IMPROV     := rcud.RESULT1_PERFORM_IMPROVEMENT;
                :P218_RESULT1_AVG_CONTACT_TIME  := rcud.RESULT1_AVG_CONTACT_TIME;
                :P218_RESULT1_CYLE_TIME_DIFFER  := rcud.RESULT1_CYLE_TIME_DIFFERENCE;
                :P218_RESULT1_PRODUCTI_IMPRO    := rcud.RESULT1_PRODUCTIVITY_IMPROVED;
                :P218_RESULT1_COST_COMP_AMOUNT  := rcud.RESULT1_COST_COMPONENT_AMOUNT;
                :P218_RESULT1_COST_SAVE_PERCENT := rcud.RESULT1_COST_SAVING_PERCENTAGE;
                :P218_RESULT1_COST_SAVE_AMOUNT  := rcud.RESULT1_COST_SAVING_AMOUNT;
                :P218_NEW_TRIAL_OR_EXISTING     := rcud.NEW_TRIAL_OR_EXISTING;
                --:P218_RESULT1_MAT_REMOVAL_RATE  := rcud.RESULT1_MATERIAL_REMOVAL_RATE;
                
                if rcud.product_class_name = 'Blades' THEN
                :P218_RESULT_CTC_TIME_PER_BLADE := rcud.RESULT_CONTACT_TIME_PER_BLADE;
                :P218_RESULT_BLADE_LIFE_IN_NOS  := rcud.RESULT_BLADE_LIFE_IN_NOS;
                :P218_RESULT_BLADE_PERF_IMPR    := rcud.RESULT_PERFORMANCE_IMPROVEMENT;
                :P218_RESULT_BLADE_LIFE_IN_CM2  := rcud.RESULT_BLADE_LIFE_IN_CM2;
                :P218_RESULT_AVG_BLADE_CTC_TIME := rcud.RESULT_AVG_CONTACT_TIME;
                :P218_RESULT_BLADE_CYC_TM_DIFF      := (rcud.EXIST_CYCLE_TIME - rcud.RECOM_CYCLE_TIME);
                :P218_RESULT_BLADE_PROD_IMPR        := round((:P218_RESULT_BLADE_CYC_TM_DIFF / rcud.RECOM_CYCLE_TIME) * 100);
                --:P218_RESULT_BLADE_PROD_IMPR    := rcud.RESULT_PRODUCTIVITY_IMPROVED;
                :P218_RESULT_BLADE_COST_SQ_CM   := rcud.RESULT_BLADE_COSTPER_SQ_CM;
                :P218_RESULT_BLD_CT_SAVE_PERCE  := rcud.RESULT_COST_SAVING_PERCENTAGE;
                :P218_RESULT_BLD_CT_SAVING_AMOU := rcud.RESULT_COST_SAVING_AMOUNT;
                :P218_TRIAL_BLADE_RESULT        := rcud.TRIAL_RESULT;
                end if;
                
                if rcud.product_class_name = 'Blades' THEN
                :P218_RESULT1_CTC_TIME_PER_BLD     := rcud.RESULT1_CONTACT_TIME_PER_BLADE;
                :P218_RESULT1_BLADE_LIFE_IN_NOS    := rcud.RESULT1_BLADE_LIFE_IN_NOS;
                :P218_RESULT1_BLADE_PERF_IMPR      := rcud.RESULT1_PERFORM_IMPROVEMENT;
                :P218_RESULT1_BLADE_LIFE_IN_CM2    := rcud.RESULT1_BLADE_LIFE_IN_CM2;
                :P218_RESULT1_AVG_BLD_CTC_TIME     := rcud.RESULT1_AVG_CONTACT_TIME;
                :P218_RESULT1_BLADE_CYC_TM_DIFF    := (rcud.EXIST_CYCLE_TIME - rcud.RECOM1_CYCLE_TIME);
                :P218_RESULT1_BLADE_PROD_IMPR      := round((:P218_RESULT1_BLADE_CYC_TM_DIFF / rcud.RECOM1_CYCLE_TIME) * 100);
                --:P218_RESULT_BLADE_PROD_IMPR    := rcud.RESULT_PRODUCTIVITY_IMPROVED;
                :P218_RESULT1_BLADE_COST_SQ_CM     := rcud.RESULT1_BLADE_COSTPER_SQ_CM;
                :P218_RESULT1_BLD_CT_SAVE_PERCE    := rcud.RESULT1_COST_SAVING_PERCENTAGE;
                :P218_RESULT1_BLD_CT_SAVING_AMT    := rcud.RESULT1_COST_SAVING_AMOUNT;
                :P218_TRIAL_BLADE_RESULT           := rcud.TRIAL_RESULT;
                end if;
                
                  IF rcount.no_of_records = 0 and rcud.product_class_name != 'Blades' THEN
                    FOR i IN 1..rcud.RECOM_NO_OF_CUTTING_EDGES
                    LOOP
                      INSERT
                      INTO XXEBA_TRIAL_EDGE_RESULTS
                        (
                          TRIAL_ID,
                          RESULT_EDGE_NUMBER,
                          RESULT_TOOL_LIFE,
                          RESULT_CONTACT_TIME_PER_EDGE
                        )
                        VALUES
                        (
                          :P218_TRIAL_ID,
                          v_edge,
                          NULL,
                          NULL
                        );
                      v_edge := v_edge + 1;
                    END LOOP;
                  END IF;
                EXCEPTION WHEN OTHERS THEN
                RAISE_APPLICATION_ERROR(-20001, sqlerrm);
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 243288598858288757
        }
    )


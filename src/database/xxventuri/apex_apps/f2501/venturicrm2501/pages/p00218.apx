page 218 (
    name: Trial Result
    title: Trial Result
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function change_toollife(rownum)
            {
                var total_life = 0;
                var v_no_cutting_edges = $v('P218_RECOM_NO_OF_CUTTING_EDGES');
            	var v_avg_life_edge;
                var per_improved;
                var cost_component;
                var cost_saving_percentage;
                $('[id^=pr02_]').each(function() {    // add hours
                    var life = $(this).val();
                    life = parseInt(life) || 0;    // if hours not a number , replace the zero(0).
                    total_life = total_life+parseInt(life);
                });
                                      
                $x('P218_TOOL_LIFE_TOTAL').value = total_life;
                
             if (v_no_cutting_edges > 0)   
             {    
            	v_avg_life_edge = (total_life / v_no_cutting_edges).toFixed(4);	
                $x('P218_RESULT_AVG_LIFE_EDGE').value = v_avg_life_edge;
             }    
                if (($x('P218_EXIST_AVG_LIFE_PER_EDGE').value > 0) && ($x('P218_NEW_TRIAL_OR_EXISTING').value == 'E'))   /* 31-Oct-18 Thamaraiselvan Added */
                    {
                per_improved = (((v_avg_life_edge -  $x('P218_EXIST_AVG_LIFE_PER_EDGE').value) / $x('P218_EXIST_AVG_LIFE_PER_EDGE').value) * 100);
                        $x('P218_RESULT_PERFOR_IMPROVEMENT').value = Math.round(per_improved);
                    }   
                
                /* cost_component = ($v('P218_RECOM_UNIT_PRICE') / (total_life / v_no_cutting_edges)) ; 24-Oct-18 Thamaraiselvan Commented*/ 
                cost_component = ($v('P218_RECOM_UNIT_PRICE') * $v('P218_RECOM_NO_OF_FLUTES') / (total_life));
                $x('P218_RESULT_COST_COMP_AMOUNT').value = cost_component.toFixed(2);
            
             
            
            
                /*
                if isFinite(($v('P218_RECOM_UNIT_PRICE') * $v('P218_RECOM_NO_OF_FLUTES') / (total_life))) == 'false'
                {
                    cost_component = 0;
                }
                */
                cost_saving_percentage = ((($v('P218_EXIST_COST_PER_COMPONENT') - cost_component) / cost_component) * 100);
               if ($x('P218_NEW_TRIAL_OR_EXISTING').value == 'E') /* 31-Oct-18 Thamaraiselvan Added */   
                 {   
                $x('P218_RESULT_COST_SAVE_PERCENT').value = Math.round(cost_saving_percentage) ;    
                $x('P218_RESULT_COST_SAVING_AMOUNT').value = ((((($v('P218_NO_OF_COMP_PROD_PER_HOUR') * 8 )* 
                                                              $v('P218_NO_OF_SHIFT_PER_DAY')) * $v('P218_NO_OF_WORK_DAYS_PER_WEEK')) * 52)
                                                             * ($v('P218_EXIST_COST_PER_COMPONENT') - cost_component)).toFixed(2);  
                 }
            
            
                  if ($x('P218_NEW_TRIAL_OR_EXISTING').value == 'C') /* 03-Sep-25 Dinesh R Added */   
                 {   
                $x('P218_RESULT_COST_SAVE_PERCENT').value = Math.round(cost_saving_percentage) ;    
                $x('P218_RESULT_COST_SAVING_AMOUNT').value = ((((($v('P218_NO_OF_COMP_PROD_PER_HOUR') * 8 )* 
                                                              $v('P218_NO_OF_SHIFT_PER_DAY')) * $v('P218_NO_OF_WORK_DAYS_PER_WEEK')) * 52)
                                                             * ($v('P218_EXIST_COST_PER_COMPONENT') - cost_component)).toFixed(2);  
                 }
            }
            
            function change_contact_time(rownum)
            {
            	var total_contact = 0;
                var v_no_cutting_edges = $v('P218_RECOM_NO_OF_CUTTING_EDGES');
            	
                $('[id^=pr03_]').each(function() {    // add hours
                    var contact = $(this).val();
                    contact = parseInt(contact) || 0;    // if hours not a number , replace the zero(0).
                    total_contact = total_contact+parseInt(contact);
                });
                                      
                $x('P218_CONTACT_TIME_TOTAL').value = total_contact;
            	$x('P218_RESULT_AVG_CONTACT_TIME').value = (total_contact/v_no_cutting_edges).toFixed(2);	
            }
            
            function change_toollife1(rownum)
            {
                var total_life = 0;
                var v_no_cutting_edges = $v('P218_RECOM1_NO_OF_CUTTING_EDGE');
            	var v_avg_life_edge;
                var per_improved;
                var cost_component;
                var cost_saving_percentage;
                $('[id^=pr05_]').each(function() {    // add hours
                    var life = $(this).val();
                    life = parseInt(life) || 0;    // if hours not a number , replace the zero(0).
                   // ALERT(life);
                    total_life = total_life + parseInt(life);
                });
                                      
                $x('P218_TOOL_LIFE_TOTAL').value = total_life;
             if (v_no_cutting_edges > 0)
              {
            	v_avg_life_edge = (total_life / v_no_cutting_edges).toFixed(4);	
                $x('P218_RESULT1_AVG_LIFE_EDGE').value = v_avg_life_edge;
              }
            if (($x('P218_EXIST_AVG_LIFE_PER_EDGE').value > 0) && ($x('P218_NEW_TRIAL_OR_EXISTING').value == 'E'))   /* 31-Oct-18 Thamaraiselvan Added */   
                {
                per_improved = (((v_avg_life_edge -  $x('P218_EXIST_AVG_LIFE_PER_EDGE').value) / $x('P218_EXIST_AVG_LIFE_PER_EDGE').value) * 100);
                $x('P218_RESULT1_PERFOR_IMPROV').value = Math.round(per_improved);
                }
             /*   cost_component = ($v('P218_RECOM_UNIT_PRICE') / (total_life / v_no_cutting_edges)) ; */
                 cost_component = ($v('P218_RECOM1_UNIT_PRICE') * $v('P218_RECOM1_NO_OF_FLUTES') / (total_life)) ;
                $x('P218_RESULT1_COST_COMP_AMOUNT').value = cost_component.toFixed(2);
                cost_saving_percentage = ((($v('P218_EXIST_COST_PER_COMPONENT') - cost_component) / cost_component) * 100);
                
            if ($x('P218_NEW_TRIAL_OR_EXISTING').value == 'E') /* 31-Oct-18 Thamaraiselvan Added */   
                {
                $x('P218_RESULT1_COST_SAVE_PERCENT').value = Math.round(cost_saving_percentage) ;    
                $x('P218_RESULT1_COST_SAVE_AMOUNT').value = ((((($v('P218_NO_OF_COMP_PROD_PER_HOUR') * 8 )* 
                                                              $v('P218_NO_OF_SHIFT_PER_DAY')) * $v('P218_NO_OF_WORK_DAYS_PER_WEEK')) * 52)
                                                             * ($v('P218_EXIST_COST_PER_COMPONENT') - cost_component)).toFixed(2);
                }
            }
            
            function change_contact_time1(rownum)
            {
            	var total_contact = 0;
                var v_no_cutting_edges = $v('P218_RECOM_NO_OF_CUTTING_EDGES');
            	
                $('[id^=pr06_]').each(function() {    // add hours
                    var contact = $(this).val();
                    contact = parseInt(contact) || 0;    // if hours not a number , replace the zero(0).
                    total_contact = total_contact+parseInt(contact);
                });
                                      
                $x('P218_CONTACT_TIME_TOTAL').value = total_contact;
            	$x('P218_RESULT1_AVG_CONTACT_TIME').value = (total_contact/v_no_cutting_edges).toFixed(2);	
            }
            
            
            // number validation in tool life field
            function isNumber(evt) {
                evt = (evt) ? evt : window.event;
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                    return false;
                }
                return true;
            }
            
            //alert($v('P218_TRIAL_RESULT'));
            
            function blade_product_impr() {
                
                var reco_unit_price = $v('P218_RECOM_UNIT_PRICE');
                var blade_life_cm2 = $v('P218_RESULT_BLADE_LIFE_IN_CM2');
                var blade_cost_sq_cm = reco_unit_price / blade_life_cm2;
                var blade_cost_cm2 = $v('P218_EXIST_BLADE_COST_CM2');
                var cost_save_percentage;
                var blade_comp_prod_per_hour;
                var blade_no_of_shift_per_day;
                var calculate;
                var blade_cost_save_amount;
                
                $x('P218_RESULT_BLADE_COST_SQ_CM').value = blade_cost_sq_cm.toFixed(2);
                cost_save_percentage = blade_cost_cm2 - blade_cost_sq_cm;
                $x('P218_RESULT_BLD_CT_SAVE_PERCE').value = cost_save_percentage.toFixed(2);
                blade_no_of_shift_per_day = $v('P218_NO_OF_SHIFT_PER_DAY');
                blade_comp_prod_per_hour = $v('P218_NO_OF_COMP_PROD_PER_HOUR');
                blade_comp_prod_per_hour = (blade_comp_prod_per_hour * 8);
                calculate = (blade_comp_prod_per_hour * blade_no_of_shift_per_day) * 300;
                blade_cost_save_amount = cost_save_percentage * calculate;
                $x('P218_RESULT_BLD_CT_SAVING_AMOU').value = blade_cost_save_amount.toFixed(2);
                
            }
            
            
            function blade_product_impr_result2() {
                
                var reco_unit_price = $v('P218_RECOM1_UNIT_PRICE');
                var blade_life_cm2 = $v('P218_RESULT1_BLADE_LIFE_IN_CM2');
                var blade_cost_sq_cm = (reco_unit_price / blade_life_cm2);
                var blade_cost_cm2 = $v('P218_EXIST_BLADE_COST_CM2');
                var cost_save_percentage;
                var blade_comp_prod_per_hour;
                var blade_no_of_shift_per_day;
                var calculate;
                var blade_cost_save_amount;
                
                $x('P218_RESULT1_BLADE_COST_SQ_CM').value = blade_cost_sq_cm.toFixed(4);
                cost_save_percentage = blade_cost_cm2 - blade_cost_sq_cm;
                $x('P218_RESULT1_BLD_CT_SAVE_PERCE').value = cost_save_percentage.toFixed(2);
                blade_no_of_shift_per_day = $v('P218_NO_OF_SHIFT_PER_DAY');
                blade_comp_prod_per_hour = $v('P218_NO_OF_COMP_PROD_PER_HOUR');
                blade_comp_prod_per_hour = (blade_comp_prod_per_hour * 8);
                calculate = (blade_comp_prod_per_hour * blade_no_of_shift_per_day) * 300;
                blade_cost_save_amount = cost_save_percentage * calculate;
                $x('P218_RESULT1_BLD_CT_SAVING_AMT').value = blade_cost_save_amount.toFixed(2);
                
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
                var avg_life_per_blade;
                var unit_price;
                var blade_cost_cm2;
                unit_price = $v('P218_EXIST_UNIT_PRICE');
                avg_life_per_blade = $v('P218_EXIST_AVG_LIFE_PER_BLADE');
                blade_cost_cm2     = unit_price / avg_life_per_blade;
               $x('P218_EXIST_BLADE_COST_CM2').value = blade_cost_cm2;     
            
            ```
    }

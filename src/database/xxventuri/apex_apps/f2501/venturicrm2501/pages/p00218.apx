    region cutting-tool-trial-result (
        name: Cutting Tool - Trial Result
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                  --APEX_ITEM.HIDDEN(1,EDGE_RESULT_ID) as s_no,
                  EDGE_RESULT_ID,
                  TRIAL_ID,
                 -- RESULT_EDGE_NUMBER,
                  APEX_ITEM.DISPLAY_AND_SAVE(1,RESULT_EDGE_NUMBER) as RESULT_EDGE_NUMBER,
                   APEX_ITEM.TEXT(
                    p_idx         => 2,
                    p_value       => RESULT_TOOL_LIFE,
                    p_size        =>10,
                    p_maxlength   => 10,
                   -- p_attributes  => 'class="p-text-label" onkeypress="return isNumber(event)" onchange="change_toollife('||rownum||')" ',
                    p_attributes  => 'class="p-text-label" onkeypress="return isNumber(event)" oninput="change_toollife('||rownum||')" ', --added by dinesh R on 5-sep-2025
                
                    p_item_id     => 'pr02_'||rownum,
                    p_item_label  => NULL)RESULT_TOOL_LIFE,
                       APEX_ITEM.TEXT(
                    p_idx         => 3,
                    p_value       => RESULT_CONTACT_TIME_PER_EDGE,
                    p_size        => 10,
                    p_maxlength   => 10,
                   -- p_attributes  => 'class="p-text-label" onkeypress="return isNumber(event)" onchange="change_contact_time('||rownum||')" ',
                    p_attributes  => 'class="p-text-label" onkeypress="return isNumber(event)" oninput="change_toollife('||rownum||')" ',--added by dinesh R on 5-sep-2025
                
                    p_item_id     => 'pr03_'||rownum,
                    p_item_label  => NULL)RESULT_CONTACT_TIME_PER_EDGE,
                   STATUS
                FROM XXEBA_TRIAL_EDGE_RESULTS WHERE  TRIAL_ID = :P218_TRIAL_ID;
                ```
            pageItemsToSubmit: P218_TRIAL_ID
        }
        layout {
            sequence: 10
            parentRegion: @recommendation
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: item=value
            item: P218_PRODUCT_CLASS_NAME
            value: Cutting Tools
        }
        reportLayout {
            numberOfRows: 1500
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column EDGE_RESULT_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column RESULT_CONTACT_TIME_PER_EDGE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Contact Time / Edge
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            security {
                escapeSpecialChars: false
            }
        )

        column RESULT_EDGE_NUMBER (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Edge Number
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            security {
                escapeSpecialChars: false
            }
        )

        column RESULT_TOOL_LIFE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Tool Life
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            security {
                escapeSpecialChars: false
            }
        )

        column STATUS (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
        )

        column TRIAL_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

    )


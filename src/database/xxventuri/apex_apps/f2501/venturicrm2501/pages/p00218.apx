    dynamicAction set-performance-improvement (
        name: Set Performance Improvement
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P218_RESULT_AVG_LIFE_EDGE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      V_EXIST_AVERAGE_LIFE_PER_EDGE XXEBA_TRIAL_DETAILS.EXIST_AVERAGE_LIFE_PER_EDGE%type;
                    BEGIN
                      SELECT EXIST_AVERAGE_LIFE_PER_EDGE
                      INTO V_EXIST_AVERAGE_LIFE_PER_EDGE
                      FROM XXEBA_TRIAL_DETAILS
                      WHERE TRIAL_ID                   = :P218_TRIAL_ID;
                     -- raise_application_error(-20001, V_EXIST_AVERAGE_LIFE_PER_EDGE);
                     IF V_EXIST_AVERAGE_LIFE_PER_EDGE > 0 then
                      :P218_RESULT_PERFOR_IMPROVEMENT := (:P218_RESULT_AVG_CONTACT_TIME - V_EXIST_AVERAGE_LIFE_PER_EDGE) / V_EXIST_AVERAGE_LIFE_PER_EDGE;
                      end if;
                    END;
                    ```
                itemsToSubmit: [
                    P218_TRIAL_ID
                    P218_RESULT_AVG_LIFE_EDGE
                ]
                itemsToReturn: P218_RESULT_PERFOR_IMPROVEMENT
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


page 252 (
    name: Attendance Details
    title: Attendance Details
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region attendance-details (
        name: Attendance Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ATT_ID,
                       EMPLOYEE_ID,
                       initcap(EMPLOYEE_NAME) as EMPLOYEE_NAME ,
                       ATTEND_DATE,
                       ATTEND_INTIME,
                       ATTEND_IN_LAT,
                       ATTEND_IN_LONG,
                       ATTEND_OUT_TIME,
                       ATTEND_OUT_LAT,
                       ATTEND_OUT_LONG,
                       CLIENT_IP_ADDRESS,
                       DEVICE_ID,
                       SOURCE_APP,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE,
                       ATTEND_IN_LOCATION as in_location,
                       ATTEND_OUT_LOCATION as out_location,
                       replace(XXEBS_SALES_SECURITY_PKG.get_location_details(ATT_ID,'IN'),',,'  , ',') as start_location,
                       replace(XXEBS_SALES_SECURITY_PKG.get_location_details(ATT_ID,'OUT'),',,' , ',')  as end_location
                    from XXEBA_SALES_ATTENDANCE_T 
                    where initcap(EMPLOYEE_NAME) <>'Admin'
                  ORDER BY ATTEND_DATE DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                select ATT_ID,
                       EMPLOYEE_ID,
                       initcap(EMPLOYEE_NAME) as EMPLOYEE_NAME ,
                       ATTEND_DATE,
                       ATTEND_INTIME,
                       ATTEND_IN_LAT,
                       ATTEND_IN_LONG,
                       ATTEND_OUT_TIME,
                       ATTEND_OUT_LAT,
                       ATTEND_OUT_LONG,
                       CLIENT_IP_ADDRESS,
                       DEVICE_ID,
                       SOURCE_APP,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE,
                       --to_char(ATTEND_INTIME, 'HH:MI PM') || replace(regexp_replace(GET_GEO_LOCATION(ATTEND_IN_LAT,ATTEND_IN_LONG),'[0123456789.]',''),'IN',',')  as in_time_location,
                       --to_char(ATTEND_OUT_TIME, 'HH:MI PM')|| replace(regexp_replace(GET_GEO_LOCATION(ATTEND_OUT_LAT,ATTEND_OUT_LONG),'[0123456789.]',''),'IN',',') as out_time_location
                     /*case when ATTEND_IN_LAT is not null and ATTEND_IN_LONG is not null then
                   replace(replace(replace(regexp_replace(XXEBS_SALES_SECURITY_PKG.GET_GEO_LOCATION(ATTEND_IN_LAT,ATTEND_IN_LONG),'[0123456789.]',''),'IN',','),'Tamil Nadu',''),',','')
                     else null
                     end as in_location,
                     case when ATTEND_OUT_LAT is not null and ATTEND_OUT_LONG is not null then 
                     replace(replace(replace(regexp_replace(XXEBS_SALES_SECURITY_PKG.GET_GEO_LOCATION(ATTEND_OUT_LAT,ATTEND_OUT_LONG),'[0123456789.]',''),'IN',',') ,'Tamil Nadu',''),',','')
                     else null
                     end as 
                     out_location*/
                    from XXEBA_SALES_ATTENDANCE_T where initcap(EMPLOYEE_NAME) <>'Admin'
                  ORDER BY ATTEND_DATE DESC
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {

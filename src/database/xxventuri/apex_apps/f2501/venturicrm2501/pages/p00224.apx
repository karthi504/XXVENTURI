page 224 (
    name: Tool Details
    title: Tool Details
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function isNumber(evt) {
                evt = (evt) ? evt : window.event;
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57) && (charCode != 46)) {
                    return false;
                }
                return true;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region cutting-parameters (
        name: Cutting Parameters
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @tool-details
            slot: wizardSubRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
    )

    region cutting-parameters-blades-exist (
        name: Cutting Parameters Blades - Exist
        type: staticContent
        layout {
            sequence: 60
            parentRegion: @cutting-parameters
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P222_PRODUCT_CLASS
            value: Blades
        }
    )

    region cutting-parameters-tools (
        name: Cutting Parameters Tools
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @cutting-parameters
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item!=value
            item: P222_PRODUCT_CLASS
            value: Blades
        }
    )

    region footer (
        name: Footer
        type: staticContent
        layout {
            sequence: 70
            parentRegion: @tool-details
            slot: wizardSubRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="background: #fafafa;"
        }
    )

    region tool-details (
        name: Tool Details
        type: list
        source {
            list: @wizard-progress-list
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsXSmall
            ]
        }
        componentAppearance {
            listTemplate: @wizard-progress
        }
    )

    region tool-details-2 (
        name: Tool Details
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @tool-details
            slot: wizardSubRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs

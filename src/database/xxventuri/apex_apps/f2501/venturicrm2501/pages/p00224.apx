    validation validate-exist-blade-size (
        name: Validate EXIST_BLADE_SIZE
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  IF :P222_PRODUCT_CLASS = 'Blades' THEN
                    IF :P224_EXIST_BLADE_SIZE IS NULL THEN
                      RETURN 'Please enter blade size';
                    END IF;
                  END IF;
                END;
                ```
        }
        error {
            associatedItem: @P224_EXIST_BLADE_SIZE
        }
    )


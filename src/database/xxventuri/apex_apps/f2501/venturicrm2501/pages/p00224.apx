    dynamicAction set-blade-cost-cm (
        name: Set Blade Cost CM2
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P224_EXIST_BLADE_UNIT_PRICE
                P224_EXIST_AVG_LIFE_PER_BLADE
            ]
        }
        serverSideCondition {
            type: item=value
            item: P222_NEW_EXIST_DEV
            value: E
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    IF :P224_EXIST_AVG_LIFE_PER_BLADE > 0 AND :P224_EXIST_BLADE_UNIT_PRICE IS NOT NULL AND :P224_EXIST_AVG_LIFE_PER_BLADE IS NOT NULL THEN
                      :P224_EXIST_BLADE_COST_CM2     := ROUND(:P224_EXIST_BLADE_UNIT_PRICE / :P224_EXIST_AVG_LIFE_PER_BLADE, 2);
                    ELSE
                      :P224_EXIST_BLADE_COST_CM2 := NULL;
                    END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P224_EXIST_BLADE_UNIT_PRICE
                    P224_EXIST_AVG_LIFE_PER_BLADE
                ]
                itemsToReturn: P224_EXIST_BLADE_COST_CM2
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-cost-per-component (
        name: Set Cost Per Component
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P224_EXIST_UNIT_PRICE
                P224_EXIST_AVERAGE_LIFE_PER_ED
                P224_EXIST_NO_OF_CUTTING_EDGES
            ]
        }
        serverSideCondition {
            type: item=value
            item: P222_NEW_EXIST_DEV
            value: E
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        IF :P224_EXIST_AVERAGE_LIFE_PER_ED > 0  and :P224_EXIST_NO_OF_CUTTING_EDGES > 0 AND :P224_EXIST_UNIT_PRICE> 0THEN
                            :P224_EXIST_COST_PER_COMPONENT := round((:P224_EXIST_UNIT_PRICE/ :P224_EXIST_AVERAGE_LIFE_PER_ED)*(:P224_EXIST_NO_OF_CUTTING_EDGES), 2);
                        END IF;
                    END;
                    
                    
                    
                    ```
                itemsToSubmit: [
                    P224_EXIST_NO_OF_CUTTING_EDGES
                    P224_EXIST_AVERAGE_LIFE_PER_ED
                    P224_EXIST_UNIT_PRICE
                ]
                itemsToReturn: P224_EXIST_COST_PER_COMPONENT
                showProcessing: true
            }
            execution {
                sequence: 10
            }
            comments {
                comments:
                    ```
                    /*  Old Formula
                    BEGIN
                     24-Oct-18 Thamaraiselvan Added 
                    if :P224_EXIST_AVERAGE_LIFE_PER_ED > 0 then
                        :P224_EXIST_COST_PER_COMPONENT := round((:P224_EXIST_UNIT_PRICE / :P224_EXIST_AVERAGE_LIFE_PER_ED), 2) * :P224_EXIST_NO_OF_CUTTING_EDGES;
                    end if;
                    
                    END;
                    */
                    /*BEGIN
                        IF :P224_EXIST_AVERAGE_LIFE_PER_ED > 0 and  :P224_EXIST_NO_OF_CUTTING_EDGES > 0 and :P224_EXIST_NO_OF_FLUTES > 0 then
                            :P224_EXIST_COST_PER_COMPONENT := round( ( :P224_EXIST_UNIT_PRICE / (:P224_EXIST_AVERAGE_LIFE_PER_ED * :P224_EXIST_NO_OF_CUTTING_EDGES * :P224_EXIST_NO_OF_FLUTES)), 2);
                        END IF;
                    END;*/
                    ```
            }
        )

    )

    dynamicAction set-exist-blade-cutting-speed (
        name: Set Exist Blade Cutting Speed
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P224_EXIST_BLADE_SPINDLE_SPEED
                P224_COMP_BLADE_DIAMETER
            ]
        }
        serverSideCondition {
            type: item=value
            item: P222_NEW_EXIST_DEV
            value: E
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                      :P224_EXIST_BLADE_CUTTING_SPEED := (3.14 * NVL(:P224_COMP_BLADE_DIAMETER, 0) * NVL(:P224_EXIST_BLADE_SPINDLE_SPEED, 0))/1000;
                      RETURN :P224_EXIST_BLADE_CUTTING_SPEED;
                    END;
                    ```
                itemsToSubmit: [
                    P224_EXIST_BLADE_SPINDLE_SPEED
                    P224_COMP_BLADE_DIAMETER
                ]
            }
            affectedElements {
                selectionType: items
                items: P224_EXIST_BLADE_CUTTING_SPEED
            }
            execution {
                sequence: 10
            }
        )

    )


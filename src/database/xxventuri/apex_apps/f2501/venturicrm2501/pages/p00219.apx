    region view-products (
        name: View Products
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SEQ_ID ,
                  C001 PRODUCT_NAME ,
                  C002 PRODUCT_TYPE ,
                  C003 PRODUCT_GROUP ,
                  C004 BRAND_NAME ,
                  C005 ORDERING_CODE ,
                  C006 HSN_CODE,
                  C007 TARIFF_CODE,
                  C008 UNIT_PRICE,
                  C009 CURRENCY,
                  C010 PRODUCT_COST,
                  C011 UNIT_OF_MEASURE,
                  C012 LEAD_TIME,
                  C013 MIN_ORDER_QTY,
                  C014 PRODUCT_CLASS,
                  C015 DESCRIPTION,
                  C016 DISCOUNT_PCT,
                  C020 RESULT
                FROM APEX_COLLECTIONS
                WHERE COLLECTION_NAME = 'PRODUCTS_UPLOAD_COLLECTION'
                AND SEQ_ID            > 1; 
                ```
        }
        layout {
            sequence: 1220
            slot: body
        }
        appearance {

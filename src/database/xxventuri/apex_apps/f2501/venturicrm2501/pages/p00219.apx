        }
    )

    process product-validations (
        name: Product Validations
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 Declare 
                cursor p is (select ID from EBA_SALES_products where ID  not in
                (select PRODUCT_ID from EBA_SALES_VERIFICATIONS where PRODUCT_ID in (select ID from EBA_SALES_products)) AND STATUS='Y');
                Begin
                for rec in p
                loop
                insert into EBA_SALES_VERIFICATIONS (ENTITY_TYPE,PRODUCT_ID,VERIFICATION_STATUS) 
                  values ('PRODUCT',rec.ID,'Validated') ;
                end loop;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 206125561985726545
        }
        serverSideCondition {
            whenButtonPressed: @save-data
        }
    )

    process save-collection (
        name: Save_collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_collection_name VARCHAR2(255);
                  V_PRODUCT_TYPE    NUMBER;
                  V_PRODUCT_FAMILY  NUMBER;
                  V_PRODUCT_BRAND   NUMBER;
                  V_PRODUCT_UNIT    NUMBER;
                  V_STOCK_UNIT      NUMBER;
                  V_LEAD_TIME       NUMBER;
                  V_PRODUCT_CLASS   NUMBER;
                  V_ERRORS          VARCHAR2(4000);
                  V_COUNT           NUMBER;
                  lv_product_cost   VARCHAR2(20);
                  LV_UNIT_ID        NUMBER;
                  lv_max_discount_pct NUMBER;
                  CURSOR cpro
                  IS
                    SELECT SEQ_ID ,
                      C001 PRODUCT_NAME,
                      C002 PRODUCT_TYPE,
                      C003 PRODUCT_GROUP,
                      C004 BRAND_NAME,
                      C005 ORDERING_CODE,
                      C006 HSN_CODE,
                      C007 TARIFF_CODE,
                      C008 UNIT_PRICE,
                      C009 CURRENCY,
                      C010 PRODUCT_COST,
                      C011 UNIT_OF_MEASURE,
                      C012 LEAD_TIME,
                      C013 MIN_ORDER_QTY,
                      C014 PRODUCT_CLASS,
                      C015 DESCRIPTION,
                	  C016 DISCOUNT_PCT
                    FROM APEX_COLLECTIONS
                    WHERE COLLECTION_NAME = 'PRODUCTS_UPLOAD_COLLECTION'
                    AND SEQ_ID            > 1;
                  RPRO CPRO%ROWTYPE;
                 
                BEGIN
                  v_collection_name := 'PRODUCTS_UPLOAD_COLLECTION';
                 
                  FOR RPRO IN CPRO
                  LOOP
                    BEGIN
                    
                    BEGIN
                      SELECT product_type_id
                      INTO V_PRODUCT_TYPE
                      FROM xxeba_sales_product_types      
                      WHERE upper(product_type) = upper(rpro.product_type)
                      AND STATUS = 'Y'; /* 02-Nov-18 Thamaraiselvan Added */
                    EXCEPTION WHEN OTHERS THEN
                    V_PRODUCT_TYPE:= NULL;
                    END;
                    
                    BEGIN
                      SELECT id
                      INTO V_PRODUCT_FAMILY
                      FROM eba_sales_product_families
                      WHERE upper(product_family) = upper(rpro.product_group)
                      AND STATUS = 'Y'; /* 02-Nov-18 Thamaraiselvan Added */
                     EXCEPTION WHEN OTHERS THEN
                    V_PRODUCT_FAMILY:= NULL;
                    END;
                    
                    BEGIN
                      SELECT brand_id
                      INTO V_PRODUCT_BRAND
                      FROM xxeba_sales_product_brands
                      WHERE upper(brand_name) = upper(rpro.brand_name)
                      AND STATUS = 'Y'; /* 02-Nov-18 Thamaraiselvan Added */
                    EXCEPTION WHEN OTHERS THEN
                    V_PRODUCT_BRAND:= NULL;
                    END;
                    
                    BEGIN
                      SELECT unit_id
                      INTO V_PRODUCT_UNIT
                      FROM xxeba_sales_units
                      WHERE upper(unit_name) = upper(rpro.unit_of_measure)
                      AND STATUS = 'Y'; /* 02-Nov-18 Thamaraiselvan Added */
                	EXCEPTION WHEN OTHERS THEN
                    V_PRODUCT_UNIT:= NULL;
                    END;  
                      
                     BEGIN
                      SELECT stock_id
                      INTO V_LEAD_TIME
                      from xxeba_stock_codes
                      WHERE (STOCK_CODE)   = (rpro.lead_time)
                      AND STATUS = 'Y'; /* 02-Nov-18 Thamaraiselvan Added */
                     EXCEPTION WHEN OTHERS THEN
                    V_LEAD_TIME:= NULL;
                    END;   
                      
                     BEGIN
                     select id into V_PRODUCT_CLASS 
                	  from xxeba_product_class WHERE upper(product_class_name) = upper(rpro.PRODUCT_CLASS) 
                	  AND STATUS = 'Y'; /* 02-Nov-18 Thamaraiselvan Added */
                      EXCEPTION WHEN OTHERS THEN
                    V_PRODUCT_CLASS:= NULL;
                    END;
                    
                    BEGIN
                      SELECT COUNT(*) into v_count from EBA_SALES_PRODUCTS 
                      WHERE trim(PRODUCT_NAME) = trim(RPRO.PRODUCT_NAME) 
                      AND trim(CATALOGUE_NO) = trim(RPRO.ORDERING_CODE) 
                      AND STATUS = 'Y';  /* 02-Nov-18 Thamaraiselvan Added */
                	EXCEPTION WHEN OTHERS THEN
                    v_count:= 0;
                    END;  
                
                
                   BEGIN
                	SELECT unit_id INTO LV_UNIT_ID FROM xxeba_sales_units
                      WHERE upper(unit_name) = upper('Nos');
                    EXCEPTION WHEN OTHERS THEN
                    LV_UNIT_ID:= NULL;
                    END;
                    
                	BEGIN
                	    SELECT unit_id INTO V_STOCK_UNIT FROM xxeba_sales_units
                      WHERE upper(unit_name) = upper('Pack');
                    EXCEPTION WHEN OTHERS THEN
                    V_STOCK_UNIT:= NULL;
                    END;
                      
                     BEGIN
                     select nvl(NUM_VALUE,0) into lv_max_discount_pct  
                      from XXEBA_SALES_PARAMETERS_T where CODE='MAX_DISCOUNT' 
                      AND STATUS='Y';
                    EXCEPTION WHEN OTHERS THEN
                    lv_max_discount_pct:= NULL;
                    END;
                    
                    
                      IF V_COUNT >= 1 THEN
                      
                      
                              APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Product already exists');
                      END IF;
                	  
                    
                	 IF V_COUNT = 0 and RPRO.PRODUCT_COST is  null and RPRO.DISCOUNT_PCT is  null  THEN
                
                              APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Product Not Uploaded');
                     END IF;
                      
                      IF V_COUNT = 0 and RPRO.MIN_ORDER_QTY  is null  THEN
                
                             APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Product Not Uploaded');
                     END IF;
                     
                   
                    
                      IF V_COUNT = 0 and RPRO.PRODUCT_NAME IS NOT NULL AND (RPRO.PRODUCT_TYPE IS NOT NULL AND V_PRODUCT_TYPE IS NOT NULL) AND (RPRO.BRAND_NAME IS NOT NULL AND V_PRODUCT_BRAND IS NOT NULL)
                      AND RPRO.PRODUCT_COST is not null  and RPRO.MIN_ORDER_QTY is not null  THEN  	
                
                       IF TO_NUMBER(RPRO.UNIT_PRICE) > TO_NUMBER(RPRO.PRODUCT_COST)  THEN 
                
                        INSERT
                        INTO EBA_SALES_PRODUCTS
                          (
                            PRODUCT_NAME,
                            PRODUCT_TYPE_ID,
                            PRODUCT_FAMILY_ID,
                            BRAND_ID,
                            CATALOGUE_NO,
                            PRODUCT_SKU,
                            TARIFF_CODE,
                            PRODUCT_PRICE,
                            CURRENCY_TYPE,
                            PRODUCT_COST,
                            PRODUCT_CURRENCY_TYPE,
                            UNIT_OF_MEASURE,
                            STOCK_ID,
                            MINIMUM_ORDER_QUANTITY,
                            PRODUCT_DESCRIPTION,
                            PRODUCT_CLASS_ID,
                			STOCK_UOM,
                			PACK_QUANTITY
                          )
                          VALUES
                          (
                            RPRO.PRODUCT_NAME,
                            V_PRODUCT_TYPE,
                            V_PRODUCT_FAMILY,
                            V_PRODUCT_BRAND,
                            RPRO.ORDERING_CODE,
                            RPRO.HSN_CODE,
                            RPRO.TARIFF_CODE,
                            RPRO.UNIT_PRICE,
                            RPRO.CURRENCY,
                            RPRO.PRODUCT_COST,
                            RPRO.CURRENCY,
                			DECODE(UPPER(trim(RPRO.UNIT_OF_MEASURE)),
                			             'NOS',V_PRODUCT_UNIT,
                						 'PACK',LV_UNIT_ID),
                            V_LEAD_TIME,
                            DECODE(UPPER(trim(RPRO.UNIT_OF_MEASURE)), 
                			        'NOS', RPRO.MIN_ORDER_QTY,
                                    'PACK', NULL),
                            RPRO.DESCRIPTION,
                            V_PRODUCT_CLASS,
                			DECODE(UPPER(trim(RPRO.UNIT_OF_MEASURE)),
                			             'PACK',V_PRODUCT_UNIT,
                						 'NOS',LV_UNIT_ID),
                			DECODE(UPPER(trim(RPRO.UNIT_OF_MEASURE)), 
                			        'NOS', null,
                                    'PACK', RPRO.MIN_ORDER_QTY)
                          );
                     APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Uploaded');
                     ELSIF  TO_NUMBER(RPRO.UNIT_PRICE) <= TO_NUMBER(RPRO.PRODUCT_COST)  THEN 
                
                          APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Actual Price should be greater than Product Cost.');
                    END IF;
                   
                     ELSIF V_COUNT = 0 and RPRO.PRODUCT_NAME IS NOT NULL AND (RPRO.PRODUCT_TYPE IS NOT NULL AND V_PRODUCT_TYPE IS NOT NULL) AND (RPRO.BRAND_NAME IS NOT NULL AND V_PRODUCT_BRAND IS NOT NULL) 
                	  AND  RPRO.PRODUCT_COST is null AND RPRO.DISCOUNT_PCT is not null and RPRO.MIN_ORDER_QTY is not null  THEN
                
                    lv_product_cost := (round((nvl(nvl( RPRO.UNIT_PRICE,0),0) - (nvl( RPRO.UNIT_PRICE,0)) * ((nvl(RPRO.DISCOUNT_PCT,0) / 100))),2));
                       IF to_number(RPRO.DISCOUNT_PCT) <= to_number(lv_max_discount_pct)  and  to_number(RPRO.DISCOUNT_PCT) > 0  THEN
                
                       INSERT
                        INTO EBA_SALES_PRODUCTS
                          (
                            PRODUCT_NAME,
                            PRODUCT_TYPE_ID,
                            PRODUCT_FAMILY_ID,
                            BRAND_ID,
                            CATALOGUE_NO,
                            PRODUCT_SKU,
                            TARIFF_CODE,
                            PRODUCT_PRICE,
                            CURRENCY_TYPE,
                            PRODUCT_COST,
                            PRODUCT_CURRENCY_TYPE,
                            UNIT_OF_MEASURE,
                            STOCK_ID,
                            MINIMUM_ORDER_QUANTITY,
                            PRODUCT_DESCRIPTION,
                            PRODUCT_CLASS_ID,
                			DISCOUNT_PCT,
                			STOCK_UOM,
                			PACK_QUANTITY
                          )
                          VALUES
                          (
                            RPRO.PRODUCT_NAME,
                            V_PRODUCT_TYPE,
                            V_PRODUCT_FAMILY,
                            V_PRODUCT_BRAND,
                            RPRO.ORDERING_CODE,
                            RPRO.HSN_CODE,
                            RPRO.TARIFF_CODE,
                            RPRO.UNIT_PRICE,
                            RPRO.CURRENCY,
                            TO_NUMBER(lv_product_cost), --RPRO.PRODUCT_COST,
                            RPRO.CURRENCY,
                            DECODE(UPPER(trim(RPRO.UNIT_OF_MEASURE)),
                			             'NOS',V_PRODUCT_UNIT,
                						 'PACK',LV_UNIT_ID),
                            V_LEAD_TIME,
                           DECODE(UPPER(trim(RPRO.UNIT_OF_MEASURE)), 
                			        'NOS', RPRO.MIN_ORDER_QTY,
                                    'PACK', NULL),
                            RPRO.DESCRIPTION,
                            V_PRODUCT_CLASS,
                			RPRO.DISCOUNT_PCT,
                			DECODE(UPPER(trim(RPRO.UNIT_OF_MEASURE)),
                			             'PACK',V_PRODUCT_UNIT,
                						 'NOS',LV_UNIT_ID),
                			DECODE(UPPER(trim(RPRO.UNIT_OF_MEASURE)), 
                			        'NOS', '',
                                    'PACK', RPRO.MIN_ORDER_QTY)
                
                			
                          );
                     APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Uploaded');
                     ELSIF to_number(RPRO.DISCOUNT_PCT) >  to_number(lv_max_discount_pct) THEN
                      APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Discount % is not between the valid range of 1 and '||lv_max_discount_pct||'.');
                      ELSIF to_number(RPRO.DISCOUNT_PCT) <=0 THEN
                      APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Discount % is not between the valid range of 1 and '||lv_max_discount_pct||'.');
                      END IF;
                      END IF;
                    EXCEPTION
                    WHEN OTHERS THEN
                      -- V_ERRORS := ''
                  APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE ( p_collection_name => 'PRODUCTS_UPLOAD_COLLECTION', p_seq => rpro.SEQ_ID, p_attr_number => 20, p_attr_value => 'Product Not Uploaded');
                    END;
                
                  END LOOP;
                END; 
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Imported successfully!!!!!
        }
        advanced {
            executionMappingIdentifier: 249314187854790557
        }
        serverSideCondition {
            whenButtonPressed: @save-data
        }
    )


        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 2987792 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATION_DATE (
                sequence: 2
            )

            displayColumn FROM_DATE (
                sequence: 3
            )

            displayColumn LEAVE_REASON (
                sequence: 7
            )

            displayColumn LEAVE_TYPE_ID (
                sequence: 6
            )

            displayColumn NO_OF_DAYS (
                sequence: 5
            )

            displayColumn SALES_REP_ID (
                sequence: 1
            )

            displayColumn TO_DATE (
                sequence: 4
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 257
                clearCache: 257
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


page 254 (
    name: Holidays
    title: Holidays
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region holidays (
        name: Holidays
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
        }
    )

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                HOLIDAYS_ID ,  
                HOLIDAY_DATE,  
                WEEKDAY  ,     
                HOLIDAY_NAME  ,
                HOLIDAY_TYPE , 
                decode(STATUS, 'Y', 'Enabled', 'N','Disabled') STATUS,        
                CREATED_BY  ,  
                CREATION_DATE ,
                UPDATED_BY  ,  
                UPDATE_DATE   
                from 
                XXEBA_SALES_HOLIDAYS_T
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 255
                items: {
                    P255_HOLIDAYS_ID: #HOLIDAYS_ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 298417823044052836
        }

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATION_DATE (
            type: plainText
            heading {
                heading: Creation Date
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column HOLIDAYS_ID (
            type: hidden
            heading {
                heading: Holidays Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column HOLIDAY_DATE (
            type: plainText
            heading {
                heading: Date
                alignment: center
            }
            layout {
                sequence: 15
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column HOLIDAY_NAME (
            type: plainText
            heading {
                heading: Holiday Name
            }
            layout {
                sequence: 35
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column HOLIDAY_TYPE (
            type: plainTextBasedOnLov
            heading {
                heading: Holiday Type
            }
            lov {
                lov: @xx-holidays-lov
            }
            layout {
                sequence: 45
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 55
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column UPDATE_DATE (
            type: plainText
            heading {
                heading: Update Date
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column WEEKDAY (
            type: plainText
            heading {
                heading: Day
            }
            layout {
                sequence: 25
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 2984225 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn HOLIDAY_DATE (
                sequence: 2
            )

            displayColumn HOLIDAY_NAME (
                sequence: 1
            )

            displayColumn HOLIDAY_TYPE (
                sequence: 3
            )

            displayColumn STATUS (
                sequence: 5
            )

            displayColumn WEEKDAY (
                sequence: 4
            )

        )

    )

    pageItem P254_CONTACT_NUMBER (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @report
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P254_SMS_OTP (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @report
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @holidays
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 255
                clearCache: 255
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


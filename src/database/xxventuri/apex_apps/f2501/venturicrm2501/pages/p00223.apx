    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @component-details
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Are you sure want to Cancel?', 'CANCEL');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel-2 (

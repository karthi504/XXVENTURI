            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS_1
        label: Previous
        layout {
            sequence: 30
            region: @footer
            slot: previous
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous-2 (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 30
            region: @component-details
            slot: previous
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 224 When Existing or New Development
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 224
                clearCache: 224
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('NEXT','NEXT_1') and :P222_NEW_EXIST_DEV = 'N'
        }
    )

    branch (
        name: Go To 217
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 217
                action: resetPagination
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CANCEL,CANCEL_1
        }
    )

    branch (
        name: Go To Page 222
        execution {
            sequence: 10
            point: validating
        }
        behavior {
            target: {
                page: 222
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: PREVIOUS,PREVIOUS_1
        }
    )

    branch (
        name: Go To Page 224
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 224
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('NEXT','NEXT_1') and :P222_NEW_EXIST_DEV = 'E'
        }
    )

    branch (
        name: Go To Page 224 When Competition  Replacement
        execution {
            sequence: 40
        }
        behavior {
            target: {
                page: 224
                clearCache: 224
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('NEXT','NEXT_1') and :P222_NEW_EXIST_DEV = 'C'
        }
    )

)


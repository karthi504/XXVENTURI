page 223 (
    name: Component Details
    title: Component Details
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function isNumber(evt) {
                evt = (evt) ? evt : window.event;
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57) && (charCode != 46)) {
                    return false;
                }
                return true;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region component-details (
        name: Component Details
        type: list
        source {
            list: @wizard-progress-list
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsXSmall
            ]
        }
        componentAppearance {
            listTemplate: @wizard-progress
        }
    )

    region component-details-2 (
        name: Component Details
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @component-details
            slot: wizardSubRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
    )

    region dimensions-in-mm (
        name: Dimensions in MM
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @component-details
            slot: wizardSubRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
    )

    region footer (
        name: Footer
        type: staticContent
        layout {
            sequence: 60
            parentRegion: @component-details
            slot: wizardSubRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="background: #fafafa;"
        }
    )

    region machine-details (
        name: Machine Details
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @component-details
            slot: wizardSubRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
    )

    pageItem P223_CHUCK_DIAMETER (
        type: numberField

page 221 (
    name: Product Class Details
    title: Product Class Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-xxeba-product-class (
        name: Form on XXEBA_PRODUCT_CLASS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P221_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-xxeba-product-class
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P221_PRODUCT_CLASS_CODE (
        type: textField
        label {
            label: Class Code
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @form-on-xxeba-product-class
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_CLASS_CODE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P221_PRODUCT_CLASS_NAME (
        type: textField
        label {
            label: Class Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @form-on-xxeba-product-class
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_CLASS_NAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P221_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @xx-status-lov
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @form-on-xxeba-product-class
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P221_ID
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P221_TAX_PERCENT (
        type: numberField
        label {
            label: Tax %
            alignment: left
        }
        settings {
            minValue: 0
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @form-on-xxeba-product-class
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: TAX_PERCENT
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create Class
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P221_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Save Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P221_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 249347659434502349
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-xxeba-product-class (
        name: Fetch Row from XXEBA_PRODUCT_CLASS
        type: autoRowFetch
        source {
            tableName: XXEBA_PRODUCT_CLASS
            pkColumn: ID
            pkItem: P221_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 249346504556502348
        }
    )

    process process-row-of-xxeba-product-class (
        name: Process Row of XXEBA_PRODUCT_CLASS
        type: autoRowProcessing
        target {
            tableName: XXEBA_PRODUCT_CLASS
            pkColumn: ID
            pkItem: P221_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 249346855438502348
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 249347272896502348
        }
    )

)


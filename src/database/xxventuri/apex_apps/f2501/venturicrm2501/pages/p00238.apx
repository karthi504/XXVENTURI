    region sales-orders (
        name: Sales Orders
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select SO.ORDER_NUMBER "Sales Orders",
                SO.ORDER_DATE "DATE",
                T.TERRITORY_NAME "Branch",
                C.CUSTOMER_CODE "PartyAccountCode",
                'A' "PriceList",
                R.REP_LAST_NAME||' '||R.REP_LAST_NAME "Executive",
                0 "ShippingDiffBilling",
                '"'||L.CUSTOMER_ADDRESS1||', '||L.CUSTOMER_ADDRESS2||', '||CT.CITY_NAME||', '||ST.STATE||', '||CN.COUNTRY_NAME||', '||L.CUSTOMER_POSTAL_CODE||'"' "ShippingAddress",
                '' "Remarks",
                OP.PRODUCT_NAME "ProductCode",
                OP.QUANTITY "Quantity",
                SP.PRODUCT_PRICE "UnitRate",
                '' "DiscountBasis1",
                '' "Discount1",
                '' "TaxStructure",
                '' "Comments",
                '' "ReferenceBillNo",
                '' "ReferenceBillDate",
                'Nearest Integer' "RoundOffType",
                 trunc((((sp.PRODUCT_PRICE - sp.PRODUCT_COST    )/sp.PRODUCT_COST) * 100),2)  as margin
                
                
                from
                XXEBA_ORDER_PRODUCTS OP,
                XXEBA_SALES_ORDER SO,
                EBA_SALES_TERRITORIES T,
                EBA_SALES_CUSTOMERS C,
                EBA_SALES_SALESREPS R,
                EBA_SALES_CUSTOMER_LOCATIONS L,
                XXEBA_SALES_CITIES_T CT,
                EBA_SALES_STATES ST,
                EBA_SALES_COUNTRIES CN,
                EBA_SALES_PRODUCTS SP
                where 
                OP.ORDER_ID = SO.ORDER_ID
                and SO.TERRITORY_ID = T.ID(+)
                and SO.CUSTOMER_ID = C.ID
                and SO.SALES_REP = R.ID
                and SO.DELIVERY_LOCATION = L.ID
                and L.CITY_ID = CT.CITY_ID
                and L.STATE_ID = ST.ID
                and L.COUNTRY_ID = CN.ID
                and OP.PRODUCT_NAME = SP.PRODUCT_NAME
                --and SO.ORDER_DATE between :P238_FROM_DATE and :P238_TO_DATE
                order by SO.ORDER_NUMBER desc;
                ```
            pageItemsToSubmit: [
                P238_FROM_DATE
                P238_TO_DATE
            ]
        }
        layout {
            sequence: 20
            slot: body
            columnAttributes: style="display:none"
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: EXPORT
        }

                and a.ID	= b.PRODUCT_FAMILY_ID ;
                IF v_count > 20 AND v_count < 29 
                THEN return true;
                end if;
                exception when others then
                return null;
                end;
                
                
                :user_id = '137298143222078860106005067972256867714'
                
                

    region report-sysadmin (
        name: Report  sysadmin
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 SELECT
                    so.order_id,
                    so.order_number,
                    so.deal_id,
                    sd.deal_name,
                    so.customer_id,
                    sc.customer_name ,
                    so.territory_id,
                    so.sales_rep,
                    sr.rep_first_name || ' ' || sr.rep_last_name rep_name,
                    so.order_date,
                    so.po_number,
                    so.po_date,
                    so.reference,
                    (
                        SELECT customer_location_name
                        FROM eba_sales_customer_locations
                        WHERE id = so.billing_location
                    ) customer_billing_location,
                    so.billing_location,
                    cl.customer_location_name billing,
                    so.delivery_location,
                    cl2.customer_location_name delivery,
                    so.order_frequency,
                    so.next_order_date,
                    so.status,
                    to_char(so.created AT TIME ZONE 'Asia/Calcutta', 'DD-Mon-YYYY HH:MI PM') AS created,
                    value.order_value,
                    value.delivery_date,
                    value.margin,
                    value.product_group,
                    CASE
                        WHEN so.export_flag IN ('Y', 'P') THEN 'Imported'
                        ELSE 'New'
                    END AS new_imported_flag,
                    (
                        SELECT get_amount_pkg.get_total_outstanding(sc.row_key)
                        FROM dual
                    ) total_outstanding,
                    (
                        SELECT get_amount_pkg.get_overdue_amount(sc.row_key)
                        FROM dual
                    ) overdue_amount
                FROM
                    xxeba_sales_order so
                    JOIN eba_sales_deals sd ON so.deal_id = sd.id
                    JOIN eba_sales_customers sc ON so.customer_id = sc.id
                    JOIN eba_sales_salesreps sr ON so.sales_rep = sr.id
                    LEFT JOIN eba_sales_customer_locations cl ON so.delivery_location = cl.id
                    LEFT JOIN eba_sales_customer_locations cl2 ON so.billing_location = cl2.id
                  LEFT   JOIN (
                        SELECT
                            op.order_id,
                            SUM(op.quantity * op.product_price) order_value,
                            MIN(sp.margin) margin,
                            sp.product_group,
                            MIN(op.delivery_date) delivery_date
                        FROM
                            xxeba_order_products op
                            JOIN eba_sales_products sp ON op.product_id = sp.id
                            JOIN eba_sales_product_families spf ON spf.id = sp.product_family_id
                       WHERE  --sp.margin <= spf.manager_limit 
                             ( CASE
                                WHEN ( sp.margin < spf.manager_limit  and (SELECT 'Y' 
                                     FROM EBA_SALES_SALESREPS SR
                                     JOIN EBA_SALES_SALESREP_ROLES R ON SR.REP_ROLE = R.ID
                                     WHERE SR.status = 'Y'
                                     AND SR.ID = :USER_ID
                                      --sr.id ='137298143222070397625267765568033924482'
                                     AND R.ROLE_NAME IN  ('Sales Co-Ordinator', 'Administrator') )='Y')
                
                                     THEN to_char(:user_id)
                                
                                ELSE NULL
                             END
                             
                             ) = :user_id
                  
                        GROUP BY
                            op.order_id,
                           sp.product_group
                    )  value ON so.order_id = value.order_id
                WHERE
                    so.status IN ('N')
                 AND   so.created BETWEEN ADD_MONTHS(SYSDATE, -2) AND SYSDATE
                
                ORDER BY
                    so.order_id;
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                 select 'Y' From EBA_SALES_SALESREPS SR,
                EBA_SALES_SALESREP_ROLES R
                where sr.REP_ROLE = r.ID
                and sr.id in (select sales_team from EBA_SALES_PRODUCT_FAMILIES where sales_team =:user_id)
                and sr.status='Y'
                and  r.ROLE_NAME= 'Administrator'
                ```
        }
        security {
            authorizationScheme: @xxeba-admin
        }
        comments {
            comments:
                ```
                declare
                v_count number;
                begin
                select MANAGER_LIMIT into v_count from EBA_SALES_PRODUCT_FAMILIES a, eba_sales_products b where a.MANAGER_ID = :app_user
                
                and a.ID	= b.PRODUCT_FAMILY_ID ;
                IF v_count > 20 AND v_count < 29 
                THEN return true;
                end if;
                exception when others then
                return null;
                end;
                
                
                 select 'Y' from EBA_SALES_SALESREPS SR,
                EBA_SALES_SALESREP_ROLES R
                where sR.REP_ROLE = R.ID
                and sr.id in (select sales_team from EBA_SALES_PRODUCT_FAMILIES where sales_team =:user_id)
                and sr.status='Y'
                and  r.ROLE_NAME= 'Administrator'
                
                //
                
                SELECT
                    'Y'
                FROM
                    eba_sales_product_families
                WHERE
                        sales_team = :user_id
                    AND sales_team IN (
                        SELECT
                            sr.id
                        FROM
                            eba_sales_salesreps sr, eba_sales_salesrep_roles r
                        WHERE
                                sr.rep_role = r.id
                            AND sr.status = 'Y'
                            AND r.role_name = 'Administrator'
                    )
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 266
                items: {
                    P266_ORDER_ID: #ORDER_ID#
                    P266_DEAL_ID: #DEAL_ID#
                    P266_EXPORTED_FLAG: #NEW_IMPORTED_FLAG#
                    P266_SOURCE_PAGE: 238
                    P266_BILLING_LOCATION: #BILLING_LOCATION#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }

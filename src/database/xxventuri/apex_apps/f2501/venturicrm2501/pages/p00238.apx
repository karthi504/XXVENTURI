    region report-user (
        name: Report  user
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    SO.ORDER_ID, 
                    SO.ORDER_NUMBER,
                    SO.DEAL_ID,
                    SD.DEAL_NAME,
                    SO.CUSTOMER_ID,
                    SC.CUSTOMER_NAME,
                    SO.TERRITORY_ID,
                    SO.SALES_REP,
                    SR.REP_FIRST_NAME || ' ' || SR.REP_LAST_NAME REP_NAME,
                    SO.ORDER_DATE,
                    SO.PO_NUMBER,
                    SO.PO_DATE,
                    SO.REFERENCE,
                    (SELECT CUSTOMER_LOCATION_NAME FROM EBA_SALES_CUSTOMER_LOCATIONS WHERE ID = SO.BILLING_LOCATION) CUSTOMER_BILLING_LOCATION,
                    SO.BILLING_LOCATION,
                    CL.CUSTOMER_LOCATION_NAME BILLING,
                    SO.DELIVERY_LOCATION,
                    CL2.CUSTOMER_LOCATION_NAME DELIVERY,
                    SO.ORDER_FREQUENCY,
                    SO.NEXT_ORDER_DATE,
                    SO.STATUS,
                    TO_CHAR(SO.CREATED AT TIME ZONE 'Asia/Calcutta', 'DD-Mon-YYYY HH:MI PM') AS CREATED,
                    value.order_value,
                    value.DELIVERY_DATE,
                    value.margin,
                    value.PRODUCT_GROUP,
                    CASE
                        WHEN SO.EXPORT_FLAG IN ('Y', 'P') THEN 'Imported'
                        ELSE 'New'
                    END AS new_imported_flag,
                    (SELECT get_amount_pkg.get_total_outstanding(SC.ROW_KEY) FROM DUAL) TOTAL_OUTSTANDING,
                    (SELECT get_amount_pkg.get_overdue_amount(SC.ROW_KEY) FROM DUAL) OVERDUE_AMOUNT
                FROM XXEBA_SALES_ORDER SO
                JOIN EBA_SALES_DEALS SD ON SO.DEAL_ID = SD.ID
                JOIN EBA_SALES_CUSTOMERS SC ON SO.CUSTOMER_ID = SC.ID
                JOIN EBA_SALES_SALESREPS SR ON SO.SALES_REP = SR.ID
                LEFT JOIN EBA_SALES_CUSTOMER_LOCATIONS CL ON SO.DELIVERY_LOCATION = CL.ID
                LEFT JOIN EBA_SALES_CUSTOMER_LOCATIONS CL2 ON SO.BILLING_LOCATION = CL2.ID
                JOIN (
                    SELECT
                        OP.ORDER_ID,
                        SUM(OP.QUANTITY * OP.PRODUCT_PRICE) order_value,
                        MIN(SP.margin) margin,
                        SP.PRODUCT_GROUP,
                        MIN(OP.DELIVERY_DATE) DELIVERY_DATE
                    FROM XXEBA_ORDER_PRODUCTS OP,
                         eba_sales_products SP ,
                         EBA_SALES_PRODUCT_FAMILIES spf ,
                         XXEBA_SALES_ORDER SO1,
                         EBA_SALES_SALESREPS SR1
                
                    WHERE  OP.PRODUCT_ID = SP.ID
                    AND    spf.id = SP.PRODUCT_FAMILY_ID
                    AND    OP.ORDER_ID = SO1.ORDER_ID
                    AND    SO1.SALES_REP = SR1.ID
                   -- AND    SR1.REP_MANAGER_ID IN ( select REP_MANAGER_ID from EBA_SALES_SALESREPS where id =:user_id )
                    AND  spf.manager_id =  (case when (
                              (SELECT 'Y'
                            FROM EBA_SALES_SALESREPS R
                            JOIN EBA_SALES_SALESREP_ROLES SR ON SR.ID = R.REP_ROLE
                            WHERE R.ID = :USER_ID
                            AND SR.ROLE_NAME in ('Sales Co-Ordinator', 'Administrator')) ='Y' ) then 
                
                            to_char(spf.manager_id)
                            else 
                            to_char(:user_id)
                            end )
                    AND spf.manager_id IS NOT NULL
                    and  sp.MARGIN >= spf.MANAGER_LIMIT 
                   and sp.margin < spf.margin_percentage
                    GROUP BY OP.ORDER_ID, SP.PRODUCT_GROUP
                ) value ON SO.ORDER_ID = value.ORDER_ID
                WHERE 
                     SO.STATUS IN ('N')
                ORDER BY SO.ORDER_ID;
                
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql

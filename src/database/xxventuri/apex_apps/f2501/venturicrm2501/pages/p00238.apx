                --         SELECT
                --             sr.id
                --         FROM
                --             eba_sales_salesreps sr, eba_sales_salesrep_roles r
                --         WHERE
                --                 sr.rep_role = r.id
                --             AND sr.status = 'Y'
                --             AND r.role_name = 'Administrator'
                --     )
                
                 select 'Y' 
                 from   EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                where sR.REP_ROLE = R.ID
                and sr.id =:user_id
                and sr.status='Y'
                and  r.ROLE_NAME= 'Administrator'
                ```
        }
        comments {

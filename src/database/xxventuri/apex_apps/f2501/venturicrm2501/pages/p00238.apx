    region report-user-2 (
        name: Report user
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    SO.ORDER_ID, 
                    SO.ORDER_NUMBER,
                    SO.DEAL_ID,
                    SD.DEAL_NAME,
                    SO.CUSTOMER_ID,
                    SC.CUSTOMER_NAME,
                    SO.TERRITORY_ID,
                    SO.SALES_REP,
                    SR.REP_FIRST_NAME || ' ' || SR.REP_LAST_NAME REP_NAME,
                    SO.ORDER_DATE,
                    SO.PO_NUMBER,
                    SO.PO_DATE,
                    SO.REFERENCE,
                    (SELECT CUSTOMER_LOCATION_NAME FROM EBA_SALES_CUSTOMER_LOCATIONS WHERE ID = SO.BILLING_LOCATION) CUSTOMER_BILLING_LOCATION,
                    SO.BILLING_LOCATION,
                    CL.CUSTOMER_LOCATION_NAME BILLING,
                    SO.DELIVERY_LOCATION,
                    CL2.CUSTOMER_LOCATION_NAME DELIVERY,
                    SO.ORDER_FREQUENCY,
                    SO.NEXT_ORDER_DATE,
                    SO.STATUS,
                    TO_CHAR(SO.CREATED AT TIME ZONE 'Asia/Calcutta', 'DD-Mon-YYYY HH:MI PM') AS CREATED,
                    value.order_value,
                    value.DELIVERY_DATE,
                    value.margin,
                    value.PRODUCT_GROUP,
                    CASE
                        WHEN SO.EXPORT_FLAG IN ('Y', 'P') THEN 'Imported'
                        ELSE 'New'
                    END AS new_imported_flag,
                    (SELECT get_amount_pkg.get_total_outstanding(SC.ROW_KEY) FROM DUAL) TOTAL_OUTSTANDING,
                    (SELECT get_amount_pkg.get_overdue_amount(SC.ROW_KEY) FROM DUAL) OVERDUE_AMOUNT
                FROM XXEBA_SALES_ORDER SO
                JOIN EBA_SALES_DEALS SD ON SO.DEAL_ID = SD.ID
                JOIN EBA_SALES_CUSTOMERS SC ON SO.CUSTOMER_ID = SC.ID
                JOIN EBA_SALES_SALESREPS SR ON SO.SALES_REP = SR.ID
                LEFT JOIN EBA_SALES_CUSTOMER_LOCATIONS CL ON SO.DELIVERY_LOCATION = CL.ID
                LEFT JOIN EBA_SALES_CUSTOMER_LOCATIONS CL2 ON SO.BILLING_LOCATION = CL2.ID
                JOIN (
                    SELECT
                        OP.ORDER_ID,
                        SUM(OP.QUANTITY * OP.PRODUCT_PRICE) order_value,
                        MIN(SP.margin) margin,
                        SP.PRODUCT_GROUP,
                        MIN(OP.DELIVERY_DATE) DELIVERY_DATE
                    FROM XXEBA_ORDER_PRODUCTS OP
                    JOIN eba_sales_products SP ON OP.PRODUCT_ID = SP.ID
                    JOIN EBA_SALES_PRODUCT_FAMILIES spf ON spf.id = SP.PRODUCT_FAMILY_ID
                    WHERE spf.manager_id =:user_id
                    AND spf.manager_id IS NOT NULL
                    and  sp.MARGIN >= spf.MANAGER_LIMIT 
                    and sp.margin < spf.margin_percentage
                    GROUP BY OP.ORDER_ID, SP.PRODUCT_GROUP
                ) value ON SO.ORDER_ID = value.ORDER_ID
                WHERE 
                    (UPPER(SC.DEFAULT_REP_ID) IN (
                        SELECT UPPER(r.ID)
                        FROM eba_sales_salesreps r
                        START WITH r.id = :USER_ID
                        CONNECT BY PRIOR r.id = r.REP_MANAGER_ID
                    ) OR EXISTS (
                        SELECT 'Y'
                        FROM EBA_SALES_SALESREPS R
                        JOIN EBA_SALES_SALESREP_ROLES SR ON SR.ID = R.REP_ROLE
                        WHERE R.id = :USER_ID
                        AND SR.ROLE_NAME = 'Administrator'
                    ) OR EXISTS (
                        SELECT 'Y'
                        FROM EBA_SALES_SALESREPS R
                        JOIN EBA_SALES_SALESREP_ROLES SR ON SR.ID = R.REP_ROLE
                        WHERE R.id = :USER_ID
                        AND SR.ROLE_NAME = 'Sales Co-Ordinator'
                    ))
                    AND SO.STATUS IN ('Y')
                ORDER BY SO.ORDER_ID;
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments:
                ```
                declare
                v_manager_limit number;
                v_margin number;
                begin
                select Mb.ANAGER_LIMIT,a.MARGIN into v_manager_limit, v_margin from EBA_SALES_PRODUCT_FAMILIES a, eba_sales_products b where a.MANAGER_ID = :app_user
                
                and a.ID= b.PRODUCT_FAMILY_ID ;
                IF v_manager_limit > v_margin THEN return true;
                end if;
                exception when others then
                return null;
                end;
                
                
                declare
                v_manager_limit number;
                v_margin number;
                begin
                select distinct A.MANAGER_LIMIT, b.MARGIN 
                into v_manager_limit, v_margin 
                
                 from EBA_SALES_PRODUCT_FAMILIES a, eba_sales_products b 
                where a.MANAGER_ID = 137298143222078860106005067972256867714
                and a.ID= b.PRODUCT_FAMILY_ID ;
                IF v_margin <= v_manager_limit THEN return true;-- dd
                end if;
                exception when others then
                return null;
                end;
                
                ===============================================================
                select 
                SO.ORDER_ID, 
                SO.ORDER_NUMBER,
                SO.DEAL_ID,
                SD.DEAL_NAME,
                SO.CUSTOMER_ID,
                SC.CUSTOMER_NAME,
                SO.TERRITORY_ID,
                SO.SALES_REP,
                SR.REP_FIRST_NAME||' '||SR.REP_LAST_NAME REP_NAME,
                SO.ORDER_DATE,
                SO.PO_NUMBER,
                SO.PO_DATE,
                SO.REFERENCE,
                (select CUSTOMER_LOCATION_NAME from  EBA_SALES_CUSTOMER_LOCATIONS  where ID=SO.BILLING_LOCATION) CUSTOMER_BILLING_LOCATION,
                SO.BILLING_LOCATION,
                CL.CUSTOMER_LOCATION_NAME BILLING,
                SO.DELIVERY_LOCATION,
                CL2.CUSTOMER_LOCATION_NAME DELIVERY,
                SO.ORDER_FREQUENCY,
                SO.NEXT_ORDER_DATE,
                SO.STATUS,
                --SO.CREATED
                 to_char(SO.CREATED at time zone 'Asia/Calcutta', 'DD-Mon-YYYY HH:MI PM') as CREATED,
                order_value,
                
                
                DELIVERY_DATE,
                margin,
                manager_id,
                MANAGER_LIMIT,
                PRODUCT_GROUP,
                
                 (
                  CASE
                    WHEN EXPORT_FLAG IN ('Y', 'P')
                    THEN 'Imported'
                    ELSE 'New'
                  END ) new_imported_flag,   /* Thamaraiselvan Added on 18-Oct-18 */
                (SELECT get_amount_pkg.get_total_outstanding(SC.ROW_KEY) FROM DUAL) TOTAL_OUTSTANDING,
                (SELECT get_amount_pkg.get_overdue_amount(SC.ROW_KEY) FROM DUAL) OVERDUE_AMOUNT
                
                from XXEBA_SALES_ORDER SO,
                	EBA_SALES_DEALS SD,
                    -- XXEBA_ORDER_PRODUCTS OP,
                    -- EBA_SALES_PRODUCTS SP,
                	EBA_SALES_CUSTOMERS SC,
                	EBA_SALES_SALESREPS SR,
                	EBA_SALES_CUSTOMER_LOCATIONS CL,
                	EBA_SALES_CUSTOMER_LOCATIONS CL2,
                	
                    (select
                    ORDER_ID,
                    sum(order_value) order_value,
                    MIN(margin) MARGIN,
                    PRODUCT_GROUP,
                	manager_id,
                    min(DELIVERY_DATE) DELIVERY_DATE,
                    MANAGER_LIMIT
                      from
                    (
                   
                select
                   OP.ORDER_ID,
                    OP.QUANTITY,
                   OP.PRODUCT_PRICE,
                    (OP.QUANTITY * OP.PRODUCT_PRICE)order_value,
                     SP.margin,
                    DELIVERY_DATE,
                    PRODUCT_GROUP,
                	  spf.manager_id,
                      MANAGER_LIMIT
                    from
                    XXEBA_ORDER_PRODUCTS OP ,eba_sales_products SP , EBA_SALES_PRODUCT_FAMILIES spf
                    WHERE OP. PRODUCT_ID=SP.ID and spf.id =sp.PRODUCT_FAMILY_ID	
                    and spf.manager_id ='137298143222078860106005067972256867714' and spf.manager_id is not null
                    )
                    group by ORDER_ID,PRODUCT_GROUP,manager_id,MANAGER_LIMIT)value
                    
                where SO.DEAL_ID = SD.ID  
                
                -- and OP.ORDER_ID = SO.ORDER_ID
                -- and  OP.PRODUCT_NAME = SP.PRODUCT_NAME
                 -- and SO.CUSTOMER_ID = SC.ID(+)
                     and SO.CUSTOMER_ID = SC.ID
                 -- and SO.SALES_REP = SR.ID(+)
                  and SO.SALES_REP = SR.ID
                 -- and sp.product_group = 
                  and SO.DELIVERY_LOCATION = CL.ID(+)
                  and SO.BILLING_LOCATION = CL2.ID (+)
                  and SO.ORDER_ID = value.ORDER_ID(+)
                  AND (upper(SC.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Sales Co-Ordinator'))
                   and SO.STATUS IN ('Y')
                order by  SO.ORDER_ID
                  
                
                ```
        }

page 238 (
    name: Order Approvals
    title: Order Approvals
    appearance {
        pageTemplate: @standard
        templateOptions: [
            
                ```
                DECLARE    
                  BEGIN  
                    SELECT  trunc((((sp.PRODUCT_PRICE - sp.PRODUCT_COST    )/sp.PRODUCT_COST) * 100),2)  as margin
                    FROM eba_sales_products 
                
                        FOR c IN (SELECT n001 order_products_id, 
                                  n002  order_id, 
                                  c001  product_name, 
                                  n003 product_price, 
                                  c002 currency_type, 
                                  n004 brand_id,  
                                  c003 quantity, 
                                  c004 delivery_date,
                                  n005 product_id 
                                  FROM apex_collections WHERE collection_name = 'PRODUCT_COLLECTION')
                         LOOP
                           if c.order_products_id is null then
                           INSERT INTO XXEBA_ORDER_PRODUCTS (ORDER_PRODUCTS_ID, 
                											 ORDER_ID, 
                											 PRODUCT_NAME, 
                											 PRODUCT_PRICE, 
                											 CURRENCY_TYPE, 
                											 BRAND_ID,
                                                             QUANTITY,
                                                             DELIVERY_DATE,
                                                             PRODUCT_ID
                											)
                                                      VALUES (c.order_products_id,
                                                              
                ```
            
                ```
                P266_ORDER_ID,
                                                              c.product_name,
                                                              c.product_price,
                                                              c.currency_type,
                											  c.brand_id,
                                                              c.quantity,
                                                              c.delivery_date,
                                                              c.product_id
                                                              );
                              else 
                                   UPDATE XXEBA_ORDER_PRODUCTS 
                                           SET ORDER_ID = c.order_id, 
                                                     PRODUCT_NAME = c.product_name, 
                                                     PRODUCT_PRICE = c.product_price, 
                                                     CURRENCY_TYPE = c.currency_type, 
                                                     BRAND_ID = c.brand_id,
                                                     QUANTITY = c.quantity,
                                                     DELIVERY_DATE = TO_DATE(c.delivery_date,'DD/MM/RRRR'),
                                                     PRODUCT_ID=c.product_id
                                                     
                				  WHERE ORDER_PRODUCTS_ID = c.order_products_id;
                           end if;
                        END LOOP; 
                          EXCEPTION
                    WHEN OTHERS THEN
                     xxfs_pm_error_log_pkg.record_log('ERROR-So1','MSK_Tools_Quotation_Email-so1',NULL,4); 
                  
                
                END;
                
                ```
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }

                select 'Y' from eba_sales_product_families
                where :user_id in (MANAGER_ID)
                 and :user_id not in(select sr.id from EBA_SALES_SALESREPS SR,
                EBA_SALES_SALESREP_ROLES R
                where SR.REP_ROLE = R.ID
                and  r.ROLE_NAME= 'Administrator')
                
                //
                 select 'Y' from EBA_SALES_SALESREPS SR,
                EBA_SALES_SALESREP_ROLES R
                where sR.REP_ROLE = R.ID
                and sr.id  in (select sales_team from EBA_SALES_PRODUCT_FAMILIES where sales_team =:user_id)
                and sr.status='Y'
                and  r.ROLE_NAME= 'Administrator'
                

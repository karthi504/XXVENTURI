    region leave (
        name: Leave
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                ( select  REP_FIRST_NAME||' '|| REP_LAST_NAME from EBA_SALES_SALESREPS sal where sal.id = L.SALES_REP_ID) as "Sales Rep ",
                L.LEAVE_REQUEST_ID, 
                L.FROM_DATE,
                L.TO_DATE,
                DECODE(TRIM(L.FROM_PERIOD),'FD','Full Day','FN','Forenoon','AN','Afternoon') as FROM_PERIOD,
                DECODE(TRIM(L.TO_PERIOD),'FD','Full Day','FN','Forenoon','AN','Afternoon') as TO_PERIOD,
                L.NO_OF_DAYS,
                L.CONTACT_NUMBER,
                L.LEAVE_REASON,
                decode(TRIM(L.LEAVE_STATUS), 'S','Submitted', 'A','Approved', 'R','Rejected')  LEAVE_STATUS,
                L.STATUS,
                L.APPROVED_BY,
                L.APPROVED_DATE,
                L.APPROVER_COMMENTS,
                L.LEAVE_TYPE_ID
                from XXEBA_SALES_LEAVE_REQUESTS_T L,EBA_SALES_SALESREPS S 
                where LEAVE_STATUS='S'
                and L.SALES_REP_ID=S.ID 
                and S.REP_MANAGER_ID =:USER_ID order by FROM_DATE desc ;
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @nbsp
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [

    region pending-for-approval (
        name: Pending for Approval
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                SO.ORDER_ID, 
                SO.ORDER_NUMBER,
                SO.DEAL_ID,
                SD.DEAL_NAME,
                SO.CUSTOMER_ID,
                SC.CUSTOMER_NAME,
                SO.TERRITORY_ID,
                SO.SALES_REP,
                SR.REP_FIRST_NAME||' '||SR.REP_LAST_NAME REP_NAME,
                SO.ORDER_DATE,
                SO.PO_NUMBER,
                SO.PO_DATE,
                SO.REFERENCE,
                (select CUSTOMER_LOCATION_NAME from  EBA_SALES_CUSTOMER_LOCATIONS  where ID=SO.BILLING_LOCATION) BILLING_LOCATION,
                --SO.BILLING_LOCATION,
                CL.CUSTOMER_LOCATION_NAME BILLING,
                SO.DELIVERY_LOCATION,
                CL2.CUSTOMER_LOCATION_NAME DELIVERY,
                SO.ORDER_FREQUENCY,
                SO.NEXT_ORDER_DATE,
                
                -- (select rep_manager_id 
                -- from eba_sales_salesreps ss
                -- where upper(REP_FIRST_NAME) in 
                --                        (select upper(created_by) 
                --                           from xxeba_sales_order 
                --                          where order_id = so.order_id)) Approve_pending,
                
                --  case 
                --     when sp.MARGIN >= spf.MANAGER_LIMIT 
                --          and sp.margin < spf.margin_percentage 
                --     then spf.manager_id 
                --     else (select ss.id 
                --           from eba_sales_salesreps ss,
                --             EBA_SALES_SALESREP_ROLES SR 
                --           where SR.ID = ss.REP_ROLE 
                --           and ss.id = :USER_ID 
                --           and SR.ROLE_NAME = 'Administrator')
                --  end   approver_pen,
                
                
                (
                  CASE
                     WHEN SO.STATUS='Y'
                    THEN 'New'
                     WHEN SO.STATUS='R'
                    THEN 'Rejected'
                    ELSE 'New'
                  END ) order_status,
                SO.STATUS,
                --SO.CREATED
                 to_char(SO.CREATED at time zone 'Asia/Calcutta', 'DD-Mon-YYYY HH:MI PM') as CREATED,
                 value.order_value,
                 value.DELIVERY_DATE,
                (
                  CASE
                    WHEN EXPORT_FLAG IN ('Y', 'P')
                    THEN 'Imported'
                    ELSE 'New'
                  END ) new_imported_flag ,  /* Thamaraiselvan Added on 18-Oct-18 */
                   decode(SO.UPDATED_IN_TALLY,'Y','Yes','N','No') UPDATED_IN_TALLY,
                   SO.TALLY_REFERENCE_NUMBER,
                (SELECT get_amount_pkg.get_total_outstanding(SC.ROW_KEY) FROM DUAL) TOTAL_OUTSTANDING,
                (SELECT get_amount_pkg.get_overdue_amount(SC.ROW_KEY) FROM DUAL) OVERDUE_AMOUNT
                from XXEBA_SALES_ORDER SO,
                	EBA_SALES_DEALS SD,
                	EBA_SALES_CUSTOMERS SC,
                	EBA_SALES_SALESREPS SR,
                	EBA_SALES_CUSTOMER_LOCATIONS CL,
                	EBA_SALES_CUSTOMER_LOCATIONS CL2,
                --    XXEBA_ORDER_PRODUCTS OP , 
                --    EBA_SALES_PRODUCTS SP, 
                --    EBA_SALES_PRODUCT_FAMILIES SPF ,
                
                    (select
                    ORDER_ID,
                    sum(order_value) order_value,
                    min(DELIVERY_DATE) DELIVERY_DATE  from
                    (
                    select
                    ORDER_ID,
                    QUANTITY,
                    PRODUCT_PRICE,
                    (QUANTITY * PRODUCT_PRICE)order_value,
                    DELIVERY_DATE
                    from
                    XXEBA_ORDER_PRODUCTS
                
                
                
                    )
                    group by ORDER_ID)value
                    
                where SO.DEAL_ID = SD.ID
                 -- and SO.CUSTOMER_ID = SC.ID(+)
                     and SO.CUSTOMER_ID = SC.ID
                 -- and SO.SALES_REP = SR.ID(+)
                  and SO.SALES_REP = SR.ID
                  and SO.DELIVERY_LOCATION = CL.ID(+)
                  and SO.BILLING_LOCATION = CL2.ID (+)
                  and SO.ORDER_ID = value.ORDER_ID(+)
                --   and SO.ORDER_ID = OP.ORDER_ID 
                --   AND OP.PRODUCT_ID = SP.ID 
                --   AND SP.PRODUCT_FAMILY_ID = SPF.ID
                
                
                  AND (upper(SC.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Sales Co-Ordinator'))
                    and SO.STATUS IN ('N')
                    AND   so.created BETWEEN ADD_MONTHS(SYSDATE, -2) AND SYSDATE
                   AND  sr.rep_first_name
                    || ' '
                    || sr.rep_last_name  not in  ('Anand Kumar','Ashok Kumar','Deva Raj','Krishna Kumar',
                                             'Mayil Raj','Sunil Singam','Suresh Raju','Vijay Kumar','Vinoth Anand',
                                             'Yogesh Ananth','Nagaendra Kumar','Rohith Kumar')
                     AND sr.rep_first_name not in 'Dhinesh'
                
                  
                order by  SO.ORDER_ID
                  
                
                ```
        }
        layout {
            sequence: 60
            parentRegion: @tabset
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: pending
            regionDisplaySelector: true
        }

    dynamicAction null-validation (
        name: Null Validation
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @export
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if($v('P102_FROM_DATE') == "" || $v('P102_FROM_DATE') == null){
                        $('#P102_FROM_DATE_error_placeholder').html('<span class="t-Form-error">Please fill out this field.</span>');
                    }
                    else if($v('P102_TO_DATE') == "" || $v('P102_TO_DATE') == null){
                        $('#P102_FROM_DATE_error_placeholder').html('');
                        $('#P102_TO_DATE_error_placeholder').html('<span class="t-Form-error">Please fill out this field.</span>');
                    }
                    else{
                        apex.submit( 'Export');
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction send-sms (
        name: Send SMS
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: request=Value
            value: CREATE_ORDER
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var mob_no = $v('P102_CONTACT_NUMBER');
                    var message = "Dear Customer, We thank you for your Order dated "+$v('P102_PO_DATE')+". Order confirmation No. "+$v('P102_ORDER_NUMBER')+". We will deliver your material soon. Team Venturi";
                    
                    $.ajax({ type: 'GET', url: 'http://103.15.179.45:8085/MessagingGateway/SendTransSMS?Username=vtteam&Password=vtteam@123&MessageType=txt&Mobile='+mob_no+'&SenderID=VTTEAM&Message='+message, 
                    dataType: "html", 
                    success: function(data, textStatus, jqXHR) 
                    { alert("success"); } }); 
                    
                    ```
            }
            execution {
                sequence: 20
            }
            comments {
                comments:
                    ```
                    var mob_no = $v('P102_CONTACT_NUMBER');
                    var message = "Dear Customer, We thank you for your Order dated "+$v('P102_PO_DATE')+". Order confirmation No. "+$v('P102_ORDER_NUMBER')+". We will deliver your material soon. Team Venturi";
                    $.ajax({ type: 'GET', url: 'http://totalsmsindia.in/httpapi/httpapi?token=0c02420dacfff109e3696d15e6e2e96e&sender=VTteam&number='+mob_no+'&route=2&type=1&sms='+message, dataType: "html", success: function(data, textStatus, jqXHR) 
                    { alert("success"); } }); 
                    
                    ```
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select SO.PO_NUMBER, SO.PO_DATE, SC.MOBILE_NUMBER,SO.ORDER_NUMBER 
                        from XXEBA_SALES_ORDER SO, EBA_SALES_CUSTOMERS SC 
                          where SO.ORDER_ID = :P102_ORDER_ID and SO.CUSTOMER_ID = SC.ID
                    ```
                itemsToSubmit: P102_ORDER_ID
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P102_PO_NUMBER
                    P102_PO_DATE
                    P102_CONTACT_NUMBER
                    P102_ORDER_NUMBER
                ]
            }
            execution {
                sequence: 10
            }
        )

    )


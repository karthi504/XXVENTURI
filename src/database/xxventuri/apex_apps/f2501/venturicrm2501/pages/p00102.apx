    region approved (
        name: Approved
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT distinct
                    so.order_id,
                    so.order_number,
                    so.deal_id,
                    sd.deal_name,
                    so.customer_id,
                    sc.customer_name,
                    so.territory_id,
                    so.sales_rep,
                    sr.rep_first_name
                    || ' '
                    || sr.rep_last_name    rep_name,
                    so.order_date,
                    so.po_number,
                    so.po_date,
                    so.reference,
                      (
                        SELECT LISTAGG(sr.rep_first_name || ' ' || sr.rep_last_name, ', ')
                        FROM eba_sales_salesreps 
                        WHERE id =  sr.rep_manager_id 
                    ) AS approved_by,
                   -- sr.rep_manager_id,
                    sr.updated,
                	cl2.customer_location_name billing_location,
                    
                    cl.customer_location_name                                                       billing,
                    so.delivery_location,
                    cl2.customer_location_name                                                      delivery,
                    so.order_frequency,
                    so.next_order_date,
                    (
                        CASE
                            WHEN so.status = 'Y'      THEN
                                'New'
                            WHEN so.status = 'R'      THEN
                                'Rejected'
                            ELSE
                                'New'
                        END
                    )      order_status,
                --SO.CREATED
                    to_char(so.created AT TIME ZONE 'Asia/Calcutta', 'DD-Mon-YYYY HH:MI PM')        AS created,
                    order_value,
                    delivery_date,
                    (
                        CASE
                            WHEN export_flag IN ( 'Y', 'P' ) THEN
                                'Imported'
                            ELSE
                                'New'
                        END
                    )                                                                               new_imported_flag,   /* Thamaraiselvan Added on 18-Oct-18 */
                    decode(so.updated_in_tally, 'Y', 'Yes', 'N', 'No')                                  updated_in_tally,
                    so.tally_reference_number,
                 -- tal.INVOICE_NUMBER,
                  --(SELECT INVOICE_NUMBER from XXEBA_TALLY_INVOICES_T tal where tal.SALES_ORDER_NUMBER(+) = SO.ORDER_NUMBER and tal. BATCH_SEQUENCE = (select max(BATCH_SEQUENCE) from XXEBA_TALLY_INVOICES_T)) as INVOICE_NUMBER,
                /*NVL ((
                SELECT
                    LISTAGG(--TO_CHAR(invoice_date, 'DD-Mon-YYYY')
                            --|| '-'
                           -- || 
                        invoice_number, '<br>') WITHIN GROUP(
                        ORDER BY
                            invoice_date
                    )
                FROM
                    (
                        SELECT DISTINCT
                            invoice_number,
                            invoice_date,
                            sales_order_number
                        FROM
                            xxeba_tally_invoices_t
                        WHERE
                            sales_order_number = so.order_number
                            AND batch_sequence = (
                                SELECT
                                    MAX(batch_sequence)
                                FROM
                                    xxeba_tally_invoices_t
                            )
                    )
                ),'-') INVOICE_NUMBER,*/
                    so.created_by,
                    so.order_type_id,
                    (
                        SELECT
                    --SALES_ORDER_NUMBER,
                            LISTAGG(invoice_number
                                    || '/'
                                    || invoice_date, ', ') WITHIN GROUP(
                                ORDER BY
                                    invoice_number
                            ) AS invoices
                        FROM
                            (
                                SELECT DISTINCT
                                    invoice_number,
                                    sales_order_number,
                                    invoice_date
                                FROM
                                    xxeba_tally_invoices_t
                				WHERE
                                    sales_order_number = so.order_number || ''
                            ) subquery
                    )                                                                               AS invoice
                 -- invoice.INVOICE_NUMBER
                FROM
                    xxeba_sales_order             so,
                    eba_sales_deals               sd,
                    eba_sales_customers           sc,
                    eba_sales_salesreps           sr,
                   
                  --  XXEBA_TALLY_INVOICES_T tal,
                    eba_sales_customer_locations  cl,
                    eba_sales_customer_locations  cl2,
                    (
                        SELECT
                            order_id,
                            SUM(order_value)       order_value,
                            MIN(delivery_date)     AS delivery_date
                        FROM
                            (
                                SELECT
                    /*+ INDEX(XXEBA_ORDER_PRODUCTS,ORDER_PRODUCT_ID_N1) */
                                    order_id,
                                    quantity,
                                    product_price,
                                    ( quantity * product_price ) order_value,
                                    delivery_date
                                FROM
                                    xxeba_order_products
                                WHERE
                                    order_id = order_id + 0
                            )
                        GROUP BY
                            order_id
                    )                             value
                WHERE
                      so.deal_id = so.deal_id +0
                    AND so.customer_id = so.customer_id +0    
                    and   so.deal_id = sd.id 
                 -- and SO.CUSTOMER_ID = SC.ID(+)
                    AND so.customer_id = sc.id
                 -- and SO.SALES_REP = SR.ID(+)
                    AND sd.id = sd.id + 0
                    AND so.order_id = so.order_id + 0
                    AND so.sales_rep = sr.id
                    AND so.delivery_location = cl.id (+)
                    AND so.billing_location = cl2.id (+)
                    AND so.order_id = value.order_id (+)
                    AND (sc.default_rep_id IN (
                        SELECT
                            r.id
                        FROM
                            eba_sales_salesreps r
                        START WITH
                            r.id = :user_id
                        CONNECT BY
                            PRIOR r.id = r.rep_manager_id
                    )
                          OR EXISTS (
                        SELECT
                            'Y'
                        FROM
                            eba_sales_salesreps       r,
                            eba_sales_salesrep_roles  sr
                        WHERE
                                r.id = :user_id
                            AND sr.id = r.rep_role
                            AND sr.role_name = 'Administrator'
                    )
                          OR EXISTS (
                        SELECT
                            'Y'
                        FROM
                            eba_sales_salesreps       r,
                            eba_sales_salesrep_roles  sr
                        WHERE
                                r.id = :user_id
                            AND sr.id = r.rep_role
                            AND sr.role_name = 'Sales Co-Ordinator'
                    ) ) 
                    AND so.status IN ( 'Y') 
                    AND  sr.rep_first_name
                    || ' '
                    || sr.rep_last_name  not in  ('Anand Kumar','Ashok Kumar','Deva Raj','Krishna Kumar',
                                             'Mayil Raj','Sunil Singam','Suresh Raju','Vijay Kumar','Vinoth Anand',
                                             'Yogesh Ananth','Nagaendra Kumar','Rohith Kumar')
                     AND sr.rep_first_name not in 'Dhinesh'
                ORDER BY
                    so.order_id; 
                ```
        }

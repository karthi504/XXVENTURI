page 177 (
    name: "Account Transfer "
    title: "Account Transfer "
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region account-transfer (
        name: "Account Transfer "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region account-transfer-details (
        name: Account Transfer  Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,CUSTOMER_NAME,
                       PAN_NUMBER,
                       MOBILE_NUMBER,DEFAULT_REP_ID , (case when :P177_ID like '%'||ID||'|%' then 'checked' else null end) Select_request
                  from EBA_SALES_CUSTOMERS where DEFAULT_REP_ID =:P177_SALES_REP and status != 'X'
                ```
            pageItemsToSubmit: P177_SALES_REP
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 149070823045143611
        }

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DEFAULT_REP_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Default Rep
            }
            lov {
                lov: @xx-sales-rep-lov
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column MOBILE_NUMBER (
            type: plainText
            heading {
                heading: Mobile Number
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column PAN_NUMBER (
            type: plainText
            heading {
                heading: PAN Number
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column SELECT_REQUEST (
            type: plainText
            heading {
                heading: <input type="checkbox" name="request" value="all" id="all_request" >
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <input type="checkbox" name="leave_request" class="emp_leave_request" value="#ID#" #SELECT_REQUEST#>
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: I
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 1490728 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CUSTOMER_NAME (
                sequence: 2
            )

            displayColumn DEFAULT_REP_ID (
                sequence: 5
            )

            displayColumn MOBILE_NUMBER (
                sequence: 4
            )

            displayColumn PAN_NUMBER (
                sequence: 3
            )

            displayColumn SELECT_REQUEST (
                sequence: 1
            )

        )

    )

    pageItem P177_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @account-transfer-details
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P177_SALES_REP (
        type: selectList
        label {
            label: Sales Reps
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select REP_FIRST_NAME ||' '|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS where STATUS='Y'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @account-transfer
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P177_TRANSFER_TO (
        type: selectList
        label {
            label: Transfer To
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select REP_FIRST_NAME ||' '|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS where ID <>:P177_SALES_REP and STATUS='Y'
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P177_SALES_REP
            itemsToSubmit: P177_SALES_REP
        }
        layout {
            sequence: 20
            region: @account-transfer
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 50
            region: @account-transfer
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 2
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button transfer (
        buttonName: TRANSFER
        label: Transfer
        layout {
            sequence: 40
            region: @account-transfer
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: style="left:120px;"
        }
    )

    dynamicAction check-box (
        name: Check box
        execution {
            sequence: 20
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @account-transfer-details
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $( "#all_request" ).change(function() {
                       // $ ('#P177_ID').val('');
                        if($(this).is(":checked")){
                             $("input:checkbox.emp_leave_request").prop('checked', true);
                             $("input:checkbox.emp_leave_request").each(function(){
                                var $this = $(this);
                                 $ ('#P177_ID').val($ ('#P177_ID').val().replace($this.val()+'|',''));
                                $ ('#P177_ID').val($ ('#P177_ID').val()+$this.val()+'|');
                            });
                        }
                        else{
                              $("input:checkbox.emp_leave_request").prop('checked', false);
                              $("input:checkbox.emp_leave_request").each(function(){
                                var $this = $(this);
                                //alert($this.val());
                                $ ('#P177_ID').val($ ('#P177_ID').val().replace($this.val()+'|',''));
                            });
                        }
                    });
                    
                    $( "input:checkbox.emp_leave_request" ).change(function() {
                        var select_val = $ ('#P177_ID').val();
                         if($(this).is(":checked")){
                             $ ('#P177_ID').val(select_val+$(this).val()+'|');
                         }
                        else{
                            $ ('#P177_ID').val(select_val.replace($(this).val()+'|',''));
                            $("input:checkbox#all_request").prop('checked', false);
                        }
                    });
                    
                    //If all row selected - checked select all check box
                    $( document ).ready(function() {
                        if ($('input:checkbox.emp_leave_request').not(':checked').length == 0) {
                             $("input:checkbox#all_request").prop('checked', true);
                        }
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh (
        name: refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P177_SALES_REP
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @account-transfer-details
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process rep-transfer-upadate (
        name: Rep transfer upadate
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                  if :P177_TRANSFER_TO is not null then
                    
                     update EBA_SALES_CUSTOMERS SET DEFAULT_REP_ID = :P177_TRANSFER_TO where :P177_ID like'%'||ID||'|%';
                
                  end if;
                  
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 91185852914983123
        }
        serverSideCondition {
            whenButtonPressed: @transfer
        }
    )

    branch (
        name: Goto_177
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 177
                clearCache: 177
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @transfer
        }
    )

)


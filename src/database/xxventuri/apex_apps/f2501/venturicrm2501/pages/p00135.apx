        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            
            .t-Footer{
            	display:none;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: This is an interactive report of all opportunities listed by product. Click the <strong>Reset</strong> button to reset the interactive report. Click the <strong>Actions ∨</strong> button to define the number of rows displayed per page, filter, format, download, and/or save the interactive report.
    }

    region hidden-items (
        name: Hidden Items
        type: staticContent
        layout {
            sequence: 1210
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region opportunities-by-product (
        name: Opportunities by Product
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region opportunities-by-product-2 (
        name: Opportunities by Product
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.id,
                  d.row_key,
                  d.deal_name,
                  dp.close_date,
                  p.product_family_id,
                  t.id territory_id,
                  t.territory_name,
                  c.id account_id,
                  c.customer_name account,
                  d.deal_amount,
                  d.deal_probability,
                  case
                    when deal_probability > 0 and deal_probability < 100
                    then 'Yes'
                    else 'No'
                  end open,
                  deal_close_date,
                  case
                    when deal_close_date < sysdate and deal_probability != 0 and deal_probability != 100
                    then 'Yes'
                    else 'No'
                  end past_due,
                  d.qtr,
                  dp.qtr as product_qtr,
                  dsc.status_code,
                  d.updated,
                  d.updated_by,
                  d.created,
                  d.created_by,
                  sr.rep_first_name || ' ' || sr.rep_last_name as sales_rep_name,
                  p.product_name,
                  p.product_sku,
                  p.id product_id,
                  decode(p.sold_as, 'SUBSCRIPTION', 'Cloud Subscription', 'PURCHASE', 'On-Premise Purchase', p.sold_as) as product_type,
                  nvl((select sum(nvl(dp.quote_price, 0.00)) from EBA_SALES_DEAL_PRODUCTS dp where dp.deal_id = d.id), 0.00) as calculated_deal_amount,
                  nvl((select sum(nvl(dp.tcv, 0.00)) from EBA_SALES_DEAL_PRODUCTS dp where dp.deal_id = d.id), 0.00) as calculated_tcv
                from eba_sales_deals d
                join eba_sales_customers c
                  on c.id = d.customer_id
                join eba_sales_deal_products dp
                  on dp.deal_id = d.id
                join eba_sales_products p
                  on p.id = dp.product_id
                left join eba_sales_deal_status_codes dsc
                  on dsc.id = d.deal_status_code_id
                left join eba_sales_territories t
                  on t.id = c.customer_territory_id
                left join eba_sales_salesreps sr
                  on sr.id = d.salesrep_id_01
                  where 
                  (upper(p.CREATED_BY) in (SELECT  upper(r.USER_NAME)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    )   
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: grid_region
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
            savePublicReportAuthorization: @administration-rights
        }
        advanced {
            savedReportMappingIdentifier: 1593857071664209851
        }


    dynamicAction set-recom-depth-of-cut (
        name: Set Recom Depth of Cut
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: [
                P225_RECOM_TOTAL_MATERIAL_REMO
                P225_RECOM_NO_OF_PASSES
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    /* 24-Oct-18 Thamaraiselvan Added */
                    IF :P225_RECOM_NO_OF_PASSES > 0 then
                        :P225_RECOM_DEPTH_OF_CUT := round((:P225_RECOM_TOTAL_MATERIAL_REMO / :P225_RECOM_NO_OF_PASSES), 2);
                    END IF;
                    ```
                itemsToSubmit: [
                    P225_RECOM_TOTAL_MATERIAL_REMO
                    P225_RECOM_NO_OF_PASSES
                ]
                itemsToReturn: P225_RECOM_DEPTH_OF_CUT
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


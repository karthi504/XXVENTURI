page 225 (
    name: Cutting Parameters
    title: Cutting Parameters
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function isNumber(evt) {
                evt = (evt) ? evt : window.event;
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57) && (charCode != 46)) {
                    return false;
                }
                return true;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region cutting-parameters (
        name: Cutting Parameters
        type: list
        source {
            list: @wizard-progress-list
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsXSmall
            ]
        }
        componentAppearance {
            listTemplate: @wizard-progress
        }
    )

    region cutting-parameters-blades-recom (
        name: Cutting Parameters Blades - Recom 2
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @cutting-parameters-recom
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P222_PRODUCT_CLASS
            value: Blades
        }
    )


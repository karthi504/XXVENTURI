    process save-trial-details (
        name: Save Trial Details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Thamaraiselvan addedd P222_NEW_EXIST_DEV  column in insert query */
                DECLARE
                v_trial_no number;
                v_edge NUMBER := 1;
                v_trial_id NUMBER;
                BEGIN
                
                IF :P222_PRODUCT_CLASS = 'Blades' then
                    :P224_EXIST_TOOL_CHANGING_CRITE  := :P224_EXIST_BLADE_TOOL_CHANGE_C;
                    :P224_EXIST_UNIT_PRICE           := :P224_EXIST_BLADE_UNIT_PRICE;
                    :P224_EXIST_SPINDLE_SPEED        := :P224_EXIST_BLADE_SPINDLE_SPEED;
                    :P224_EXIST_CUTTING_SPEED        := :P224_EXIST_BLADE_CUTTING_SPEED;
                    :P224_EXIST_CYCLE_TIME           := :P224_EXIST_BLADE_CYCLE_TIME;    
                    :P225_RECOM_TOOL_CHANGING_CRITE  := :P225_RECOM_BLADE_TOOL_CHANGE_C;
                    :P225_RECOM_UNIT_PRICE           := :P225_RECOM_BLADE_UNIT_PRICE;    
                    :P225_RECOM_SPINDLE_SPEED        := :P225_RECOM_BLADE_SPINDLE_SPEED;
                    :P225_RECOM_CUTTING_SPEED        := :P225_RECOM_BLADE_CUTTING_SPEED;
                    :P225_RECOM_CYCLE_TIME           := :P225_RECOM_BLADE_CYCLE_TIME;
                	:P225_RECOM1_TOOL_CHANGING_C     := :P225_RECOM1_BLD_TOOL_CHANGE_C;
                    :P225_RECOM1_UNIT_PRICE          := :P225_RECOM1_BLADE_UNIT_PRICE;    
                    :P225_RECOM1_SPINDLE_SPEED       := :P225_RECOM1_BLD_SPINDLE_SPEED;
                    :P225_RECOM1_CUTTING_SPEED       := :P225_RECOM1_BLD_CUTTING_SPEED;
                    :P225_RECOM1_CYCLE_TIME          := :P225_RECOM1_BLADE_CYCLE_TIME;
                END IF;
                
                select max(NVL(trial_no, 0)) + 1 into v_trial_no from XXEBA_TRIAL_DETAILS ;
                
                INSERT
                INTO XXEBA_TRIAL_DETAILS
                  (
                    DEAL_ID,
                    COMPONENT_NAME,
                    PART_NUMBER,
                    MATERIAL_TYPE,
                    PROCESS_TYPE,
                    INPUT_CONDITION,
                    HARDNESS,
                    HEAT_TREATMENT_TYPE,
                    SURFACE_CONDITION,
                    COMP_DIAMETER,
                    COMP_LENGTH,
                    COMP_WIDTH,
                    COMP_THICKNESS,
                    COMP_SHAPE,
                    MACHINE_TYPE,
                    MACHINE_BRAND,
                    WORKHOLDING_TYPE,
                    CHUCK_DIAMETER,
                    SPINDLE_TAPER,
                    THROUGH_COOLANT,
                    TABLE_SIZE,
                    NO_OF_TOOL_LOCATION,
                    MAXIMUM_RPM,
                    SPINDLE_TOOL_WEIGHT_LIMIT,
                    EXIST_TOOL_SPEC,
                    EXIST_TOOL_HOLDING_SPEC,
                    EXIST_NO_OF_CUTTING_EDGES,
                    EXIST_NO_OF_FLUTES,
                    EXIST_TOOL_CHANGING_CRITERIA,
                    EXIST_TYPE_OF_COATING,
                    EXIST_NO_OF_REGRINDING_DONE,
                    EXIST_AVERAGE_LIFE_PER_EDGE,
                    EXIST_UNIT_PRICE,
                    RECOM_TOOL_SPEC,
                    RECOM_TOOL_HOLDING_SPEC,
                    RECOM_NO_OF_CUTTING_EDGES,
                    RECOM_NO_OF_FLUTES,
                    RECOM_TOOL_CHANGING_CRITERIA,
                    RECOM_TYPE_OF_COATING,
                    RECOM_NO_OF_REGRINDING_DONE,
                    RECOM_AVERAGE_LIFE_PER_EDGE,
                    RECOM_UNIT_PRICE,
                    EXIST_TOTAL_MATERIAL_REMOVAL,
                    EXIST_NO_OF_PASSES,
                    EXIST_DEPTH_OF_CUT,
                    EXIST_WIDTH_OF_CUT,
                    EXIST_SPINDLE_SPEED,
                    EXIST_CUTTING_SPEED,
                    EXIST_FEED_PER_TOOTH,
                    EXIST_TABLE_FEED,
                    EXIST_CYCLE_TIME,
                    RECOM_TOTAL_MATERIAL_REMOVAL,
                    RECOM_NO_OF_PASSES,
                    RECOM_DEPTH_OF_CUT,
                    RECOM_WIDTH_OF_CUT,
                    RECOM_SPINDLE_SPEED,
                    RECOM_CUTTING_SPEED,
                    RECOM_FEED_PER_TOOTH,
                    RECOM_TABLE_FEED,
                    RECOM_CYCLE_TIME,
                    NO_OF_SHIFT_PER_DAY,
                    NO_OF_WORKING_DAYS_PER_WEEK,
                    EXIST_COST_PER_COMPONENT,
                    NO_OF_COMPONENTS_PROD_PER_HOUR,
                    PRODUCT_CLASS_ID,
                    TYPE_OF_COOLANT,
                    EXIST_BLADE_SIZE,
                    EXIST_BLADE_TPI,
                    EXIST_BLADE_GRADE,
                    EXIST_BLADE_PROFILE,
                    EXIST_AVERAGE_LIFE_PER_BLADE,
                    EXIST_BLADE_COST_CM2,
                    RECOM_BLADE_SIZE,
                    RECOM_BLADE_TPI,
                    RECOM_BLADE_GRADE,
                    RECOM_BLADE_PROFILE,
                    RECOM_AVERAGE_LIFE_PER_BLADE,
                    RECOM_BLADE_COST_CM2,
                    EXIST_BLADE_INITIAL_FEED,
                    EXIST_BLADE_NORMAL_FEED,
                    RECOM_BLADE_INITIAL_FEED,
                    RECOM_BLADE_NORMAL_FEED,
                    EXIST_BLADE_AVG_LIFE_NO_OF_COM,
                    ORIGINAL_EQUIP_MANUFACTURER,
                    RECOM1_TOOL_SPEC,
                    RECOM1_TOOL_HOLDING_SPEC,
                    RECOM1_NO_OF_CUTTING_EDGES,
                    RECOM1_NO_OF_FLUTES,
                    RECOM1_TOOL_CHANGING_CRITERIA,
                    RECOM1_TYPE_OF_COATING,
                    RECOM1_NO_OF_REGRINDING_DONE,
                    RECOM1_AVERAGE_LIFE_PER_EDGE,
                    RECOM1_UNIT_PRICE,
                    RECOM1_BLADE_SIZE,
                    RECOM1_BLADE_TPI,
                    RECOM1_BLADE_GRADE,
                    RECOM1_BLADE_PROFILE,
                    RECOM1_AVERAGE_LIFE_PER_BLADE,
                    RECOM1_BLADE_COST_CM2,
                    RECOM1_TOTAL_MATERIAL_REMOVAL,
                    RECOM1_NO_OF_PASSES,
                    RECOM1_DEPTH_OF_CUT,
                    RECOM1_WIDTH_OF_CUT,
                    RECOM1_SPINDLE_SPEED,
                    RECOM1_CUTTING_SPEED,
                    RECOM1_FEED_PER_TOOTH,
                    RECOM1_TABLE_FEED,
                    RECOM1_CYCLE_TIME,
                    RECOM1_BLADE_INITIAL_FEED,
                    RECOM1_BLADE_NORMAL_FEED,
                    TRIAL_NO,
                    TRIAL_OPERATION_NAME,
                    CUTTING_TYPE,
                    NEW_TRIAL_OR_EXISTING,
                    EXIST_TOOL_BRAND
                  )
                  VALUES
                  (
                    :P222_DEAL_ID,
                    :P223_COMPONENT_NAME,
                    :P223_PART_NUMBER,
                    :P223_MATERIAL_TYPE,
                    :P223_PROCESS_TYPE,
                    :P223_INPUT_CONDITION,
                    :P223_HARDNESS,
                    :P223_HEAT_TREATMENT_TYPE,
                    :P223_SURFACE_CONDITION,
                    :P223_COMP_DIAMETER,
                    :P223_COMP_LENGTH,
                    :P223_COMP_WIDTH,
                    :P223_COMP_THICKNESS,
                    :P223_COMP_SHAPE,
                    :P223_MACHINE_TYPE,
                    :P223_MACHINE_BRAND,
                    :P223_WORKHOLDING_TYPE,
                    :P223_CHUCK_DIAMETER,
                    :P223_SPINDLE_TAPER,
                    :P223_THROUGH_COOLANT,
                    :P223_TABLE_SIZE,
                    :P223_NO_OF_TOOL_LOCATION,
                    :P223_MAXIMUM_RPM,
                    :P223_SPINDLE_TOOL_WEIGHT_LIMIT,
                    :P224_EXIST_TOOL_SPEC,
                    :P224_EXIST_TOOL_HOLDING_SPEC,
                    :P224_EXIST_NO_OF_CUTTING_EDGES,
                    :P224_EXIST_NO_OF_FLUTES,
                    :P224_EXIST_TOOL_CHANGING_CRITE,
                    :P224_EXIST_TYPE_OF_COATING,
                    :P224_EXIST_NO_OF_REGRINDING_DO,
                    :P224_EXIST_AVERAGE_LIFE_PER_ED,
                    :P224_EXIST_UNIT_PRICE,
                    :P225_RECOM_TOOL_SPEC,
                    :P225_RECOM_TOOL_HOLDING_SPEC,
                    :P225_RECOM_NO_OF_CUTTING_EDGES,
                    :P225_RECOM_NO_OF_FLUTES,
                    :P225_RECOM_TOOL_CHANGING_CRITE,
                    :P225_RECOM_TYPE_OF_COATING,
                    :P225_RECOM_NO_OF_REGRINDING_DO,
                    :P225_RECOM_AVERAGE_LIFE_PER_ED,
                    :P225_RECOM_UNIT_PRICE,
                    :P224_EXIST_TOTAL_MATERIAL_REMO,
                    :P224_EXIST_NO_OF_PASSES,
                    :P224_EXIST_DEPTH_OF_CUT,
                    :P224_EXIST_WIDTH_OF_CUT,
                    :P224_EXIST_SPINDLE_SPEED,
                    :P224_EXIST_CUTTING_SPEED,
                    :P224_EXIST_FEED_PER_TOOTH,
                    :P224_EXIST_TABLE_FEED,
                    :P224_EXIST_CYCLE_TIME,
                    :P225_RECOM_TOTAL_MATERIAL_REMO,
                    :P225_RECOM_NO_OF_PASSES,
                    :P225_RECOM_DEPTH_OF_CUT,
                    :P225_RECOM_WIDTH_OF_CUT,
                    :P225_RECOM_SPINDLE_SPEED,
                    :P225_RECOM_CUTTING_SPEED,
                    :P225_RECOM_FEED_PER_TOOTH,
                    :P225_RECOM_TABLE_FEED,
                    :P225_RECOM_CYCLE_TIME,
                    :P223_NO_OF_SHIFT_PER_DAY,
                    :P223_NO_OF_WORKING_DAYS_PER_WE,
                    :P224_EXIST_COST_PER_COMPONENT,
                    :P223_NO_OF_COMP_PROD_PER_HOUR,
                    :P222_PRODUCT_CLASS_ID,

    dynamicAction set-exist-blade-cutting-speed (
        name: Set Exist Blade Cutting Speed
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P225_EXIST_BLADE_SPINDLE_SPEED
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      IF :P225_COMP_BLADE_DIAMETER  IS NOT NULL AND :P225_EXIST_BLADE_SPINDLE_SPEED IS NOT NULL THEN
                        :P225_EXIST_BLADE_CUTTING_SPEED := (3.14 * NVL(:P225_COMP_BLADE_DIAMETER, 0) * NVL(:P225_EXIST_BLADE_SPINDLE_SPEED, 0))/1000;
                      ELSE
                        :P225_EXIST_BLADE_CUTTING_SPEED := NULL;
                      END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P225_EXIST_BLADE_SPINDLE_SPEED
                    P225_COMP_BLADE_DIAMETER
                ]
                itemsToReturn: P225_EXIST_BLADE_CUTTING_SPEED
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


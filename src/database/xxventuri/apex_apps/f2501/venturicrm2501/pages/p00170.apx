page 170 (
    name: Bank Details
    title: Bank Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-xxeba-sales-banks-list (
        name: Form on XXEBA_SALES_BANKS_LIST
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P170_BANK_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-xxeba-sales-banks-list
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: BANK_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P170_BANK_NAME (
        type: textarea
        label {
            label: Bank Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-on-xxeba-sales-banks-list
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 60
            height: 5
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: BANK_NAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_CREATED_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @form-on-xxeba-sales-banks-list
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: CREATED_BY
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_CREATION_DATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @form-on-xxeba-sales-banks-list
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: CREATION_DATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: right
        }
        layout {
            sequence: 30
            region: @form-on-xxeba-sales-banks-list
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRIPTION
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @form-on-xxeba-sales-banks-list
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_UPDATED_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @form-on-xxeba-sales-banks-list
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: UPDATED_BY
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P170_UPDATE_DATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @form-on-xxeba-sales-banks-list
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: UPDATE_DATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P170_BANK_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P170_BANK_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation p170-creation-date-must-be-timestamp (
        name: P170_CREATION_DATE must be timestamp
        execution {
            sequence: 60
        }
        validation {
            type: itemIsAValidTimestamp
            item: P170_CREATION_DATE
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P170_CREATION_DATE
        }
    )

    validation p170-update-date-must-be-timestamp (
        name: P170_UPDATE_DATE must be timestamp
        execution {
            sequence: 80
        }
        validation {
            type: itemIsAValidTimestamp
            item: P170_UPDATE_DATE
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P170_UPDATE_DATE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 70816353351979499
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-xxeba-sales-banks-list (
        name: Fetch Row from XXEBA_SALES_BANKS_LIST
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_BANKS_LIST
            pkColumn: BANK_ID
            pkItem: P170_BANK_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 70815108952979499
        }
    )

    process process-row-of-xxeba-sales-banks-list (
        name: Process Row of XXEBA_SALES_BANKS_LIST
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_BANKS_LIST
            pkColumn: BANK_ID
            pkItem: P170_BANK_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 70815562501979499
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 70815880205979499
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)


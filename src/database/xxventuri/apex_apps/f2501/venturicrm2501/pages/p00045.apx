page 45 (
    name: Rename Application
    title: Rename Application
    pageGroup: @administration
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @administration-rights
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Change the application name, displayed on the top left of each page, to one of your choosing. By default, the application name is "Opportunity Tracker". You can also change the application's subtitle text (displayed on the home page).
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region rename-application (
        name: Rename Application
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader
                t-Region--hiddenOverflow
            ]
        }
    )

    pageItem P45_APPLICATION_SUBTITLE (
        type: textField
        label {
            label: Application Subtitle
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @rename-application
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 64
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select preference_value
                from eba_sales_preferences
                where preference_name = 'APPLICATION_SUBTITLE'
                union all
                select 'Manage Opportunities'
                from dual
                where not exists ( select null
                                   from eba_sales_preferences
                                   where preference_name = 'APPLICATION_SUBTITLE')
                ```
        }
        default {
            type: static
            staticValue: &APP_NAME.
        }
        security {
            encryptSessionState: false
            restrictedChars: webSafe
        }
    )

    pageItem P45_APPLICATION_TITLE (
        type: textField
        label {
            label: Application Name
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @rename-application
            slot: regionBody
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 64
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: staticValue
            staticValue: &APPLICATION_TITLE.
            used: always
        }
        default {
            type: static
            staticValue: &APP_NAME.
        }
        security {
            encryptSessionState: false
            restrictedChars: webSafe
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @breadcrumb
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: settings
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 20
            region: @breadcrumb
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process set-application-title (
        name: Set Application Title
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :APPLICATION_TITLE := :P45_APPLICATION_TITLE;
                
                merge into eba_sales_preferences dst
                using ( select 'APPLICATION_TITLE' preference_name, :P45_APPLICATION_TITLE preference_value from dual ) src
                on ( dst.preference_name = src.preference_name )
                when matched then
                    update set dst.preference_value = src.preference_value
                when not matched then
                    insert ( preference_name, preference_value )
                    values ( src.preference_name, src.preference_value );
                
                merge into eba_sales_preferences dst
                using ( select 'APPLICATION_SUBTITLE' preference_name, :P45_APPLICATION_SUBTITLE preference_value from dual ) src
                on ( dst.preference_name = src.preference_name )
                when matched then
                    update set dst.preference_value = src.preference_value
                when not matched then
                    insert ( preference_name, preference_value )
                    values ( src.preference_name, src.preference_value );
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Application renamed.
        }
        error {
            errorMessage: #SQLERRM#
        }
        advanced {
            executionMappingIdentifier: 1551439684467080325
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: settings
            }
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)


page 84 (
    name: Visit Frequency
    title: Visit Frequency
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-xxeba-sales-visit-frequency (
        name: Form on XXEBA_SALES_VISIT_FREQUENCY
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P84_FREQUENCY_DAYS (
        type: numberField
        label {
            label: Frequency Days
            alignment: left
        }
        settings {
            minValue: 1
            maxValue: 100
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @form-on-xxeba-sales-visit-frequency
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: FREQUENCY_DAYS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P84_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-xxeba-sales-visit-frequency
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P84_ORDER_SEQUENCE (
        type: numberField
        label {
            label: Order sequence
            alignment: left
        }
        settings {
            numberAlignment: end

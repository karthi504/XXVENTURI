            type: databaseColumn
            databaseColumn: ORDER_SEQUENCE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P84_STATUS (
        type: switch
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 50
            region: @form-on-xxeba-sales-visit-frequency
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        default {
            type: static
            staticValue: Y
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P84_VISIT_FREQUENCY (
        type: textField
        label {
            label: Visit Frequency
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-on-xxeba-sales-visit-frequency
            slot: regionBody
            alignment: left
        }
        appearance {

page 157 (
    name: Customer Classifications
    title: Customer Classifications
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region customer-classifications (
        name: Customer Classifications
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1220
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "CLASS_ID", 
                "CLASS_NAME",
                "STATUS",
                "CREATED_BY",
                "CREATION_DATE",
                "UPDATED_BY",
                "UPDATE_DATE"
                from "#OWNER#"."XXEBA_SALES_CLASSIFICATION" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 158
                items: {
                    P158_CLASS_ID: #CLASS_ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 126985941832114682
        }

        column CLASS_ID (
            type: hidden
            heading {
                heading: Class Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column CLASS_NAME (
            type: plainText
            heading {
                heading: Class Name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Added  By
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column CREATION_DATE (
            type: hidden
            heading {
                heading: Creation Date
            }
            layout {
                sequence: 5
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column STATUS (
            type: hidden
            heading {
                heading: Status
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column UPDATED_BY (
            type: hidden
            heading {
                heading: Updated By
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column UPDATE_DATE (
            type: hidden
            heading {
                heading: Update Date
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 1269894 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLASS_ID (
                sequence: 1
            )

            displayColumn CLASS_NAME (
                sequence: 2
            )

            displayColumn CREATED_BY (
                sequence: 4
            )

            displayColumn CREATION_DATE (
                sequence: 5
            )

            displayColumn STATUS (
                sequence: 3
            )

            displayColumn UPDATED_BY (
                sequence: 6
            )

            displayColumn UPDATE_DATE (
                sequence: 7
            )

        )

    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 40
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 33
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 158
                clearCache: 158
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)


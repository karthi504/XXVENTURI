page 2 (
    name: Accounts
    title: Accounts
    pageGroup: @accounts
    appearance {
        pageTemplate: @left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // standard, cacheable elements
            var timeout = 0; // used for debounce on search
            var CONTAINER_SEL = '.t-Form-fieldContainer';
            var pagePrefix = 'P' + $('#pFlowStepId').val();
            var displayAsId = pagePrefix + '_DISPLAY_AS';
            var $displayAs = $('#' + displayAsId);
            var $body = $('.t-PageBody');
            var $search = $('#' + pagePrefix + '_SEARCH');
            var $sort = $('#' + pagePrefix + '_SORT');
            var $reset = $('#reset_button');
            var $cardsReg = $('#cards_region');
            var $reportReg = $('#report_region');
            var $gridReg0 = $('#grid_region0');
            var $gridReg1 = $('#grid_region1');
            var $gridReg2 = $('#grid_region2');
            var $gridReg3 = $('#grid_region3');
            var $gridReg4 = $('#grid_region4');
            
            
            // custom items (will vary by page)
            var $territory = $('#' + pagePrefix + '_TERRITORY_ID');
            var $keyAccounts = $('#' + pagePrefix + '_KEY');
            
            function showLeftColumn() {
              $body
                .removeClass('t-PageBody--hideLeft')
                .addClass('t-PageBody--showLeft');
                
              // Takes 200ms to hide column
              setTimeout(function() {
                // Ensure column headers align correctly
                $(window).trigger('apexwindowresized');
              }, 250);
            }
            
            function hideLeftColumn() {
              $body
                .removeClass('t-PageBody--showLeft')
                .addClass('t-PageBody--hideLeft');
                
              // Takes 200ms to hide column
              setTimeout(function() {
                // Ensure column headers align correctly
                $(window).trigger('apexwindowresized');
              }, 250);
            }
              
            // applyFilters triggers the refresh event on the correct region
            function applyFilters() {
              var display = $v(displayAsId);
              
              if (display === 'CARDS') {
                $cardsReg.trigger('apexrefresh');
              } else if (display === 'REPORT') {
                $reportReg.trigger('apexrefresh');
              } else if (display === 'GRID') {
                   $gridReg0.trigger('apexrefresh');
                   $gridReg1.trigger('apexrefresh');
                   $gridReg2.trigger('apexrefresh');
                   $gridReg3.trigger('apexrefresh');
                   $gridReg4.trigger('apexrefresh');
              }
            }
            
            // toggleRegionDisplay is similar to applyFilters except that it also
            // takes into account what regions or items need to be displayed or hidden
            function toggleRegionDisplay(refresh) {
              var display = $v(displayAsId);
              
              refresh = (refresh === false) ? false : true;
              
              if (display === 'CARDS') {
                $reportReg.hide();
                $gridReg0.hide();
                $gridReg1.hide();
                $gridReg2.hide();
                $gridReg3.hide();
                $gridReg4.hide();
            
                showLeftColumn();
            
                $sort.closest(CONTAINER_SEL).show();
            
                if (refresh) {
                  $cardsReg.trigger('apexrefresh');
                }
                
                $cardsReg.show();
              } else if (display === 'REPORT') {
                $sort.closest(CONTAINER_SEL).hide();
                $cardsReg.hide();
                  $gridReg0.hide();
                $gridReg1.hide();
                  $gridReg2.hide();
                  $gridReg3.hide();
                  $gridReg4.hide();
            
                showLeftColumn();
            
                if (refresh) {
                  $reportReg.trigger('apexrefresh');
                }
            
                $reportReg.show();
              } else if (display === 'GRID') {
                $sort.closest(CONTAINER_SEL).hide();
                $cardsReg.hide();
                $reportReg.hide();
            
                hideLeftColumn();
            
                if (refresh) {
                    $gridReg0.trigger('apexrefresh');
                  $gridReg1.trigger('apexrefresh');
                    $gridReg2.trigger('apexrefresh');
                    $gridReg3.trigger('apexrefresh');
                    $gridReg4.trigger('apexrefresh');
                }
                 $gridReg0.show();
                $gridReg1.show();
                  $gridReg2.show();
                  $gridReg3.show();
                  $gridReg4.show();
              }
            }
              
            function debounceSearch() {
              clearTimeout(timeout);
              
              timeout = setTimeout(applyFilters, 250);
            }
              
            function preventSubmitOnEnter(e) {
              if (e.which === 13) {
                return false;
              }
            }
            
            function resetFilters() {
              $search.val(null);
              $territory.val(null);
              $keyAccounts.val(null);
              
              $sort.val('NAME');
            
              applyFilters();
            }
            
            // standard search event bindings
            $search.keydown(preventSubmitOnEnter);
            $search.keyup(debounceSearch);
            
            // dynamic event bindings (will vary by filter page)
            $territory.change(applyFilters);
            $keyAccounts.change(applyFilters);
            
            // standard display, sort, reset event bindings
            $displayAs.change(toggleRegionDisplay);
            $sort.change(applyFilters);
            $reset.click(resetFilters);
              
            toggleRegionDisplay(false);
            ```
    }
    css {
        inline:
            ```css
            .t-Card-initials {
              font-size: 14px;
            }
            
            
            .t-Footer{
            	display:none;
            }
            
            @media only screen and (min-width: 993px) {
                .t-Cards--3cols .t-Cards-item {
                    width: 28.33%;
                }
            }
            
            .t-Tabs--pill .t-Tabs-item.is-active .t-Tabs-link, .t-Tabs--pill .t-Tabs-link:active, .t-Tabs--pill .t-Tabs-link:hover {
                background-color: #309fdb;
                color: white;
            }
            
            
            
             
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            
            Use the filters on the left to show different results in the region on the right. The right region can be displayed in one of three ways (Cards View, Report View, and Customizable Grid) by using the display-mode buttons located just to the left of the <strong>Create Account</strong> button. Filters are not displayed in the Customizable Grid view.
            ```
    }

    region account-cards (
        name: Account Cards
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with base_accounts as (
                  select c.id,
                    c.row_key as CUSTOMER_CODE,
                   --- c.CUSTOMER_CODE,
                    c.customer_name,
                    c.customer_description,
                    c.customer_stock_symb,
                    case c.customer_is_key_account_yn
                      when 'Y' then 'Yes'
                      when 'N' then 'No'
                    end key_account,
                    c.tags,
                    c.updated,
                    (
                      select count(*)
                      from eba_sales_deals dx
                      where dx.customer_id = c.id
                        and dx.deal_probability > 0
                        and dx.deal_probability < 100
                    ) open_deals,
                    (
                      select count(*)
                      from eba_sales_deals
                      where customer_id = c.id
                        and deal_close_date < sysdate
                        and deal_probability != 0
                        and deal_probability != 100
                    ) past_due_deals,
                    (
                      select count(*) 
                      from eba_sales_leads 
                      where account_id = c.id
                        and lead_status_id not in (1, 5)
                    ) open_leads,
                    case 
                      when c.default_rep_id is not null
                      then (
                        select max(rep_last_name
                          ||', '
                          || rep_first_name) d
                        from eba_sales_salesreps sr
                        where sr.id = c.default_rep_id
                      )
                    end default_rep
                  from eba_sales_customers c
                  left join eba_sales_territories t
                    on c.customer_territory_id = t.id
                  where :P2_DISPLAY_AS = 'CARDS' AND c.status in('Y','R','U','V','A','N')
                    and (:P2_TERRITORY_ID is null or t.id = :P2_TERRITORY_ID)
                    and (:P2_KEY is null or customer_is_key_account_yn = :P2_KEY) 
                --    and(upper(c.CREATED_BY) in (SELECT  upper(r.USER_NAME)
                    and(upper(c.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE
                                  and SR.ROLE_NAME in ('Administrator','Sales Co-Ordinator'))
                    )                                
                ),
                card_details as (
                  select customer_name card_title,
                    null card_icon,
                   CUSTOMER_CODE card_initials,
                    null card_text,
                    coalesce(customer_description, 'No description provided') card_text_p1,
                    'Deals: ' || to_char(open_deals,'999G999G999G990') || ' open' ||
                      case 
                        when past_due_deals != 0
                        then ', ' || to_char(past_due_deals,'999G999G999G990') || ' past due'
                      end card_text_p2,
                    'Leads: ' || to_char(past_due_deals,'999G999G999G990') || ' open'card_text_p3,
                    apex_util.prepare_url(
                      'f?p=' ||
                      :APP_ID ||
                      ':94:' ||
                      :APP_SESSION ||
                      ':::94:P94_ID:' ||
                      id
                    ) card_link,
                    updated card_subtext,
                    open_deals,
                    past_due_deals,
                    open_leads
                  from base_accounts
                )
                select *
                from card_details
                where (
                  :P2_SEARCH is null
                    or instr(upper(card_title), upper(:P2_SEARCH)) > 0
                    or instr(upper(card_initials), upper(:P2_SEARCH)) > 0
                    or instr(upper(card_text_p1), upper(:P2_SEARCH)) > 0
                    or instr(upper(card_text_p2), upper(:P2_SEARCH)) > 0
                    or instr(upper(card_text_p3), upper(:P2_SEARCH)) > 0
                    or instr(upper('Updated: ' || apex_util.get_since(card_subtext)), upper(:P2_SEARCH)) > 0
                ) 
                
                order by
                  case :P2_SORT
                    when 'NAME' then card_title
                  end,
                  case :P2_SORT
                    when 'OPEN_DEALS' then open_deals
                  end desc,
                  case :P2_SORT
                    when 'PAST_DUE' then past_due_deals
                  end desc,
                  case :P2_SORT
                    when 'OPEN_LEADS' then open_leads
                  end desc,
                  case :P2_SORT
                    when 'UPDATED' then card_subtext
                  end desc
                ```
            pageItemsToSubmit: [
                P2_SEARCH
                P2_TERRITORY_ID
                P2_KEY
                P2_DISPLAY_AS
                P2_SORT
            ]
        }

    region account-report (
        name: Account Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with base_accounts as (
                  select c.id,c.GST_NO,c.CLASSIFICATION_ID,
                    c.row_key,
                    c.customer_name,
                    t.territory_name,
                    c.customer_territory_id,
                    case  c.status 
                    when 'Y' then 'New'
                    when 'R' then 'recommended'
                    when 'U' then 'recommended'
                    when 'V' then 'Verified'
                    when 'A' then 'Approved'
                end  as customer_status,
                    c.updated,
                    (
                      select count(*)
                      from eba_sales_deals dx
                      where dx.customer_id = c.id
                        and dx.deal_probability > 0
                        and dx.deal_probability < 100
                    ) open_deals,
                    (
                      select count(*)
                      from eba_sales_deals
                      where customer_id = c.id
                        and deal_close_date < sysdate
                        and deal_probability != 0
                        and deal_probability != 100
                    ) past_due,
                    (
                      select count(*) 
                      from eba_sales_leads 
                      where account_id = c.id
                    ) leads
                  from eba_sales_customers c
                  left join eba_sales_territories t
                    on c.customer_territory_id = t.id
                  where :P2_DISPLAY_AS = 'REPORT' AND c.status in ('Y','R','U','V','A')
                    and (:P2_TERRITORY_ID is null or t.id = :P2_TERRITORY_ID)
                    and (:P2_KEY is null or customer_is_key_account_yn = :P2_KEY)
                --  and(upper(c.CREATED_BY) in (SELECT  upper(r.USER_NAME)
                    and(upper(c.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE
                            and SR.ROLE_NAME in ('Administrator','Sales Co-Ordinator') )
                    )                                
                )
                select *
                from base_accounts
                where (
                  :P2_SEARCH is null
                    or instr(upper(customer_name), upper(:P2_SEARCH)) > 0
                    or instr(upper(row_key), upper(:P2_SEARCH)) > 0
                    or instr(upper(territory_name), upper(:P2_SEARCH)) > 0
                    or instr(upper(apex_util.get_since(updated)), upper(:P2_SEARCH)) > 0
                    or instr(open_deals, upper(:P2_SEARCH)) > 0
                    or instr(past_due, upper(:P2_SEARCH)) > 0
                    or instr(leads, upper(:P2_SEARCH)) > 0
                )
                ```
            pageItemsToSubmit: [
                P2_DISPLAY_AS
                P2_TERRITORY_ID
                P2_KEY
                P2_SEARCH
            ]
        }
        layout {

    validation meeting-per-validation-create (
        name: Meeting Per validation - Create
        execution {
            sequence: 100
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                lv_meeting_per_day number;
                lv_appt_count      NUMBER;
                
                begin
                IF :P185_APPOINTMENT_ID is null then
                SELECT MEETINGS_PER_DAY into lv_meeting_per_day FROM  EBA_SALES_SALESREPS WHERE STATUS='Y' AND ID = :P185_SALES_REP;
                SELECT count(*) into lv_appt_count from XXEBA_SALES_CRM_APPOINTMENTS  
                where  to_date(trunc(APPOINTMENT_DATE),'DD-Mon-YYYY')= to_date(:P185_APPOINTMENT_DATE,'DD-Mon-YYYY')  AND SALESREP_ID=:P185_SALES_REP;
                       
                    if lv_appt_count >= lv_meeting_per_day   then
                        return 'Visit per day limit has been exceeded.';
                    end if;
                   return  null;
                    --return lv_appt_count;
                 END  IF;
                 
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNull
            item: P185_APPOINTMENT_ID
        }
    )

    validation meeting-per-validation-save (
        name: Meeting Per validation - Save
        execution {
            sequence: 110
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                lv_meeting_per_day number;
                lv_appt_count      NUMBER;
                
                begin
                
                 
                IF :P185_APPOINTMENT_ID is not null then
                SELECT MEETINGS_PER_DAY into lv_meeting_per_day FROM  EBA_SALES_SALESREPS WHERE STATUS='Y' AND ID = :P185_SALES_REP;
                SELECT count(*) into lv_appt_count from XXEBA_SALES_CRM_APPOINTMENTS  
                where  to_char(trunc(APPOINTMENT_DATE),'DD-Mon-YYYY')= to_char(to_date(:P185_APPOINTMENT_DATE,'DD-Mon-YYYY'),'DD-Mon-YYYY')   AND SALESREP_ID=:P185_SALES_REP ;
                       
                    if lv_appt_count >=lv_meeting_per_day   then
                        return 'Visit per day limit has been exceeded.';
                    end if;
                    return null;
                   -- return lv_appt_count;
                 END  IF;
                
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
            type: never
        }
    )


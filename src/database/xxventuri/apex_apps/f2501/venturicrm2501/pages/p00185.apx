        source {
            plsqlCode:
                ```plsql
                insert into XXEBA_SALES_APPOINTMENT (CUSTOMER_ID, APPOINTMENT_TYPE, APPOINTMENT_DATE
                                                     , APPOINTMENT_PURPOSE, CONTACT_PERSON_ID 
                , CONTACT_LOCATION_ID, COMMENTS, LEAD_ID, OPPORTUNITY_ID , APPOINTMENT_STATUS, CONTACT_ID
                                                    )
                values (:P185_CUSTOMER_ID, :P185_APPOINTMENT_TYPE, to_timestamp(:P185_NEXT_DATE, 'DD-Mon-YYYY HH12:MI AM')
                        , :P185_APPOINTMENT_PURPOSE, :P185_CONTACT_PERSON_ID
                       , :P185_CONTACT_LOCATION_ID, :P185_COMMENTS, :P185_LEAD_ID, :P185_OPPORTUNITY_ID , :P185_APPOINTMENT_STATUS, :P185_CONTACT_ID
                       );
                       
                       
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 202033396893912436
        }
        serverSideCondition {
            type: item=value
            item: P185_NEXT_APPOINTMENT
            value: O

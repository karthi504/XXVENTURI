    dynamicAction show-hide-schedule (
        name: Show/Hide Schedule
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P185_NEXT_SCHEDULE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var schedule = $('#P185_NEXT_SCHEDULE').val();
                    $('#P185_SCHEDULES_LIST').val('');
                    
                    $('.week_selected').removeClass('week_selected');
                    $('.date_selected').removeClass('date_selected');
                    
                    if(schedule == 'D'){
                        $('#weekly_box').hide();
                        $('#monthly_box').hide();
                        $('#mothly_schedue_value').hide();
                    //  $('#P185_SCHEDULES_LIST').hide();
                    }
                    else if(schedule == 'W'){
                        $('#weekly_box').show();
                         $('#monthly_box').hide();
                        $('#mothly_schedue_value').hide();
                    //  $('#P185_SCHEDULES_LIST').hide();
                    }
                    else if(schedule == 'M'){
                        $('#weekly_box').hide();
                         $('#monthly_box').show();
                        $('#mothly_schedue_value').hide();
                    //  $('#P185_SCHEDULES_LIST').hide();
                    }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )


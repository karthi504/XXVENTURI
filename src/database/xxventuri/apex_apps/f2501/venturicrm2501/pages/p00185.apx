    pageItem P185_CUSTOMER_ID (
        type: plugin/select2
        label {
            label: Account
            alignment: left
        }
        settings {
            width: 93.5%
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.customer_name display_value,c.id return_value  from eba_sales_customers c where c.status='A' and 
                (upper(c.DEFAULT_REP_ID) in (SELECT  upper(r.ID)                                
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    )                 
                order by 1
                ```
        }
        layout {
            sequence: 90
            region: @form-on-xxeba-sales-appointment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                select c.customer_name display_value,c.id return_value  from eba_sales_customers c,eba_sales_verifications v
                where c.id=v.CUST_ID and c.status='Y'
                and(upper(c.DEFAULT_REP_ID) in (SELECT  upper(r.ID)                                
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    )                 
                order by 1
                ```
        }
    )


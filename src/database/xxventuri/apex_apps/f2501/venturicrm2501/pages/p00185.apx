page 185 (
    name: schedule Appointments Details
    title: schedule Appointments Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
            $('#weekly_box .days').click(function (){
                if ( $(this).hasClass("week_selected") ){
                    $('#P136_SCHEDULES_LIST').val($('#P136_SCHEDULES_LIST').val().replace($(this).attr('id')+',', ""));
                    $(this).removeClass('week_selected');
                }
                else{
                    $('#P136_SCHEDULES_LIST').val($('#P136_SCHEDULES_LIST').val()+$(this).attr('id')+',');
                   $(this).addClass('week_selected');
                } 
            });
            
            $('#monthly_box .date').click(function (){
                if ( $(this).hasClass("date_selected") ){
                    $('#P136_SCHEDULES_LIST').val($('#P136_SCHEDULES_LIST').val().replace($(this).attr('id')+',', ""));
                    $(this).removeClass('date_selected');
                }
                else{
                    $('#P136_SCHEDULES_LIST').val($('#P136_SCHEDULES_LIST').val()+$(this).attr('id')+',');
                   $(this).addClass('date_selected');
                } 
            });
            
            $('#date_button').click(function (){
                $('#mothly_schedue_value span').text($('#P136_SCHEDULES_LIST').val());
                $('#mothly_schedue_value').show();
                $('#monthly_box').hide();
            });
            
            
            ```
    }
    css {
        inline:
            ```css
            .calender-hot-button{
                    background-color: #0572CE !important;
                    color: #fff !important;
            }
            
            .days {
                float: left;
                margin: 6px;
                width: 26px;
                text-align: center;
                border: 1px solid;
                border-radius: 250px;
                cursor: pointer;
            }
            
            #weekly_box{
                margin-top: -6px;
                margin-left: 20px;
            }
            
            .week_selected{
                background: #0585e0;
                color: #fff;
                font-weight: bold;
            }
            
            .date {
                width: 26px;
                text-align: center;
                cursor: pointer;
                border: 1px outset;
            }
            
            #monthly_box{
                float: left;
                margin-left: 20px;
            }
            
            #monthly_box table{
                border:1px solid #c7c7c7;
            }
            
            .date:hover {
                border: 1px dotted;
            }
                
            .date_selected{
                background: #0585e0;
                color: #fff;
                font-weight: bold;
            }    
                
            #date_button{
                padding: 0 12px;
                background: #0572ce;
                border: 1px solid #0464b4;
                color: #fff;
                cursor: pointer;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent

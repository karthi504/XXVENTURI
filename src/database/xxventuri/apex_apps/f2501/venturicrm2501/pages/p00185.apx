    process schedule-appoinment (
        name: Schedule Appoinment
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P185_APPOINTMENT_ID IS NOT NULL THEN
                    insert into XXEBA_SALES_MEETING_SCHEDULE (APPOINTMENT_ID, SCHEDULE_TYPE, SCHEDULE_SEQUENCE)
                    values(:P185_APPOINTMENT_ID, :P185_NEXT_SCHEDULE, :P185_SCHEDULES_LIST);
                ELSE
                    UPDATE XXEBA_SALES_MEETING_SCHEDULE 
                            SET SCHEDULE_TYPE = :P185_NEXT_SCHEDULE, 
                                    SCHEDULE_SEQUENCE = :P185_SCHEDULES_LIST
                    WHERE APPOINTMENT_ID = :P185_APPOINTMENT_ID;
                END IF;
                
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 202033819585912436
        }
        serverSideCondition {
            type: item=value
            item: P185_NEXT_APPOINTMENT
            value: R
        }
    )


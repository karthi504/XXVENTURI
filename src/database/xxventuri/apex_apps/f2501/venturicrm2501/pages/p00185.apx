    pageItem P185_SALES_REP_NAME (
        type: displayOnly
        label {
            label: Sales Rep
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select REP_FIRST_NAME ||' '|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS
                where  STATUS='Y' and  (upper(ID) in (SELECT upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 100
            region: @form-on-xxeba-sales-appointment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: &USER_ID.
        }
        security {
            encryptSessionState: false
        }
    )


    pageItem P185_APPOINTMENT_STATUS (
        type: radioGroup
        label {
            label: Appointment Status
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                
                SELECT display_value d, return_value r FROM (
                SELECT 1 seq, 'Prepone' display_value, 'Preponed' return_value FROM DUAL
                UNION
                SELECT 2 seq, 'Postpone' display_value, 'Postponed' return_value FROM DUAL
                UNION
                SELECT 3 seq, 'Cancel' display_value, 'Cancelled' return_value FROM DUAL
                UNION
                SELECT 4 seq, 'Visited' display_value, 'Visited' return_value FROM DUAL
                )
                ORDER BY seq
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 240
            region: @form-on-xxeba-sales-appointment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: APPOINTMENT_STATUS
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P185_APPOINTMENT_ID
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments: STATIC2:Prepone,Postpone,Cancel,Visited
        }
    )


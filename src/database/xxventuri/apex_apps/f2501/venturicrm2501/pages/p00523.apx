    dynamicAction set-account-id (
        name: Set Account ID
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .delete-accrow
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: apex_collection.delete_member('P523_ACCOUNT_COLLECTION', :P523_ACCOUNT_ID);
                itemsToSubmit: P523_ACCOUNT_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @accounts-contacts
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @selection-summary
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).parent().data('id')
            }
            affectedElements {
                selectionType: items
                items: P523_ACCOUNT_ID
            }
            execution {
                sequence: 10
            }
        )

    )


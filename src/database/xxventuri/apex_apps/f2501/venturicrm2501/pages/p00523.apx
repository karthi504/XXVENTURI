    region selection-summary (
        name: Selection Summary
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    nvl(acc.accounts,0)   AS accounts_total,
                    nvl(lcc.leads,0)      AS leads_total,
                    (acc.accounts + lcc.leads) total_contacts
                FROM 
                (
                    SELECT
                        COUNT(*) AS accounts
                    FROM
                        apex_collections
                    WHERE
                        collection_name = 'P523_ACCOUNT_COLLECTION'
                ) acc, 
                (
                    SELECT
                        COUNT(*) AS leads
                    FROM
                        apex_collections
                    WHERE
                        collection_name = 'P523_LEADS_COLLECTION'
                ) lcc 
                ```
        }
        layout {
            sequence: 10
            parentRegion: @review-accounts-and-contacts
            slot: wizardSubRegions
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--large
                t-BadgeList--cols t-BadgeList--3cols
                t-BadgeList--circular
            ]
            showNullValuesAs: -
        }


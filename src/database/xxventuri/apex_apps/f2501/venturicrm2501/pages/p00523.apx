    process generate-accounts-collection (
        name: Generate Accounts Collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                	CURSOR Cled is
                	SELECT
                		customer_id,
                		contact_name,
                		contact_email,
                		cus.customer_name,
                		industry_name
                	FROM
                		eba_sales_customer_contacts   con,
                		eba_sales_customers           cus,
                		eba_sales_industries          ind
                	WHERE
                		con.customer_id = cus.id
                		AND cus.industry_id = ind.id
                		AND contact_name IS NOT NULL
                		AND contact_email IS NOT NULL
                		AND instr(':'||:P522_ACCOUNTS||':', ':'||customer_id||':') > 0;
                		rled cled%rowtype;
                BEGIN
                
                	apex_collection.create_or_truncate_collection(p_collection_name      => 'P523_ACCOUNT_COLLECTION');
                										
                	for rled in cled
                	LOOP
                		apex_collection.add_member (p_collection_name      => 'P523_ACCOUNT_COLLECTION',
                									p_c001                 => rled.customer_id,
                                                    p_c002                 => rled.contact_name,
                									p_c003				   => rled.contact_email,
                									p_c004				   => rled.customer_name,
                									p_c005				   => rled.industry_name
                                                   );
                	END LOOP;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 158030785118622134
        }
    )

    process generate-leads-collection (
        name: Generate Leads Collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                	CURSOR Cled is
                	SELECT
                    lead_name_01,
                    lead_email_01,
                    contact_name,
                    (
                        SELECT
                            lead_source
                        FROM
                            eba_sales_acc_sources
                        WHERE
                            id = lead_source_id
                    ) lead_source
                FROM
                    eba_sales_leads
                WHERE
                    instr(':'
                          || :p521_lead_source
                          || ':', ':'
                                  || lead_source_id
                                  || ':') > 0
                    AND account_id IS NULL
                    AND account_name IS NOT NULL
                    AND lead_email_01 IS NOT NULL
                    AND contact_name IS NOT NULL
                UNION
                SELECT
                    lead_name_01,
                    lead_email_01,
                    contact_name,
                    (
                        SELECT
                            lead_source
                        FROM
                            eba_sales_acc_sources
                        WHERE
                            id = lead_source_id
                    ) lead_source
                FROM
                    eba_sales_leads
                WHERE
                    instr(':'
                          || replace(:p521_lead_source, ':', ' ')
                          || ':', ':'
                                  || 0
                                  || ':') = 1
                    AND account_id IS NULL
                    AND account_name IS NOT NULL
                    AND lead_email_01 IS NOT NULL
                    AND contact_name IS NOT NULL;
                		rled cled%rowtype;
                BEGIN
                
                	apex_collection.create_or_truncate_collection(p_collection_name      => 'P523_LEADS_COLLECTION');
                										
                	for rled in cled
                	LOOP
                		apex_collection.add_member (p_collection_name      => 'P523_LEADS_COLLECTION',
                									p_c001                 => rled.lead_name_01,
                                                    p_c002                 => rled.lead_email_01,
                									p_c003				   => rled.contact_name,
                									p_c004				   => rled.lead_source                                  
                                                   );
                	END LOOP;
                END;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 160067364856015497
        }
    )

    process send-mass-email-process (
        name: Send Mass Email Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR ccol IS
                    SELECT
                        c002   AS contact_name,
                        c003   AS contact_email
                    FROM
                        apex_collections
                    WHERE
                        collection_name = 'P523_ACCOUNT_COLLECTION'
                    UNION
                    SELECT
                        c003   AS contact_name,
                        c002   AS contact_email
                    FROM
                        apex_collections
                    WHERE
                        collection_name = 'P523_LEADS_COLLECTION';
                
                    rcol          ccol%rowtype;
                    v_body_html   CLOB;
                    v_body        CLOB;
                    v_mass_email_id NUMBER;
                BEGIN
                    v_body := 'To view the content of this message, please use an HTML enabled mail client.' || utl_tcp.crlf;
                    
                    IF :p520_mail_body_content IS NOT NULL AND :p520_subject IS NOT NULL THEN
                    
                         INSERT INTO xxeba_mass_emails_t (
                                    template_id,
                                    mail_content
                                ) VALUES (
                                    :p520_select_template,
                                    :p520_mail_body_content
                                ) RETURNING mass_email_id INTO v_mass_email_id;
                                
                        FOR rcol IN ccol LOOP
                            v_body_html := replace(:p520_mail_body_content, '#Name#', rcol.contact_name);
                            
                            BEGIN               
                                INSERT INTO xxeba_mass_email_details_t (
                                    mass_email_id,
                                    mail_to,
                                    mail_cc,
                                    subject,
                                    contact_name                    
                                ) VALUES (
                                    v_mass_email_id,
                                    rcol.contact_email,
                                    NULL,
                                    :p520_subject,
                                    rcol.contact_name                    
                                );
                
                            END;
                
                            apex_mail.send(
                                           p_to         => rcol.contact_email, 
                                           p_from       => 'CRM Desk "@" Venturi Tools <crm_desk@4iapps.com>', 
                                           p_subj       => :p520_subject, 
                                           p_body       => v_body, 
                                           p_body_html  => v_body_html
                                           );
                                     apex_mail.push_queue(p_smtp_hostname => '4iapps-com.mail.protection.outlook.com', p_smtp_portno => 25);                             
                        END LOOP;
                    END IF;
                    apex_collection.truncate_collection('P523_LEADS_COLLECTION');
                    apex_collection.truncate_collection('P523_ACCOUNT_COLLECTION');
                EXCEPTION WHEN OTHERS THEN
                raise_application_error(-20001, SQLERRM);
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Mail Sent Successfully.
        }
        advanced {
            executionMappingIdentifier: 160069058433015514
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 10
            point: validating
        }
        behavior {
            target: {

    pageItem P523_MAIL_CONTENT_NAME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @subject-p520-subject
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                
                 v_name varchar2(4000);
                BEGIN
                      BEGIN
                        SELECT
                            c002 into v_name
                        FROM
                          apex_collections
                        WHERE collection_name = 'P523_ACCOUNT_COLLECTION'  
                        and seq_id = 1;
                      EXCEPTION WHEN NO_DATA_FOUND THEN
                         BEGIN   
                            SELECT
                                c001 into v_name
                            FROM
                              apex_collections
                            WHERE collection_name = 'P523_LEADS_COLLECTION'
                            and seq_id = 1;
                         EXCEPTION WHEN NO_DATA_FOUND THEN
                            v_name := '#Name#';
                         END;
                      END;
                
                return v_name;
                
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )


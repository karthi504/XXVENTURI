page 527 (
    name: Apex Screen Capture
    title: Apex Screen Capture
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #APP_IMAGES#spin.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var video = document.getElementById('video');
            var videoStream;
            var canvas = document.getElementById('canvas');
            var context = canvas.getContext('2d');
            
            var spinner;
            var spinTargetElem = document.getElementById('wwvFlowForm');
            var spinOptions = {
              lines: 13
            , length: 28
            , width: 14
            , radius: 42
            , scale: 1
            , corners: 1
            , color: '#000'
            , opacity: 0.25
            , rotate: 0
            , direction: 1
            , speed: 1
            , trail: 60
            , fps: 20
            , zIndex: 2e9
            , className: 'spinner'
            , top: '50%'
            , left: '50%'
            , shadow: false
            , hwaccel: false
            , position: 'absolute'
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region capture-photo (
        name: capture photo
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="text-align:center;">
                  <video id="video" width="450" height="220" autoplay></video>
                  <canvas id="canvas" width="450" height="220" style="display:none;"></canvas>
                </div>
                ```
        }
        layout {
            sequence: 1220
            slot: body
            column: 1
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new (
        name: New
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select photos.seq_id,
                       photos.seq_id as view_photo
                from apex_collections photos
                where photos.collection_name = 'PHOTOS'
                ```
        }
        layout {
            sequence: 1240
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column SEQ_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Seq Id
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column VIEW_PHOTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: View Photo
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

    )

    region new-2 (
        name: New
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  l_photo_clob clob;
                  l_photo_blob blob;
                  v_base64_content CLOB;
                  v_step PLS_INTEGER := 12000;
                
                  
                begin
                  select blob001
                  into l_photo_blob
                  from apex_collections
                  where collection_name = 'PHOTOS'
                  and seq_id = 1;
                  
                  --:P527_PHOTO_SEQ_ID
                 FOR i IN 0 .. TRUNC((DBMS_LOB.getlength(l_photo_blob) - 1 )/v_step) LOOP
                        v_base64_content := v_base64_content || replace(replace(UTL_RAW.cast_to_varchar2(UTL_ENCODE.base64_encode(DBMS_LOB.substr(l_photo_blob, v_step, i * v_step + 1))),chr(10)),chr(13));
                    END LOOP;
                    
                  --P527_PHOTO_SEQ_ID
                 /* l_photo_clob := apex_web_service.blob2clobbase64(
                                    p_blob => l_photo_blob
                                  );*/
                                  
                        
                 --  :P527_PHOTO_BASE64:= v_base64_content;
                  -- htp.p(v_base64_content);
                   
                 INSERT INTO base64_test(base64_content) VALUES(v_base64_content);  
                 /* apex_json.open_object;
                  apex_json.write('photoBase64', l_photo_clob);
                  apex_json.close_object;*/
                end;
                
                ```
        }
        layout {
            sequence: 1230
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )


    dynamicAction show-camera (
        name: SHOW_CAMERA
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @capture-photo
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction show-photo (
        name: SHOW_PHOTO
        execution {
            sequence: 50
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P527_PHOTO_SEQ_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    spinner = new Spinner(spinOptions).spin(spinTargetElem);
                    video.style.display = 'none';
                    canvas.style.display = 'inline-block';
                    
                    apex.server.process(
                      'GET_PHOTO',
                      {},
                    	{
                        success: function(data) {
                                   var image = new Image();
                                   image.onload = function() {
                                     context.drawImage(image, 0, 0);
                                   };
                                   image.src = 'data:image/png;base64,' + data.photoBase64;
                                   
                                   spinner.stop();
                                 }
                      }
                    );
                    ```
            }
            affectedElements {
                selectionType: items
                items: P527_PHOTO_BASE64
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction snap-photo (
        name: snap photo
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @snap-photo
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    spinner = new Spinner(spinOptions).spin(spinTargetElem);
                    context.drawImage(video, 0, 0, 384, 288);
                    video.style.display = 'none';  
                    canvas.style.display = 'inline-block'; 
                    videoStream.getTracks()[0].stop(); 
                    
                    apex.server.process(
                      'SAVE_PHOTO',
                      {
                        p_clob_01: canvas.toDataURL().match(/,(.*)$/)[1]
                    	},
                    	{
                        success: function(data) {
                                   if (data.result == 'success') {
                                     apex.submit('SNAP_PHOTO');
                                   }
                                 }
                      }
                    );
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process get-photo (
        name: GET_PHOTO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_photo_clob clob;
                  l_photo_blob blob;
                  v_base64_content CLOB;
                  v_step PLS_INTEGER := 12000;
                
                begin
                
                  select blob001
                  into l_photo_blob
                  from apex_collections
                  where collection_name = 'PHOTOS'
                  and seq_id = :P527_PHOTO_SEQ_ID;
                
                 FOR i IN 0 .. TRUNC((DBMS_LOB.getlength(l_photo_blob) - 1 )/v_step) LOOP
                        v_base64_content := v_base64_content || replace(replace(UTL_RAW.cast_to_varchar2(UTL_ENCODE.base64_encode(DBMS_LOB.substr(l_photo_blob, v_step, i * v_step + 1))),chr(10)),chr(13));
                    END LOOP;
                                    
                -- INSERT INTO base64_test(base64_content) VALUES(v_base64_content);  
                
                   apex_json.open_object;
                  apex_json.write('photoBase64', l_photo_clob);
                  apex_json.close_object;
                end;
                
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 633350072357432670
        }
        serverSideCondition {
            type: never
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                v_number NUMBER;
                l_photo_clob clob;
                  l_photo_blob blob;
                  v_base64_content CLOB;
                  v_step PLS_INTEGER := 12000;
                  v_clob CLOB;
                v_body_content CLOB;
                v_mail_response CLOB;
                BEGIN
                /*SELECT DBMS_LOB.GETLENGTH(blob001) 
                INTO v_number 
                from apex_collections where collection_name = 'PHOTOS'
                AND  seq_id = 1 ;
                */
                  select blob001
                  into l_photo_blob
                  from apex_collections
                  where collection_name = 'PHOTOS'
                  and seq_id = 1;
                 -- :P527_PHOTO_SEQ_ID;
                
                FOR i IN 0 .. TRUNC((DBMS_LOB.getlength(l_photo_blob) - 1 )/v_step) LOOP
                        v_base64_content := v_base64_content || replace(replace(UTL_RAW.cast_to_varchar2(UTL_ENCODE.base64_encode(DBMS_LOB.substr(l_photo_blob, v_step, i * v_step + 1))),chr(10)),chr(13));
                    END LOOP;
                
                 INSERT INTO base64_test(base64_content) VALUES(v_base64_content);  
                
                   v_body_content :=  '{"file":"data:image/png;base64,'||v_base64_content ||'
                                                    "}';	
                                                    
                 xxfs_pm_error_log_pkg.record_log('LOG','CAMERA_ACCESS','v_body_content '||v_clob,4); 
                 
                apex_web_service.g_request_headers.DELETE();
                     apex_web_service.g_request_headers(1).name  := 'Content-Type';
                     apex_web_service.g_request_headers(1).value := 'application/json';
                        
                     v_mail_response := apex_web_service.make_rest_request(p_url          => 'https://events.4iapps.com:9002/barcodereader/api/getcode',
                                                                           p_http_method  => 'POST',	
                                                                           p_body		 => v_body_content
                                                                             );
                
                
                apex_collection.delete_collection(p_collection_name => 'PHOTOS');
                --raise_application_error(-20001,'photo' ||v_number);
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 633350512335432674
        }
        serverSideCondition {
            whenButtonPressed: @snap-photo
            type: never
        }
    )

    process new-2 (
        name: New_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_number NUMBER;
                  l_photo_clob clob;
                  l_photo_blob blob;
                  v_base64_content CLOB;
                  v_step PLS_INTEGER := 12000;
                  v_clob CLOB;
                  v_body_content CLOB;
                  v_barcode varchar2(100);
                  v_response CLOB;
                  json_content APEX_JSON.t_values;
                
                BEGIN
                
                /*SELECT DBMS_LOB.GETLENGTH(blob001) 
                INTO v_number 
                from apex_collections where collection_name = 'PHOTOS'
                AND  seq_id = 1 ;
                */
                
                  select blob001
                  into l_photo_blob
                  from apex_collections
                  where collection_name = 'PHOTOS'
                  and seq_id = (select max(seq_id) from apex_collections where collection_name = 'PHOTOS');
                 -- :P527_PHOTO_SEQ_ID;
                
                    FOR i IN 0 .. TRUNC((DBMS_LOB.getlength(l_photo_blob) - 1 )/v_step) LOOP
                        v_base64_content := v_base64_content || replace(replace(UTL_RAW.cast_to_varchar2(UTL_ENCODE.base64_encode(DBMS_LOB.substr(l_photo_blob, v_step, i * v_step + 1))),chr(10)),chr(13));
                    END LOOP;
                
                
                /*
                  FOR V_I IN 0..TRUNC((DBMS_LOB.GETLENGTH(l_photo_blob) - 1 ) / v_step) LOOP
                          v_base64_content := v_base64_content || UTL_RAW.CAST_TO_VARCHAR2(
                                                                       UTL_ENCODE.BASE64_ENCODE(
                                                                                                DBMS_LOB.SUBSTR(
                                                                                                                l_photo_blob,
                                                                                                                v_step,
                                                                                                                V_I * v_step + 1
                                                                                                               )
                                                                                               )
                                                                      );
                   END LOOP;
                */
                
                   v_body_content :=  '{"file":"data:image/png;base64,'||v_base64_content ||'"}';	
                
                --- INSERT INTO barcode_base64(base64_content, barcode_number) VALUES(v_base64_content, v_barcode);  
                INSERT INTO base64_test(base64_content) VALUES(v_body_content);  
                
                 ---raise_application_error(-20100,v_body_content);                                   
                 --xxfs_pm_error_log_pkg.record_log('LOG','CAMERA_ACCESS','v_body_content '||v_clob,4); 
                 
                apex_web_service.g_request_headers.DELETE();
                     apex_web_service.g_request_headers(1).name  := 'Content-Type';
                     apex_web_service.g_request_headers(1).value := 'application/json';
                        
                     v_response := apex_web_service.make_rest_request(p_url          => 'http://events.4iapps.com/barcodereader/api/getcode',
                                                                      p_http_method  => 'POST',	
                                                                      p_body		 => v_body_content
                                                                     );
                
                ---raise_application_error(-20100,v_response);
                
                ---APEX_JSON.parse(v_response);
                ---- v_barcode := apex_json.get_varchar2('code');
                
                --- INSERT INTO barcode_base64(base64_content, barcode_number) VALUES(v_response, v_barcode);  
                INSERT INTO base64_test(base64_content) VALUES(v_response);
                --  https://events.4iapps.com:9002/barcodereader/api/getcode
                
                apex_collection.delete_collection(p_collection_name => 'PHOTOS');
                ----raise_application_error(-20001,'photo' ||v_number);
                ---exception when others then
                 ---   null;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 622649303161583980
        }
    )

    process save-photo (
        name: SAVE_PHOTO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_photo_clob clob;
                  l_photo_blob blob;
                begin
                
                --raise_application_error(-20001,'Hai');
                  l_photo_clob := apex_application.g_clob_01;
                 
                  --raise_application_error(-20001,'base64 '||l_photo_clob);       
                  
                  l_photo_blob := apex_web_service.clobbase642blob(
                                    p_clob => l_photo_clob
                                  );
                -- l_photo_clob:= BLOB_TO_BASE64()                
                
                --raise_application_error(-20001,'Hai'||l_photo_blob); 
                --l_photo_clob             		 := :P527_PHOTO_BASE64;
                
                --raise_application_error(-20001,'Hai'||:P527_PHOTO_BASE64);
                
                  apex_collection.add_member(
                    p_collection_name => 'PHOTOS',
                    p_blob001 => l_photo_blob
                     );
                
                
                  -- update XXFS_PM_VISITOR_LOG_T set DOCUMENT_FILE = l_photo_blob, VISIT_INTIME = SYSTIMESTAMP where VISITLOG_ID = :P110_VISITLOG_ID;
                
                  apex_json.open_object;
                  apex_json.write(
                    p_name => 'result',
                    p_value => 'success'
                  );
                  apex_json.close_object;
                
                --:APP_PHOTO:= l_photo_clob;
                --apex_collection.delete_collection(p_collection_name => 'PHOTOS');
                
                exception
                  when others then
                    apex_json.open_object;
                    apex_json.write(
                      p_name => 'result',
                      p_value => 'fail'
                    );
                    apex_json.close_object;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 633350006303432669
        }
    )

    process set-photo-collection (
        name: Set Photo collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  lco_photos_collection_name constant apex_collections.collection_name%type := 'PHOTOS';
                begin
                
                  if not apex_collection.collection_exists(lco_photos_collection_name) then
                     apex_collection.create_collection(
                         p_collection_name => lco_photos_collection_name
                        );
                end if;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 633348282708432652
        }
    )

)


page 190 (
    name: Complaints
    title: Complaints
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region complaints (
        name: Complaints
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1220
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                 CASE 
                    WHEN  cc.STATUS in ('N', 'I') THEN
                      '<a href="'
                     ||apex_util.prepare_url ('f?p='
                     ||:app_id
                     ||':194:'
                     ||:app_session
                     || '::NO:194:P194_COMPLAINT_ID:'
                     || COMPLAINT_ID) ||'"><i style = "cursor: pointer; color: blue;  font-size:24px"  class="fa  fa-check-square-o"></i></a>'
                    ELSE  null
                    END UPDATE_STATUS,
                 CASE 
                    WHEN  cc.STATUS = 'C' THEN
                      '<a href="'
                     ||apex_util.prepare_url ('f?p='
                     ||:app_id
                     ||':195:'
                     ||:app_session
                     || '::NO:195:P195_COMPLAINT_ID:'
                     || COMPLAINT_ID) ||'"><i style = "cursor: pointer; color: blue;  font-size:24px"  class="fa  fa-check-square-o"></i></a>'
                    ELSE  null
                    END VERIFY_UPDATE,
                cc.COMPLAINT_ID, 
                cc.COMPLAINT_NUMBER,
                cc.ACCOUNT_ID,
                cc.RAISED_DATE,
                cc.RAISED_BY,
                cc.CONTACT_NUMBER,
                cc.RAISED_SOURCE,
                cc.COMPLAINT_TYPE,
                cc.COMPLAINT_PRODUCTS,
                cc.COMPLAINT_SUBJECT,
                cc.COMPLAINT_DESC,
                cc.ASSIGNED_TO,
                cc.ROOT_CAUSE,
                cc.CORRECTIVE_ACTION,
                cc.PREVENTIVE_ACTION,
                cc.RESOLVED_REMARKS,
                cc.RESOLVED_BY,
                cc.RESOLVED_DATE,
                cc.VERIFIED_REMARKS,
                cc.VERIFIED_BY,
                cc.VERIFIED_DATE,
                decode(cc.STATUS,'N','New',
                                 'I','In Progress',
                                 'C','Completed',
                                 'X','Deleted',
                                 'V','Verified') STATUS,
                cc.CREATED,
                cc.CREATED_BY,
                cc.UPDATED,
                cc.UPDATED_BY,
                (SELECT listagg( p.product_name
                  ||' ['
                  ||CATALOGUE_NO
                  ||']' , ', ') within GROUP(
                ORDER BY product_name)
                FROM XXEBA_CUSTOMER_COMPLAINTS_T c,
                  eba_sales_PRODUCTS p
                WHERE instr(':'
                  ||COMPLAINT_PRODUCTS
                  ||':', ':'
                  ||p.id
                  ||':')         > 0
                AND c.COMPLAINT_ID = cc.COMPLAINT_ID) as products_list
                from XXEBA_CUSTOMER_COMPLAINTS_T cc,
                eba_sales_salesreps sr,
                  eba_sales_customers c
                where sr.id              = cc.ASSIGNED_TO
                and cc.ACCOUNT_ID          = c.id
                and (upper(cc.ASSIGNED_TO) in
                  (select upper(r.id)
                  from eba_sales_salesreps r
                    start with r.id      = :user_id
                    connect by prior r.id= r.rep_manager_id
                  )
                or exists
                  (select 'y'
                  from eba_sales_salesreps r,
                    eba_sales_salesrep_roles sr
                  where r.id       = :user_id
                  and sr.id        = r.rep_role
                  and sr.role_name IN ('Administrator','Sales Co-Ordinator')  --- Sales Co-Ordinator role added by bharath raju on 25-Aug-2023
                  )); 
                
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 191
                items: {
                    P191_COMPLAINT_ID: #COMPLAINT_ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil-alt.png" class="apex-edit-pencil-alt" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 294443191549115499
        }


page 171 (
    name: Account Products
    title: Account Products
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "ID", 
                "CUSTOMER_ID",
                "PRODDUCT_GROUP_ID",
                "HSN_CODE",
                "MONTHLY_VOLUME",
                "UNIT_OF_MEASURES",
                "BRAND_ID",
                "ORDER_FREQUENCY",
                "REMARKS"
                from "#OWNER#"."XXEBA_SALES_ACC_PRODUCTS" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 172
                items: {
                    P172_ID: #ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 128714382500252773
        }

        column BRAND_ID (
            type: plainText
            heading {
                heading: Brand Id
            }
            layout {
                sequence: 7
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column CUSTOMER_ID (
            type: plainText
            heading {
                heading: Customer Id
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column HSN_CODE (
            type: plainText
            heading {
                heading: Hsn Code
            }
            layout {
                sequence: 4
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column MONTHLY_VOLUME (
            type: plainText
            heading {
                heading: Monthly Volume
            }
            layout {
                sequence: 5
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ORDER_FREQUENCY (
            type: plainText
            heading {
                heading: Order Frequency
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column PRODDUCT_GROUP_ID (
            type: plainText
            heading {
                heading: Prodduct Group Id
            }
            layout {
                sequence: 3
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column REMARKS (
            type: plainText
            heading {
                heading: Remarks
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column UNIT_OF_MEASURES (
            type: plainText
            heading {
                heading: Unit Of Measures
            }
            layout {
                sequence: 6
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 1287204 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BRAND_ID (
                sequence: 7
            )

            displayColumn CUSTOMER_ID (
                sequence: 2
            )

            displayColumn HSN_CODE (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn MONTHLY_VOLUME (
                sequence: 5
            )

            displayColumn ORDER_FREQUENCY (
                sequence: 8
            )

            displayColumn PRODDUCT_GROUP_ID (
                sequence: 3
            )

            displayColumn REMARKS (
                sequence: 9
            )

            displayColumn UNIT_OF_MEASURES (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 172
                clearCache: 172
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


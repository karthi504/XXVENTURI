            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            cssClasses: mnw180
        }
        source {
            type: databaseColumn
            databaseColumn: ACCOUNT_STANDING_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )


    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 40
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create Opportunity
        layout {
            sequence: 30
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P16_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 50
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 20
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation p16-deal-amount-not-null (
        name: P16_DEAL_AMOUNT Not Null
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P16_DEAL_AMOUNT
        }
        error {
            errorMessage: #LABEL# must have some value.
            displayLocation: inlineWithField
        }
        config {
            buildOption: 2564105947780700774
        }
    )

    validation p16-deal-probability-is-not-0-or (
        name: P16_DEAL_PROBABILITY is not 0 or 100
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P16_DEAL_PROBABILITY not in ('0', '100')
        }
        error {
            errorMessage: Use the Close Won/Lost button to set #LABEL# to 0 or 100.
            associatedItem: @P16_DEAL_PROBABILITY
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation p16-deal-status-code-id-not-in (
        name: P16_DEAL_STATUS_CODE_ID not in (4, 11)
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P16_DEAL_STATUS_CODE_ID not in ('4', '11')
        }
        error {
            errorMessage: Use the Close Won/Lost button to set #LABEL# to a "closed" value.
            associatedItem: @P16_DEAL_STATUS_CODE_ID
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    computation p80-id (
        itemName: P80_ID
        execution {
            sequence: 10
            point: afterFooter
        }
        computation {
            type: staticValue
            staticValue: &P16_ID.
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P16_DEAL_NAME
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 737770011612542778
        }
        serverSideCondition {
            type: request!=Value
            value: DELETE
        }
    )

    process fetch-row-from-eba-sales-deals (
        name: Fetch Row from EBA_SALES_DEALS
        type: autoRowFetch
        source {
            tableName: EBA_SALES_DEALS
            pkColumn: ID
            pkItem: P16_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 4690876431235395409
        }
    )

    process process-row-of-eba-sales-deals (
        name: Process Row of EBA_SALES_DEALS
        type: autoRowProcessing
        target {
            tableName: EBA_SALES_DEALS
            pkColumn: ID
            pkItem: P16_ID
            returnKeyIntoItem: P16_ID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table EBA_SALES_DEALS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 4690876649440395412
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 4690876821483395413
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process update-sales-deal-sales-rep (
        name: Update Sales Deal Sales Rep
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    cursor crep is select SALESREP_ID_01 from EBA_SALES_DEALS  where id = :P16_ID;
                    rrep crep%rowtype;
                BEGIN
                
                    open crep;
                    fetch crep into rrep;
                    close crep;
                
                    IF rrep.SALESREP_ID_01 != :P16_SALESREP_ID_01 THEN
                
                        update XXEBA_SALES_ORDER  set sales_rep = :P16_SALESREP_ID_01
                        where DEAL_ID = :P16_ID
                        and nvl(UPDATED_IN_TALLY,'N') = 'N';
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 188707379484923555
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    branch (
        name: Branch to Opportunities on delete
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)


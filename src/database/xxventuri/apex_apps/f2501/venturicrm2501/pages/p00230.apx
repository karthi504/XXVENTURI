    dynamicAction null-validation (
        name: Null Validation
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @/export
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if($v('P230_FROM_DATE') == "" || $v('P230_FROM_DATE') == null){
                        $('#P230_FROM_DATE_error_placeholder').html('<span class="t-Form-error">Please fill out this field.</span>');
                    }
                    else if($v('P230_TO_DATE') == "" || $v('P230_TO_DATE') == null){
                        $('#P230_FROM_DATE_error_placeholder').html('');
                        $('#P230_TO_DATE_error_placeholder').html('<span class="t-Form-error">Please fill out this field.</span>');
                    }
                    else{
                        apex.submit( 'EXPORT');
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction send-sms (
        name: Send SMS
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: request=Value
            value: CREATE_ORDER
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var mob_no = $v('P230_CONTACT_NUMBER');
                    var message = "Dear Customer, We thank you for your Order dated "+$v('P230_PO_DATE')+". Order confirmation No. "+$v('P230_ORDER_NUMBER')+". We will deliver your material soon. Team Venturi";
                    $.ajax({ type: 'GET', url: 'http://totalsmsindia.in/httpapi/httpapi?token=0c02420dacfff109e3696d15e6e2e96e&sender=VTteam&number='+mob_no+'&route=2&type=1&sms='+message, dataType: "html", success: function(data, textStatus, jqXHR) 
                    { alert("success"); } }); 
                    ```
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select SO.PO_NUMBER, SO.PO_DATE, SC.MOBILE_NUMBER,SO.ORDER_NUMBER 
                        from XXEBA_SALES_ORDER SO, EBA_SALES_CUSTOMERS SC 
                          where SO.ORDER_ID = :P230_ORDER_ID and SO.CUSTOMER_ID = SC.ID
                    ```
                itemsToSubmit: P230_ORDER_ID
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P230_PO_NUMBER
                    P230_PO_DATE
                    P230_CONTACT_NUMBER
                    P230_ORDER_NUMBER
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-to-date-limit (
        name: Set To Date Limit
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P230_FROM_DATE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#P230_TO_DATE").datepicker( "option","minDate",$v('P230_FROM_DATE'));
                    $("#P230_TO_DATE").next().addClass('ui-datepicker-trigger a-Button a-Button--calendar');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process update-flag (
        name: Update Flag
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Note : Sales Order Default Value is N once exported it will change to P onceagain download means it will change into Y */
                
                Begin
                for rec in (select SO.ORDER_ID ID  from
                XXEBA_ORDER_PRODUCTS OP,
                XXEBA_SALES_ORDER SO,
                EBA_SALES_TERRITORIES T,
                EBA_SALES_CUSTOMERS C,
                EBA_SALES_SALESREPS R,
                EBA_SALES_CUSTOMER_LOCATIONS L,
                XXEBA_SALES_CITIES_T CT,
                EBA_SALES_STATES ST,
                EBA_SALES_COUNTRIES CN,
                EBA_SALES_PRODUCTS SP
                where 
                OP.ORDER_ID = SO.ORDER_ID
                and C.CUSTOMER_TERRITORY_ID = T.ID
                and SO.CUSTOMER_ID = C.ID
                and SO.SALES_REP = R.ID
                and SO.DELIVERY_LOCATION = L.ID(+)
                and L.CITY_ID = CT.CITY_ID(+)
                and L.STATE_ID = ST.ID(+)
                and L.COUNTRY_ID = CN.ID(+)
                and OP.PRODUCT_ID = SP.ID
                and SO.STATUS = 'Y' and SO.EXPORT_FLAG='N'
                and trunc(SO.ORDER_DATE) between :P230_FROM_DATE  and  :P230_TO_DATE )
                loop
                update XXEBA_SALES_ORDER SET EXPORT_FLAG ='P'  where ORDER_ID =rec.ID and NVL(EXPORT_FLAG,'N') !='Y'    ;
                END LOOP;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 320678208929091964
        }
    )

    process update-flag-into-y (
        name: Update flag into Y
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Note : Sales Order Default Value is N once exported it will change to P onceagain download means it will change into Y */
                Begin
                update XXEBA_SALES_ORDER SET EXPORT_FLAG ='Y'  where EXPORT_FLAG='P';
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 320677925502091964
        }
    )

    branch (
        name: Go To Page 183
        execution {

page 120 (
    name: Brand Details
    title: Brand Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-xxeba-sales-product-brands (
        name: Form on XXEBA_SALES_PRODUCT_BRANDS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P120_BRAND_CODE (
        type: textField
        label {
            label: Brand Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-on-xxeba-sales-product-brands
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 15
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_CODE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P120_BRAND_DESCRIPTION (
        type: textarea
        label {
            label: Brand Description
            alignment: left
        }
        layout {
            sequence: 40
            region: @form-on-xxeba-sales-product-brands
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 68
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_DESCRIPTION
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P120_BRAND_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-xxeba-sales-product-brands
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P120_BRAND_NAME (
        type: textField
        label {
            label: Brand Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @form-on-xxeba-sales-product-brands
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 7
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_NAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P120_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @xx-status-lov
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @form-on-xxeba-sales-product-brands
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P120_BRAND_ID
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Add Brand
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P120_BRAND_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P120_BRAND_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 67218474211545281
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-xxeba-sales-product-brands (
        name: Fetch Row from XXEBA_SALES_PRODUCT_BRANDS
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_PRODUCT_BRANDS
            pkColumn: BRAND_ID
            pkItem: P120_BRAND_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 67217283496545280
        }
    )

    process process-row-of-xxeba-sales-product-brands (
        name: Process Row of XXEBA_SALES_PRODUCT_BRANDS
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_PRODUCT_BRANDS
            pkColumn: BRAND_ID
            pkItem: P120_BRAND_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 67217746510545280
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 67218082351545280
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)


    region customers-visit-details (
        name: Customers Visit Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CUSTOMER_NAME, SALESREPS, TERRITORY_NAME, NEXT_VISIT_DATE, LAST_SCHEDULE_DATE, LAST_VISITED_DATE, (case when LAST_SCHEDULE_DATE <= LAST_VISITED_DATE then 'Yes' else 'No' end) VISIT_DUE
                from (select C.CUSTOMER_NAME, SR.REP_FIRST_NAME||' '||SR.REP_LAST_NAME SALESREPS, CT.TERRITORY_NAME, get_nextappointment(A.APPOINTMENT_ID)  NEXT_VISIT_DATE, get_lastschedule(A.APPOINTMENT_ID) LAST_SCHEDULE_DATE,
                	   (select max(A.APPOINTMENT_DATE) from XXEBA_SALES_APPOINTMENT A where A.CUSTOMER_ID = c.ID and A.APPOINTMENT_STATUS = 'Visited')  LAST_VISITED_DATE
                from XXEBA_SALES_CUSTOMER_DETAILS CD, 
                	 EBA_SALES_CUSTOMERS C, 
                	 EBA_SALES_SALESREPS SR,
                	 EBA_SALES_TERRITORIES CT,
                     XXEBA_SALES_APPOINTMENT A
                where c.ID = CD.CUSTOMER_ID
                  and C.DEFAULT_REP_ID = SR.ID
                  and C.CUSTOMER_TERRITORY_ID = CT.ID
                  and CD.VISIT_FREQUENCY_REC is not null
                  and A.CUSTOMER_ID = c.ID
                  and A.CUSTOMER_DETAIL_ID is not null)
                /*select C.CUSTOMER_NAME, VF.FREQUENCY_DAYS, VF.VISIT_FREQUENCY, SR.REP_FIRST_NAME||' '||SR.REP_LAST_NAME SALESREPS, CT.TERRITORY_NAME,
                	   (select max(A.APPOINTMENT_DATE) from XXEBA_SALES_APPOINTMENT A where A.CUSTOMER_ID = c.ID and A.APPOINTMENT_STATUS = 'Visited')  LAST_VISITED_DATE,
                	   (select max(A.APPOINTMENT_DATE) from XXEBA_SALES_APPOINTMENT A where A.CUSTOMER_ID = c.ID and A.APPOINTMENT_STATUS = 'Visited')+VF.FREQUENCY_DAYS  NEXT_VISIT_DATE,
                       (case when trunc((select max(A.APPOINTMENT_DATE) from XXEBA_SALES_APPOINTMENT A where A.CUSTOMER_ID = c.ID and A.APPOINTMENT_STATUS = 'Visited')+VF.FREQUENCY_DAYS) < trunc(sysdate) then 'Yes' else 'No' end) VISIT_DUE
                from XXEBA_SALES_CUSTOMER_DETAILS CD, 
                	 EBA_SALES_CUSTOMERS C, 
                	 XXEBA_SALES_VISIT_FREQUENCY VF,
                	 EBA_SALES_SALESREPS SR,
                	 EBA_SALES_TERRITORIES CT
                where c.ID = CD.CUSTOMER_ID
                  and CD.VISIT_FREQUENCY_REC = VF.ID
                  and C.DEFAULT_REP_ID = SR.ID
                  and C.CUSTOMER_TERRITORY_ID = CT.ID
                  and CD.VISIT_FREQUENCY_REC is not null;
                 */
                 ;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 202369916599393523
        }


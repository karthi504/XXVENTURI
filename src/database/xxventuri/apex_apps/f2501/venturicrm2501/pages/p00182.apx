page 182 (
    name: Upload data
    title: Upload data
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region upload-data (
        name: Upload data
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P182_ATTACHMENT_TYPE (
        type: textField
        label {
            label: Attachment Type
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 160
            region: @upload-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            type: databaseColumn
            databaseColumn: ATTACHMENT_TYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P182_DEAL_ID (
        type: textField
        label {
            label: Deal id
            alignment: left
        }
        layout {
            sequence: 170
            region: @upload-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: DEAL_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P182_ENTITY_TYPE (
        type: textField
        label {
            label: Entity Type
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 100
            region: @upload-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            type: databaseColumn
            databaseColumn: ENTITY_TYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P182_FILE_BLOB (
        type: fileUpload
        label {
            label: File Blob
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            mimeTypeColumn: FILE_MIMETYPE
            filenameColumn: FILENAME
            charSetColumn: FILE_CHARSET
            bobLastUpdatedColumn: UPDATED
        }
        layout {
            sequence: 70
            region: @upload-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: FILE_BLOB
            used: always
        }
    )

    pageItem P182_FILE_COMMENTS (
        type: textarea
        label {
            label: File Comments
            alignment: right
        }
        layout {
            sequence: 80
            region: @upload-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: FILE_COMMENTS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P182_ID (
        type: textField
        label {
            label: ID
            alignment: left
        }
        layout {
            sequence: 10
            region: @upload-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @upload-data
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 182
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @upload-data
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P182_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @upload-data
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P182_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @upload-data
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    process fetch-row-from-eba-sales-files (
        name: Fetch Row from EBA_SALES_FILES
        type: autoRowFetch
        source {
            tableName: EBA_SALES_FILES
            pkColumn: ID
            pkItem: P182_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 91414944750695716
        }
    )

    process process-row-of-eba-sales-files (
        name: Process Row of EBA_SALES_FILES
        type: autoRowProcessing
        target {
            tableName: EBA_SALES_FILES
            pkColumn: ID
            pkItem: P182_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 91415276392695717
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 91415699494695717
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 182
            }
        }
    )

)


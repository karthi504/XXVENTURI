    process load-collection-data (
        name: Load Collection Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_collection_name VARCHAR2 (30) := 'PRODUCT_COLLECTION';
                  
                BEGIN
                
                  IF apex_collection.collection_exists (p_collection_name => v_collection_name) THEN
                     apex_collection.delete_collection (p_collection_name => v_collection_name);
                  END IF;
                  apex_collection.create_or_truncate_collection (p_collection_name => v_collection_name);
                  
                  IF :P103_COPY_ORDER = 'S' THEN
                    FOR prc IN
                    (SELECT NULL ORDER_PRODUCTS_ID,ORD.ORDER_ID,
                      ORD.PRODUCT_NAME,
                      ORD.PRODUCT_PRICE,
                      ORD.CURRENCY_TYPE,
                      ORD.BRAND_ID,
                      ORD.QUANTITY,
                      ORD.DELIVERY_DATE,
                      ORD.PRODUCT_ID,
                      PRD.PRODUCT_COST,
                      PRD.margin,
                     (select sum(S.QTY_IN_STOCK) from XXEBA_TALLY_STOCK_T S where S.PRODUCT_CODE= PRD.ROW_KEY and 
                S.BATCH_SEQUENCE = (select MAX(BATCH_SEQUENCE)from XXEBA_TALLY_STOCK_T )) STOCK
                    FROM XXEBA_ORDER_PRODUCTS ORD,
                         eba_sales_products  PRD
                    WHERE ORD.PRODUCT_ID = PRD.ID(+)
                    AND ORD.ORDER_ID = :P103_ORDER_ID
                    )
                    LOOP
                      apex_collection.add_member (p_collection_name => v_collection_name, 
                                                  p_n001 => prc.ORDER_PRODUCTS_ID, 
                                                  p_n002 => prc.ORDER_ID, 
                                                  p_c001 => prc.PRODUCT_NAME, 
                                                  p_n003 => prc.PRODUCT_PRICE, 
                                                  p_c002 => prc.CURRENCY_TYPE, 
                                                  p_n004 => prc.BRAND_ID, 
                                                  p_c003 => prc.QUANTITY, 
                                                  p_c004 => prc.DELIVERY_DATE, 
                                                  p_n005 => prc.PRODUCT_ID,
                                             --   p_n006 => prc.margin,
                                                  p_c006 => to_char(prc.PRODUCT_COST,'999G999G999G999G990D00'),
                                                  p_c007 => prc.STOCK,
                                                  p_c008 => prc.margin
                                                 );
                    END LOOP;
                  ELSE
                    FOR prc IN
                    (SELECT ORD.ORDER_PRODUCTS_ID,
                      ORD.ORDER_ID,
                      ORD.PRODUCT_NAME,
                      ORD.PRODUCT_PRICE,
                      ORD.CURRENCY_TYPE,
                      ORD.BRAND_ID,
                      ORD.QUANTITY,
                      ORD.DELIVERY_DATE,
                      ORD.PRODUCT_ID,
                      PRD.MARGIN,
                      PRD.PRODUCT_COST,
                     (select sum(S.QTY_IN_STOCK) from XXEBA_TALLY_STOCK_T S where S.PRODUCT_CODE= PRD.ROW_KEY and 
                S.BATCH_SEQUENCE = (select MAX(BATCH_SEQUENCE)from XXEBA_TALLY_STOCK_T )) STOCK
                    FROM XXEBA_ORDER_PRODUCTS ORD,
                       eba_sales_products  PRD
                    WHERE ORD.PRODUCT_ID = PRD.ID(+)
                    AND ORD.ORDER_ID = :P103_ORDER_ID
                    UNION ALL
                    SELECT NULL ORDER_PRODUCTS_ID,
                      NULL ORDER_ID,
                      P.PRODUCT_NAME,
                      DP.PRODUCT_PRICE,
                      DP.CURRENCY_TYPE,
                      DP.PRODUCT_BRAND_ID,
                      DP.QUANTITY,
                      DP.CLOSE_DATE,
                      DP.PRODUCT_ID,
                     P.MARGIN,
                      P.PRODUCT_COST,
                     (select sum(S.QTY_IN_STOCK) from XXEBA_TALLY_STOCK_T S where S.PRODUCT_CODE= P.ROW_KEY and 
                S.BATCH_SEQUENCE = (select MAX(BATCH_SEQUENCE)from XXEBA_TALLY_STOCK_T )) STOCK
                    FROM EBA_SALES_DEAL_PRODUCTS DP,
                      EBA_SALES_PRODUCTS P
                    WHERE DP.DEAL_ID    = :P103_DEAL_ID
                    AND DP.PRODUCT_ID   = P.ID(+)
                    AND :P103_ORDER_ID IS NULL
                    )
                    LOOP
                      apex_collection.add_member (p_collection_name => v_collection_name, 
                                                  p_n001 => prc.ORDER_PRODUCTS_ID, 
                                                  p_n002 => prc.ORDER_ID, 
                                                  p_c001 => prc.PRODUCT_NAME, 
                                                  p_n003 => prc.PRODUCT_PRICE, 
                                                  p_c002 => prc.CURRENCY_TYPE, 
                                                  p_n004 => prc.BRAND_ID, 
                                                  p_c003 => prc.QUANTITY, 
                                                  p_c004 => prc.DELIVERY_DATE,
                                                  p_n005 => prc.PRODUCT_ID,
                                               --   P_n006 => prc.margin,
                                                  p_c006 => to_char(prc.PRODUCT_COST,'999G999G999G999G990D00'),
                                                 p_c007 => prc.STOCK,
                                                 p_c008 => prc.margin);
                    END LOOP;
                  END IF;
                    IF :P103_COPY_ORDER = 'S' AND :P103_DEAL_ID is null THEN
                    apex_collection.create_or_truncate_collection (p_collection_name => v_collection_name);
                    FOR prc IN
                    (SELECT NULL ORDER_PRODUCTS_ID,ORD.ORDER_ID,
                      ORD.PRODUCT_NAME,
                      ORD.PRODUCT_PRICE,
                      ORD.CURRENCY_TYPE,
                      ORD.BRAND_ID,
                      ORD.QUANTITY,
                      NULL as DELIVERY_DATE,
                      ORD.PRODUCT_ID,
                      PRD.margin,
                      PRD.PRODUCT_COST,
                     (select sum(S.QTY_IN_STOCK) from XXEBA_TALLY_STOCK_T S where S.PRODUCT_CODE= PRD.ROW_KEY and 
                S.BATCH_SEQUENCE = (select MAX(BATCH_SEQUENCE)from XXEBA_TALLY_STOCK_T )) STOCK
                    FROM XXEBA_ORDER_PRODUCTS ORD,
                       eba_sales_products  PRD
                    WHERE ORD.PRODUCT_ID = PRD.ID(+)
                    AND  ORDER_ID = :P103_ORDER_ID
                    )
                    LOOP
                      apex_collection.add_member (p_collection_name => v_collection_name, 
                                                  p_n001 => prc.ORDER_PRODUCTS_ID, 
                                                  p_n002 => prc.ORDER_ID, 
                                                  p_c001 => prc.PRODUCT_NAME, 
                                                  p_n003 => prc.PRODUCT_PRICE, 
                                                  p_c002 => prc.CURRENCY_TYPE, 
                                                  p_n004 => prc.BRAND_ID, 
                                                  p_c003 => prc.QUANTITY, 
                                                  p_c004 => prc.DELIVERY_DATE, 
                                                  p_n005 => prc.PRODUCT_ID,
                                              --    p_n006 => prc.margin,
                                                  p_c006 => to_char(prc.PRODUCT_COST,'999G999G999G999G990D00'),
                                                  p_c007 => prc.STOCK,
                                                   p_c008 => prc.margin);
                    END LOOP;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 69956657178201137
        }
    )


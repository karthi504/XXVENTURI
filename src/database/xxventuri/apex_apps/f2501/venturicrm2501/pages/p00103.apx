    pageItem P103_BILLING_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select  display_value d, return_value r FROM (select 1 seq, CUSTOMER_LOCATION_NAME as display_value ,L.ID as return_value
                from EBA_SALES_CUSTOMER_LOCATIONS L, EBA_SALES_CUSTOMERS C,XXEBA_SALES_ORDER SO
                where L.CUSTOMER_ID = C.ID
                and C.ID = :P103_CUSTOMER_ID   
                and SO.ORDER_ID=:P103_ORDER_ID
                and L.ID=SO.BILLING_LOCATION
                union 
                select 2 seq, CUSTOMER_LOCATION_NAME as display_value ,ID as return_value from EBA_SALES_CUSTOMER_LOCATIONS where CUSTOMER_ID=:P103_CUSTOMER_ID
                                                             and ID not in (select L.ID 
                from EBA_SALES_CUSTOMER_LOCATIONS L, EBA_SALES_CUSTOMERS C,XXEBA_SALES_ORDER SO
                where L.CUSTOMER_ID = C.ID
                and C.ID = :P103_CUSTOMER_ID   
                and SO.ORDER_ID=:P103_ORDER_ID
                and L.ID=SO.BILLING_LOCATION))
                ORDER BY seq
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P103_CUSTOMER_ID
            itemsToSubmit: [
                P103_CUSTOMER_ID
                P103_ORDER_ID
            ]
        }
        layout {
            sequence: 140
            region: @sales-order
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            cssClasses: mnw120
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                /*select L.CUSTOMER_LOCATION_NAME, L.ID from EBA_SALES_CUSTOMER_LOCATIONS L, EBA_SALES_CUSTOMERS C,XXEBA_SALES_ORDER SO
                where L.CUSTOMER_ID = C.ID
                and C.ID = :P103_CUSTOMER_ID  
                and SO.ORDER_ID=:P103_ORDER_ID
                and L.ID=SO.BILLING_LOCATION*/
                
                select  CUSTOMER_LOCATION_NAME as d,ID as r from EBA_SALES_CUSTOMER_LOCATIONS
                 where CUSTOMER_ID=:P103_CUSTOMER_ID 
                ```
        }
    )


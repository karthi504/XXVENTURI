    process insert-order-products (
        name: "Insert Order Products "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE    
                l_margin                      number;
                  BEGIN  
                  --insert into xx_test values (1,'Before Update',0);
                       
                        FOR c IN (SELECT n001 order_products_id, 
                                  n002  order_id, 
                                  c001  product_name, 
                                  n003 product_price, 
                                  c002 currency_type, 
                                  n004 brand_id,  
                                  c003 quantity, 
                                  c004 delivery_date,
                                  n005 product_id ,
                                  c008  margin,
                                  c006 product_cost
                                  FROM apex_collections WHERE collection_name = 'PRODUCT_COLLECTION')
                         LOOP
                
                         Begin
                
                              SELECT  
                   trunc((((PRODUCT_PRICE - to_number(c.product_cost)  )/to_number(c.product_cost)) * 100),2) AS MARGIN into l_margin
                FROM 
                    XXEBA_ORDER_PRODUCTS 
                     where  ORDER_PRODUCTS_ID = c.ORDER_PRODUCTS_ID;
                
                      Exception when others then
                     l_margin:=null;
                     End ;
                     
                           if c.order_products_id is null then
                           INSERT INTO XXEBA_ORDER_PRODUCTS (ORDER_PRODUCTS_ID, 
                											 ORDER_ID, 
                											 PRODUCT_NAME, 
                											 PRODUCT_PRICE, 
                											 CURRENCY_TYPE, 
                											 BRAND_ID,
                                                             QUANTITY,
                                                             DELIVERY_DATE,
                                                             PRODUCT_ID,
                                                             margin
                											)
                                                      VALUES (c.order_products_id,
                                                              :P103_ORDER_ID,
                                                              c.product_name,
                                                              c.product_price,
                                                              c.currency_type,
                											  c.brand_id,
                                                              c.quantity,
                                                              c.delivery_date,
                                                              c.product_id,
                                                              l_margin
                                                              );
                              else 
                                   UPDATE XXEBA_ORDER_PRODUCTS 
                                           SET ORDER_ID = c.order_id, 
                                                     PRODUCT_NAME  = c.product_name, 
                                                     PRODUCT_PRICE = c.product_price, 
                                                     CURRENCY_TYPE = c.currency_type, 
                                                     BRAND_ID      = c.brand_id,
                                                     QUANTITY      = c.quantity,
                                                     DELIVERY_DATE = TO_DATE(c.delivery_date,'DD/MM/RRRR'),
                                                     PRODUCT_ID    = c.product_id,
                                                        margin     = l_margin
                                                     
                				  WHERE ORDER_PRODUCTS_ID = c.order_products_id;
                               --   insert into xx_test values (2,'After Update',l_margin);
                           end if;
                        END LOOP; 
                          EXCEPTION
                    WHEN OTHERS THEN
                     xxfs_pm_error_log_pkg.record_log('ERROR-So1','MSK_Tools_Quotation_Email-so1',NULL,4); 
                  
                
                END;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 70038172747707717
        }
    )

    process insert-sales-orders (
        name: Insert Sales Orders
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                v_seq_num number;
                v_order_number varchar2(50);
                begin
                    if :P103_ORDER_ID is not null --or :P103_COPY_ORDER = 'S' 
                                                  and    nvl(:P103_COPY_ORDER,'N') = 'S'
                                                         then
                    -- Generate Sequence Number
                    v_seq_num :=XXFS_PM_LEAVE_REQUESTS_SEQ.nextval();
                    v_order_number := to_char(sysdate,'YY')||trim(to_char(v_seq_num,'00000'));
                    --raise_application_error(-20010,v_order_number);
                    
                    --to_char(to_date(:P103_DELIVERY_DATE,'DD/MM/YYYY'), 'DD-Mon-YY')
                
                   update XXEBA_ORDER_PRODUCTS set delivery_date = to_char(to_date(:P103_DELIVERY_DATE, 'DD/MM/YYYY'), 'DD-Mon-YYYY') where order_id = :P103_ORDER_ID;
                
                    update XXEBA_SALES_ORDER set ORDER_REPEAT = 'Y' where ORDER_ID = :P103_ORDER_ID ; -- If copy order change repeated status 
                    
                    insert into XXEBA_SALES_ORDER (ORDER_NUMBER,
                                                   DEAL_ID, CUSTOMER_ID, TERRITORY_ID, SALES_REP, PO_NUMBER, PO_DATE , REFERENCE , 
                                BILLING_LOCATION, DELIVERY_LOCATION, ORDER_FREQUENCY, NEXT_ORDER_DATE, ORDER_DATE, ORDER_REPEAT,REMARKS,CREATED_BY,UPDATED_BY,SOURCE_APPLICATION,ORDER_TYPE_ID)
                                values (to_number(v_order_number),
                                        :P103_DEAL_ID, :P103_CUSTOMER_ID, :P103_TERRITORY_ID, :P103_SALES_REP_ID, :P103_PO_NUMBER, :P103_PO_DATE, :P103_REFERENCE, 
                                :P103_BILLING_LOCATION, :P103_DELIVERY_LOCATION, :P103_ORDER_FREQUENCY, :P103_NEXT_ORDER_DATE, :P103_ORDER_DATE, 'Y',:P103_REMARKS,NVL(V('APP_USER'), USER),NVL(V('APP_USER'), USER),'W',:P103_ORDER_TYPE) RETURNING ORDER_ID INTO :P103_ORDER_ID;
                    else
                    --raise_application_error(-20010,:P103_ORDER_FREQUENCY||' - '||:P103_NEXT_ORDER_DATE);
                    update XXEBA_SALES_ORDER set
                              --  ORDER_NUMBER = to_number(v_order_number),
                                DEAL_ID = :P103_DEAL_ID, 
                                CUSTOMER_ID = :P103_CUSTOMER_ID, 
                                TERRITORY_ID = :P103_TERRITORY_ID, 
                                SALES_REP = :P103_SALES_REP_ID, 
                                PO_NUMBER = :P103_PO_NUMBER, 
                                PO_DATE = :P103_PO_DATE, 
                                REFERENCE = :P103_REFERENCE, 
                                BILLING_LOCATION = :P103_BILLING_LOCATION, 
                                DELIVERY_LOCATION = :P103_DELIVERY_LOCATION, 
                                ORDER_FREQUENCY = :P103_ORDER_FREQUENCY, 
                                NEXT_ORDER_DATE = :P103_NEXT_ORDER_DATE,
                               ORDER_DATE = :P103_ORDER_DATE,
                               UPDATED_BY = NVL(V('APP_USER'), USER),
                               ORDER_TYPE_ID = :P103_ORDER_TYPE
                              where ORDER_ID = :P103_ORDER_ID;
                    end if;
                      EXCEPTION
                    WHEN OTHERS THEN
                     xxfs_pm_error_log_pkg.record_log('ERROR-SO','MSK_Tools_Quotation_Email-SO',NULL,4); 
                 
                end;
                ```
        }
        execution {

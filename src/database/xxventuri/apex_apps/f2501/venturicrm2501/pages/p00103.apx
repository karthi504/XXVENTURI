    validation delivery-date-validations-for-same-product (
        name: Delivery Date validations for same product
        execution {
            sequence: 70
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                     product_id  NUMBER;
                    v_error_text  VARCHAR2(1000) := NULL;
                BEGIN
                  FOR c1 IN
                  (SELECT seq_id s_no,n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date,
                    n005 product_id
                   FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                   order by seq_id
                  )
                 LOOP
                  FOR c2 IN (SELECT seq_id s_no,n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date,
                    n005 product_id
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                   order by seq_id)
                  LOOP 
                  IF c2.order_products_id != c1.order_products_id THEN 
                  IF c2.order_id = c1.order_id and c2.product_id = c1.product_id  THEN 
                     IF c2.Delivery_date = c1.Delivery_date  THEN
                   v_error_text :='Sorry! Same Delivery Date is available for this product '||c2.product_name||'.';
                   END IF;
                   END IF;
                   END IF;
                   END LOOP;
                  END LOOP;
                  RETURN v_error_text; 
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )


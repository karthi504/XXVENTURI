    validation unit-price-validations (
        name: Unit Price Validations
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  minimum_price NUMBER;
                  
                  lv_product_id number;
                  v_error_text  VARCHAR2(1000) := NULL;
                BEGIN
                  FOR c IN
                  (SELECT n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  LOOP
                  select PRODUCT_ID into lv_product_id from XXEBA_ORDER_PRODUCTS where ORDER_PRODUCTS_ID= c.order_products_id;
                    SELECT NVL(P.PRODUCT_COST+(P.PRODUCT_COST*(PF.MARGIN_PERCENTAGE/100)),0)
                    INTO minimum_price
                    FROM EBA_SALES_PRODUCT_FAMILIES PF,
                      EBA_SALES_PRODUCTS P
                    WHERE P.PRODUCT_FAMILY_ID = PF.ID
                    AND P.ID                  =lv_product_id;
                    IF trim(c.product_price) < round(minimum_price)  THEN
                     v_error_text :='Sorry! Unit Price is lesser than the minimum price of this Product.';
                     
                    END IF;
                  END LOOP;
                  RETURN v_error_text; 
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
            type: never
        }
    )

    process change-closed-statues (
        name: Change Closed Statues
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for c1 in (
                select id
                from EBA_SALES_DEAL_STATUS_CODES
                where CORRESPONDING_PROB_PCT = 100) loop
                
                update EBA_SALES_DEALS 
                set DEAL_STATUS_CODE_ID = c1.id ,
                    DEAL_CLOSE_DATE = least (sysdate, deal_close_date),
                    DEAL_PROBABILITY = 100
                where id = :P103_DEAL_ID;
                
                end loop;
                commit;

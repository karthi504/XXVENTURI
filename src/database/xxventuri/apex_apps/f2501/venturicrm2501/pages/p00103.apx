    button create (
        buttonName: CREATE
        label: Create Order
        layout {
            sequence: 60
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P103_ORDER_ID is null or nvl(:P103_COPY_ORDER,'N') = 'S'  and :P103_SOURCE_PAGE=102
        }
    )

    button create-repeat (
        buttonName: CREATE_REPEAT
        label: Create Repeat Order
        layout {
            sequence: 40
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 103
                items: {
                    P103_ORDER_ID: &P103_ORDER_ID.
                    P103_COPY_ORDER: S
                    P103_SOURCE_PAGE: &P103_SOURCE_PAGE.
                    P103_ORDER_DATE: &P103_SYSDATE.
                    P103_REPEAT_ORDER_FLAG: R
                }
                clearCache: 103
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P103_ORDER_ID is not null and nvl(:P103_COPY_ORDER,'N') != 'S'  and :P103_SOURCE_PAGE=102 and :P103_ORDER_STATUS='New'
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 30
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P103_ORDER_ID is not null and :P103_EXPORTED_FLAG='New' and :P103_SOURCE_PAGE=102 and :P103_ORDER_STATUS <> 'New'
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 80
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:openModal('REMARKS');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P103_SOURCE_PAGE
            value: 238
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 50
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P103_ORDER_ID is not null and :P103_EXPORTED_FLAG='New' and nvl(:P103_COPY_ORDER,'N') != 'S'  and :P103_SOURCE_PAGE=102 and :P103_ORDER_STATUS <> 'New'
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit
        layout {
            sequence: 30
            region: @remarks
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction check-validation-for-remarks (
        name: Check validation for remarks
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }
        clientSideCondition {
            type: itemIsNull
            item: P103_REASON
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     apex.message.alert( "Remarks must have some value.", function(){
                       /* afterLoad();*/
                        
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-product-row (
        name: DELETE_PRODUCT_ROW
        execution {
            sequence: 50
        }
        when {
            event: custom
            customEvent: DELETE_PRODUCT_ROW
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    	v_collection_name  		VARCHAR2 (30) := 'PRODUCT_COLLECTION';
                    BEGIN
                    APEX_COLLECTION.DELETE_MEMBER (
                        v_collection_name ,
                        :P103_SEQ_ID);
                    END;
                    ```
                itemsToSubmit: P103_SEQ_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @products
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction imported-alert (
        name: Imported Alert
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /*alert($v('P103_DEAL_ID').toString().length);*/
                    if ($v('P103_EXPORTED_FLAG')=='Imported')
                    {
                    //alert('You are not eligible to raise Work From Home request.');
                     apex.message.alert("Note: This Sales Order has been already processed by the Accounting System. Hence cannot edit/delete.", function(){
                        afterLoad();
                    });
                    }
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P103_DEAL_ID
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 90
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: button
            button: @cancel-r
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CANCEL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction region-refresh (
        name: Region Refresh
        execution {
            sequence: 100
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @add
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @products

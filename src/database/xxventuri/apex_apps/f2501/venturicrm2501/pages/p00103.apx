    validation product-price-null-validation (
        name: Product Price Null validation
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_error_text VARCHAR2(1000) := NULL;
                BEGIN
                  FOR c IN
                  (SELECT n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  LOOP
                    IF trim(c.product_price) IS NULL THEN
                      v_error_text           := v_error_text||'Price can not be null for '||c.product_name||'<br>';
                    END IF;
                     IF trim(c.Delivery_date) IS NULL THEN
                      v_error_text                                  := v_error_text||'Delivery Date can not be null for'||c.product_name||'<br>';
                    END IF;
                    IF to_date(trim(c.Delivery_date), 'DD-Mon-YYYY') < TRUNC(sysdate) THEN
                      v_error_text                                  := v_error_text||'Delivery Date should be greater than OR equal to current date for'||c.product_name||'<br>';
                    END IF;
                  END LOOP;
                  RETURN v_error_text;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation quantity-validations (
        name: Quantity Validations
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  minimum_quantity VARCHAR2(100);          /* VARCHAR2(20) into VARCHAR2(100)  Modified on 01-SEP-18*/
                  pack_quantity VARCHAR2(100);
                  v_error_text  VARCHAR2(4000) := NULL;    /* v_error_text  VARCHAR2(4000)  Modified on 01-SEP-18 */
                  lv_product_id NUMBER;
                  lv_remainder NUMBER;
                BEGIN
                  FOR c IN
                  (SELECT n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    c003   quantity,
                    n004 brand_id,
                    c004 Delivery_date
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  
                  LOOP
                  select  PRODUCT_ID into lv_product_id  from XXEBA_ORDER_PRODUCTS where ORDER_PRODUCTS_ID=c.order_products_id;
                    SELECT MINIMUM_ORDER_QUANTITY ,PACK_QUANTITY
                    INTO minimum_quantity,pack_quantity
                    FROM EBA_SALES_PRODUCT_FAMILIES PF,
                      EBA_SALES_PRODUCTS P
                    WHERE P.PRODUCT_FAMILY_ID = PF.ID
                    AND P.ID                  =lv_product_id;
                     IF to_number(trim(c.quantity)) < 1  THEN
                     v_error_text :='Sorry! Quantity is less than one.'; 
                    END IF;
                    
                   IF minimum_quantity IS NOT NULL  THEN
                      
                      IF to_number(trim(c.quantity)) < to_number(minimum_quantity) THEN
                        v_error_text                :='Sorry! Order Quantity of '||trim(c.quantity)||' is less than its Minimum Order Quantity of  '||minimum_quantity ||'.';
                      END IF;
                      
                    ELSIF  pack_quantity IS NOT NULL and  minimum_quantity is null  THEN
                      SELECT MOD(to_number(c.quantity), to_number(pack_quantity)) INTO lv_remainder FROM dual;
                      
                      IF lv_remainder <> 0 THEN
                        RETURN 'Sorry! Order Quantity should be multiples of Pack Quantity '|| pack_quantity ||'.';
                      END IF;
                      
                    END IF ;
                    
                  END LOOP;
                  
                  RETURN v_error_text; 
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )


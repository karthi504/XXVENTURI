    process update-status (
        name: Update Status
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                lv_count number :=0 ;
                minimum_price number;
                
                BEGIN
                  FOR c IN
                  (SELECT n001 order_products_id,
                    n002 order_id,
                    c001 product_name,
                    n003 product_price,
                    c002 currency_type,
                    n004 brand_id,
                    c004 Delivery_date,
                    n005 product_id
                  FROM apex_collections
                  WHERE collection_name = 'PRODUCT_COLLECTION'
                  )
                  LOOP
                    SELECT NVL(P.PRODUCT_COST+(P.PRODUCT_COST*(PF.MARGIN_PERCENTAGE/100)),0) 
                    INTO minimum_price
                    FROM EBA_SALES_PRODUCT_FAMILIES PF,
                      EBA_SALES_PRODUCTS P
                    WHERE P.PRODUCT_FAMILY_ID = PF.ID
                    AND P.ID                  =c.product_id;
                    IF trim(c.product_price) < round(minimum_price)  THEN
                    lv_count := lv_count+1;
                     END IF;
                  END LOOP;
                  IF lv_count > 0 then
                  UPDATE XXEBA_SALES_ORDER SET STATUS='N'  WHERE ORDER_ID =:P103_ORDER_ID ;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 78746749342937246
        }
    )


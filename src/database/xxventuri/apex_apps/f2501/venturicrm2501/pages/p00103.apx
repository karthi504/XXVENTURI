    button add (
        buttonName: ADD
        label: Add
        layout {
            sequence: 90
            region: @products
            slot: edit
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--simple
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 108
                items: {
                    P108_SOURCE_PAGE: 103
                    P108_ACCOUNT_ID: &P103_CUSTOMER_ID.
                    P108_DEAL_ID: &P103_OPP_ID.
                    P108_ORDER_ID: &P103_ORDER_ID.
                }
                clearCache: 108
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P103_REPEAT_ORDER_FLAG
            value: R
        }
    )

    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 70
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P103_SOURCE_PAGE
            value: 238
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @sales-order
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp

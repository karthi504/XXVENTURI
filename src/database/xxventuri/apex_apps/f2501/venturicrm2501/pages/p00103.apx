    dynamicAction update-product-row (
        name: UPDATE_PRODUCT_ROW
        execution {
            sequence: 40
        }
        when {
            event: custom
            customEvent: UPDATE_PRODUCT_ROW
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_seq_id          apex_application_global.vc_arr2;
                      l_products_id     apex_application_global.n_arr;
                      l_order_id        apex_application_global.n_arr;
                      l_product_name    apex_application_global.vc_arr2;
                      l_product_cost    apex_application_global.vc_arr2;
                      l_product_stock   apex_application_global.vc_arr2;
                      l_product_price   apex_application_global.n_arr;
                      l_currency_type   apex_application_global.vc_arr2;
                      l_brand_id        apex_application_global.n_arr;
                      l_delivery_date   apex_application_global.vc_arr2;
                      l_quantity        apex_application_global.vc_arr2;
                      l_product_id      apex_application_global.n_arr;
                      v_collection_name VARCHAR2 (30) := 'PRODUCT_COLLECTION';
                      v_start_date      VARCHAR2 (30);
                      v_end_date        VARCHAR2 (30);
                    BEGIN
                    
                      l_seq_id(1)        := :P103_SEQ_ID;
                      l_products_id(1)   := to_number(:P103_ORDER_PRODUCTS_ID);
                      l_order_id(1)      := to_number(:P103_ORDER_ID_HID);
                      l_product_name(1)  := :P103_PRODUCT_NAME;
                      l_product_price(1) := to_number(:P103_PRODUCT_PRICE);
                      l_currency_type(1) := :P103_CURRENCY_TYPE;
                      l_brand_id(1)      := to_number(:P103_BRAND_ID);
                      l_delivery_date(1) := TO_CHAR(TO_DATE(:P103_DELIVERY_DATE,'DD-Mon-RRRR'),'DD-Mon-RRRR'); --DD/MM/RRRR
                      l_quantity(1)      := :P103_QUANTITY;
                      l_product_id(1)    := to_number(:P103_PRODUCT_ID);
                      l_product_cost(1)  := :P103_PRODUCT_COST;
                      l_product_stock(1) := :P103_STOCK;
                      APEX_COLLECTION.UPDATE_MEMBERS (p_collection_name => v_collection_name, 
                                                      p_seq  => l_seq_id, 
                                                      p_n001 => l_products_id, 
                                                      p_n002 => l_order_id, 
                                                      p_c001 => l_product_name, 
                                                      p_n003 => l_product_price, 
                                                      p_c002 => l_currency_type, 
                                                      p_n004 => l_brand_id, 
                                                      p_c003 => l_quantity, 
                                                      p_c004 => l_delivery_date, 
                                                      p_n005 => l_product_id,
                                                      p_c006 => l_product_cost,
                                                      p_c007 => l_product_stock);
                    END;
                    ```
                itemsToSubmit: [
                    P103_SEQ_ID
                    P103_ORDER_PRODUCTS_ID
                    P103_ORDER_ID_HID
                    P103_PRODUCT_NAME
                    P103_PRODUCT_PRICE
                    P103_CURRENCY_TYPE
                    P103_BRAND_ID
                    P103_DELIVERY_DATE
                    P103_QUANTITY
                    P103_PRODUCT_ID
                    P103_PRODUCT_COST
                    P103_STOCK
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


page 103 (
    name: Sales Orders Details
    title: Sales Orders Details
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            function change_price(seq_id)
            {
                updateTimeSheet(seq_id);
            }
            
            function change_Quantity(seq_id)
            {
                updateTimeSheet(seq_id);
            }
            
            function change_Delivery(seq_id)
            {
                updateTimeSheet(seq_id);
            }
            
            // Update collection function
            function updateTimeSheet(pSeqId) {
                //alert(pSeqId);
                //alert($("#pr09_"+pSeqId).val());
                $x('P103_SEQ_ID').value = $("#pr01_"+pSeqId).val();
                $x('P103_ORDER_PRODUCTS_ID').value = $("#pr02_"+pSeqId).val();
                $x('P103_ORDER_ID_HID').value = $("#pr03_"+pSeqId).val();
                $x('P103_PRODUCT_NAME').value = $("#pr04_"+pSeqId).val();
            	$x('P103_PRODUCT_PRICE').value = $("#pr05_"+pSeqId).val();
            	$x('P103_CURRENCY_TYPE').value = $("#pr06_"+pSeqId).val();
            	$x('P103_BRAND_ID').value = $("#pr07_"+pSeqId).val();
               $x('P103_DELIVERY_DATE').value = $("#pr08_"+pSeqId).val();
                $x('P103_QUANTITY').value = $("#pr09_"+pSeqId).val();
                $x('P103_PRODUCT_ID').value = $("#pr10_"+pSeqId).val();
                $x('P103_PRODUCT_COST').value = $("#pr11_"+pSeqId).val();
                $x('P103_STOCK').value = $("#pr12_"+pSeqId).val();
            
            
              
                /*alert($x('P103_SEQ_ID').value+'-'+$x('P103_PRODUCT_PRICE').value);
                alert($x('P103_SEQ_ID').value+'-'+$x('P103_DELIVERY_DATE').value);
                alert($x('P103_SEQ_ID').value+'-'+$x('P103_QUANTITY').value);*/
              
                
            	$.event.trigger("UPDATE_PRODUCT_ROW"); // call update collection function 
            }
            
            function delete_order(pSeqId) {
                 if (confirm("Are you sure you want to delete this Product?")) {
                     $x('P103_SEQ_ID').value = $("#pr01_"+pSeqId).val();
                     $x('P103_DELETED_IDS').value = $x('P103_DELETED_IDS').value+','+$("#pr02_"+pSeqId).val();
                    $.event.trigger("DELETE_PRODUCT_ROW"); // call update collection function 
                } 
            }
            
            
            // number validation in hours field
            function isNumber(evt) {
                evt = (evt) ? evt : window.event;
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                    return false;
                }
                return true;
            }
            
            ```
    }
    css {
        inline:
            ```css
            #order_product table th:nth-child(2),#order_product table th:nth-child(3),#order_product table th:nth-child(4),#order_product table th:nth-child(7),#order_product table th:nth-child(9),#order_product table th:nth-child(13)
            {
                display:none;
            }
            #order_product table td:nth-child(2),#order_product table td:nth-child(3),#order_product table td:nth-child(4),#order_product table td:nth-child(7),#order_product table td:nth-child(9),#order_product table td:nth-child(13)
            {
                display:none;
            }
            
            #order_product table.t-Report-report td, #order_product table.t-Report-report th
            {
                border-right:1px solid #e6e6e6;
            }
            /*
            #order_product .a-Button.a-Button--calendar {
                margin-top: -5px;
            }
            */
            .p-number-label{
                    text-align: right;
            }
            
            .p-text-label{
                border: none;
                background: transparent;
                pointer-events: none;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region products (
        name: Products
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    ROWNUM row_num,
                    APEX_ITEM.HIDDEN(1, seq_id, NULL, 'pr01_' || seq_id) seq_id,
                    APEX_ITEM.HIDDEN(2, n001, NULL, 'pr02_' || seq_id) ORDER_PRODUCTS_ID,
                    APEX_ITEM.HIDDEN(3, n002, NULL, 'pr03_' || seq_id) ORDER_ID,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) 
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n005) 
                        THEN APEX_ITEM.TEXT(4, c001, 50, 50, 'class="p-text-label" style="color:red;border:none;background-color:snow;" disabled', 'pr04_' || seq_id)
                        ELSE APEX_ITEM.TEXT(4, c001, 50, 50, 'class="p-text-label" style="border:none;background-color:snow;" disabled', 'pr04_' || seq_id)
                     END) PRODUCT_NAME,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) 
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n005) 
                        THEN APEX_ITEM.TEXT(5, n003, 10, 50, 'class="p-number-label" style="color:red" onkeypress="return isNumber(event)" onchange="change_price(' || seq_id || ')"', 'pr05_' || seq_id)
                        ELSE APEX_ITEM.TEXT(5, n003, 10, 50, 'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_price(' || seq_id || ')"', 'pr05_' || seq_id)
                     END) PRODUCT_PRICE,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) 
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n005) 
                        THEN APEX_ITEM.TEXT(6, c002, 10, 50, 'class="p-text-label" style="color:red" disabled', 'pr06_' || seq_id)
                        ELSE APEX_ITEM.TEXT(6, c002, 10, 50, 'class="p-text-label" disabled', 'pr06_' || seq_id)
                     END) CURRENCY_TYPE,
                    APEX_ITEM.HIDDEN(7, n004, NULL, 'pr07_' || seq_id) BRAND_ID,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) 
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n005) 
                        THEN APEX_ITEM.DATE_POPUP2(8, TO_DATE(c004, 'DD/MM/YYYY'), 'DD-Mon-YYYY', 10, 12, 'class="p-date-label" style="color:red" onchange="change_Delivery(' || seq_id || ')"', 'pr08_' || seq_id)
                        ELSE APEX_ITEM.DATE_POPUP2(8, TO_DATE(c004, 'DD/MM/YYYY'), 'DD-Mon-YYYY', 10, 12, 'class="p-date-label" onchange="change_Delivery(' || seq_id || ')"', 'pr08_' || seq_id)
                     END) Delivery_date,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) 
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n005) 
                        THEN APEX_ITEM.TEXT(9, c003, 10, 50, 'class="p-number-label" style="color:red" onkeypress="return isNumber(event)" onchange="change_Quantity(' || seq_id || ')"', 'pr09_' || seq_id)
                        ELSE APEX_ITEM.TEXT(9, c003, 10, 50, 'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_Quantity(' || seq_id || ')"', 'pr09_' || seq_id)
                     END) Quantity,
                    APEX_ITEM.HIDDEN(10, n005, NULL, 'pr10_' || seq_id) PRODUCTS_ID,
                    '<span class="delete_order" onclick="delete_order(' || seq_id || ')"><i class="fa fa-trash" aria-hidden="true"></i><span>' delete_order,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) 
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n005) 
                        THEN APEX_ITEM.TEXT(11, c006, 20, 50, 'class="p-number-label" style="border:none;color:red" onkeypress="return isNumber(event)" onchange="change_price(' || seq_id || ')"', 'pr11_' || seq_id)
                        ELSE APEX_ITEM.TEXT(11, c006, 20, 50, 'class="p-number-label" style="display:none" onkeypress="return isNumber(event)" onchange="change_price(' || seq_id || ')"', 'pr11_' || seq_id)
                     END) Product_Cost,
                    (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) 
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n005) 
                        THEN APEX_ITEM.TEXT(12, c007, 10, 50, 'class="p-text-label" style="color:red;border:none;background-color:snow;" disabled', 'pr12_' || seq_id)
                        ELSE APEX_ITEM.TEXT(12, c007, 10, 50, 'class="p-text-label" style="border:none;background-color:snow;" disabled', 'pr12_' || seq_id)
                     END) Product_Stock,
                     (CASE 
                        WHEN n003 < (SELECT NVL(P.PRODUCT_COST + (P.PRODUCT_COST * (PF.MARGIN_PERCENTAGE / 100)), 0) 
                                     FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                                     WHERE P.PRODUCT_FAMILY_ID = PF.ID AND P.ID = n005)
                        THEN APEX_ITEM.TEXT(13, TRUNC((((n003 - (SELECT P.PRODUCT_COST FROM EBA_SALES_PRODUCTS P WHERE P.ID = n005)) / (SELECT P.PRODUCT_COST FROM EBA_SALES_PRODUCTS P WHERE P.ID = n005)) * 100), 2), 10, 50, 'class="p-text-label" style="border:none;background-color:snow;" disabled', 'pr13_' || seq_id)
                        ELSE APEX_ITEM.TEXT(13, TRUNC((((n003 - (SELECT P.PRODUCT_COST FROM EBA_SALES_PRODUCTS P WHERE P.ID = n005)) / (SELECT P.PRODUCT_COST FROM EBA_SALES_PRODUCTS P WHERE P.ID = n005)) * 100), 2), 10, 50, 'class="p-text-label" style="border:none;background-color:snow;" disabled', 'pr13_' || seq_id)
                     END) margin
                FROM 
                    apex_collections
                WHERE 
                    collection_name = 'PRODUCT_COLLECTION';
                
                ```
        }
        layout {
            sequence: 1210
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: order_product
            regionDisplaySelector: true
        }
        comments {
            comments:
                ```
                SELECT 
                    ROWNUM row_num,
                    APEX_ITEM.HIDDEN(1,seq_id,NULL,'pr01_'||seq_id) seq_id,
                    APEX_ITEM.HIDDEN(2,n001,NULL,'pr02_'||seq_id) ORDER_PRODUCTS_ID,
                    APEX_ITEM.HIDDEN(3,n002,NULL,'pr03_'||seq_id) ORDER_ID,
                    (CASE WHEN n003 < (SELECT NVL(P.PRODUCT_COST+(P.PRODUCT_COST*(PF.MARGIN_PERCENTAGE/100)),0) Minimum_Price
                        FROM EBA_SALES_PRODUCT_FAMILIES PF, EBA_SALES_PRODUCTS P
                        WHERE P.PRODUCT_FAMILY_ID = PF.ID
                        AND P.ID =n005) 
                		THEN APEX_ITEM.TEXT(4,c001,50,50,'class=p-text-label" style="color:red;border:none;background-color:snow;" disabled  ','pr04_'||seq_id) 
                        ELSE
                        APEX_ITEM.TEXT(4,c001,50,50,'class=p-text-label" style="border:none;background-color:snow;" disabled ','pr04_'||seq_id) 
                        END) PRODUCT_NAME,
                    --APEX_ITEM.TEXT(4,c001,50,50,'class="p-text-label" disabled ','pr04_'||seq_id) PRODUCT_NAME,
                    APEX_ITEM.TEXT(5,n003,10,50,'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_price('||seq_id||')" ','pr05_'||seq_id) PRODUCT_PRICE,
                    APEX_ITEM.TEXT(6,c002,5,50,'class="p-text-label" disabled ','pr06_'||seq_id) CURRENCY_TYPE,
                    APEX_ITEM.HIDDEN(7,n004,NULL,'pr07_'||seq_id) BRAND_ID,
                    APEX_ITEM.DATE_POPUP2(8,TO_DATE(c004, 'DD/MM/YYYY'),'DD-Mon-YYYY',10,12,' class="p-date-label" onchange="change_Delivery('||seq_id||')"','pr08_'||seq_id) Delivery_date,
                    APEX_ITEM.TEXT(9,c003,10,50,'class="p-number-label" onkeypress="return isNumber(event)" onchange="change_Quantity('||seq_id||')" ','pr09_'||seq_id) Quantity,
                    APEX_ITEM.HIDDEN(10,n005,NULL,'pr10_'||seq_id) PRODUCTS_ID,
                    '<span class="delete_order" onclick="delete_order('||seq_id||')"><i class="fa fa-trash" aria-hidden="true"></i><span>' delete_order
                FROM apex_collections
                WHERE collection_name = 'PRODUCT_COLLECTION'
                ```
        }

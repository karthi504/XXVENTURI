    pageItem P1004_YEAR_WISE (
        type: selectList
        label {
            label: Year
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PERIOD_NAME D,ID R FROM EBA_SALES_SALES_PERIODS where FISCAL_YEAR IN
                (
                SELECT DISTINCT
                    to_char(invoice_date, 'YY')
                FROM
                    xxeba_tally_invoices_t
                WHERE
                    to_char(invoice_date, 'YYYY') = to_char(sysdate, 'YYYY')
                    OR to_char(invoice_date, 'YYYY') = to_char(sysdate, 'YYYY') - 1);
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {

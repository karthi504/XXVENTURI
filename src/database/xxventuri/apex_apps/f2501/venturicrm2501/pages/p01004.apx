            region: @target-vs-actual-sub-region
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: SELECT FIRST_DAY FROM EBA_SALES_SALES_PERIODS where PERIOD_NAME =:P1004_YEAR_WISE;
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P1004_LAST_DATE (

                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @go-dup
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @product-class-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction region-refresh (
        name: REGION REFRESH
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @go
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @brand-wise-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


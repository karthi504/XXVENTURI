page 1004 (
    name: New Reports
    title: New Reports
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region brand-wise-report (
        name: Brand Wise Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  SALES_YEAR, TOTAL_AMOUNT,BRAND_NAME from
                  (
                SELECT 
                TO_CHAR(INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                SUM(to_number(NVL(TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                BRAND_NAME
                FROM XXEBA_TALLY_INVOICES_T T,EBA_SALES_PRODUCTS P ,XXEBA_SALES_PRODUCT_BRANDS  B , EBA_SALES_CUSTOMERS C
                WHERE T.product_code=p.row_key
                  AND T.CUSTOMER_ID = C.ROW_KEY
                  AND C.DEFAULT_REP_ID	= :P1004_SALES_REP
                  AND batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                  AND  P.BRAND_ID = B.BRAND_ID  
                group by BRAND_NAME,to_char(INVOICE_DATE,'YYYY'))
                
                where SALES_YEAR= :P1004_YEAR 
                 -- and rownum <=10;
                ```
            pageItemsToSubmit: [
                P1004_SALES_REP
                P1004_YEAR
            ]
        }
        layout {
            sequence: 10
            parentRegion: @brand-wise-sales
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 688766754417952111
        }

        column BRAND_NAME (
            type: plainText
            heading {
                heading: Brand Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column SALES_YEAR (
            type: plainText
            heading {
                heading: Sales Year
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column TOTAL_AMOUNT (
            type: plainText
            heading {
                heading: Total Amount
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            width: 8.5
            height: 11
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 6905787 (
            visibility: primaryDefault

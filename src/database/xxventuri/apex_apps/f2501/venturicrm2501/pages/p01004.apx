    region product-class-report (
        name: Product Class Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  SALES_YEAR, TOTAL_AMOUNT,PRODUCT_CLASS_NAME  from
                  (
                SELECT 
                TO_CHAR(INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                SUM(to_number(NVL(TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                PRODUCT_CLASS_NAME 
                FROM XXEBA_TALLY_INVOICES_T T,EBA_SALES_PRODUCTS P ,XXEBA_PRODUCT_CLASS C , EBA_SALES_CUSTOMERS CU
                WHERE T.product_code=p.row_key
                  AND T.CUSTOMER_ID = CU.ROW_KEY
                  AND CU.DEFAULT_REP_ID	= :P1004_SALES_REP_DUP
                  AND batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                  AND  C.ID =P.PRODUCT_CLASS_ID   
                group by PRODUCT_CLASS_NAME ,to_char(INVOICE_DATE,'YYYY'))
                
                where SALES_YEAR= :P1004_YEAR_DUP
                --  and rownum <=10;
                ```
            pageItemsToSubmit: [
                P1004_SALES_REP_DUP
                P1004_YEAR_DUP
            ]
        }
        layout {
            sequence: 10
            parentRegion: @product-class-wise-sales
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }

    region sales-target-vs-actual (
        name: Sales Target vs Actual
        type: chart
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments:
                ```
                /*select   SALES_YEAR,TOTAL_AMOUNT,sales_rep from
                  (
                SELECT 
                TO_CHAR(t.INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                SUM(to_number(NVL(t.TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                      
                (select sum(TARGET_AMOUNT)  from XXEBA_SALES_PERSON_TARGET where TARGET_PERIOD in 
                (SELECT ID FROM EBA_SALES_SALES_PERIODS where FISCAL_YEAR = ( select to_char (to_date(:P237_YEAR_WISE,'YY'),'YY') from dual ))) as max,   
                      
                (s.REP_FIRST_NAME ||' ' || s.REP_LAST_NAME )as sales_rep
                FROM XXEBA_TALLY_INVOICES_T t,EBA_SALES_CUSTOMERS c,EBA_SALES_SALESREPS s 
                WHERE 
                t.customer_id = c.ROW_KEY
                and c.DEFAULT_REP_ID =S.id
                and  t.batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                group by  s.REP_FIRST_NAME,s.REP_LAST_NAME,to_char(t.INVOICE_DATE,'YYYY'))
                where 
                SALES_YEAR = :P237_YEAR_WISE
                and rownum <=5 ; 
                */
                
                select 50 as a, 100 as b from dual
                ```
        }
        chart {
            type: statusMeterGauge
        }
        chartLayout {
            maxWidth: 400
            height: 300
        }
        gauge {
            innerRadius: 0.7
        }

        series target (
            name: Target
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT   SALES_YEAR,TOTAL_AMOUNT,sales_rep,
                    NVL ((SELECT TARGET_AMOUNT  FROM XXEBA_SALES_PERSON_TARGET WHERE TARGET_PERIOD = :P1004_YEAR_WISE),0)max_amd
                    FROM
                      (
                    SELECT 
                    TO_CHAR(t.INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                    SUM(to_number(NVL(t.TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                    (s.REP_FIRST_NAME ||' ' || s.REP_LAST_NAME )as sales_rep
                    FROM XXEBA_TALLY_INVOICES_T t,EBA_SALES_CUSTOMERS c,EBA_SALES_SALESREPS s 
                    WHERE 
                           t.customer_id = c.ROW_KEY
                    AND    c.DEFAULT_REP_ID =s.id
                    AND    s.id=:P1004_REP_NAME
                    AND    t.batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                    AND    to_char(t.INVOICE_DATE,'DD-Mon-YYYY') BETWEEN TO_DATE(: P1004_FIRST_DATE,'DD-Mon-YYYY') AND TO_DATE(:P1004_LAST_DATE,'DD-Mon-YYYY')
                    
                    GROUP BY  to_char(t.INVOICE_DATE,'YYYY'),s.REP_FIRST_NAME,s.REP_LAST_NAME )
                    ```
                pageItemsToSubmit: [
                    P1004_YEAR_1
                    P1004_REP_NAME
                ]
            }
            columnMapping {
                label: SALES_YEAR
                value: TOTAL_AMOUNT
                maxValue: MAX_AMD
            }
            appearance {
                color: RED
            }
            thresholds {
                display: onIndicator
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

    )


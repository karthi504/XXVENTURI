    region product-group-wise-report (
        name: Product Group-wise Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  SALES_YEAR, TOTAL_AMOUNT,PRODUCT_FAMILY from
                  (
                SELECT 
                TO_CHAR(INVOICE_DATE,'YYYY')AS SALES_YEAR, 
                SUM(to_number(NVL(TOTAL_AMOUNT,0)))AS TOTAL_AMOUNT,
                PRODUCT_FAMILY
                FROM XXEBA_TALLY_INVOICES_T T,EBA_SALES_PRODUCTS P ,eba_sales_product_families  B, EBA_SALES_CUSTOMERS CU
                
                WHERE T.product_code=p.row_key
                  AND T.CUSTOMER_ID = CU.ROW_KEY
                  AND CU.DEFAULT_REP_ID	= :P1004_REP_ID
                  AND batch_sequence=(SELECT MAX(BATCH_SEQUENCE) FROM XXEBA_TALLY_INVOICES_T) 
                  AND  P.PRODUCT_FAMILY_ID = B.ID  
                group by PRODUCT_FAMILY,to_char(INVOICE_DATE,'YYYY'))
                
                where SALES_YEAR= :P1004_YEAR_1;
                ```
            pageItemsToSubmit: [
                P1004_REP_ID
                P1004_YEAR_1
            ]
        }
        layout {
            sequence: 10
            parentRegion: @product-group-wise-sales
            slot: subRegions

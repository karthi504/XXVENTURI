page 40 (
    name: Deal Terms
    title: Deal Terms
    pageGroup: @administration
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region deal-terms (
        name: Deal Terms
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, term_name, days, description, created, created_by, updated, updated_by
                  from eba_sales_deal_terms
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1124152377994090288
        }

        savedReport 153561 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TERM_NAME
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRIPTION
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @CREATED
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @CREATED_BY
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @UPDATED
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @UPDATED_BY
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @DAYS
                layout {
                    sequence: 9
                }
            )

        )

        column CREATED (
            type: datePickerJquery
            heading {
                heading: Created
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: SINCE
            }
            source {
                databaseColumn: CREATED
                dataType: timestampWithLocalTimeZone
            }
        )

        column CREATED_BY (
            type: textarea
            heading {
                heading: Created By
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: CREATED_BY
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column DAYS (
            type: numberField
            heading {
                heading: Days
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                databaseColumn: DAYS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DESCRIPTION (
            type: textarea
            heading {
                heading: Description
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: ID
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
        )

        column TERM_NAME (
            type: link
            heading {
                heading: Term Name
            }
            layout {
                sequence: 30
            }
            link {
                target: {
                    page: 41
                    items: {
                        P41_ID: &ID.
                    }
                    clearCache: 41
                    action: resetPagination
                }
            }
            source {
                databaseColumn: TERM_NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column UPDATED (
            type: datePickerJquery
            heading {
                heading: Updated
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: SINCE
            }
            source {
                databaseColumn: UPDATED
                dataType: timestampWithLocalTimeZone
            }
        )

        column UPDATED_BY (
            type: textarea
            heading {
                heading: Updated By
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: UPDATED_BY
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    button create-deal-term (
        buttonName: CREATE_DEAL_TERM
        label: Create Deal Term
        layout {
            sequence: 10
            region: @breadcrumb
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 41
                clearCache: 41
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-ig-on-create (
        name: Refresh IG on Create
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create-deal-term
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @deal-terms
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-ig-on-edit (
        name: Refresh IG on Edit
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @deal-terms
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @deal-terms
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


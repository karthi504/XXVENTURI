page 137 (
    name: Stock Code Details
    title: Stock Code Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region stock-code-details (
        name: Stock Code Details
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P137_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 30
            region: @stock-code-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 28
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRIPTION
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P137_STOCK_CODE (
        type: numberField
        label {
            label: Stock Code
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @stock-code-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: STOCK_CODE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P137_STOCK_ID (
        type: hidden
        layout {
            sequence: 10
            region: @stock-code-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: STOCK_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @stock-code-details
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 97
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @stock-code-details
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P137_STOCK_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @stock-code-details
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @stock-code-details
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_STOCK_ID
        }
    )

    validation stock-code-validations (
        name: Stock Code Validations
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                For rec in (select STOCK_CODE from XXEBA_STOCK_CODES  )
                loop 
                if :P137_STOCK_CODE =rec.STOCK_CODE then
                        return 'Already this code is exists. Please give another code' ;
                    end if;
                    END LOOP;
                    END;
                ```
        }
        error {
            displayLocation: inlineWithField
            associatedItem: @P137_STOCK_CODE
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process fetch-row-from-xxeba-stock-codes (
        name: Fetch Row from XXEBA_STOCK_CODES
        type: autoRowFetch
        source {
            tableName: XXEBA_STOCK_CODES
            pkColumn: STOCK_ID
            pkItem: P137_STOCK_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 89850900764928909
        }
    )

    process process-row-of-xxeba-stock-codes (
        name: Process Row of XXEBA_STOCK_CODES
        type: autoRowProcessing
        target {
            tableName: XXEBA_STOCK_CODES
            pkColumn: STOCK_ID
            pkItem: P137_STOCK_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 89851364139928909
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 89851759110928909
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 97
            }
        }
    )

)


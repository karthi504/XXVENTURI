page 183 (
    name: Sale Order copy
    title: Sale Order copy
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region sales-orders (
        name: Sales Orders
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                'Sales Orders'  "Sales Orders",
                --T.TERRITORY_NAME "Branch",
                T.BILLING_REGION "Branch",
                C.CUSTOMER_CODE "PartyAccountCode",
                'A' "PriceList",
                --R.REP_LAST_NAME||' '||R.REP_LAST_NAME "Executive",
                initcap(R.USER_NAME)  "Executive",
                0 "ShippingDiffBilling",
                --'"'||L.CUSTOMER_ADDRESS1||', '||L.CUSTOMER_ADDRESS2||', '||CT.CITY_NAME||', '||ST.STATE||', '||CN.COUNTRY_NAME||', '||L.CUSTOMER_POSTAL_CODE||'"' "ShippingAddress",
                '' "ShippingAddress",
                '' "Remarks",
                --OP.PRODUCT_NAME "ProductCode",
                SP.PRODUCT_NAME "ProductCode",
                SP.CATALOGUE_NO "Ordering Code",     -- Column added on 19-June-18 by Thamaraiselvan
                OP.QUANTITY "Quantity",OP.DELIVERY_DATE "Deliverydate",
                OP.PRODUCT_PRICE "UnitRate",
                --(select SP.PRODUCT_PRICE from EBA_SALES_PRODUCTS SP  where OP.PRODUCT_NAME = SP.PRODUCT_NAME and rownum=1) "UnitRate",
                '' "DiscountBasis1",
                '' "Discount1",
                '18-'||SP.PRODUCT_SKU "TaxStructure",
                SO.REMARKS  "Comments",
                SO.PO_NUMBER "ReferenceBillNo",
                SO.PO_DATE "ReferenceBillDate",
                'Nearest Integer' "RoundOffType",
                SO.ORDER_DATE "DATE",
                'SO' "A",
                SO.ORDER_NUMBER "B",
                (select PART_NUMBER from XXEBA_SALES_ACC_PRODUCTS where PRODUCT_ID=OP.PRODUCT_ID AND CUSTOMER_ID=SO.CUSTOMER_ID) "Part Number"
                from
                XXEBA_ORDER_PRODUCTS OP,
                XXEBA_SALES_ORDER SO,
                EBA_SALES_TERRITORIES T,
                EBA_SALES_CUSTOMERS C,
                EBA_SALES_SALESREPS R,
                EBA_SALES_CUSTOMER_LOCATIONS L,
                XXEBA_SALES_CITIES_T CT,
                EBA_SALES_STATES ST,
                EBA_SALES_COUNTRIES CN,
                EBA_SALES_PRODUCTS SP
                where 
                OP.ORDER_ID = SO.ORDER_ID
                --and SO.TERRITORY_ID = T.ID
                and C.CUSTOMER_TERRITORY_ID = T.ID
                and SO.CUSTOMER_ID = C.ID
                and SO.SALES_REP = R.ID
                and SO.DELIVERY_LOCATION = L.ID(+)
                and L.CITY_ID = CT.CITY_ID(+)
                and L.STATE_ID = ST.ID(+)
                and L.COUNTRY_ID = CN.ID(+)
                and OP.PRODUCT_ID = SP.ID(+)
                and SO.STATUS = 'Y' 
                and NVL(SO.EXPORT_FLAG,'N')!='Y' -- NVL handled by Karkuvelraja T on 02-Jun-2018
                --and SO.ORDER_DATE between :P183_FROM_DATE and :P183_TO_DATE
                order by SO.ORDER_NUMBER;
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnAttributes: style="display:block"
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Export_report
        }
        link {
            linkColumn: customTarget
            target: {
                page: 103
                items: {
                    P103_ORDER_ID: #ORDER_ID#
                    P103_DEAL_ID: #DEAL_ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 297976416346153417
        }


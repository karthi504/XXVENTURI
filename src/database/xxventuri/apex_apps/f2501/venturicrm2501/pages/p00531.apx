    region inactive-customers (
        name: Inactive Customers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select customer_name,CUSTOMER_CODE,CUSTOMER_TERRITORY_ID,default_rep_id from eba_sales_customers 
                 where id not in (
                SELECT distinct
                    customer_id
                FROM
                    xxeba_sales_order
                WHERE
                    customer_id IS NOT NULL
                    AND status = 'Y'
                    AND UPDATED_IN_TALLY = 'Y'
                    AND to_char(ORDER_DATE,'DD-Mon-YYYY') >  add_months(trunc(sysdate,'MM'),-3)
                    )
                    
                ```

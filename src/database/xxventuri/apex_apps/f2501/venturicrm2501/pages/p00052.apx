page 52 (
    name: Competitor Details
    title: Competitor Details
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        authorizationScheme: @xxeba-admin
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }
    config {
        buildOption: @competitors
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region competitor-details (
        name: Competitor Details
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P52_COMPETITOR_DESC (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        settings {
            resizable: false
            trimSpaces: none
        }
        layout {
            sequence: 150
            region: @competitor-details
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 64
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: COMPETITOR_DESC
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P52_COMPETITOR_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @competitor-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 64
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: COMPETITOR_NAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P52_ID (
        type: hidden
        layout {
            sequence: 10
            region: @competitor-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P52_TAGS (
        type: plugin/tagEntry
        label {
            label: Tags
            alignment: left
        }
        settings {
            validationFailureMessage: Tags may not contain the following characters: : ; \ / ? &
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select tag
                  from eba_sales_tags_type_sum
                 where content_type = 'COMPETITOR'
                ```
        }
        layout {
            sequence: 160
            region: @competitor-details
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 80
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: TAGS
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )


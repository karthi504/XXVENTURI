page 228 (
    name: Parameters List
    title: Parameters List
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region parameters-list (
        name: Parameters List
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1220
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                  PARAMETER_ID,
                  CODE,
                  CHAR_VALUE,
                  NUM_VALUE,
                  DECODE(STATUS, 'Y', 'Enabled', 'Disabled')STATUS
                FROM XXEBA_SALES_PARAMETERS_T
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 227
                items: {
                    P227_PARAMETER_ID: #PARAMETER_ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 589842950242486634
        }

        column CHAR_VALUE (
            type: plainText
            heading {
                heading: Character Value
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NUM_VALUE (
            type: plainText
            heading {
                heading: Numeric Value
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column PARAMETER_ID (
            type: hidden
            heading {
                heading: Parameter Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 2950139 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CHAR_VALUE (
                sequence: 3
            )

            displayColumn CODE (
                sequence: 2
            )

            displayColumn NUM_VALUE (
                sequence: 4
            )

            displayColumn PARAMETER_ID (
                sequence: 1
            )

            displayColumn STATUS (
                sequence: 5
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add Parameter
        layout {
            sequence: 30
            region: @parameters-list
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 227
                clearCache: 227
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


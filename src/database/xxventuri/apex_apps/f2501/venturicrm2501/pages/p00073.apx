page 73 (
    name: Create Opportunity
    title: Create Opportunity
    pageGroup: @opportunities
    appearance {
        pageMode: modalDialog
        dialogTemplate: @wizard-modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
            .shuttle select {width: 300px}
            </style>
            ```
    }
    security {
        authorizationScheme: @contribution-rights
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region buttons-container (
        name: Buttons container
        type: staticContent
        layout {
            sequence: 10
            slot: wizardButtons
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region create-opportunity (
        name: Create Opportunity
        type: staticContent
        layout {
            sequence: 10
            slot: wizardBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader
                t-Region--hiddenOverflow
                t-Form--labelsAbove
            ]
        }
    )

    region create-opportunity-train (
        name: create opportunity train
        type: list
        source {
            list: @create-opportunity-train
        }
        layout {
            sequence: 10
            slot: wizardProgressBar
        }
        componentAppearance {
            listTemplate: @wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P73_OPPORTUNITY_NAME (
        type: displayOnly
        label {
            label: "Opportunity: "
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @create-opportunity
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: &P71_OPPORTUNITY_NAME.
            used: always
        }
        default {
            type: static
            staticValue: &P71_OPPORTUNITY_NAME.
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P73_PRODUCTS (
        type: shuttle
        label {
            label: Products (shuttle proposed projects to right side)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select product_name, id
                from eba_sales_products
                order by upper(product_name)
                ```
        }
        layout {
            sequence: 30
            region: @create-opportunity
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons-container
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @buttons-container
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--large
            ]
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 20
            region: @buttons-container
            slot: previous
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-clicked (
        name: Cancel clicked
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 20
            point: validating
        }
        behavior {
            target: {
                page: 72
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            whenButtonPressed: @previous
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 74
            }
            saveStateBeforeBranching: true
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)


page 217 (
    name: Trial Report
    title: Trial Report
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region closed (
        name: Closed
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                TRIAL_ID,
                DEAL_ID,
                to_char(sysdate, 'YY')||'/'||trial_no as trial_no,
                COMPONENT_NAME,
                PART_NUMBER,
                MATERIAL_TYPE,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_PROCESS_TYPE' and LIST_ID = trial.PROCESS_TYPE)PROCESS_TYPE,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_INPUT_CONDITION' and LIST_ID = trial.INPUT_CONDITION)INPUT_CONDITION,
                HARDNESS,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_HEAT_TREATMENT_TYPE' and LIST_ID = trial.HEAT_TREATMENT_TYPE)HEAT_TREATMENT_TYPE,
                SURFACE_CONDITION,
                COMP_DIAMETER,
                COMP_LENGTH,
                COMP_WIDTH,
                COMP_THICKNESS,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_SHAPE' and LIST_ID = trial.COMP_SHAPE)COMP_SHAPE,
                MACHINE_TYPE,
                MACHINE_BRAND,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_WORKHOLDING_TYPE' and LIST_ID = trial.WORKHOLDING_TYPE)WORKHOLDING_TYPE,
                CHUCK_DIAMETER,
                SPINDLE_TAPER,
                decode(THROUGH_COOLANT,'Y', 'Yes', 'No')THROUGH_COOLANT,
                TABLE_SIZE,
                NO_OF_TOOL_LOCATION,
                MAXIMUM_RPM,
                SPINDLE_TOOL_WEIGHT_LIMIT,
                EXIST_TOOL_SPEC,
                EXIST_TOOL_HOLDING_SPEC,
                EXIST_NO_OF_CUTTING_EDGES,
                EXIST_NO_OF_FLUTES,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_TOOL_CHANGING_CRITERIA' and LIST_ID = trial.EXIST_TOOL_CHANGING_CRITERIA)EXIST_TOOL_CHANGING_CRITERIA,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_COATING_TYPE' and LIST_ID = trial.EXIST_TYPE_OF_COATING)EXIST_TYPE_OF_COATING,
                EXIST_NO_OF_REGRINDING_DONE,
                EXIST_AVERAGE_LIFE_PER_EDGE,
                EXIST_UNIT_PRICE,
                RECOM_TOOL_SPEC,
                RECOM_TOOL_HOLDING_SPEC,
                RECOM_NO_OF_CUTTING_EDGES,
                RECOM_NO_OF_FLUTES,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_TOOL_CHANGING_CRITERIA' and LIST_ID = trial.RECOM_TOOL_CHANGING_CRITERIA)RECOM_TOOL_CHANGING_CRITERIA,
                (select LIST_VALUE from XXEBA_LIST_VALUES where LIST_CODE = 'TRIAL_COATING_TYPE' and LIST_ID = trial.RECOM_TYPE_OF_COATING)RECOM_TYPE_OF_COATING,
                RECOM_NO_OF_REGRINDING_DONE,
                RECOM_AVERAGE_LIFE_PER_EDGE,
                RECOM_UNIT_PRICE,
                EXIST_TOTAL_MATERIAL_REMOVAL,
                EXIST_NO_OF_PASSES,
                EXIST_DEPTH_OF_CUT,
                EXIST_WIDTH_OF_CUT,
                EXIST_SPINDLE_SPEED,
                EXIST_CUTTING_SPEED,
                EXIST_FEED_PER_TOOTH,
                EXIST_TABLE_FEED,
                EXIST_CYCLE_TIME,
                RECOM_TOTAL_MATERIAL_REMOVAL,
                RECOM_NO_OF_PASSES,
                RECOM_DEPTH_OF_CUT,
                RECOM_WIDTH_OF_CUT,
                RECOM_SPINDLE_SPEED,
                RECOM_CUTTING_SPEED,
                RECOM_FEED_PER_TOOTH,
                RECOM_TABLE_FEED,
                RECOM_CYCLE_TIME,
                RESULT_AVG_LIFE_EDGE,
                RESULT_AVG_CONTACT_TIME,
                RESULT_CYLE_TIME_DIFFERENCE,
                RESULT_PRODUCTIVITY_IMPROVED,
                decode(TRIAL_RESULT, 'F', 'Fail', 'P', 'Pass')TRIAL_RESULT,
                decode(STATUS, 'N', 'New', 'I', 'In Progress', 'C', 'Closed')STATUS,
                deal.deal_name,
                deal.customer_name,
                created_date,
                created_by,
                (case when STATUS = 'C' then null else
                --'<i class="fa fa-check-circle"></i>' 
                 '<img src="#APP_IMAGES#result_icon.png" alt="result">'
                 end) as result,
                 (select REP_FIRST_NAME  from eba_sales_salesreps where ID=deal.salesrep_id_01 ) as Sales_Rep,
                  (NVL(RECOM_UNIT_PRICE,0) * NVL(RECOM_NO_OF_FLUTES,0)) AS val
                from XXEBA_TRIAL_DETAILS trial, 
                (SELECT d.id,
                  d.deal_name,
                  d.salesrep_id_01,
                  c.customer_name
                FROM eba_sales_deals d,
                  eba_sales_customers c
                WHERE c.id = d.customer_id 
                )deal
                where DEAL_ID = deal.id and trial.status = 'C'
                -- AND trial.status != 'X'
                -- and status = 'Y'
                ```
        }
        layout {
            sequence: 30
            parentRegion: @trial-report
            slot: tabs
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 317393458050847821
        }


        }

        savedReport 3173634 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMPONENT_NAME (
                sequence: 5
            )

            displayColumn CREATED_DATE (
                sequence: 2
            )

            displayColumn CUSTOMER_NAME (
                sequence: 4
            )

            displayColumn DEAL_NAME (
                sequence: 3
            )

            displayColumn HARDNESS (
                sequence: 10
            )

            displayColumn INPUT_CONDITION (
                sequence: 9
            )

            displayColumn MATERIAL_TYPE (
                sequence: 7
            )

            displayColumn PART_NUMBER (
                sequence: 6
            )

            displayColumn PROCESS_TYPE (

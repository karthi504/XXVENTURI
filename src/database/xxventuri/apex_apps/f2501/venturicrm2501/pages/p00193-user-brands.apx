            }
            source {
                databaseColumn: USER_BRAND_ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column USER_ID (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {

page 193 (
    name: User Brands
    alias: USER-BRANDS
    title: User Brands
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region brands (
        name: Brands
        type: staticContent
        layout {
            sequence: 1220
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select USER_BRAND_ID,
                       USER_ID,
                       BRAND_ID,
                       APPROVAL_LIMIT,
                       STATUS,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE
                  from XXEBA_SALES_USER_BRANDS
                  where user_id = :P193_USER_ID;
                ```
        }
        layout {
            sequence: 1230
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-lg
            ]
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            selectFirstRow: false
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            download: false
        }
        heading {
            fixedTo: region
            fixedReportHeight: 250
        }
        advanced {
            savedReportMappingIdentifier: 318851946946440113
        }

        savedReport 3189190 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @USER_BRAND_ID
                layout {
                    sequence: 1
                }

page 227 (
    name: Parameter Details
    title: Parameter Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-xxeba-sales-parameters-t (
        name: Form on XXEBA_SALES_PARAMETERS_T
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P227_CHAR_VALUE (
        type: textarea
        label {
            label: Character Value
            alignment: left
        }
        layout {
            sequence: 30
            region: @form-on-xxeba-sales-parameters-t
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 2000
        }
        source {
            type: databaseColumn
            databaseColumn: CHAR_VALUE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P227_CODE (
        type: textField
        label {
            label: Code
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @form-on-xxeba-sales-parameters-t
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            type: databaseColumn
            databaseColumn: CODE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P227_NUM_VALUE (
        type: numberField
        label {
            label: Numeric Value
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @form-on-xxeba-sales-parameters-t
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: NUM_VALUE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P227_PARAMETER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-xxeba-sales-parameters-t
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: PARAMETER_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P227_STATUS (
        type: switch
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 50
            region: @form-on-xxeba-sales-parameters-t
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P227_PARAMETER_ID
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Add Parameter
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P227_PARAMETER_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P227_PARAMETER_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 296239475253470027
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-xxeba-sales-parameters-t (
        name: Fetch Row from XXEBA_SALES_PARAMETERS_T
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_PARAMETERS_T
            pkColumn: PARAMETER_ID
            pkItem: P227_PARAMETER_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 296238269873470026
        }
    )

    process process-row-of-xxeba-sales-parameters-t (
        name: Process Row of XXEBA_SALES_PARAMETERS_T
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_PARAMETERS_T
            pkColumn: PARAMETER_ID
            pkItem: P227_PARAMETER_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 296238631322470026
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 296239074725470026
        }
    )

)


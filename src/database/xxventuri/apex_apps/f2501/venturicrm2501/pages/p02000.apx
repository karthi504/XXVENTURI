    dynamicAction set-total-order-value-as-on-date (
        name: Set Total Order Value as on date
        execution {
            sequence: 240
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                    SELECT
                        TO_CHAR( SUM(nvl(PRD.PRODUCT_PRICE,0) * nvl(PRD.QUANTITY,0)), '99G99G99G990D00')     INTO :P2000_TOTAL_ORDERS_VALUE
                    FROM
                        XXEBA_ORDER_PRODUCTS PRD, XXEBA_SALES_ORDER ORD
                    WHERE
                        PRD.ORDER_ID = ORD.ORDER_ID
                        AND ORD.SALES_REP = :USER_ID
                        AND ORD.STATUS = 'Y'
                        AND PRD.STATUS = 'Y'
                        AND ORD.CREATED BETWEEN Last_Day(ADD_MONTHS(SYSDATE,-1))+1 AND SYSDATE;
                        
                     SELECT SUM(INVOICE_VALUE)  INTO :P2000_INVOICE_VALUE FROM  
                    (SELECT DISTINCT(INVOICE_ID),(-1*INVOICE_VALUE) as INVOICE_VALUE 
                     FROM  XXEBA_TALLY_INVOICES_T WHERE SALES_ORDER_NUMBER IN (SELECT
                        ORDER_NUMBER
                    FROM
                        XXEBA_ORDER_PRODUCTS PRD, XXEBA_SALES_ORDER ORD
                    WHERE
                        PRD.ORDER_ID = ORD.ORDER_ID
                        AND ORD.SALES_REP = :USER_ID
                        AND ORD.STATUS = 'Y'
                        AND PRD.STATUS = 'Y'
                        AND ORD.CREATED BETWEEN Last_Day(ADD_MONTHS(SYSDATE,-1))+1 AND SYSDATE));
                    
                        
                    EXCEPTION
                        WHEN OTHERS THEN 
                        :P2000_TOTAL_ORDERS_VALUE:= 0;
                        xxfs_pm_error_log_pkg.record_log('ERROR','Total Order Value as on Date HOME PAGE: ' || :P2000_TOTAL_ORDERS_VALUE,'BLOCK 1',:APP_PAGE_ID);
                    END;
                    ```
                itemsToReturn: [
                    P2000_TOTAL_ORDERS_VALUE
                    P2000_INVOICE_VALUE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-total-orders-as-on-date (
        name: Set Total Orders as on date
        execution {
            sequence: 230
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT
                        COUNT(*) INTO :P2000_TOTAL_ORDERS_SCORE
                    FROM
                        XXEBA_SALES_ORDER
                    WHERE
                        SALES_REP = :USER_ID
                        AND STATUS = 'Y'
                        AND CREATED BETWEEN Last_Day(ADD_MONTHS(SYSDATE,-1))+1 AND SYSDATE;
                    EXCEPTION
                        WHEN OTHERS THEN 
                        :P2000_TOTAL_ORDERS_SCORE:= NULL;
                        xxfs_pm_error_log_pkg.record_log('ERROR','Total Orders as on Date HOME PAGE: ' || :P2000_TOTAL_ORDERS_SCORE,'BLOCK 1',:APP_PAGE_ID);
                    END;
                    ```
                itemsToReturn: P2000_TOTAL_ORDERS_SCORE
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-total-score-as-on-date (
        name: Set Total Score as on date
        execution {
            sequence: 220
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_first_month_date	DATE;
                    v_sysdate 			DATE;
                    
                    BEGIN
                    v_first_month_date:= Last_Day(ADD_MONTHS(SYSDATE,-1))+1;
                    
                    select 
                    XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:USER_ID,'Identification',TO_DATE(TO_DATE(v_first_month_date,'DD-MM-YYYY'),'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:USER_ID,'First Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:USER_ID,'Repeat Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:USER_ID,'100% Plan',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:USER_ID,'90% Plan',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:USER_ID,'75% Plan',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:USER_ID,'<50%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))     
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_QUOTE_SUBMISSION(:USER_ID,'Tooling Up',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_QUOTE_SUBMISSION(:USER_ID,'Project',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(:USER_ID,'New Product',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(:USER_ID,'Project',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(:USER_ID,'Price Increase',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(:USER_ID,'First Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(:USER_ID,'Annual Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(:USER_ID,'Schedule Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(:USER_ID,'>50000',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(:USER_ID,'>100000',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(:USER_ID,'Repeat Sales Order',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:USER_ID,'<20%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:USER_ID,'>20%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:USER_ID,'>30%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:USER_ID,'>50%',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    into  :P2000_SCORE1 from dual;
                    
                    EXCEPTION WHEN OTHERS THEN
                     v_first_month_date:= NULL;
                     xxfs_pm_error_log_pkg.record_log('ERROR','SCORE 1 HOME PAGE: '||:P2000_SCORE1,'BLOCK 1',:APP_PAGE_ID);
                    END;
                    ```
                itemsToReturn: P2000_SCORE1
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_first_month_date	DATE;
                    v_sysdate 			DATE;
                    
                    BEGIN
                    v_first_month_date:= Last_Day(ADD_MONTHS(SYSDATE,-1))+1;
                    
                    select
                     XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(:USER_ID,'Monthly',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(:USER_ID,'3 Months',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(:USER_ID,'6 Months',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(:USER_ID,'Annual',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_SUPPLY(:USER_ID,'On Time',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_SUPPLY(:USER_ID,'Delayed',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_SUPPLY(:USER_ID,'Delay More Than Week',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CONDUCTING_TRIALS(:USER_ID,'New Product',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CONDUCTING_TRIALS(:USER_ID,'Improvement',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CONDUCTING_TRIALS(:USER_ID,'Competition Replacement',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_DISCIPLINE(:USER_ID,'No Leave',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_DISCIPLINE(:USER_ID,'2 Days',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_DISCIPLINE(:USER_ID,'>2 Days',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))   
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_DISCIPLINE(:USER_ID,'Late Arrival',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_REPORT_SUBMIT(:P253_SALES_REP,'On-Time',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_REPORT_SUBMIT(:P253_SALES_REP,'Delayed',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY'))
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_REWARDS(:P253_SALES_REP,'',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PAYMENT_COLLECTION(:P253_SALES_REP,'On Time',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PAYMENT_COLLECTION(:P253_SALES_REP,'>75 days',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PAYMENT_COLLECTION(:P253_SALES_REP,'>90 days',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                    +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PAYMENT_COLLECTION(:P253_SALES_REP,'>120 days',TO_DATE(v_first_month_date,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                    INTO :P2000_SCORE2 from dual;
                    
                    EXCEPTION WHEN OTHERS THEN
                     v_first_month_date:= NULL;
                     xxfs_pm_error_log_pkg.record_log('ERROR','SCORE 2 HOME PAGE: '||:P2000_SCORE2,'BLOCK 1',:APP_PAGE_ID);
                    END;
                    
                    
                    ```
                itemsToReturn: P2000_SCORE2
                showProcessing: true
            }
            execution {
                sequence: 30
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                    BEGIN
                    select (:P2000_SCORE1 + :P2000_SCORE2) into :P2000_TOTAL_SCORE from dual;
                    EXCEPTION WHEN OTHERS THEN
                     :P2000_TOTAL_SCORE:= NULL;
                     xxfs_pm_error_log_pkg.record_log('ERROR','tOTAL SCORE  HOME PAGE: '||:P2000_TOTAL_SCORE,'BLOCK 1',:APP_PAGE_ID);
                    END;
                    ```
                itemsToSubmit: [
                    P2000_SCORE1
                    P2000_SCORE2
                ]
                itemsToReturn: P2000_TOTAL_SCORE
                showProcessing: true
            }
            execution {
                sequence: 40
            }
        )

    )

    computation last-page (
        itemName: LAST_PAGE
        execution {
            sequence: 20
            point: beforeHeader
        }
        computation {
            type: staticValue
            staticValue: 100
        }
    )

    branch (
        name: Go To Page 1000
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            target: {
                page: 1000
                clearCache: 1000
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: eba_sales_fw.get_preference_value('FIRST_RUN') = 'YES'
        }
    )

)


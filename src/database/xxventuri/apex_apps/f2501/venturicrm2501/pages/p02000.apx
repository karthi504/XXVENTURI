    region new-accounts-without-billing (
        name: New Accounts without Billing
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT customer_name, sc.created
                FROM eba_sales_customers sc,
                  (SELECT ID AS customer_id FROM eba_sales_customers sc
                  MINUS
                  SELECT so.customer_id FROM xxeba_sales_order so
                  ) no_sales
                WHERE sc.ID = no_sales.customer_id
                AND ((sc.default_rep_id = (select id from EBA_SALES_SALESREPS where upper(user_name) = upper(:APP_USER))
                  AND NOT EXISTS
                    (SELECT 'Y'
                    FROM EBA_SALES_SALESREPS SR,
                      EBA_SALES_SALESREP_ROLES R
                    WHERE SR.REP_ROLE       = R.ID
                    AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                    AND SR.ID = (select id from EBA_SALES_SALESREPS where upper(user_name) = upper(:APP_USER))
                    ))
                   OR (((sc.default_rep_id = :P2000_NEW_ACCOUNT_WITHOUT_BILL OR :P2000_NEW_ACCOUNT_WITHOUT_BILL IS NULL) and sc.default_rep_id in (SELECT id
                FROM eba_sales_salesreps r
                  START WITH r.id      = :USER_ID
                  CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                AND EXISTS
                  (SELECT 'Y'
                  FROM EBA_SALES_SALESREPS SR,
                    EBA_SALES_SALESREP_ROLES R
                  WHERE SR.REP_ROLE       = R.ID
                  AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                  AND upper(SR.user_name) = :APP_USER
                  ))
                  OR ((sc.default_rep_id = :P2000_NEW_ACCOUNT_WITHOUT_BILL  OR :P2000_NEW_ACCOUNT_WITHOUT_BILL IS NULL)
                  AND EXISTS
                    (SELECT 'Y'
                    FROM EBA_SALES_SALESREPS SR,
                      EBA_SALES_SALESREP_ROLES R
                    WHERE SR.REP_ROLE       = R.ID
                    AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                    AND SR.ID = (select id from EBA_SALES_SALESREPS where  upper(user_name) = upper(:APP_USER))
                    ) ) )
                AND SC.status != 'X';
                ```
            pageItemsToSubmit: P2000_NEW_ACCOUNT_WITHOUT_BILL
        }
        layout {
            sequence: 330
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }

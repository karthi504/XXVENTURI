    region repeat-sales-during-current-month (
        name: Repeat Sales During Current Month
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT month_wise.customer_name,
                  month_wise.product_name,
                  SUM((SP.QUANTITY * SP.PRODUCT_PRICE))order_value
                FROM
                  ( SELECT DISTINCT customer_id,
                    customer_name,
                    product_name,
                    product_id
                  FROM
                    (SELECT so.customer_id,
                      sc.customer_name,
                      sp.product_name,
                      op.product_id
                    FROM xxeba_sales_order so,
                      eba_sales_customers sc,
                      xxeba_order_products op ,
                      eba_sales_products sp,
                      XXEBA_LIST_VALUES lv
                
                    WHERE so.customer_id                  = sc.id
                    AND so.order_id                       = op.order_id
                    AND op.product_id                     = sp.id
                     AND lv.LIST_ID = so.ORDER_TYPE_ID
                     AND lv.LIST_VALUE = 'Repeat Order'
                    AND lv.LIST_CODE='SALES_ORDER_TYPE'
                    AND TO_CHAR(TRUNC(so.created), 'Mon') = TO_CHAR(add_months(TRUNC(sysdate),0), 'Mon')
                    AND ((SO.SALES_REP = NVL(:P2000_REPEAT_SALES_ORDER,:USER_ID)
                    AND NOT EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                      AND upper(SR.user_name) = :APP_USER
                      ))
                     
                     OR (((SO.SALES_REP = NVL(:P2000_REPEAT_SALES_ORDER,:USER_ID) OR :P2000_REPEAT_SALES_ORDER IS NULL) and SO.created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = :APP_USER
                      ))
                         
                    OR ((SO.SALES_REP = NVL(:P2000_REPEAT_SALES_ORDER,:USER_ID)
                    OR :P2000_REPEAT_SALES_ORDER IS NULL)
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                      AND upper(SR.user_name) = :APP_USER
                      ) ) )
                     
                    INTERSECT
                     
                    SELECT so.customer_id,
                      sc.customer_name,
                      sp.product_name,
                      op.product_id
                    FROM xxeba_sales_order so,
                      eba_sales_customers sc,
                      xxeba_order_products op ,
                      eba_sales_products sp,
                     XXEBA_LIST_VALUES lv 
                    WHERE so.customer_id                  = sc.id
                    AND so.order_id                       = op.order_id
                    AND op.product_id                     = sp.id
                     AND lv.LIST_ID = so.ORDER_TYPE_ID
                     AND lv.LIST_VALUE = 'Repeat Order'
                    AND lv.LIST_CODE='SALES_ORDER_TYPE'
                    AND TO_CHAR(TRUNC(so.created), 'Mon') = TO_CHAR(TRUNC(sysdate), 'Mon')
                    AND so.status != 'X'
                    AND ((SO.SALES_REP = NVL(:P2000_REPEAT_SALES_ORDER,:USER_ID)
                    AND NOT EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                      AND upper(SR.user_name) = :APP_USER
                      ))
                    OR ((SO.SALES_REP = NVL(:P2000_REPEAT_SALES_ORDER,:USER_ID)
                    OR :P2000_REPEAT_SALES_ORDER IS NULL)
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                      AND upper(SR.user_name) = :APP_USER
                      ) ) )
                    )
                  )month_wise,
                  xxeba_sales_order SO,
                  xxeba_order_products SP
                WHERE so.order_id                     = sp.order_id
                AND month_wise.customer_id            = so.customer_id
                AND month_wise.product_id             = sp.product_id
                AND TO_CHAR(TRUNC(so.created), 'Mon') = TO_CHAR(TRUNC(sysdate), 'Mon')
                AND ((SO.SALES_REP = NVL(:P2000_REPEAT_SALES_ORDER,:USER_ID)
                AND NOT EXISTS
                  (SELECT 'Y'
                  FROM EBA_SALES_SALESREPS SR,
                    EBA_SALES_SALESREP_ROLES R
                  WHERE SR.REP_ROLE       = R.ID
                  AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                  AND upper(SR.user_name) = :APP_USER
                  ))
                OR ((SO.SALES_REP = NVL(:P2000_REPEAT_SALES_ORDER,:USER_ID)
                OR :P2000_REPEAT_SALES_ORDER IS NULL)
                AND EXISTS
                  (SELECT 'Y'
                  FROM EBA_SALES_SALESREPS SR,
                    EBA_SALES_SALESREP_ROLES R
                  WHERE SR.REP_ROLE       = R.ID
                  AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                  AND upper(SR.user_name) = :APP_USER
                  ) ) )
                GROUP BY month_wise.customer_name,
                  month_wise.product_name
                ```
            pageItemsToSubmit: P2000_REPEAT_SALES_ORDER
        }
        layout {
            sequence: 370
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h480
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 51
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }

        column CUSTOMER_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Customer
            }
            layout {
                sequence: 1
            }
        )

        column ORDER_VALUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Order Value
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column PRODUCT_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Product
            }
            layout {
                sequence: 2
            }
        )

    )


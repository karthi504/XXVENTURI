        series monthly-created-opportunities (
            name: Monthly Created Opportunities
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select months, count(*) from (
                                    select to_char(DEAL_CLOSE_DATE,'Mon-YYYY') Months, id from EBA_SALES_DEALS
                                        where DEAL_CLOSE_DATE between to_date('01-01-'||nvl(:P2000_FY_OCD,'17'), 'dd-mm-yy') and to_date('01-12-'||nvl(:P2000_FY_OCD,'18'), 'dd-mm-yy')
                        AND (SALESREP_ID_01 in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                      
                     or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                      
                                         order by DEAL_CLOSE_DATE)  
                    group by Months;
                    ```
            }
            columnMapping {
                label: MONTHS
                value: COUNT(*)
            }
            appearance {
                color: #F9D33A
            }
            link {
                type: redirectThisApp
                target: {
                    page: 42
                    items: {
                        IR_TERRITORY_NAME: &TERRITORY.
                        IRC_PRODUCT_QTR: FY&P2000_FY_OCD.
                    }
                    clearCache: [
                        42
                        RIR
                    ]
                    action: resetPagination
                }
            }
            label {
                show: true
                position: outsideSlice
            }

    pageItem P2000_TRIAL_CREATED_PASSED_ID (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_tl_sql     VARCHAR2(4000);
                  v_admin_sql  VARCHAR2(4000);
                  v_rep_mgr_id NUMBER;
                BEGIN
                
                  SELECT COUNT(REP_MANAGER_ID)
                  INTO v_rep_mgr_id
                  FROM eba_sales_salesreps
                  WHERE id        = :USER_ID;
                  
                  IF v_rep_mgr_id = 0 THEN
                    v_admin_sql  := 'SELECT rep_first_name  
                                      ||'' ''  
                                      ||rep_last_name d,  
                                      upper(user_name) r
                                      FROM eba_sales_salesreps
                                      where status = ''Y''
                                      order by 1';
                    RETURN v_admin_sql;
                  elsif v_rep_mgr_id > 0 THEN
                    v_tl_sql        := ('SELECT rep_first_name  
                                        ||'' ''||rep_last_name d,  
                                        upper(user_name) r
                                        FROM eba_sales_salesreps r                       
                                        START WITH r.id      = :USER_ID  
                                        CONNECT BY PRIOR r.id= r.REP_MANAGER_ID  
                                        order by 1');
                    RETURN v_tl_sql;
                  END IF;
                END;
                ```
            displayExtraValues: false
            nullDisplayValue: All
        }
        layout {
            sequence: 10
            region: @trials-created-vs-closed-sub
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            authorizationScheme: @xxeba-admin-teamlead
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                SELECT rep_first_name
                  ||' '
                  ||rep_last_name d,
                  upper(user_name) r
                FROM eba_sales_salesreps
                WHERE upper(user_name) IN
                  (SELECT created_by FROM XXEBA_TRIAL_DETAILS
                  )
                  order by 1;
                ```
        }
    )


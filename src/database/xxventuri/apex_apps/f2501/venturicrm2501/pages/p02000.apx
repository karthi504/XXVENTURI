    region top-open-opportunities (
        name: Top Open Opportunities
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select sd.id,
                  sd.deal_name,
                  case when apex_util.get_build_option_status(
                                p_application_id    => :APP_ID,
                                p_build_option_name => 'Opportunity Amount Set at Product Level'
                            ) = 'EXCLUDE' then
                      nvl(sd.deal_amount,0)
                  else
                      nvl((select sum(nvl(dp.quote_price, 0)) from EBA_SALES_DEAL_PRODUCTS dp where dp.deal_id = sd.id and (nvl(:P2000_FY_PCD, 0) = 0 or :P2000_FY_PCD = substr(dp.qtr, -2))),0)
                  end as deal_amount
                from eba_sales_deals sd
                join eba_sales_deal_status_codes sdsc
                  on sd.deal_status_code_id = sdsc.id
                where sdsc.corresponding_prob_pct not in (0, 100)
                  and (
                          (apex_util.get_build_option_status(
                                    p_application_id    => :APP_ID,
                                    p_build_option_name => 'Opportunity Amount Set at Product Level'
                                ) = 'EXCLUDE'
                           and 
                           (nvl(:P2000_FY_OCD, 0) = 0 or :P2000_FY_OCD = substr(sd.qtr, -2))
                          )
                          or 
                          apex_util.get_build_option_status(
                                p_application_id    => :APP_ID,
                                p_build_option_name => 'Opportunity Amount Set at Product Level'
                          ) = 'INCLUDE'
                      )
                      AND (sd.SALESREP_ID_01 in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                  
                 or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                  
                order by case when apex_util.get_build_option_status(
                             p_application_id    => :APP_ID,
                             p_build_option_name => 'Opportunity Amount Set at Product Level'
                         ) = 'EXCLUDE' then
                      nvl(sd.deal_amount,0)
                  else
                      nvl((select sum(nvl(dp.quote_price, 0)) from EBA_SALES_DEAL_PRODUCTS dp where dp.deal_id = sd.id and (nvl(:P2000_FY_PCD, 0) = 0 or :P2000_FY_PCD = substr(dp.qtr, -2))),0)
                  end desc
                
                ```
        }
        layout {
            sequence: 180
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                t-Region--noPadding
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: i-h400
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @show-top-open-opportunities-on-home-page
        }
        settings {
            labelColumn: DEAL_NAME
            valueColumn: DEAL_AMOUNT
            formatMask: 999G999G999G999G999G990
            labelLinkTarget: {
                page: 80
                items: {
                    P80_ID: &ID.
                }
                clearCache: 80
                action: resetPagination
            }
            valueLinkTarget: {
                page: 80
                items: {
                    P80_ID: &ID.
                }
                clearCache: 80
                action: resetPagination
            }
            textPosition: above
            colorScheme: default
            maximumRows: 50
        }
    )

    region total-leads-by-source (
        name: Total Leads by Source

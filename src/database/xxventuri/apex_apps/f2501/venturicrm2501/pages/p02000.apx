    region trials-material-value (
        name: Trials  Material Value
        type: chart
        layout {
            sequence: 310
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: No data to display
        }

        series unit-price-vs-fluets (
            name: Unit Price vs Fluets
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT SUM(no_of_records) no_of_records,
                      NVL(month_wise, PERIOD)       AS month_wise,
                      NVL(month_id, cal.YEAR_MONTH) AS month_id
                    FROM
                      (SELECT (NVL(tri.RECOM_UNIT_PRICE, 0) * NVL(tri.RECOM_NO_OF_FLUTES,0) ) no_of_records,
                        TO_CHAR(CREATED_DATE , 'Mon-YYYY')          AS month_wise,
                        to_number(TO_CHAR(CREATED_DATE , 'YYYYMM')) AS month_id
                      FROM XXEBA_TRIAL_DETAILS tri, eba_sales_deals deal
                      WHERE tri.TRIAL_RESULT = 'P' AND deal.ID=tri.deal_id
                       AND ((deal.SALESREP_ID_01 = :P2000_TRIAL_UNIT_PRICE_FLUETS
                      AND NOT EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)   in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                        AND upper(SR.user_name) = :APP_USER
                        ))
                           
                     OR (((deal.SALESREP_ID_01 = :P2000_TRIAL_UNIT_PRICE_FLUETS OR :P2000_TRIAL_UNIT_PRICE_FLUETS IS NULL) and deal.created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = :APP_USER
                      ))       
                      OR ((deal.SALESREP_ID_01                   = :P2000_TRIAL_UNIT_PRICE_FLUETS
                      OR :P2000_TRIAL_UNIT_PRICE_FLUETS  IS NULL)
                      AND EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                        AND upper(SR.user_name) = :APP_USER
                        ) ) )
                     
                      ),
                      XXEBA_MONTHLY_CALENDAR_V cal
                    WHERE month_id(+) = cal.YEAR_MONTH
                    GROUP BY NVL(month_wise, PERIOD),
                             (month_id, cal.YEAR_MONTH)
                             ORDER BY NVL(month_id, cal.YEAR_MONTH)
                    ```
                pageItemsToSubmit: P2000_TRIAL_UNIT_PRICE_FLUETS
            }
            columnMapping {
                label: MONTH_WISE
                value: NO_OF_RECORDS
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
            value {
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 2
                pattern: Rs ##,##,##,###.##
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

    )


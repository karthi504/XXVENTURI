    region top-10-orders (
        name: Top 10 Orders
        type: chart
        layout {
            sequence: 260
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
            showGroupName: false
        }
        legend {
            show: false
        }

        series top-5-sales-order (
            name: Top 5 Sales Order
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select * from (
                    SELECT
                        customer_name,
                        order_value
                    FROM
                        (
                            SELECT
                                customer_name,
                                SUM(order_value) order_value
                            FROM
                                (
                                    SELECT
                                        sc.customer_name,
                                        ( quantity * product_price ) order_value
                                    FROM
                                        xxeba_sales_order      so,
                                        xxeba_order_products   op,
                                        eba_sales_customers    sc
                                    WHERE
                                        so.order_id = op.order_id
                                        AND so.customer_id = sc.id
                                        AND so.status != 'X'
                    	                AND (order_date between trunc((SYSDATE), 'month') and  last_day(SYSDATE))
                                        AND ( ( so.sales_rep = NVL(:p2000_top_5_sales_orders,:user_id)
                                                AND NOT EXISTS (
                                            SELECT
                                                'Y'
                                            FROM
                                                eba_sales_salesreps        sr,
                                                eba_sales_salesrep_roles   r
                                            WHERE
                                                sr.rep_role = r.id
                                                AND upper(r.role_name) IN (
                                                    'ADMINISTRATOR',
                                                    'TEAM LEADER - SALES'
                                                )
                                                AND upper(sr.user_name) = :app_user
                                        ) )
                                              OR ( ( ( so.sales_rep = NVL(:p2000_top_5_sales_orders,:user_id) 
                                                      
                                                       OR :p2000_top_5_sales_orders IS NULL )
                                                     AND so.created_by IN (
                                            SELECT
                                                upper(user_name)
                                            FROM
                                                eba_sales_salesreps r
                                            START WITH
                                                r.id = :user_id
                                            CONNECT BY
                                                PRIOR r.id = r.rep_manager_id
                                        ) )
                                                   AND EXISTS (
                                            SELECT
                                                'Y'
                                            FROM
                                                eba_sales_salesreps        sr,
                                                eba_sales_salesrep_roles   r
                                            WHERE
                                                sr.rep_role = r.id
                                                AND upper(r.role_name) = 'TEAM LEADER - SALES'
                                                AND upper(sr.user_name) = :app_user
                                        ) )
                                              OR ( ( so.sales_rep = NVL(:p2000_top_5_sales_orders,:user_id) 
                                                    
                                                     OR :p2000_top_5_sales_orders IS NULL )
                                                   AND EXISTS (
                                            SELECT
                                                'Y'
                                            FROM
                                                eba_sales_salesreps        sr,
                                                eba_sales_salesrep_roles   r
                                            WHERE
                                                sr.rep_role = r.id
                                                AND upper(r.role_name) = 'ADMINISTRATOR'
                                                AND upper(sr.user_name) = :app_user
                                        ) ) )
                                )
                            GROUP BY
                                customer_name
                        )
                    
                    ORDER BY
                        2 DESC
                    )
                    where rownum <= 10
                    ```
                pageItemsToSubmit: P2000_TOP_5_SALES_ORDERS
            }
            columnMapping {
                label: CUSTOMER_NAME
                value: ORDER_VALUE
            }
            appearance {
                color: #4AEB41
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
            value {
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 2
                pattern: Rs ##,##,##,###.##
                baselineScaling: min
            }
            majorTicks {
                show: auto
            }
            minorTicks {
                show: false
            }
        )

    )


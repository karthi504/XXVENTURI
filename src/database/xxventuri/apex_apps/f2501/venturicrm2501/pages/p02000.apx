            onDisplay: none
            onDataChange: none
        }

        series opportunity-pipeline (
            name: Opportunity Pipeline
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sdsc.status_code,
                      sdsc.corresponding_prob_pct,
                      count(*) cnt
                    from eba_sales_deals sd
                    join eba_sales_deal_status_codes sdsc
                      on sd.deal_status_code_id = sdsc.id
                    where sdsc.corresponding_prob_pct != 0
                    AND (sd.SALESREP_ID_01 in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                      
                     or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                      
                    group by sdsc.status_code,
                      sdsc.corresponding_prob_pct
                    order by sdsc.corresponding_prob_pct
                    ```
            }
            columnMapping {
                label: STATUS_CODE
                value: CNT
            }
            label {
                show: true
            }
        )

    )


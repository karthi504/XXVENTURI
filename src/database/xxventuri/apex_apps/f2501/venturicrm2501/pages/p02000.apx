    region high-profit-sales (
        name: High Profit Sales
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                  sc.customer_name,
                  sp.product_name,
                 -- SO.CUSTOMER_ID,
                 -- OP.PRODUCT_ID,
                   op.quantity,
                   op.product_price,
                  (op.product_price * op.quantity) order_value,
                  --SP.PRODUCT_COST as master_product_cost, 
                  round((((op.product_price / sp.product_cost) * 100 ) - 100), 2) as profit_sales_percentage
                from xxeba_sales_order so,
                  xxeba_order_products op,
                  eba_sales_products sp,
                  eba_sales_customers sc
                where so.order_id = op.order_id
                and op.product_id = sp.id
                and so.customer_id = sc.id
                and to_char(so.created, 'Mon') = to_char(sysdate, 'Mon')
                and round((((op.product_price / sp.product_cost) * 100 ) - 100), 2) >= 20
                and SO.status != 'X';
                ```
        }
        layout {
            sequence: 350
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @xxeba-admin
        }

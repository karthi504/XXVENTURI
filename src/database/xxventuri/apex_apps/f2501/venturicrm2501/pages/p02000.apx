            name: x
            value {
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )


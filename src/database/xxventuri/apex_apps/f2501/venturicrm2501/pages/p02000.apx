            hideAndShowBehavior: none
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ){ 
                    this.donutSliceLabel = function( dataContext ){
                        var value_ger;
                        
                        value_ger = dataContext.value.toLocaleString('de-DE', {
                                      minimumFractionDigits: 0
                                    });
                        
                        return value_ger;
                    }  
                    options.dataLabel = donutSliceLabel; 
                    return options; 
                } 
                ```
        }

        series closed (
            name: Closed
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    
                    SELECT 
                      NVL(no_of_records, 0) AS no_of_records,
                      NVL(month_name, PERIOD)       AS month_wise,
                      NVL(month_id, cal.YEAR_MONTH) AS month_id
                    FROM
                      (
                      SELECT COUNT(*) no_of_records,
                        TO_CHAR(CC.RESOLVED_DATE, 'Mon-YYYY')month_name,
                        TO_CHAR(CC.RESOLVED_DATE, 'YYYYMM')month_id
                      FROM XXEBA_CUSTOMER_COMPLAINTS_T CC
                      group by TO_CHAR(CC.RESOLVED_DATE, 'Mon-YYYY'),  TO_CHAR(CC.RESOLVED_DATE, 'YYYYMM')
                      ),
                      XXEBA_MONTHLY_CALENDAR_V cal
                    WHERE month_id(+) = cal.YEAR_MONTH
                    ORDER BY NVL(month_id, cal.YEAR_MONTH);
                    ```
            }
            columnMapping {
                label: MONTH_WISE
                value: NO_OF_RECORDS
            }
            appearance {
                color: #30F009
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        series created (
            name: Created
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                      NVL(no_of_records, 0) AS no_of_records,
                      NVL(month_name, PERIOD)       AS month_wise,
                      NVL(month_id, cal.YEAR_MONTH) AS month_id
                    FROM
                      (
                      SELECT COUNT(*) no_of_records,
                        TO_CHAR(CC.CREATED, 'Mon-YYYY')month_name,
                        TO_CHAR(CC.CREATED, 'YYYYMM')month_id
                      FROM XXEBA_CUSTOMER_COMPLAINTS_T CC
                      WHERE status != 'X'
                      group by TO_CHAR(CC.CREATED, 'Mon-YYYY'),  TO_CHAR(CC.CREATED, 'YYYYMM')
                      ),
                      XXEBA_MONTHLY_CALENDAR_V cal
                    WHERE month_id(+) = cal.YEAR_MONTH
                    ORDER BY NVL(month_id, cal.YEAR_MONTH);
                    ```
            }
            columnMapping {
                label: MONTH_WISE
                value: NO_OF_RECORDS
            }
            appearance {
                color: #FF0505
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )


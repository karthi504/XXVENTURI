        series top-5-sales-order (
            name: Top 5 Sales Order
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select no_of_records,month_wise,month_id 
                    from 
                    (SELECT 
                     count(*) as no_of_records,
                    to_char(CREATED , 'Mon-YY') AS month_wise,
                    to_char(CREATED , 'MM-YY') AS month_id
                    FROM eba_sales_customers
                    where CREATED >= add_months(trunc(sysdate,'MM'),-5) 
                    AND STATUS != 'X'
                    AND STATUS = 'A'
                    AND ((DEFAULT_REP_ID = NVL(UPPER(:P2000_MONTHWISE_ACCOUNTS),:USER_ID)
                    AND NOT EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                      AND upper(SR.user_name) =  :APP_USER
                      ))
                         
                     OR (((DEFAULT_REP_ID = NVL(UPPER(:P2000_MONTHWISE_ACCOUNTS),:USER_ID) OR upper(:P2000_MONTHWISE_ACCOUNTS) IS NULL) and created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = upper(:APP_USER)
                      ))  
                    OR ((DEFAULT_REP_ID = NVL(UPPER(:P2000_MONTHWISE_ACCOUNTS),:USER_ID)
                    OR :P2000_MONTHWISE_ACCOUNTS IS NULL)
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                      AND upper(SR.user_name) = :APP_USER
                      )
                      )
                      )
                    GROUP BY to_char(CREATED , 'Mon-YY'),
                    to_char(CREATED , 'MM-YY') 
                    order by to_char(CREATED , 'MM-YY') ) order by to_date (month_wise,'MM-YY')  asc
                    
                    ```
                pageItemsToSubmit: P2000_MONTHWISE_ACCOUNTS
            }
            columnMapping {
                label: MONTH_WISE
                value: NO_OF_RECORDS
            }
            appearance {
                color: #05F5CD
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
            value {
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                baselineScaling: min
            }
            minorTicks {
                show: false
            }
        )


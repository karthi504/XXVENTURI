            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            minorTicks {
                show: false
            }
        )

    )

    region trials-created-vs-closed (
        name: Trials - Created vs Closed
        type: chart
        layout {
            sequence: 300
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        tooltip {
            showGroupName: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: No data to display
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ){ 
                    this.donutSliceLabel = function( dataContext ){
                        var value_ger;
                        
                        value_ger = dataContext.value.toLocaleString('de-DE', {
                                      minimumFractionDigits: 0
                                    });
                        
                        return value_ger;
                    }  
                    options.dataLabel = donutSliceLabel; 
                    return options; 
                } 
                ```
        }

        series created (
            name: Created
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(no_of_records, 0)no_of_records,
                      NVL(month_wise, PERIOD)       AS month_wise,
                      NVL(month_id, cal.YEAR_MONTH) AS month_id
                    FROM
                      (SELECT COUNT(*) no_of_records,
                        TO_CHAR(CREATED_DATE , 'Mon-YYYY')          AS month_wise,
                        to_number(TO_CHAR(CREATED_DATE , 'YYYYMM')) AS month_id
                      FROM XXEBA_TRIAL_DETAILS tri
                      WHERE tri.status != 'X'
                       AND ((created_by = :APP_USER
                      AND NOT EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)   in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                        AND upper(SR.user_name) = :APP_USER
                        ))
                            
                     OR (((created_by = :P2000_TRIAL_CREATED_PASSED_ID OR :P2000_TRIAL_CREATED_PASSED_ID IS NULL) and created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = :APP_USER
                      ))        
                      OR ((created_by                   = :P2000_TRIAL_CREATED_PASSED_ID
                      OR :P2000_TRIAL_CREATED_PASSED_ID IS NULL)
                      AND EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                        AND upper(SR.user_name) = :APP_USER
                        ) ) )
                      GROUP BY TO_CHAR(CREATED_DATE , 'Mon-YYYY'),
                        to_number(TO_CHAR(CREATED_DATE , 'YYYYMM'))
                      ),
                      XXEBA_MONTHLY_CALENDAR_V cal
                    WHERE month_id(+) = cal.YEAR_MONTH
                    ORDER BY NVL(month_id, cal.YEAR_MONTH)
                    ```
                pageItemsToSubmit: P2000_TRIAL_CREATED_PASSED_ID
            }
            columnMapping {
                label: MONTH_WISE
                value: NO_OF_RECORDS
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        series passed (
            name: Passed
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(no_of_records, 0)no_of_records,
                      NVL(month_wise, PERIOD)       AS month_wise,
                      NVL(month_id, cal.YEAR_MONTH) AS month_id
                    FROM
                      (SELECT COUNT(*) no_of_records,
                        TO_CHAR(CREATED_DATE , 'Mon-YYYY')          AS month_wise,
                        to_number(TO_CHAR(CREATED_DATE , 'YYYYMM')) AS month_id
                      FROM XXEBA_TRIAL_DETAILS tri
                      WHERE TRIAL_RESULT = 'P'
                      AND STATUS != 'X'
                      AND ((created_by = :APP_USER
                      AND NOT EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                        AND upper(SR.user_name) = :APP_USER
                        ))
                           
                    OR (((created_by = :P2000_TRIAL_CREATED_PASSED_ID OR :P2000_TRIAL_CREATED_PASSED_ID IS NULL) and created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = :APP_USER
                      ))
                      OR ((created_by                   = :P2000_TRIAL_CREATED_PASSED_ID
                      OR :P2000_TRIAL_CREATED_PASSED_ID IS NULL)
                      AND EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                        AND upper(SR.user_name) = :APP_USER
                        ) ) )
                      GROUP BY TO_CHAR(CREATED_DATE , 'Mon-YYYY'),
                        to_number(TO_CHAR(CREATED_DATE , 'YYYYMM'))
                      ),
                      XXEBA_MONTHLY_CALENDAR_V cal
                    WHERE month_id(+) = cal.YEAR_MONTH
                    ORDER BY NVL(month_id, cal.YEAR_MONTH)
                    ```
                pageItemsToSubmit: P2000_TRIAL_CREATED_PASSED_ID
            }
            columnMapping {
                label: MONTH_WISE
                value: NO_OF_RECORDS
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
            minorTicks {
                show: true
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            minorTicks {
                show: false
            }
        )

    )


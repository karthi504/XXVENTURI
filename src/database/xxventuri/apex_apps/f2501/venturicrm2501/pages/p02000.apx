            }
        )

    )

    region revenue-by-territories-2 (
        name: Revenue By Territories
        type: chart
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        config {
            buildOption: @opportunity-amount-set-at-product-level
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        legend {
            show: false
        }

        series revenue-by-territories (
            name: Revenue By Territories
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(sum(dp.quote_price), 0) as revenue,
                           t.territory_name as territory
                      from eba_sales_deal_products dp,
                           eba_sales_territories t
                     where dp.deal_id in (select id
                                            from eba_sales_deals 
                                           where customer_id in (select id 
                                                                   from eba_sales_customers 
                                                                  where customer_territory_id = t.id)
                                         )
                       and (
                               nvl(:P2000_FY_PCD, 0) = 0
                               or
                               dp.close_date between (select min(first_day) from eba_sales_sales_periods where fiscal_year = :P2000_FY_PCD) and (select max(last_day) from eba_sales_sales_periods where fiscal_year = :P2000_FY_PCD)
                           )
                     group by t.territory_name
                    ```
            }
            columnMapping {
                label: TERRITORY
                value: REVENUE
            }
            link {
                type: redirectThisApp
                target: {
                    page: 42
                    items: {
                        IR_TERRITORY_NAME: &TERRITORY.
                        IRC_PRODUCT_QTR: FY&P2000_FY_PCD.
                    }
                    clearCache: [
                        42
                        RIR
                    ]
                    action: resetPagination
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )


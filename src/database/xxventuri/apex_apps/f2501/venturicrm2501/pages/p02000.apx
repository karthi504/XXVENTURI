        series revenue-by-product-family (
            name: Revenue By Product Family
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(dp.quote_price) as revenue,
                           pf.product_family
                      from eba_sales_deal_products dp,
                           eba_sales_products p,
                           eba_sales_product_families pf
                     where dp.product_id = p.id
                       and p.product_family_id = pf.id
                       and (
                               nvl(:P2000_FY_PCD, 0) = 0
                               or
                               dp.close_date between (select min(first_day) from eba_sales_sales_periods where fiscal_year = :P2000_FY_PCD) and (select max(last_day) from eba_sales_sales_periods where fiscal_year = :P2000_FY_PCD)
                           )
                     group by pf.product_family
                    ```
            }
            columnMapping {
                label: PRODUCT_FAMILY
                value: REVENUE
            }
            link {
                type: redirectThisApp
                target: {
                    page: 135
                    items: {
                        IR_PRODUCT_FAMILY_ID: &PRODUCT_FAMILY.
                        IRLIKE_PRODUCT_QTR: \%FY&P2000_FY_PCD.%\

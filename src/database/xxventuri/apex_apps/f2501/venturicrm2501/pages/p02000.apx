                begin
                select count(*) into :P2000_ORDER_APPROVAL_COUNT from XXEBA_SALES_ORDER where STATUS = 'N';
                if :P2000_ORDER_APPROVAL_COUNT > 0 then 
                return :P2000_ORDER_APPROVAL_COUNT;

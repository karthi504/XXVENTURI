page 2000 (
    name: Venturi Home Page
    title: Venturi Home Page
    pageGroup: @home
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-Footer{
            	display:none;
            }
            
            #HOME_MENU ul li:nth-child(1) a{
            	border-left: 5px solid #309fdb;
            }
            
            #HOME_MENU ul li:nth-child(2) a{
            	border-left: 5px solid #13b6cf;
            }
            
            #HOME_MENU ul li:nth-child(3) a{
            	border-left: 5px solid #2ebfbc;
            }
            
            #HOME_MENU ul li:nth-child(4) a{
            	border-left: 5px solid #3caf85;
            }
            
            #HOME_MENU ul li:nth-child(5) a{
            	border-left: 5px solid #81bb5f;
            }
            
            #HOME_MENU ul li:nth-child(6) a{
            	border-left: 5px solid #ddde53;
            }
            
            #HOME_MENU ul li:nth-child(7) a{
            	border-left: 5px solid #fbce4a;
            }
            
            #HOME_MENU ul li:nth-child(8) a{
            	border-left: 5px solid #ed813e;
            }
            
            
            .js-navCollapsed .t-TreeNav .a-TreeView-node--topLevel > .a-TreeView-content .a-TreeView-label .a-TreeView-badge {
                display:none;
            }
            
            #go_button{
             margin-left: 22px;
                margin-top: 4px;
            }
            
            
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            <h2>About this Application</h2>
            <p>
            	Manage opportunities, track leads, manage accounts and contacts. Opportunities are organized by territory and account. For each opportunity you can track products, competition, team members, and add hypertext links and file attachments. Use interactive reports to slice and dice your pipeline. You can upload leads from spreadsheets and convert leads to opportunities.
            </p>
            ```
    }
    comments {
        comments:
            ```
            $(window).on("theme42ready", function() {
               if ($("body").hasClass("js-navExpanded")) {
               $("#t_Button_navControl").click();
              }
            });
            ```
    }

    region accounts-with-no-orders-for-past-two-months (
        name: Accounts with No Orders for Past Two Months
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.CUSTOMER_NAME,C.DEFAULT_REP_ID,
                S.REP_FIRST_NAME,
                orders.order_date  as last_order_date 
                from eba_sales_customers c ,(SELECT
                       max(order_date) as order_date ,customer_id
                FROM xxeba_sales_order 
                where trunc(CREATED) NOT BETWEEN TRUNC((ADD_MONTHS(SYSDATE, -2)),'MM') AND TRUNC(SYSDATE) 
                GROUP BY customer_id
                ) orders,
                EBA_SALES_SALESREPS S 
                where c.id=orders.customer_id and c.STATUS <> 'X'  
                AND 
                 C.DEFAULT_REP_ID=S.ID 
                 AND (upper(C.DEFAULT_REP_ID) in (SELECT  upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR 
                           where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                order by orders.order_date desc
                ```
            pageItemsToSubmit: P2000_NEW_ACCOUNT_WITHOUT_BILL
        }
        layout {
            sequence: 400
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 51
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        download {
            csvExportEnabled: true
        }

        column CUSTOMER_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Account Name
            }
            layout {
                sequence: 1
            }
            columnFormatting {
                htmlExpression: "<span style=\"white-space:nowrap;\">#CUSTOMER_NAME#</span> "
            }
            sorting {
                sortable: false
            }
        )

        column DEFAULT_REP_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column LAST_ORDER_DATE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Last Order Date
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-YYYY
            }
            columnFormatting {
                htmlExpression: "<span style=\"white-space:nowrap;\">#LAST_ORDER_DATE#</span> "
            }
            sorting {
                sortable: false
            }
        )

        column REP_FIRST_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Sales Rep Name
            }
            layout {
                sequence: 3
            }
            columnFormatting {
                htmlExpression: "<span style=\"white-space:nowrap;\">#REP_FIRST_NAME#</span> "
            }
            sorting {
                sortable: false
            }
        )

    )


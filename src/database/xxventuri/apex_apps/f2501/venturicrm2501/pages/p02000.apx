    pageItem P2000_UNVALIDATED (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                lv_verified number;
                lv_all_customer number;
                begin
                SELECT count(*) into :P2000_UNVALIDATED FROM EBA_SALES_CUSTOMERS WHERE STATUS='V';
                
                 if :P2000_UNVALIDATED > 0  then 
                      return :P2000_UNVALIDATED;
                else 
                return null;
                end if;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                select count(ID) into lv_verified from EBA_SALES_CUSTOMERS where ID in (select CUST_ID from EBA_SALES_VERIFICATIONS) AND STATUS='Y' ;
                select count(ID) into lv_all_customer from EBA_SALES_CUSTOMERS where  STATUS='Y' AND verified_by is not null ;
                    :P2000_UNVALIDATED :=lv_all_customer-lv_verified;
                ```
        }
    )

    pageItem P2000_VERIFICATION_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                SELECT count(*) into :P2000_VERIFICATION_COUNT
                FROM EBA_SALES_CUSTOMERS WHERE STATUS IN ('N');
                if :P2000_VERIFICATION_COUNT > 0 then 
                return :P2000_VERIFICATION_COUNT ;
                else 
                return null;
                end if;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                select count(*) into :P2000_VERIFICATION_COUNT  from EBA_SALES_CUSTOMERS where ID  in ( select CUSTOMER_ID from XXEBA_SALES_CUSTOMER_DETAILS 
                where EXPECTED_BUSINESS   IS NOT NULL
                AND CREDIT_LIMIT_REC      IS NOT NULL
                AND  ASSIGNED_TO          IS NOT NULL
                AND RECOMMENDED_BY        IS NOT  NULL ) AND VERIFIED_BY is null ;
                ```
        }
    )


    region leave-details (
        name: Leave Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                L.LEAVE_REQUEST_ID, 
                L.SALES_REP_ID,
                L.FROM_DATE,
                L.TO_DATE,
                DECODE(TRIM(L.FROM_PERIOD),'FD','Full Day','FN','Forenoon','AN','Afternoon') as FROM_PERIOD,
                DECODE(TRIM(L.TO_PERIOD),'FD','Full Day','FN','Forenoon','AN','Afternoon') as TO_PERIOD,
                L.NO_OF_DAYS,
                L.CONTACT_NUMBER,
                L.CONTACT_ADDRESS,
                L.LEAVE_REASON,
                decode(TRIM(L.LEAVE_STATUS), 'S','Submitted', 'A','Approved', 'R','Rejected')  LEAVE_STATUS,
                L.STATUS,
                L.CREATED_BY,
                L.CREATION_DATE,
                L.UPDATED_BY,
                L.UPDATE_DATE,
                L.APPROVED_BY,
                L.APPROVED_DATE,
                L.APPROVER_COMMENTS,
                L.LEAVE_TYPE_ID
                from XXEBA_SALES_LEAVE_REQUESTS_T L,EBA_SALES_SALESREPS S 
                where L.SALES_REP_ID=S.ID 
                 AND (upper(L.SALES_REP_ID) in (SELECT  upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR 
                           where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'));
                
                ```
        }
        layout {
            sequence: 390
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [

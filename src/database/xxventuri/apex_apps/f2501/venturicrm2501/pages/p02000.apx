        series sales-order-count (
            name: Sales Order Count
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                      NVL(no_of_records, 0) AS no_of_records,
                      NVL(month_name, PERIOD)       AS month_wise,
                      NVL(month_id, cal.YEAR_MONTH) AS month_id
                    FROM
                      (
                      SELECT COUNT(*) no_of_records,
                        TO_CHAR(SO.CREATED, 'Mon-YYYY')month_name,
                        TO_CHAR(SO.CREATED, 'YYYYMM')month_id
                      FROM XXEBA_SALES_ORDER SO
                      WHERE 
                        --SO.CREATED   >= add_months(TRUNC(sysdate,'MM'),-5)
                      so.STATUS = 'Y'
                      AND ((SALES_REP = NVL(:P2000_SALES_ORDER_COUNT,:USER_ID)
                      AND NOT EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                        AND upper(SR.user_name) = :APP_USER
                        ))
                           
                         OR (((SALES_REP = NVL(:P2000_SALES_ORDER_COUNT,:USER_ID) OR :P2000_SALES_ORDER_COUNT IS NULL) and created_by in (SELECT upper(user_name)
                        FROM eba_sales_salesreps r
                          START WITH r.id      = :USER_ID
                          CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                        AND EXISTS
                          (SELECT 'Y'
                          FROM EBA_SALES_SALESREPS SR,
                            EBA_SALES_SALESREP_ROLES R
                          WHERE SR.REP_ROLE       = R.ID
                          AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                          AND upper(SR.user_name) = :APP_USER
                          ))
                           
                      OR ((SALES_REP = NVL(:P2000_SALES_ORDER_COUNT,:USER_ID)
                      OR :P2000_SALES_ORDER_COUNT IS NULL)
                          
                      AND EXISTS
                        (SELECT 'Y'
                        FROM EBA_SALES_SALESREPS SR,
                          EBA_SALES_SALESREP_ROLES R
                        WHERE SR.REP_ROLE       = R.ID
                        AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                        AND upper(SR.user_name) = :APP_USER
                        ) ) )
                      GROUP BY TO_CHAR(SO.CREATED, 'Mon-YYYY'),
                        TO_CHAR(SO.CREATED, 'YYYYMM')
                      ),
                      XXEBA_MONTHLY_CALENDAR_V cal
                    WHERE month_id(+) = cal.YEAR_MONTH
                    ORDER BY NVL(month_id, cal.YEAR_MONTH)
                    ```
                pageItemsToSubmit: P2000_SALES_ORDER_COUNT
            }
            columnMapping {
                label: MONTH_WISE
                value: NO_OF_RECORDS
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )


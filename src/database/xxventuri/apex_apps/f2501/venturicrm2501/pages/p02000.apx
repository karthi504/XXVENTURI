    pageItem P2000_FY_OCD (
        type: selectList
        label {
            label: Fiscal Year
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @fiscal-years-deal-close-dates
            displayExtraValues: false
            nullDisplayValue: - All -
        }

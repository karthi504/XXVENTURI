    region status-wise-trials (
        name: Status-wise Trials
        type: chart
        layout {
            sequence: 290
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: noRescaling
        }

        series trial-status-wise (
            name: Trial Status Wise
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT COUNT(*) AS no_of_records,
                     DECODE(STATUS, 'N', 'New', 'I', 'In Progress', 'C', 'Closed') STATUS,
                      DECODE(STATUS, 'N', '01-New', 'I', '02-In Progress', 'C', '03-Closed') STATUS_ORDER,
                      DECODE(STATUS, 'N', 'New', 'I', 'In Progress', 'C', 'Closed')
                      || ' - '
                      ||COUNT(*) AS status_with_count
                    FROM XXEBA_TRIAL_DETAILS
                    WHERE STATUS != 'X'
                    AND ((created_by = :APP_USER AND NOT EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  in ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                      AND upper(SR.user_name) = :APP_USER
                      ))    
                         
                     OR (((created_by = :P2000_TRIAL_SALESPERSON_ID OR :P2000_TRIAL_SALESPERSON_ID IS NULL) and created_by in (SELECT upper(user_name)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID))
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'TEAM LEADER - SALES'
                      AND upper(SR.user_name) = :APP_USER
                      ))
                      
                    OR ((created_by = :P2000_TRIAL_SALESPERSON_ID OR :P2000_TRIAL_SALESPERSON_ID IS NULL)
                    AND EXISTS
                      (SELECT 'Y'
                      FROM EBA_SALES_SALESREPS SR,
                        EBA_SALES_SALESREP_ROLES R
                      WHERE SR.REP_ROLE       = R.ID
                      AND Upper(R.ROLE_NAME)  = 'ADMINISTRATOR'
                      AND upper(SR.user_name) = :APP_USER
                      )
                      )
                      )
                    GROUP BY DECODE(STATUS, 'N', 'New', 'I', 'In Progress', 'C', 'Closed'),
                    DECODE(STATUS, 'N', '01-New', 'I', '02-In Progress', 'C', '03-Closed')
                    ORDER BY 3
                    ```
                pageItemsToSubmit: P2000_TRIAL_SALESPERSON_ID
            }
            columnMapping {
                label: STATUS
                value: NO_OF_RECORDS
                customTooltip: STATUS_WITH_COUNT
                customColumn: STATUS_WITH_COUNT
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )

    region team-mates-efficiency-score (
        name: Team mates efficiency Score
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SAL.REP_FIRST_NAME||' '||SAL.REP_LAST_NAME AS NAME,
                (XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(SAL.ID,'Identification',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(SAL.ID,'First Order',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(SAL.ID,'Repeat Order',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(SAL.ID,'100% Plan',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(SAL.ID,'90% Plan',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(SAL.ID,'75% Plan',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(SAL.ID,'<50%',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))      
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_QUOTE_SUBMISSION(SAL.ID,'Tooling Up',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_QUOTE_SUBMISSION(SAL.ID,'Project',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(SAL.ID,'New Product',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(SAL.ID,'Project',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(SAL.ID,'Price Increase',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(SAL.ID,'First Order',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(SAL.ID,'Annual Order',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(SAL.ID,'Schedule Order',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))   
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(SAL.ID,'>50000',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(SAL.ID,'>100000',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_SO(SAL.ID,'Repeat Sales Order',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(SAL.ID,'<20%',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(SAL.ID,'>20%',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(SAL.ID,'>30%',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(SAL.ID,'>50%',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(SAL.ID,'Monthly',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(SAL.ID,'3 Months',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(SAL.ID,'6 Months',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_PLANNING(SAL.ID,'Annual',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_SUPPLY(SAL.ID,'On Time',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_SUPPLY(SAL.ID,'Delayed',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MATERIAL_SUPPLY(SAL.ID,'Delay More Than Week',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CONDUCTING_TRIALS(SAL.ID,'New Product',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CONDUCTING_TRIALS(SAL.ID,'Improvement',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CONDUCTING_TRIALS(SAL.ID,'Competition Replacement',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_DISCIPLINE(SAL.ID,'No Leave',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')) 
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_DISCIPLINE(SAL.ID,'2 Days',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))  
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_DISCIPLINE(SAL.ID,'>2 Days',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY'))   
                +XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_DISCIPLINE(SAL.ID,'Late Arrival',TO_DATE(Last_Day(ADD_MONTHS(SYSDATE,-1))+1,'DD-MM-YYYY'),TO_DATE(SYSDATE,'DD-MM-YYYY')))
                AS Efficiency_Score,
                (SELECT
                    COUNT(*) FROM
                    XXEBA_SALES_ORDER
                WHERE
                    SALES_REP = SAL.ID
                    AND STATUS = 'Y'
                    AND CREATED BETWEEN Last_Day(ADD_MONTHS(SYSDATE,-1))+1 AND SYSDATE) as Total_orders
                
                FROM EBA_SALES_SALESREPS SAL
                WHERE SAL.STATUS = 'Y'
                AND (upper(SAL.ID) in (SELECT  upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR 
                           where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'));
                ```
        }

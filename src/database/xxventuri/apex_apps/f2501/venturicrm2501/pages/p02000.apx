    pageItem P2000_PRODUCTS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  lv_verified_p   NUMBER;
                  lv_all_products NUMBER;
                BEGIN
                  SELECT COUNT(ID)
                  INTO lv_verified_p
                  FROM EBA_SALES_products
                  WHERE ID IN (SELECT PRODUCT_ID FROM EBA_SALES_VERIFICATIONS) AND STATUS='Y' ;
                  SELECT COUNT(ID) INTO lv_all_products FROM EBA_SALES_products where  STATUS='Y';
                  :P2000_PRODUCTS :=lv_all_products-lv_verified_p;
                if :P2000_PRODUCTS > 0  then 
                      return :P2000_PRODUCTS;
                else 
                return null;
                end if;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P2000_REC_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @notification-region
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                SELECT count(*) into :P2000_REC_COUNT
                FROM EBA_SALES_CUSTOMERS C WHERE NOT EXISTS (select * from  XXEBA_SALES_CUSTOMER_DETAILS D
                where C.ID=D.CUSTOMER_ID) AND STATUS='Y'
                AND ID  IN
                  (SELECT id
                  FROM EBA_SALES_CUSTOMERS
                  WHERE  upper(DEFAULT_REP_ID) IN
                    (SELECT upper(r.ID)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID
                    ) );
                    
                if :P2000_REC_COUNT > 0 then 
                return :P2000_REC_COUNT ;
                else 
                return null;
                end if;
                
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                SELECT count(*) into :P2000_REC_COUNT
                FROM XXEBA_SALES_CUSTOMER_DETAILS
                WHERE (EXPECTED_BUSINESS IS NULL
                or CREDIT_LIMIT_REC      IS NULL
                or ASSIGNED_TO           IS NULL
                or RECOMMENDED_BY        IS NULL)
                and  CUSTOMER_ID          IN
                  (SELECT id
                  FROM EBA_SALES_CUSTOMERS
                  WHERE  upper(DEFAULT_REP_ID) IN
                    (SELECT upper(r.ID)
                    FROM eba_sales_salesreps r
                      START WITH r.id      = :USER_ID
                      CONNECT BY PRIOR r.id= r.REP_MANAGER_ID
                    )  
                  ) ;
                ```
        }
    )


        series leads-by-source (
            name: Leads by source
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(sls.lead_source, 'Unidentified') lead_source,
                      count(*) cnt
                    from eba_sales_leads sl ,EBA_SALES_CUSTOMERS c ,eba_sales_lead_sources sls
                      where sl.lead_status_id = sls.id and sl.ACCOUNT_ID=c.id and 
                    
                     (c.DEFAULT_REP_ID in ( select ID from EBA_SALES_SALESREPS  where ID = :USER_ID)
                      or 
                        EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator'))
                        and  instr(':' || :P2000_LEAD_STATUSES || ':', ':' || sl.lead_status_id || ':') > 0
                     group by sls.lead_source
                    order by cnt desc
                    
                    
                    
                    
                    /*select nvl(sls.lead_source, 'Unidentified') lead_source,
                      count(*) cnt
                    from eba_sales_leads sl
                    left join eba_sales_lead_sources sls
                      on sl.lead_source_id = sls.id
                    where instr(':' || :P2000_LEAD_STATUSES || ':', ':' || sl.lead_status_id || ':') > 0
                    group by sls.lead_source
                    order by cnt desc*/
                    
                    ```
                pageItemsToSubmit: P2000_LEAD_STATUSES
            }
            columnMapping {
                label: LEAD_SOURCE
                value: CNT
            }
            label {
                show: true
            }
        )


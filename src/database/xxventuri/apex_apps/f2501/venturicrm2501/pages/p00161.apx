page 161 (
    name: Product Types Details
    title: Product Types Details
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region product-type-details (
        name: Product Type Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P161_PRODUCT_DESCRIPTION (
        type: textarea
        label {
            label: Product Description
            alignment: right
        }
        layout {
            sequence: 30
            region: @product-type-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_DESCRIPTION
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_PRODUCT_NAME (
        type: textField
        label {
            label: Product Type
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @product-type-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_TYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P161_PRODUCT_TYPE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @product-type-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_TYPE_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P161_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @xx-status-lov
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @product-type-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P161_PRODUCT_TYPE_ID
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @product-type-details
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 58
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @product-type-details
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P161_PRODUCT_TYPE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @product-type-details
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @product-type-details
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P161_PRODUCT_TYPE_ID
        }
    )

    process fetch-row-from-xxeba-sales-product-types (
        name: Fetch Row from XXEBA_SALES_PRODUCT_TYPES
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_PRODUCT_TYPES
            pkColumn: PRODUCT_TYPE_ID
            pkItem: P161_PRODUCT_TYPE_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 69447796280078411
        }
    )

    process process-row-of-xxeba-sales-product-types (
        name: Process Row of XXEBA_SALES_PRODUCT_TYPES
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_PRODUCT_TYPES
            pkColumn: PRODUCT_TYPE_ID
            pkItem: P161_PRODUCT_TYPE_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 69448247621078411
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 69448651228078411
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 58
            }
        }
    )

)


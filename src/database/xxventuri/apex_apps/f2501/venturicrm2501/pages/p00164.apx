    pageItem P164_CREDIT_DAYS (
        type: selectList
        label {
            label: "Credit Terms "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d ,r from 
                (
                select 'No Credit'd,'0' r, '1' seq from dual
                union
                select 'Immediate'd,'1' r, '2' seq from dual
                union 
                select '30 Days' d,'30' r ,'3' seq from dual
                union 
                select '45 Days' d,'45' r ,'4' seq from dual
                union 
                select '60 Days' d,'60' r ,'5' seq from dual
                union 
                select '90 Days' d,'90' r ,'6' seq from dual
                ) order by seq
                ```
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 80
            region: @additional-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            cssClasses: mnw180
        }
        source {
            type: databaseColumn
            databaseColumn: CREDIT_DAYS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )


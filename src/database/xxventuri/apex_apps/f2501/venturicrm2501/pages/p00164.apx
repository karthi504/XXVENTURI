page 164 (
    name: Additional Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            $('#weekly_box .days').click(function (){
                if ( $(this).hasClass("week_selected") ){
                    $('#P164_SCHEDULES_LIST').val($('#P164_SCHEDULES_LIST').val().replace($(this).attr('id')+',', ""));
                    $(this).removeClass('week_selected');
                }
                else{
                    //alert($('.week_selected').length);
                    //alert($v('P164_VISIT_REPET_DAYS'));
                    var select_w = $('.week_selected').length;
                    var freq_days = $v('P164_VISIT_REPET_DAYS');
                    if(select_w == freq_days){
                        var first_select = $('#P164_SCHEDULES_LIST').val().substr(0,3);
                        $('#'+first_select).removeClass('week_selected');
                        $('#P164_SCHEDULES_LIST').val($('#P164_SCHEDULES_LIST').val().replace(first_select+',', ""));
                    }
                    $('#P164_SCHEDULES_LIST').val($('#P164_SCHEDULES_LIST').val()+$(this).attr('id')+',');
                    $(this).addClass('week_selected');
                } 
            });
            
            $('#monthly_box .date').click(function (){
                if ( $(this).hasClass("date_selected") ){
                    $('#P164_SCHEDULES_LIST').val($('#P164_SCHEDULES_LIST').val().replace($(this).attr('id')+',', ""));
                    $(this).removeClass('date_selected');
                }
                else{
                    var select_w = $('.date_selected').length;
                    var freq_days = $v('P164_VISIT_REPET_DAYS');
                     if(select_w == freq_days){
                        var first_select = $('#P164_SCHEDULES_LIST').val().substr(0, $('#P164_SCHEDULES_LIST').val().indexOf(","));
                        $('#'+first_select).removeClass('date_selected');
                        $('#P164_SCHEDULES_LIST').val($('#P164_SCHEDULES_LIST').val().replace(first_select+',', ""));
                    }
                    $('#P164_SCHEDULES_LIST').val($('#P164_SCHEDULES_LIST').val()+$(this).attr('id')+',');
                   $(this).addClass('date_selected');
                } 
            });
            
            $('#date_button').click(function (){
                $('#mothly_schedue_value span').text($('#P164_SCHEDULES_LIST').val().slice(0,-1));
                $('#mothly_schedue_value').show();
                $('#monthly_box').hide();
            });
            ```
    }
    css {
        inline:
            ```css
            .calender-hot-button{
                    background-color: #0572CE !important;
                    color: #fff !important;
            }
            
            .days {
                float: left;
                margin: 6px;
                width: 26px;
                text-align: center;
                border: 1px solid;
                border-radius: 250px;
                cursor: pointer;
            }
            
            #weekly_box{
                margin-top: -6px;
                margin-left: 20px;
            }
            
            .week_selected{
                background: #0585e0;
                color: #fff;
                font-weight: bold;
            }
            
            .date {
                width: 26px;
                text-align: center;
                cursor: pointer;
                border: 1px outset;
            }
            
            #monthly_box{
                float: left;
                margin-left: 20px;
            }
            
            #monthly_box table{
                border:1px solid #c7c7c7;
            }
            
            .date:hover {
                border: 1px dotted;
            }
                
            .date_selected{
                background: #0585e0;
                color: #fff;
                font-weight: bold;
            }
            
            #mothly_schedue_value{
                margin: 0 0 0 10px;
            }
                
            #date_button{
                padding: 0 12px;
                background: #0572ce;
                border: 1px solid #0464b4;
                color: #fff;
                cursor: pointer;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region additional-details (

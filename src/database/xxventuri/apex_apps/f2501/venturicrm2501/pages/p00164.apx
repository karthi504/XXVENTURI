    process add-appointment (
        name: Add Appointment
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_appointment_id    number;
                    v_rep_id                   number;
                    
                begin
                
                select DEFAULT_REP_ID into v_rep_id from EBA_SALES_CUSTOMERS where ID = :P164_CUSTOMER_ID;
                
                begin
                select APPOINTMENT_ID into v_appointment_id from XXEBA_SALES_APPOINTMENT where CUSTOMER_DETAIL_ID = :P164_DETAILS_ID;
                exception 
                    when others then 
                        v_appointment_id := null;
                end;
                
                if v_appointment_id is null  then
                    insert into XXEBA_SALES_APPOINTMENT (CUSTOMER_ID, APPOINTMENT_TYPE, APPOINTMENT_DATE
                        , APPOINTMENT_PURPOSE, CONTACT_PERSON_ID 
                        , CONTACT_LOCATION_ID, COMMENTS, LEAD_ID, OPPORTUNITY_ID , APPOINTMENT_STATUS, SALESREPS_ID, CUSTOMER_DETAIL_ID)
                    values (:P164_CUSTOMER_ID, 'Direct Mail', null
                        , 'Meeting', :P136_CONTACT_PERSON_ID
                        , :P136_CONTACT_LOCATION_ID, 'Scheduled from Account''s Visit Frequency ', null, null , 'Scheduled', v_rep_id, :P164_DETAILS_ID)returning APPOINTMENT_ID into v_appointment_id;
                
                    insert into XXEBA_SALES_MEETING_SCHEDULE (APPOINTMENT_ID, SCHEDULE_TYPE, SCHEDULE_SEQUENCE)
                    values(v_appointment_id, :P164_NEXT_SCHEDULE, :P164_SCHEDULES_LIST);
                
                else
                  update XXEBA_SALES_MEETING_SCHEDULE set SCHEDULE_TYPE = :P164_NEXT_SCHEDULE, SCHEDULE_SEQUENCE = :P164_SCHEDULES_LIST
                    where APPOINTMENT_ID = v_appointment_id;
                end if;
                
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 67798127524401552
        }
    )


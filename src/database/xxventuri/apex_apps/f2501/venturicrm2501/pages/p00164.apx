                    var schedule =  $( "#P164_VISIT_FREQUENCY_REC option:selected" ).text().charAt(0)
                    //var schedule = $('#P164_NEXT_SCHEDULE').val();
                    $('#P164_SCHEDULES_LIST').val('');
                    

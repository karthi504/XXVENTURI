    process set-recomendation-details (
        name: Set  Recomendation Details 1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                select (EXPECTED_BUSINESS ||' '||EXPECTED_BUSINESS_CURRENCY)expected, 

                    else if(schedule == 'M'){
                        $('#weekly_box').hide();
                         $('#monthly_box').show();
                        $('#mothly_schedue_value').hide();
                    //  $('#P164_SCHEDULES_LIST').hide();
                    }
                    
                    */
                    
                     $('#weekly_box').hide();
                     $('#monthly_box').hide();
                    ```
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue

page 122 (
    name: Brands
    title: Brands
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "BRAND_ID", 
                "ENTITY_ID",
                "ENTITY_TYPE",
                "BRAND_NAME",
                "BRAND_CODE",
                "BRAND_PRICE",
                "UNIT_OF_MEASURE",
                "MINIMUM_ORDER_QTY",
                "LEAD_TIME",
                "BRAND_CURRENCY_TYPE",
                dbms_lob.getlength("BRAND_ATTACHMENT") "BRAND_ATTACHMENT",
                "BRAND_ATT_MIMETYPE",
                "BRAND_ATT_FILENAME",
                "BRAND_ATT_CHARSET",
                "BRAND_ATT_LAST_UPDATE",
                "CREATED_BY",
                "CREATED",
                "UPDATED_BY",
                "UPDATED"
                from "#OWNER#"."XXEBA_SALES_BRANDS" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 127
                items: {
                    P127_BRAND_ID: #BRAND_ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 125032758271958033
        }

        column BRAND_ATTACHMENT (
            type: downloadBlob
            heading {
                heading: Brand Attachment
            }
            layout {
                sequence: 11
            }
            blobAttributes {
                tableName: XXEBA_SALES_BRANDS
                blobColumn: BRAND_ATTACHMENT
                primaryKeyColumn1: BRAND_ID
            }
            source {
                dataType: NUMBER
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: K
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column BRAND_ATT_CHARSET (
            type: plainText
            heading {
                heading: Brand Att Charset
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column BRAND_ATT_FILENAME (
            type: plainText
            heading {
                heading: Brand Att Filename
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column BRAND_ATT_LAST_UPDATE (
            type: plainText
            heading {
                heading: Brand Att Last Update
            }
            layout {
                sequence: 15
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: O
            }
        )

        column BRAND_ATT_MIMETYPE (
            type: plainText
            heading {
                heading: Brand Att Mimetype
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column BRAND_CODE (
            type: plainText
            heading {
                heading: Brand Code
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column BRAND_CURRENCY_TYPE (
            type: plainText
            heading {
                heading: Brand Currency Type
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column BRAND_ID (
            type: plainText
            heading {
                heading: Brand Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column BRAND_NAME (
            type: plainText
            heading {
                heading: Brand Name
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column BRAND_PRICE (

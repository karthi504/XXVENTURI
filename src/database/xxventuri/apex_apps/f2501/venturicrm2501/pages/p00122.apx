            layout {
                sequence: 6
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column CREATED (
            type: plainText
            heading {
                heading: Created
            }
            layout {
                sequence: 17
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: Q
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 16
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column ENTITY_ID (
            type: plainText
            heading {
                heading: Entity Id
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ENTITY_TYPE (
            type: plainText
            heading {
                heading: Entity Type
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LEAD_TIME (
            type: plainText
            heading {
                heading: Lead Time
            }
            layout {
                sequence: 9
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column MINIMUM_ORDER_QTY (
            type: plainText
            heading {
                heading: Minimum Order Qty
            }
            layout {
                sequence: 8
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column UNIT_OF_MEASURE (
            type: plainText
            heading {
                heading: Unit Of Measure
            }
            layout {
                sequence: 7
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED (
            type: plainText
            heading {
                heading: Updated
            }
            layout {
                sequence: 19
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: S
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 18
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 1250428 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BRAND_ATTACHMENT (
                sequence: 11
            )

            displayColumn BRAND_ATT_CHARSET (
                sequence: 14
            )

            displayColumn BRAND_ATT_FILENAME (
                sequence: 13
            )

            displayColumn BRAND_ATT_LAST_UPDATE (
                sequence: 15
            )

            displayColumn BRAND_ATT_MIMETYPE (
                sequence: 12
            )

            displayColumn BRAND_CODE (
                sequence: 5
            )

            displayColumn BRAND_CURRENCY_TYPE (
                sequence: 10
            )

            displayColumn BRAND_ID (
                sequence: 1
            )

            displayColumn BRAND_NAME (
                sequence: 4
            )

            displayColumn BRAND_PRICE (
                sequence: 6
            )

            displayColumn CREATED (
                sequence: 17
            )

            displayColumn CREATED_BY (
                sequence: 16
            )

            displayColumn ENTITY_ID (
                sequence: 2
            )

            displayColumn ENTITY_TYPE (
                sequence: 3
            )

            displayColumn LEAD_TIME (
                sequence: 9
            )

            displayColumn MINIMUM_ORDER_QTY (
                sequence: 8
            )

            displayColumn UNIT_OF_MEASURE (
                sequence: 7
            )

            displayColumn UPDATED (
                sequence: 19
            )

            displayColumn UPDATED_BY (
                sequence: 18
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 127
                clearCache: 127
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


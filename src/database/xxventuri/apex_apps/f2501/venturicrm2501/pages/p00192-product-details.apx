            }
        )

        column PRODUCT_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Product Id
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column PRODUCT_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {

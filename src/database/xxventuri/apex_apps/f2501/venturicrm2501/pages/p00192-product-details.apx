    button add (
        buttonName: ADD
        label: Add
        layout {
            sequence: 90
            region: @products-2
            slot: EDIT
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--simple
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 108
                items: {
                    P108_SOURCE_PAGE: 103
                    P108_ACCOUNT_ID: &P192_CUSTOMER_ID.
                    P108_DEAL_ID: &P192_OPP_ID.
                    P108_ORDER_ID: &P192_ORDER_ID.
                }
                clearCache: 108
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P192_REPEAT_ORDER_FLAG
            value: R
        }
    )

    dynamicAction price (
        name: Price
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P192_PRODUCT_NAME
        }

        action price (
            name: PRICE
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT PRODUCT_price FROM EBA_SALES_PRODUCTS WHERE PRODUCT_NAME =:P192_PRODUCT_NAME
                itemsToSubmit: P192_PRODUCT_NAME
            }
            affectedElements {
                selectionType: items
                items: P192_NEW
            }
            execution {
                sequence: 10
            }
        )

    )

)


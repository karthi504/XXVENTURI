            heading {
                heading: Rn
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    region products-2 (
        name: Products
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    customer_name,
                    product_id,
                    product_name,
                    product_price,
                    quantity,
                    Total_Price
                FROM (
                    SELECT
                        sc.customer_name,
                        product_id,
                        op.product_name,
                        op.product_price,
                        op.quantity,
                        op.quantity * op.product_price AS Total_Price,
                        ROW_NUMBER() OVER (PARTITION BY sc.customer_name ORDER BY op.quantity * op.product_price DESC) AS rn
                    FROM
                        xxeba_sales_order so
                        JOIN xxeba_order_products op ON so.order_id = op.order_id
                        JOIN eba_sales_customers sc ON so.customer_id = sc.id
                    WHERE
                        so.status != 'X'
                        AND so.order_date BETWEEN TRUNC(SYSDATE, 'month') AND LAST_DAY(SYSDATE)
                        AND sc.customer_name = :P192_CUSTOMER_NAME
                )
                WHERE rn <= 10
                ORDER BY Total_Price DESC;
                
                ```
            pageItemsToSubmit: P192_CUSTOMER_NAME
        }
        layout {
            sequence: 1230
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
        advanced {
            htmlDomId: order_product
        }
        comments {
            comments:
                ```
                SELECT 
                    ROWNUM row_num,
                    APEX_ITEM.HIDDEN(1,seq_id,NULL,'pr01_'||seq_id) seq_id,
                    APEX_ITEM.HIDDEN(2,n001,NULL,'pr02_'||seq_id) ORDER_PRODUCTS_ID,

    region products (
        name: Products
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM (
                    SELECT
                        customer_name,
                        order_value,
                        product_id,
                        product_name,
                        ROW_NUMBER() OVER (ORDER BY order_value DESC) AS rn
                    FROM (
                        SELECT
                            sc.customer_name,
                            SUM(quantity * product_price) AS order_value,
                            op.product_id,
                            op.product_name
                        FROM
                            xxeba_sales_order so,
                            xxeba_order_products op,
                            eba_sales_customers sc
                        WHERE
                            so.order_id = op.order_id
                            AND so.customer_id = sc.id
                            AND so.status != 'X'
                            AND (order_date BETWEEN TRUNC(SYSDATE, 'month') AND LAST_DAY(SYSDATE))
                            AND (
                                (so.sales_rep = NVL(:p100_top_5_sales_orders, :user_id)
                                 AND NOT EXISTS (
                                    SELECT 'Y'
                                    FROM
                                        eba_sales_salesreps sr,
                                        eba_sales_salesrep_roles r
                                    WHERE
                                        sr.rep_role = r.id
                                        AND UPPER(r.role_name) IN ('ADMINISTRATOR', 'TEAM LEADER - SALES')
                                        AND UPPER(sr.user_name) = :app_user
                                ))
                                OR (
                                    (so.sales_rep = NVL(:p100_top_5_sales_orders, :user_id) OR :p100_top_5_sales_orders IS NULL)
                                    AND so.created_by IN (
                                        SELECT UPPER(user_name)
                                        FROM eba_sales_salesreps r
                                        START WITH r.id = :user_id
                                        CONNECT BY PRIOR r.id = r.rep_manager_id
                                    )
                                    AND EXISTS (
                                        SELECT 'Y'
                                        FROM
                                            eba_sales_salesreps sr,
                                            eba_sales_salesrep_roles r
                                        WHERE
                                            sr.rep_role = r.id
                                            AND UPPER(r.role_name) = 'TEAM LEADER - SALES'
                                            AND UPPER(sr.user_name) = :app_user
                                    )
                                )
                                OR (
                                    (so.sales_rep = NVL(:p100_top_5_sales_orders, :user_id) OR :p100_top_5_sales_orders IS NULL)
                                    AND EXISTS (
                                        SELECT 'Y'
                                        FROM
                                            eba_sales_salesreps sr,
                                            eba_sales_salesrep_roles r
                                        WHERE
                                            sr.rep_role = r.id
                                            AND UPPER(r.role_name) = 'ADMINISTRATOR'
                                            AND UPPER(sr.user_name) = :app_user
                                    )
                                )
                            )
                        GROUP BY
                            sc.customer_name,
                            op.product_id,
                            op.product_name
                    )
                )
                WHERE rn <= 10
                ORDER BY order_value DESC;
                
                ```
        }
        layout {
            sequence: 1250
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }


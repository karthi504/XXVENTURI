page 1005 (
    name: Test Page
    title: Test Page
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                SO.ORDER_ID, 
                SO.ORDER_NUMBER,
                SO.DEAL_ID,
                SD.DEAL_NAME,
                SO.CUSTOMER_ID,
                SC.CUSTOMER_NAME,
                SO.TERRITORY_ID,
                SO.SALES_REP,
                SR.REP_FIRST_NAME||' '||SR.REP_LAST_NAME REP_NAME,
                SO.ORDER_DATE,
                SO.PO_NUMBER,
                SO.PO_DATE,
                SO.REFERENCE,
                (select CUSTOMER_LOCATION_NAME from  EBA_SALES_CUSTOMER_LOCATIONS  where ID=SO.BILLING_LOCATION) CUSTOMER_BILLING_LOCATION,
                SO.BILLING_LOCATION,
                CL.CUSTOMER_LOCATION_NAME BILLING,
                SO.DELIVERY_LOCATION,
                CL2.CUSTOMER_LOCATION_NAME DELIVERY,
                SO.ORDER_FREQUENCY,
                SO.NEXT_ORDER_DATE,
                SO.STATUS,
                --SO.CREATED
                 to_char(SO.CREATED at time zone 'Asia/Calcutta', 'DD-Mon-YYYY HH:MI PM') as CREATED,
                 order_value,
                DELIVERY_DATE,
                (
                  CASE
                    WHEN EXPORT_FLAG IN ('Y', 'P')
                    THEN 'Imported'
                    ELSE 'New'
                  END ) new_imported_flag   /* Thamaraiselvan Added on 18-Oct-18 */
                from XXEBA_SALES_ORDER SO,
                	EBA_SALES_DEALS SD,
                	EBA_SALES_CUSTOMERS SC,
                	EBA_SALES_SALESREPS SR,
                	EBA_SALES_CUSTOMER_LOCATIONS CL,
                	EBA_SALES_CUSTOMER_LOCATIONS CL2,
                    (select
                    ORDER_ID,
                    sum(order_value) order_value,
                    min(DELIVERY_DATE) DELIVERY_DATE  from
                    (
                    select
                    ORDER_ID,
                    QUANTITY,
                    PRODUCT_PRICE,
                    (QUANTITY * PRODUCT_PRICE)order_value,
                    DELIVERY_DATE
                    from
                    XXEBA_ORDER_PRODUCTS
                    )
                    group by ORDER_ID)value
                    
                where SO.DEAL_ID = SD.ID  
                 -- and SO.CUSTOMER_ID = SC.ID(+)
                     and SO.CUSTOMER_ID = SC.ID
                 -- and SO.SALES_REP = SR.ID(+)
                  and SO.SALES_REP = SR.ID
                  and SO.DELIVERY_LOCATION = CL.ID(+)
                  and SO.BILLING_LOCATION = CL2.ID (+)
                  and SO.ORDER_ID = value.ORDER_ID(+)
                  --and  SO.ORDER_ID in (258025938247708660953807395260991478068,257600572274182157933873410108072901762)
                 
                 and  :USER_ID in(
                (SELECT CASE WHEN(SELECT ROUND(((SELECT sum(PRODUCT_PRICE) FROM XXEBA_ORDER_PRODUCTS WHERE ORDER_ID =SO.ORDER_ID)/(SELECT  sum(PRODUCT_PRICE) FROM EBA_SALES_PRODUCTS WHERE ID IN(SELECT  PRODUCT_ID FROM XXEBA_ORDER_PRODUCTS WHERE ORDER_ID =SO.ORDER_ID)) * 100),2) FROM DUAL) >= 10 THEN
                (SELECT  REP_MANAGER_ID FROM EBA_SALES_SALESREPS WHERE ID in(SELECT  SALES_REP FROM XXEBA_SALES_ORDER WHERE ORDER_ID =SO.ORDER_ID))
                ELSE
                (SELECT  ID FROM EBA_SALES_SALESREPS WHERE ID =258025938247708660953807395260991478068)
                END FROM DUAL))
                  
                 and SO.STATUS IN ('N')
                order by  SO.ORDER_ID;
                  
                
                ```
        }
        layout {
            sequence: 1220
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }

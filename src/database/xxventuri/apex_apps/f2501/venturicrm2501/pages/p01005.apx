    dynamicAction show-hide-others (
        name: Show/hide/Others
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P1005_MAIL_SUBJECT
        }
        clientSideCondition {
            type: item=value
            item: P1005_MAIL_SUBJECT
            value: Others
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P1005_OTHERS
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P1005_OTHERS
            }
            execution {
                sequence: 10
            }
        )

    )


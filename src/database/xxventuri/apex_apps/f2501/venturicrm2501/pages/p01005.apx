    pageItem P1005_MAIL_SUBJECT (
        type: selectList
        label {
            label: Mail Subject
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Quotation for Special Tools;Quotation for Special Tools,Quotation for Lubricants;Quotation for Lubricants,Others;Others
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }

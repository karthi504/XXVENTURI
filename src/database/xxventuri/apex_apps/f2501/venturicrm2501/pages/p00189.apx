        page {
            width: 8.5
            height: 11
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 4438828 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BOUNCES (
                sequence: 7
            )

            displayColumn CAMPIGN_TITLE (
                sequence: 2
            )

            displayColumn CLICKS_TOTAL (
                sequence: 6
            )

            displayColumn EMAILS_SENT (
                sequence: 4
            )

            displayColumn OPENS_TOTAL (
                sequence: 5

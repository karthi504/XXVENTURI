page 189 (
    name: Mailchimp Campaign Report
    title: Mailchimp Campaign Report
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region mailchimp-campaign-report (
        name: Mailchimp Campaign Report
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1240
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 SELECT SEQ_ID ,
                         C001 as opens_total,
                         C002 as clicks_total,
                         c003 as hard_bounces,
                         c004 as soft_bounces,
                         c005 as unsubscribed,
                         c006 as emails_sent,
                		 c007 as campign_title,
                		 c008 as subject,
                         c003+c004 as bounces
                      FROM   apex_collections
                      WHERE  collection_name = 'MAILCHIMP_REPORT';
                ```
        }
        layout {
            sequence: 1230
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 443797634099727618
        }

        column BOUNCES (
            type: plainText
            heading {
                heading: Bounced
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
            enableUsersTo {
                sort: false
            }
        )

        column CAMPIGN_TITLE (
            type: plainText
            heading {
                heading: Campign Title
            }
            layout {

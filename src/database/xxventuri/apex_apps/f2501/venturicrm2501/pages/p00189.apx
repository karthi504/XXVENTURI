            displayColumn SEQ_ID (
                sequence: 1
            )

            displayColumn SUBJECT (
                sequence: 3
            )

            displayColumn UNSUBSCRIBED (
                sequence: 8
            )

        )

    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 10
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_response CLOB;
                        ll_res     CLOB;
                        a          NUMBER;
                        total_item NUMBER;
                        l_process  VARCHAR2(500);
                        l_values   apex_json.t_values;
                    BEGIN
                        apex_web_service.G_request_headers(1).name := 'Content-Type';
                    
                        apex_web_service.G_request_headers(1).value := 'application/json';
                    
                        apex_web_service.G_request_headers(2).name := 'Authorization';
                    
                        apex_web_service.G_request_headers(2).value :=
                        'Bearer 96977c29dc23ab7af30100c3b63d6153-us2';
                    
                        l_response := apex_web_service.Make_rest_request(p_url =>
                                                    'https://us2.api.mailchimp.com/3.0/campaigns',
                                                    p_http_method => 'GET');
                    
                        apex_json.Parse(l_response);
                    
                        total_item := apex_json.Get_number('total_items');
                    
                        apex_collection.Create_or_truncate_collection(
                        p_collection_name => 'MAILCHIMP_REPORT');
                    
                        FOR a IN 1 .. total_item LOOP
                            l_process := 'https://us2.api.mailchimp.com/3.0/reports/'
                                         ||apex_json.Get_varchar2('campaigns['
                                                                  ||a
                                                                  ||'].id');
                    
                            ll_res := apex_web_service.Make_rest_request(p_url => l_process,
                                      p_http_method => 'GET');
                    
                            apex_json.Parse(p_values => l_values, p_source => ll_res);
                    
                            apex_collection.Add_member(p_collection_name => 'MAILCHIMP_REPORT',
                            p_c001 => apex_json.Get_varchar2(p_values => l_values,
                                      p_path => 'opens.opens_total'
                                      ), p_c002 => apex_json.Get_varchar2(p_values => l_values,
                                                   p_path => 'clicks.clicks_total'
                            ), p_c003 => apex_json.Get_varchar2(p_values => l_values,
                                         p_path => 'bounces.hard_bounces'), p_c004 =>
                            apex_json.Get_varchar2(p_values => l_values,
                            p_path => 'bounces.soft_bounces'
                            ), p_c005 =>
                            apex_json.Get_varchar2(
                            p_values => l_values, p_path => 'unsubscribed'), p_c006 =>
                            apex_json.Get_varchar2(p_values => l_values, p_path => 'emails_sent'),
                            p_c007 => apex_json.Get_varchar2(p_values => l_values,
                                      p_path => 'campaign_title'
                            ), p_c008 => apex_json.Get_varchar2(p_values => l_values,
                                         p_path => 'subject_line'));
                        END LOOP;
                    END; 
                    ```
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction refresh-the-region (
        name: Refresh the Region
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.submit('REFRESH');
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)


page 34 (
    name: Product Family
    title: Product Family
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
             $("#P34_MARGIN_LIMIT").keypress(function(event){ 
                event = (event) ? event : window.event;
                var charCode = (event.which) ? event.which : event.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                   return false;
                }
                return true;
            });
            
            
            ```
    }
    security {
        authorizationScheme: @xxeba-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region product-group-details (
        name: Product Group Details
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P34_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 40
            region: @product-group-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRIPTION
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_GROUP_CODE (
        type: textField
        label {
            label: Group Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @product-group-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 70
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: GROUP_CODE
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_HSN_NUMBER (
        type: textField
        label {
            label: HSN Number
            alignment: left
        }
        settings {
            subtype: phone
        }
        layout {
            sequence: 100
            region: @product-group-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_SKU
            used: always
        }
    )

    pageItem P34_ID (
        type: hidden
        layout {
            sequence: 10
            region: @product-group-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P34_MANAGER (
        type: popupLov
        label {
            label: "Manager "
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct (rep_first_name || ' ' || rep_last_name) as D, id r
                from eba_sales_salesreps 
                WHERE STATUS='Y'
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @product-group-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: MANAGER_ID
            used: always
        }
    )

    pageItem P34_MARGIN_LIMIT (
        type: textField
        label {
            label: Margin Limit
            alignment: left
        }
        settings {
            subtype: phone
        }
        layout {
            sequence: 90
            region: @product-group-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        advanced {
            postText: %
        }
        source {
            type: databaseColumn
            databaseColumn: MANAGER_LIMIT
            used: always
        }
    )

    pageItem P34_MARGIN_PERCENTAGE (
        type: textField
        label {
            label: Margin
            alignment: left
        }
        layout {
            sequence: 50
            region: @product-group-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            valueRequired: true
        }
        advanced {
            postText: %
        }
        source {
            type: databaseColumn
            databaseColumn: MARGIN_PERCENTAGE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_PRODUCT_FAMILY (
        type: textarea
        label {
            label: Product Group
            alignment: left
        }
        layout {
            sequence: 30
            region: @product-group-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: PRODUCT_FAMILY
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_SALES_TEAM (
        type: popupLov
        label {
            label: Sales Team
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct (rep_first_name || ' ' || rep_last_name) as D, id r
                from eba_sales_salesreps 
                WHERE STATUS='Y'
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 80
            region: @product-group-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 500
        }
        source {
            type: databaseColumn
            databaseColumn: SALES_TEAM
            used: always
        }
    )

    pageItem P34_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @xx-status-lov
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @product-group-details
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        advanced {
            customAttributes: style="width:100px;"
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P34_ID
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P34_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P34_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation margin-limit (
        name: Margin limit
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  IF :P34_MARGIN_LIMIT >= :P34_MARGIN_PERCENTAGE THEN
                    RETURN FALSE;
                  ELSE
                    RETURN TRUE;
                  END IF;
                  exception when others then return null;
                END;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Manager limit should be less than margin limit!
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation margin-limit-2 (
        name: Margin limit_1
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  IF :P34_MARGIN_LIMIT >= :P34_MARGIN_PERCENTAGE THEN
                    RETURN FALSE;
                  ELSE
                    RETURN TRUE;
                  END IF;
                  exception when others then return null;
                END;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Manager limit should be less than margin limit!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1173745977487309528
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-eba-sales-product-families (
        name: Fetch Row from EBA_SALES_PRODUCT_FAMILIES
        type: autoRowFetch
        source {
            tableName: EBA_SALES_PRODUCT_FAMILIES
            pkColumn: ID
            pkItem: P34_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1173744772350309527
        }
    )

    process process-row-of-eba-sales-product-families (
        name: Process Row of EBA_SALES_PRODUCT_FAMILIES
        type: autoRowProcessing
        target {
            tableName: EBA_SALES_PRODUCT_FAMILIES
            pkColumn: ID
            pkItem: P34_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 1173745214556309528
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1173745618805309528
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)


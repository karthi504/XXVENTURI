    pageItem P94_PHOTO (
        type: displayImage
        label {
            alignment: left
        }
        settings {
            basedOn: blobColSql
            sqlQuery:
                ```sql
                select FILE_BLOB from (select f.FILE_BLOB from EBA_SALES_FILES f,EBA_SALES_CUSTOMER_CONTACTS cc,EBA_SALES_CUSTOMERS c
                where cc.CUSTOMER_ID=c.id and cc.ID =f.CONTACT_ID and KEY_CONTACT='Y'and c.id=:P94_ID
                order by f.CREATED desc) where  rownum = 1
                
                /*select FILE_BLOB from (select f.FILE_BLOB from EBA_SALES_FILES f,EBA_SALES_CUSTOMER_CONTACTS cc,EBA_SALES_CUSTOMERS c
                where cc.CUSTOMER_ID=c.id and f.ACCOUNT_ID=CC.CUSTOMER_ID and KEY_CONTACT='Y'and c.id=140306149349797948707380504941910019519 
                order by f.CREATED desc) where  rownum = 1*/
                ```
        }
        layout {
            sequence: 20
            region: @contact-images
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        advanced {
            customAttributes: "style=\"height: 210px; width: 200px; border: 3px solid #16C4E6; border-radius: 7px; margin-right: 3px;\" "
        }
    )


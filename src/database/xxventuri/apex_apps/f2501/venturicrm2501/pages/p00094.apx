page 94 (
    name: Account
    title: Account
    pageGroup: @accounts
    appearance {
        pageTemplate: @marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-Footer{
            	display:none;
            
            
            }
            
            .t-Form-itemWrapper{
                float: right;
            }
            
            .t-Body-actions {
                width: 215px;
            }
            
            
            
            
            
            
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Manage an account's contact information, competitors, locations, links, attachments, and/or comments. You can also validate the account.
    }

    region account (
        name: Account
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.id,
                  c.row_key,C.CUSTOMER_CODE,
                    case customer_is_key_account_yn
                      when 'Y' then 'Yes'
                      when 'N' then 'No'
                    end key_account,
                 -- c.customer_stock_symb,
                --  c.customer_duns,
                --  c.customer_sic,
                  c.customer_web_site,
                  c.LAST_UPDATED_LATITUDE LATITUDE, 
                  c.LAST_UPDATED_LONGITUDE LONGITUDE,
                  --c.customer_facebook,
                  c.customer_linkedin,
                 -- c.customer_twitter,
                  c.customer_description,c.Account_source ,c.GST_NO, C.Classification_ID,
                  c.tags,
                  c.created,
                  lower(c.created_by) created_by,
                  c.updated,
                  lower(c.updated_by) updated_by,
                  t.id territory_id,
                  t.territory_name,
                  case
                    when c.default_rep_id is not null
                    then (
                      select rep_first_name || ' ' || rep_last_name
                      from eba_sales_salesreps sr
                      where sr.id = c.default_rep_id and sr.status='Y'
                    )
                  end default_rep
                from eba_sales_customers c
                left join eba_sales_territories t
                  on t.id = c.customer_territory_id
                where c.id = :P94_ID
                ```
        }
        layout {
            sequence: 20
            slot: masterDetail
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

        column ACCOUNT_SOURCE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Account source
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @xx-account-source
            }
            layout {
                sequence: 5
            }
        )

        column CLASSIFICATION_ID (
            reportColumnQueryId: 12
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: "Classification "
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @xx-classification-lov
            }
            layout {
                sequence: 9
            }
        )

        column CREATED (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Created
            }
            layout {
                sequence: 17
            }
            appearance {
                formatMask: SINCE
            }
            columnFormatting {
                htmlExpression: #CREATED# by #CREATED_BY#

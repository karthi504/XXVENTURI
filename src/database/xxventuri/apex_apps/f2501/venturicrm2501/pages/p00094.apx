    region recommended-details (
        name: "Recommended Details "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "DETAILS_ID",
                "CUSTOMER_ID",null edit ,
                "EXPECTED_BUSINESS",
                "EXPECTED_BUSINESS_CURRENCY",
                "CREDIT_TERMS_REC",
                "CREDIT_LIMIT_REC",
                "CREDIT_LIMIT_CURRENCY",
                "GRACE_DAYS_REC",
                "VISIT_FREQUENCY_REC",
                "ASSIGNED_TO",
                "COMMENTS",
                "RECOMMENDED_BY",
                "CREATED_BY"
                from "XXEBA_SALES_CUSTOMER_DETAILS"
                where CUSTOMER_ID = :P94_ID
                ```
        }
        layout {
            sequence: 20
            parentRegion: @additional-details
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }


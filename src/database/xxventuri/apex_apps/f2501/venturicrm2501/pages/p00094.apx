    button view-location (
        buttonName: VIEW_LOCATION
        label: View Location
        layout {
            sequence: 20
            region: @breadcrumb-display
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 186
                items: {
                    P186_ID: &P94_ID.
                }
                clearCache: 186
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   lv_latitude varchar2(100);
                   
                begin
                
                  select LAST_UPDATED_LATITUDE into lv_latitude from EBA_SALES_CUSTOMERS where ID = :P94_ID;
                  if lv_latitude is not null then
                      return true;
                  else
                      return false;
                  end if;
                
                  exception when others then return false;
                
                end;
                ```
        }
    )


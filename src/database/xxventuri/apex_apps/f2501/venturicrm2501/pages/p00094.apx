    button edit-account (
        buttonName: EDIT_ACCOUNT
        label: Edit Account
        layout {
            sequence: 30
            region: @breadcrumb-display
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--padRight

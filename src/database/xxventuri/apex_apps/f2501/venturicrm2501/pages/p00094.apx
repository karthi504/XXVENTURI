                SELECT null edit, 
                      appointment_id, 
                      customer_id,
                      appointment_type,
                      appointment_date,
                     contact_address,
                      appointment_purpose,
                      contact_person_id,
                      contact_location_id
                      comments 
                FROM xxeba_sales_appointment where  customer_id = :P94_ID
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {

                items: {
                    P3_ID: &P94_ID.
                }
                clearCache: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P94_STATUS <> 'A' or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE
                            and SR.ROLE_NAME in ('Administrator'))
                ```
        }
    )


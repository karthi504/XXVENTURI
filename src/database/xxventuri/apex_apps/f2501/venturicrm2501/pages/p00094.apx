    region usage-metrics-90-days (
        name: Usage Metrics - 90 days
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select count(*) c,
                  'Views' l,
                  1 disp
                from eba_sales_clicks
                where cust_id = :P94_ID 
                  and view_timestamp > sysdate - 90
                union all
                select count(distinct(app_username)) c,
                    'Users' l,
                    2 disp
                from eba_sales_clicks
                where cust_id = :P94_ID 
                  and view_timestamp > sysdate - 90
                order by disp
                ```
        }
        layout {
            sequence: 100
            slot: rightSideColumn
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @usage-metrics
        }
        settings {
            badgeStyle: circular
            value: C
            bottomLabel: L
            linkTarget: {
                page: 138
                items: {
                    P138_ENTITY_TYPE: ACCOUNT
                    P138_ENTITY_ID: &P94_ID.
                }
                clearCache: 138
            }
            layout: 2Columns
        }
    )

    region validations (
        name: Validations
        type: plugin/contentValidator
        source {
            sqlQuery:
                ```sql
                select v.verified_by,
                  v.created
                from eba_sales_verifications v
                where cust_id = :P94_ID
                order by v.created desc
                ```
        }
        layout {
            sequence: 40
            slot: rightSideColumn
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--hiddenOverflow
            ]
            cssClasses: js-validateRegion
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 'Y' from EBA_SALES_CUSTOMERS where ID=:P94_ID and STATUS='V'
        }
        security {
            authorizationScheme: @xxeba-admin
        }
        config {
            buildOption: @validations
        }
        settings {
            validationLink: {
                page: 146
                items: {
                    P146_ENTITY_TYPE: ACCOUNT
                    P146_ENTITY_ID: &P94_ID.
                }
                clearCache: 146
            }
            previousValidationsLink: {
                page: 147
                items: {
                    P147_ENTITY_TYPE: ACCOUNT
                    P147_ENTITY_ID: &P94_ID.
                }
                clearCache: 147
                action: resetPagination
            }
        }
    )


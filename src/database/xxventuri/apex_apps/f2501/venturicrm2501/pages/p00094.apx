    region breadcrumb-display (
        name: &BREADCRUMB_DISPLAY.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region competition (
        name: Competition
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select NULL EDIT,id,
                   (select COMPETITOR_NAME from EBA_SALES_COMPETITORS x where x.id = c.COMPETITOR_ID) competitor, 
                   (select COMPETITOR_THREAT  from EBA_SALES_COMPETITOR_THREATS x where x.id = c.COMPETITOR_THREAT_ID) threat, 
                   COMPETITION_DESC,
                   created,
                   lower(created_by) created_by
                from EBA_SALES_ACT_COMPETITION c
                where    CUSTOMER_ID = :P94_ID
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                t-Region--noPadding
                #DEFAULT#
                t-Region--scrollBody
                t-Form--labelsAbove
            ]
            cssClasses: js-dynamicHideShowRegion
        }
        advanced {
            regionDisplaySelector: true
        }
        config {
            buildOption: @competitors
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                t-Report--stretch
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No competitors identified, click "+" icon to add a competitor
        }
        componentAdvanced {
            stripHtml: true
        }

        column COMPETITION_DESC (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Description
            }
            layout {
                sequence: 4
            }
        )

        column COMPETITOR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Competitor
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1

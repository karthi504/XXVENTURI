    region bank-details (
        name: "Bank Details "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "ID", Null Edit,
                "CUSTOMER_ID",
                "BANK_NAME",
                "BRANCH_LOCATION",
                "ACCOUNT_NUMBER",
                "ACCOUNT_TYPE",
                "IFSC_CODE",
                "STATUS",
                "CREATED_BY",
                "CREATION_DATE",
                "UPDATED_BY",
                "UPDATE_DATE"
                from "#OWNER#"."XXEBA_SALES_CUST_BANKS" 
                  where CUSTOMER_ID = :P94_ID
                

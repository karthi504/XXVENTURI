    dynamicAction account-region-refresh (
        name: Account Region Refresh
        execution {
            sequence: 100
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @account
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


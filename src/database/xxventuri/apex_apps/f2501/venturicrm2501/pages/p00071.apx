page 71 (
    name: Create Opportunity
    title: Create Opportunity
    pageGroup: @opportunities
    appearance {
        pageMode: modalDialog
        dialogTemplate: @wizard-modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
            
            a.simpleButton{display:inline-block;padding:0 8px;font:normal 11px/20px Arial,sans-serif;color:#666;background-color:#F0F0F0;border:1px solid #CCC;text-align:center;-moz-border-radius:4px;-webkit-border-radius:4px;border-radius:8px; text-decoration: none !important}
            a.simpleButton:hover {background-color: #FFF}
            </style>
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: wizardButtons
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region create-opportunity-train (
        name: create opportunity train
        type: list
        source {
            list: @create-opportunity-train
        }
        layout {
            sequence: 10
            slot: wizardProgressBar
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            listTemplate: @wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region new-account (
        name: New Account
        type: staticContent
        layout {
            sequence: 20
            slot: wizardBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region opportunity-information (
        name: Opportunity Information
        type: staticContent
        layout {
            sequence: 10
            slot: wizardBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region other-opportunity-attributes (
        name: Other Opportunity Attributes
        type: staticContent
        layout {
            sequence: 1210
            slot: wizardBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P71_ACCOUNT (
        type: plugin/select2
        label {
            label: Account
            alignment: left
        }
        settings {
            width: 80%
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select sc.CUSTOMER_NAME display_value, sc.ID return_value  
                from eba_sales_CUSTOMERS  sc 
                where sc.status='A' and
                  (upper(sc.DEFAULT_REP_ID) in (SELECT  upper(r.ID)                                
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS (select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR 
                                 where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    )                                
                
                order by 1
                
                
                
                ```
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @opportunity-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                select sc.CUSTOMER_NAME display_value, sc.ID return_value  
                from 
                --eba_sales_leads l, 
                eba_sales_CUSTOMERS  sc 
                where sc.status='Y' and
                --sc.id=l.account_id
                --AND 
                    sc.ID in (select CUST_ID from EBA_SALES_VERIFICATIONS)
                  AND
                  (upper(sc.DEFAULT_REP_ID) in (SELECT  upper(r.ID)                                
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS (select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR 
                                 where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    )                                
                
                order by 1
                
                ```
        }
    )


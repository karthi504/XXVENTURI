    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button next (
        buttonName: NEXT
        label: Create Opportunity
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-clicked (
        name: Cancel clicked
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction hide-use (
        name: hide_use
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P71_NEW_OR_EXISTING
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction show-hide-existing-account-item (
        name: show hide existing account item
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P71_NEW_OR_EXISTING
        }
        clientSideCondition {
            type: item=value
            item: P71_NEW_OR_EXISTING
            value: EXISTING
        }

        action native-hide (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P71_ACCOUNT
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P71_ACCOUNT
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            settings {
                showAllOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P71_ACCOUNT
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction show-hide-new-account-region (
        name: show hide new account region
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P71_NEW_OR_EXISTING
        }
        clientSideCondition {
            type: item=value
            item: P71_NEW_OR_EXISTING
            value: NEW
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @new-account
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P71_CUSTOMER_NAME
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @new-account
            }
            execution {
                sequence: 10
            }
        )

    )

    validation p71-account-not-null-when-existing (
        name: P71_ACCOUNT not null when existing
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P71_ACCOUNT
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P71_ACCOUNT
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: item=value
            item: P71_NEW_OR_EXISTING
            value: EXISTING
        }
    )

    validation p71-customer-name-not-duplicated (
        name: P71_CUSTOMER_NAME not duplicated
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select null
                from eba_sales_customers
                where upper(customer_name) = upper(:P71_CUSTOMER_NAME)
                ```
        }
        error {
            errorMessage: An account with that name already exists.
            associatedItem: @P71_CUSTOMER_NAME
        }
        serverSideCondition {
            type: item=value
            item: P71_NEW_OR_EXISTING
            value: NEW
        }
    )

    validation p71-customer-name-not-null-when-new (
        name: P71_CUSTOMER_NAME not null when new
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P71_CUSTOMER_NAME
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P71_CUSTOMER_NAME
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: item=value
            item: P71_NEW_OR_EXISTING
            value: NEW
        }
    )


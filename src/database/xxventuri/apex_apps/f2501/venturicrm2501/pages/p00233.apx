page 233 (
    name: Account Details
    title: Account Details
    pageGroup: @accounts
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            $(document).ready(function() {
                $("#P233_GSTNO").keypress(function(event) { 
                    var charCode = event.which || event.keyCode;
                    var currentVal = $(this).val();
                    var currentLength = currentVal.length;
            
                    // Check if the current length is less than 15
                    if (currentLength >= 15) {
                        event.preventDefault();
                        return;
                    }
            
                    // Validate each position based on the specified format
                    if (currentLength < 2) {
                        // First 2 characters must be numbers
                        if (!(charCode >= 48 && charCode <= 57)) {
                            event.preventDefault();
                        }
                    } else if (currentLength < 7) {
                        // Next 5 characters must be alphabets
                        if (!((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
                        }
                    } else if (currentLength < 11) {
                        // Next 4 characters must be numbers
                        if (!(charCode >= 48 && charCode <= 57)) {
                            event.preventDefault();
                        }
                    } else if (currentLength == 11) {
                        // Next character must be an alphabet
                        if (!((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
                        }
                    } else if (currentLength == 12) {
                        // Next character must be a number
                        if (!(charCode >= 48 && charCode <= 57)) {
                            event.preventDefault();
                        }
                    } else if (currentLength == 13) {
                        // Next character must be an alphabet
                        if (!((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
                        }
                    } else if (currentLength == 14) {
                        // Next character can be alphanumeric
                        if (!((charCode >= 48 && charCode <= 57) || 
                              (charCode >= 65 && charCode <= 90) || 
                              (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
                        }
                    }
                });
            
                // Prevent pasting if you also want to restrict pasting more than 15 characters or non-alphanumeric characters
                $("#P233_GSTNO").on('paste', function(event) {
                    var pasteData = (event.originalEvent || event).clipboardData.getData('text');
                    
                    if (pasteData.length > 15 || !/^[a-zA-Z0-9]*$/.test(pasteData)) {
                        event.preventDefault();
                        return;
                    }
            
                    // Additional check for the specific format
                    if (!/^[0-9]{2}[a-zA-Z]{5}[0-9]{4}[a-zA-Z][0-9][a-zA-Z][a-zA-Z0-9]$/.test(pasteData)) {
                        event.preventDefault();
                    }
                });
            });
            
            
            
            
            
            $(document).ready(function() {
                $("#P233_PAN_NUMBER").keypress(function(event) {
                    var charCode = event.which || event.keyCode;
            		var currentVal = $(this).val();
            		var currentLength = currentVal.length;
                    
                    // Check if the current length is less than 10
                    if ($(this).val().length >= 10) {
                        event.preventDefault();
                        return;
                    }
            		
            		if (currentLength <5)
            		{
            		 if (!((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
            		}
            		}
            		else if (currentLength <9) 
            		{
            		 if (!(charCode >= 48 && charCode <= 57)) {
                            event.preventDefault();
                        }
            		}
            		
                    
                   else if (currentLength ==9) {
            	   if (!((charCode >= 65 && charCode <= 90) || // Uppercase A-Z
                          (charCode >= 97 && charCode <= 122)  // Lowercase a-z
            		
                          )) {
                        event.preventDefault();
                    }
            		}
                });
            
                // Optional: Prevent pasting if you also want to restrict pasting more than 10 characters
                $("#P233_PAN_NUMBER").on('paste', function(event) {
                    var pasteData = (event.originalEvent || event).clipboardData.getData('text');
                    
                    if (pasteData.length > 10 || !/^[a-zA-Z0-9]*$/.test(pasteData)) {
                        event.preventDefault();
                    }
                });
            });
            
            
            
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript">
            <!--
            
             htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            //-->
            </script>
            
            
            <script>
            function isCharKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 33 && (charCode < 65 || charCode > 91)&& (charCode < 97 || charCode > 122))
                        return false;
            
                     return true;
                  }
            function isNumberKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 31 && (charCode < 48 || charCode > 57))
                        return false;
            
                     return true;
                  }
            </script>
            ```

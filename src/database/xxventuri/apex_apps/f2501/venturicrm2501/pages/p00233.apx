        }
    )

    validation p233-customer-name-not-duplicated (
        name: P233_CUSTOMER_NAME not duplicated
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_no_of_records NUMBER;
                BEGIN
                  SELECT COUNT(*)
                  INTO v_no_of_records
                  FROM EBA_SALES_customers
                  WHERE upper(trim(GST_NO)) = upper(trim(:P233_GSTNO))
                  AND UPPER(TRIM(CUSTOMER_NAME)) = UPPER(TRIM(:P233_CUSTOMER_NAME));
                  
                  IF v_no_of_records  > 0 THEN
                    RETURN 'An account with that name already exists.';
                  END IF;
                  
                END;
                ```
        }
        comments {
            comments:
                ```
                select null
                from eba_sales_customers
                where (:P233_ID is null or :P233_ID != id)
                    and upper(trim(customer_name)) = upper(trim(:P233_CUSTOMER_NAME))
                ```
        }
    )


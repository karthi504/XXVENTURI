    dynamicAction dialog-closed (
        name: dialog_closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @add-city
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('City has been added successfully.');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P233_CITY_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation contractnumber-validation (
        name: ContractNumber Validation
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF length(:P233_CONTACT_CELL) < 10 OR length(:P233_CONTACT_CELL) > 11 THEN
                        return 'Contract Mobile Number should contain atleast 10 digits.';
                    END IF;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation gst-len-validation (
        name: GST_LEN_Validation
        execution {
            sequence: 70
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin 
                 if LENGTH(:P233_GSTNO) != 15  THEN 
                 RETURN 'GST number should contain atleast 15 digits.';
                END IF;
                END;
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
    )

    validation gst-no-validation (
        name: GST No Validation
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_no_of_records NUMBER;
                BEGIN
                  SELECT COUNT(*)
                  INTO v_no_of_records
                  FROM EBA_SALES_customers
                  WHERE upper(trim(GST_NO)) = upper(trim(:P233_GSTNO));
                  
                  IF v_no_of_records  > 0 THEN
                    RETURN 'Sorry! This GST No. is already exists';
                  END IF;
                  
                END;
                ```
        }
    )

    validation gst-validation (
        name: GST_Validation
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                   if   :P233_GSTNO is null THEN
                        return 'GST Number must have some values.';
                     end if;
                END;
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation mobile-number-validation (
        name: Mobile Number Validation
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                
                
                BEGIN
                    if length(:P233_MOBILE_NUMBER) < 10 OR length(:P233_MOBILE_NUMBER) > 11 THEN
                         return 'Account Mobile Number should contain atleast 10 digits.';
                    end if;
                    
                   
                END;
                ```

    process contact-and-location-insert (
        name: Contact and Location Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                /* Contact Insert */
                  IF :P233_ID IS NOT NULL THEN
                    INSERT
                    INTO EBA_SALES_CUSTOMER_CONTACTS
                      (
                        CUSTOMER_ID,
                        CONTACT_NAME,
                        DEPARTMENT,
                        CONTACT_CELL,
                        DESIGNATION,
                        CONTACT_EMAIL,
                        KEY_CONTACT
                      )
                      VALUES
                      (
                        :P233_ID,
                        :P233_CONTACT_NAME,
                        :P233_DEPARTMENT,
                        trim(:P233_CONTACT_PREFIX)||trim(:P233_CONTACT_CELL),
                        :P233_DESIGNATION,
                        :P233_CONTACT_EMAIL,
                        :P233_KEY_CONTACT
                      );
                /* Location Insert */      
                    INSERT
                    INTO EBA_SALES_CUSTOMER_LOCATIONS
                      (
                        CUSTOMER_ID,
                        CUSTOMER_LOCATION_NAME,
                        CUSTOMER_ADDRESS1,
                        CUSTOMER_ADDRESS2,
                        COUNTRY_ID,
                        STATE_ID,
                        CITY_ID,
                        CUSTOMER_POSTAL_CODE
                      )
                      VALUES
                      (
                        :P233_ID,
                        :P233_CUSTOMER_LOCATION_NAME,
                        :P233_CUSTOMER_ADDRESS1,
                        :P233_CUSTOMER_ADDRESS2,
                        :P233_COUNTRY_ID,
                        :P233_STATE_ID,
                        :P233_CITY_ID,
                        :P233_CUSTOMER_POSTAL_CODE
                      );
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 26427254189660243
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process customer-code-update (
        name: Customer_code_Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                 
                  update EBA_SALES_CUSTOMERS SET CUSTOMER_CODE=(select max(to_number(CUSTOMER_CODE)) + 1 from EBA_SALES_CUSTOMERS) where ID=:P233_ID;
                
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 28230748193705129
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )


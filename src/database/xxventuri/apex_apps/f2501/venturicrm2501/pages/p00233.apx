    pageItem P233_DEFAULT_REP_ID (
        type: selectList
        label {
            label: Sales Rep
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                lv_all_customers varchar2(4000);
                lv_customers varchar2(4000);
                begin
                lv_all_customers := 'select REP_FIRST_NAME ||'' ''|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS where STATUS=''Y''
                order by 1';
                
                lv_customers := 'select REP_FIRST_NAME ||'' ''|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS where STATUS=''Y''
                and UPPER(USER_NAME)<>UPPER(''admin'')
                order by 1';
                if UPPER(:APP_USERNAME) = UPPER('System Administrator') then
                return lv_all_customers;
                else 
                return lv_customers;
                end if;
                end;
                ```
            nullDisplayValue: - Select Rep -
        }
        layout {
            sequence: 170
            region: @b-new-account-b
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--indicatorAsterisk
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: DEFAULT_REP_ID
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Declare 
                lv_number  number;
                Begin
                lv_number :=:user_id;
                return lv_number;
                END;
                ```
        }
        security {
            encryptSessionState: false
            restrictedChars: webSafe
        }
        comments {
            comments:
                ```
                select REP_FIRST_NAME ||' '|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS where STATUS='Y'
                order by 1
                ```
        }
    )


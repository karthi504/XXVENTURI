page 167 (
    name: "Banks "
    title: "Banks "
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "ID", 
                "CUSTOMER_ID",
                "BANK_NAME",
                "BRANCH_LOCATION",
                "ACCOUNT_NUMBER",
                "ACCOUNT_TYPE",
                "IFSC_CODE",
                "STATUS",
                "CREATED_BY",
                "CREATION_DATE",
                "UPDATED_BY",
                "UPDATE_DATE"
                from "#OWNER#"."XXEBA_SALES_CUST_BANKS" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 168
                items: {
                    P168_ID: #ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 128561809323912902
        }

        column ACCOUNT_NUMBER (
            type: plainText
            heading {
                heading: Account Number
            }
            layout {
                sequence: 5
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ACCOUNT_TYPE (
            type: plainText
            heading {
                heading: Account Type
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column BANK_NAME (
            type: plainText
            heading {
                heading: Bank Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column BRANCH_LOCATION (
            type: plainText
            heading {
                heading: Branch Location
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column CREATION_DATE (
            type: plainText
            heading {
                heading: Creation Date
            }
            layout {
                sequence: 10
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: J
            }
        )

        column CUSTOMER_ID (
            type: plainText
            heading {
                heading: Customer Id
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IFSC_CODE (
            type: plainText
            heading {
                heading: Ifsc Code
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column UPDATE_DATE (
            type: plainText
            heading {
                heading: Update Date
            }
            layout {
                sequence: 12
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 1285691 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNT_NUMBER (
                sequence: 5
            )

            displayColumn ACCOUNT_TYPE (
                sequence: 6
            )

            displayColumn BANK_NAME (
                sequence: 3
            )

            displayColumn BRANCH_LOCATION (
                sequence: 4
            )

            displayColumn CREATED_BY (
                sequence: 9
            )

            displayColumn CREATION_DATE (
                sequence: 10
            )

            displayColumn CUSTOMER_ID (
                sequence: 2
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn IFSC_CODE (
                sequence: 7
            )

            displayColumn STATUS (
                sequence: 8
            )

            displayColumn UPDATED_BY (
                sequence: 11
            )

            displayColumn UPDATE_DATE (
                sequence: 12
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 168
                clearCache: 168
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


page 146 (
    name: Validation Details
    title: Validation Details
    pageGroup: @accounts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @xxeba-admin
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region button-bar (
        name: Button Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region form-items (
        name: form items
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @validation-details
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region introduction-text (
        name: Introduction text
        type: staticContent
        source {
            htmlCode: <p>If you feel information associated with this &P146_ENTITY_TYPE_LOWER. is correct and accurate, please validate it. Enter any comments (optional), check the validation checkbox, and then click the Validate button below.</p>
        }
        layout {
            sequence: 1
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region validation-details (
        name: Validation Details
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
    )

    pageItem P146_ANNUAL_AMT (
        type: textField
        label {
            label: Annual Purchase Potential Amount
            alignment: left
        }
        layout {
            sequence: 10
            region: @form-items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P146_ENTITY_ID (
        type: hidden
        layout {
            sequence: 40
            region: @form-items
            slot: regionBody
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P146_ENTITY_TYPE (
        type: hidden
        layout {
            sequence: 20
            region: @form-items
            slot: regionBody
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P146_ENTITY_TYPE_LOWER (
        type: hidden
        layout {
            sequence: 30
            region: @form-items
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P146_I_VALIDATE (
        type: checkboxGroup
        label {
            label: Check to validate
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:I validate this info is accurate;VALIDATED
        }
        layout {
            sequence: 60
            region: @form-items
            slot: regionBody
            alignment: left
            labelColumnSpan: 0
        }
        appearance {
            template: @hidden
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P146_VERIFICATION_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @form-items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            width: 60
            height: 5
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @button-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Validate
        layout {
            sequence: 20
            region: @button-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-clicked (
        name: Cancel clicked
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation deatils-validation (
        name: Deatils_validation
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Declare 
                lv_c_count Number;
                lv_m_count Number;
                lv_l_count Number;
                lv_d_count Number;
                lv_a_count Number;
                lv_industry_type VARCHAR2(200);
                begin
                SELECT INDUSTRY_NAME  INTO lv_industry_type FROM eba_sales_industries where ID = (select INDUSTRY_ID from eba_sales_customers where ID=:P146_ENTITY_ID) ;
                SELECT Count(*) into lv_c_count FROM EBA_SALES_CUSTOMER_CONTACTS  WHERE CUSTOMER_ID =:P146_ENTITY_ID ;
                SELECT Count(*) into lv_m_count from XXEBA_SALES_CUST_MACHINERIES WHERE CUSTOMER_ID =:P146_ENTITY_ID ;
                SELECT Count(*) into lv_l_count from EBA_SALES_CUSTOMER_LOCATIONS WHERE CUSTOMER_ID =:P146_ENTITY_ID ;
                SELECT Count(*) into lv_d_count from XXEBA_SALES_CUSTOMER_DETAILS WHERE CUSTOMER_ID =:P146_ENTITY_ID ;
                SELECT Count(*) into lv_a_count from  XXEBA_SALES_ACC_PRODUCTS    WHERE CUSTOMER_ID =:P146_ENTITY_ID;
                    if lv_c_count= 0 then
                        return 'Please fill atleast one Contact for this Account.';
                   
                     ELSIF lv_m_count= 0 AND lv_industry_type <>'Reseller' then
                        return 'Please fill atleast one Machinery detail for this Account.';
                    
                     ELSIF lv_l_count= 0 then
                        return 'Please fill atleast one Location for this Account.';
                 
                      ELSIF lv_d_count= 0 then
                        return 'Please fill Additional Details for this Account.';
                   
                    ELSIF lv_a_count= 0 then
                        return 'Please fill atleast one Product for this Account.';
                    end if;
                 end;
                ```
        }
        error {
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    validation p146-i-validate-is-not-null (
        name: P146_I_VALIDATE is not null
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P146_I_VALIDATE
        }
        error {
            errorMessage: Please check to validate.
        }
    )

    process admin-approve-process (
        name: Admin Approve Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  UPDATE EBA_SALES_CUSTOMERS
                  SET STATUS         ='A',
                 ANNUAL_PUR_POTENTIAL_AMT =:P146_ANNUAL_AMT
                  WHERE id         =:P146_ENTITY_ID;
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 26668877868805451
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process close-dialog (
        name: close dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 602451128314514287
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    process create-validation (
        name: Create validation
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                  l_verification_rec eba_sales_verifications%rowtype;
                
                begin
                
                  l_verification_rec.verification_comment := :P146_VERIFICATION_COMMENT;
                  l_verification_rec.entity_type := :P146_ENTITY_TYPE;
                  l_verification_rec.verified_by := lower(:APP_USER);
                
                  case :P146_ENTITY_TYPE
                    when 'LEAD'
                    then
                      l_verification_rec.lead_id := :P146_ENTITY_ID;
                    when 'OPPORTUNITY'
                    then
                      l_verification_rec.opp_id := :P146_ENTITY_ID;
                    when 'ACCOUNT'
                    then
                      l_verification_rec.cust_id := :P146_ENTITY_ID;
                    when 'TERRITORY'
                    then
                      l_verification_rec.territory_id := :P146_ENTITY_ID;
                    when 'CONTACT'
                    then
                      l_verification_rec.contact_id := :P146_ENTITY_ID;
                    when 'PRODUCT'
                    then
                      l_verification_rec.product_id := :P146_ENTITY_ID;
                  end case;
                  
                  
                  insert into eba_sales_verifications values l_verification_rec;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Validation saved.
        }
        error {
            errorMessage: Unable to save validation.
        }
        advanced {
            executionMappingIdentifier: 624457942904860508
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process init-page (
        name: Init page
        type: executeCode
        source {
            plsqlCode: :P146_ENTITY_TYPE_LOWER := lower(:P146_ENTITY_TYPE);
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 832323220790324291
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 68
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)


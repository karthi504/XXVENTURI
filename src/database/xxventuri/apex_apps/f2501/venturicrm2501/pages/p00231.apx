page 231 (
    name: Sales Kit
    title: Sales Kit
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .a-Button--hot, .t-Button--hot:not(.t-Button--simple), body .ui-state-default.ui-button.ui-button--hot, body .ui-state-default.ui-priority-primary
            {
                left:930px
            }
            
            
            
            .doc_img img
            {
            width:200%;
            }
            
            .t-Report-report td[headers="IMAGE"] img {
              width: 40px;
              border: 1px solid #bbb;
              padding: 4px;
              background: #fff;
              cursor: pointer;
            }
            
            
            .body .ui-widget-overlay
            {
                opacity: .75 !important;
            }
            
            
            .t-Button--hideShow.t-Button {
                border-radius: 100%  !important;
                padding: .4rem  !important;
            }
            
            .a-IRR-header--group {
                background-color: #368ae4;
                color: white;
            }
            
            .a-IRR-header--group:hover {
                background-color: #368ae4;
                color: white;
            }
            
            
            
            
            .t-Button--hot:not(.t-Button--simple), body .ui-state-default.ui-button.ui-button--hot, body .ui-state-default.ui-priority-primary {
                left: 900px;
            }
            ```
    }
    headerAndFooter {
        footerText:
            ```html
            <!-- for Jquery Fancy box -->
            <script type="text/javascript" src="#APP_IMAGES#jquery.fancybox.pack.js"></script>
            
            <script type="text/javascript" src="#APP_IMAGES#jquery.fancybox.js"></script>
            
            <link rel="stylesheet" href="/i/xxcust_Theam/jquery.fancybox.css" type="text/css">
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region sales-files-kit (
        name: Sales Files Kit
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NULL AS EDIT_LINK,
                  KIT_ID,
                  FILE_TITLE,
                  FILE_TYPE_ID,
                  dbms_lob.getlength(FILE_IMAGES) FILE_IMAGES,
                  FILE_NAME,
                  FILE_MIMETYPE,
                  FILE_CHARSET,
                  FILE_LAST_UPDATE,
                  FILE_COMMENTS,
                  initcap(CREATED_BY) as CREATED_BY,
                  CREATED_DATE,
                  STATUS,   
                (SELECT LIST_VALUE  
                  FROM XXEBA_LIST_VALUES
                  WHERE LIST_CODE='SALES_KIT_TYPE' AND LIST_ID=FILE_TYPE_ID) as FILE_TYPE_NAME
                FROM XXEBA_SALES_KIT_FILES
                WHERE STATUS    ='Y'
                and(
                (:USER_ID =REP_ID and FILE_TYPE_ID='132') or FILE_TYPE_ID <> '132' );
                ```
        }
        layout {
            sequence: 1230
            parentRegion: @sales-kit-2
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 47141238199965835
        }

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column CREATED_DATE (
            type: plainText
            heading {
                heading: Created On
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column EDIT_LINK (
            type: link
            heading {
                heading: &nbsp
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 232
                    items: {
                        P232_KIT_ID: #KIT_ID#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
            security {
                authorizationScheme: @xxeba-admin
            }
        )

        column FILE_CHARSET (
            type: hidden
            heading {
                heading: File charset
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FILE_COMMENTS (
            type: plainText
            heading {
                heading: Comments
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column FILE_IMAGES (
            type: downloadBlob
            heading {
                heading: File
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                downloadText: <i class="fa fa-paperclip" aria-hidden="true"></i>
            }
            blobAttributes {
                tableName: XXEBA_SALES_KIT_FILES
                blobColumn: FILE_IMAGES
                primaryKeyColumn1: KIT_ID
                mimeTypeColumn: FILE_MIMETYPE
                filenameColumn: FILE_NAME
                lastUpdatedColumn: FILE_LAST_UPDATE
                charSetColumn: FILE_CHARSET
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column FILE_LAST_UPDATE (
            type: hidden
            heading {
                heading: File last update
            }
            layout {
                sequence: 90
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FILE_MIMETYPE (
            type: hidden
            heading {
                heading: File mimetype
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FILE_NAME (
            type: hidden
            heading {
                heading: File Name Upload
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FILE_TITLE (
            type: plainText
            heading {
                heading: Filename
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FILE_TYPE_ID (
            type: hidden
            heading {
                heading: File type id
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FILE_TYPE_NAME (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column KIT_ID (
            type: hidden
            heading {
                heading: Kit id
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column STATUS (
            type: hidden
            heading {
                heading: Status
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            width: 8.5
            height: 11
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 473639 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATED_BY (
                sequence: 14
            )

            displayColumn CREATED_DATE (
                sequence: 11
            )

            displayColumn EDIT_LINK (
                sequence: 1
            )

            displayColumn FILE_CHARSET (
                sequence: 8
            )

            displayColumn FILE_COMMENTS (
                sequence: 10
            )

            displayColumn FILE_IMAGES (
                sequence: 5
            )

            displayColumn FILE_LAST_UPDATE (
                sequence: 9
            )

            displayColumn FILE_MIMETYPE (
                sequence: 7
            )

            displayColumn FILE_NAME (
                sequence: 6
            )

            displayColumn FILE_TITLE (
                sequence: 3
            )

            displayColumn FILE_TYPE_ID (
                sequence: 4
            )

            displayColumn FILE_TYPE_NAME (
                sequence: 13
            )

            displayColumn KIT_ID (
                sequence: 2
            )

            displayColumn STATUS (
                sequence: 12
            )

        )

    )

    region sales-kit (
        name: Sales Kit
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1220
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-kit-2 (
        name: Sales Kit
        type: staticContent
        layout {
            sequence: 1230
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button upload-documents (
        buttonName: UPLOAD_DOCUMENTS
        label: Upload File
        layout {
            sequence: 10
            region: @sales-kit
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 232
                clearCache: 232
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    dynamicAction ir-refresh-edit (
        name: IR Refresh Edit
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sales-files-kit
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sales-files-kit
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction region-refresh (
        name: Region Refresh
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @upload-documents
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Action Processed.');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sales-files-kit
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-xxeba-efficiency-data-t (
        name: Fetch Row from XXEBA_EFFICIENCY_DATA_T
        type: autoRowFetch
        source {
            tableName: XXEBA_EFFICIENCY_DATA_T
            pkColumn: EFFICIENCY_ID
            pkItem: P263_EFFICIENCY_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 364566766789352113
        }
    )

    process insert-into-xxeba-efficiency-data-t (
        name: Insert into XXEBA_EFFICIENCY_DATA_T
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  IF :P263_EFFICIENCY_ID IS NULL THEN
                    INSERT
                    INTO XXEBA_EFFICIENCY_DATA_T
                      (
                        PERIOD_NAME,
                        PERF_FROM_DATE,
                        PERF_TO_DATE,
                        SALES_REP_ID,
                        EFFICIENCY_TYPE,
                        PERF_SCORE,
                        PERF_REWARDS
                      )
                      VALUES
                      (
                        :P263_MONTH
                        ||'-'
                        ||:P263_YEAR,
                        TRUNC(last_day(add_months(to_date('01-'
                        ||:P263_MONTH
                        ||:P263_YEAR),-1))+1),
                        last_day(add_months(to_date('01-'
                        ||:P263_MONTH
                        ||:P263_YEAR),0)),
                        :P263_SALES_REP_ID,
                        :P263_EFFICIENCY_TYPE,
                        DECODE(:P263_EFFICIENCY_TYPE,'On-Time',5,'Delayed',2),
                        :P263_PERF_REWARDS
                      );
                  elsif :P263_EFFICIENCY_ID IS NOT NULL THEN
                    UPDATE XXEBA_EFFICIENCY_DATA_T
                    SET EFFICIENCY_TYPE = :P263_EFFICIENCY_TYPE,
                      PERF_SCORE        = DECODE(:P263_EFFICIENCY_TYPE,'On-Time',5,'Delayed',2),
                      PERF_REWARDS      = :P263_PERF_REWARDS
                    WHERE EFFICIENCY_ID = :P263_EFFICIENCY_ID;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 364580355757363252
        }
    )

    process process-row-of-xxeba-efficiency-data-t (
        name: Process Row of XXEBA_EFFICIENCY_DATA_T
        type: autoRowProcessing
        target {
            tableName: XXEBA_EFFICIENCY_DATA_T
            pkColumn: EFFICIENCY_ID
            pkItem: P263_EFFICIENCY_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 364567144242352113
        }
        serverSideCondition {
            type: never
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 364567560730352113
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)


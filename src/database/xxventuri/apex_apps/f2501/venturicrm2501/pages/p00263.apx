    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Submit
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P263_EFFICIENCY_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: (:P263_DAYS < 50) and :P263_EFFICIENCY_ID is not null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction change-efficiency-type-color (
        name: Change efficiency type color
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P263_EFFICIENCY_TYPE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ($v('P263_EFFICIENCY_TYPE')=='On-Time') {
                       
                         $('label[for="P263_EFFICIENCY_TYPE_0"]').css("background-color","green");
                         $('label[for="P263_EFFICIENCY_TYPE_0"]').css("color","white");
                         $('label[for="P263_EFFICIENCY_TYPE_1"]').css("background-color","#f8f8f8");
                         $('label[for="P263_EFFICIENCY_TYPE_1"]').css("color","black");
                    }
                     if ($v('P263_EFFICIENCY_TYPE')=='Delayed') {
                         $('label[for="P263_EFFICIENCY_TYPE_1"]').css("background-color","#F9690E");
                         $('label[for="P263_EFFICIENCY_TYPE_1"]').css("color","white");
                         $('label[for="P263_EFFICIENCY_TYPE_0"]').css("background-color","#f8f8f8");
                         $('label[for="P263_EFFICIENCY_TYPE_0"]').css("color","black");
                         
                    }
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction change-perf-score-color-change (
        name: Change perf score color change
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P263_PERF_REWARDS
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ($v('P263_PERF_REWARDS')==1) {
                       
                         $('label[for="P263_PERF_REWARDS_0"]').css("background-color","red");
                         $('label[for="P263_PERF_REWARDS_0"]').css("color","white");
                         $('label[for="P263_PERF_REWARDS_1"]').css("background-color","#f8f8f8");
                         $('label[for="P263_PERF_REWARDS_1"]').css("color","black");
                         $('label[for="P263_PERF_REWARDS_2"]').css("background-color","#f8f8f8");
                         $('label[for="P263_PERF_REWARDS_2"]').css("color","black");
                         
                    }
                     if ($v('P263_PERF_REWARDS')==2) {
                         $('label[for="P263_PERF_REWARDS_1"]').css("background-color","orange");
                         $('label[for="P263_PERF_REWARDS_1"]').css("color","white");
                         $('label[for="P263_PERF_REWARDS_0"]').css("background-color","#f8f8f8");
                         $('label[for="P263_PERF_REWARDS_0"]').css("color","black");
                         $('label[for="P263_PERF_REWARDS_2"]').css("background-color","#f8f8f8");
                         $('label[for="P263_PERF_REWARDS_2"]').css("color","black");
                        
                         
                    }
                    
                    if ($v('P263_PERF_REWARDS')==5) {
                         $('label[for="P263_PERF_REWARDS_2"]').css("background-color","green");
                         $('label[for="P263_PERF_REWARDS_2"]').css("color","white");
                         $('label[for="P263_PERF_REWARDS_0"]').css("background-color","#f8f8f8");
                         $('label[for="P263_PERF_REWARDS_0"]').css("color","black");
                         $('label[for="P263_PERF_REWARDS_1"]').css("background-color","#f8f8f8");
                         $('label[for="P263_PERF_REWARDS_1"]').css("color","black");
                       
                    
                    }
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation p263-created-date-must-be-timestamp (
        name: P263_CREATED_DATE must be timestamp
        execution {
            sequence: 110
        }
        validation {
            type: itemIsAValidTimestamp
            item: P263_CREATED_DATE
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P263_CREATED_DATE
        }
    )

    validation p263-updated-date-must-be-timestamp (
        name: P263_UPDATED_DATE must be timestamp
        execution {
            sequence: 130
        }
        validation {
            type: itemIsAValidTimestamp
            item: P263_UPDATED_DATE
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P263_UPDATED_DATE
        }
    )

    validation rep-id-validation (
        name: REP_ID_VALIDATION
        execution {
            sequence: 140
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_count NUMBER;
                BEGIN
                  SELECT COUNT(1)
                  INTO v_count
                  FROM XXEBA_EFFICIENCY_DATA_T
                  WHERE SALES_REP_ID= :P263_SALES_REP_ID
                  AND PERIOD_NAME = :P263_MONTH
                    ||'-'
                    || :P263_YEAR;
                   
                  IF v_count      > 0 THEN
                    RETURN 'Sorry already you have entered';
                  END IF;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 364567989092352114
        }
        serverSideCondition {

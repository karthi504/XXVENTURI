        source {
            type: databaseColumn
            databaseColumn: CREATED_DATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P263_DAYS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @form-on-xxeba-efficiency-data-t
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select trunc(sysdate)-trunc(CREATED_DATE) as days from XXEBA_EFFICIENCY_DATA_T where EFFICIENCY_ID =:P263_EFFICIENCY_ID
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P263_EFFICIENCY_ID (

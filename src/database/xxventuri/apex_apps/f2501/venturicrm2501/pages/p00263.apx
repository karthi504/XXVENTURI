        }
        lov {
            type: staticValues
            staticValues: STATIC2:On-Time;On-Time,Delayed;Delayed
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @form-on-xxeba-efficiency-data-t
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: EFFICIENCY_TYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P263_MONTH (
        type: selectList
        label {
            label: Select Period
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT to_char(add_months(SYSDATE, (LEVEL-1 )),'Month') as d, 
                       to_char(add_months(SYSDATE, (LEVEL-1 )),'Month') as r 
                  FROM dual 
                CONNECT BY LEVEL <= to_number(extract(month from sysdate))
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @form-on-xxeba-efficiency-data-t
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(add_months( to_date(sysdate), 0 )-1,'Mon')
        }
        serverSideCondition {
            type: itemIsNull
            item: P263_EFFICIENCY_ID
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments: STATIC2:January;January,February;February,March;March,April;April,May;May,June;June,July;July,August;August,September;September,October;October,November;November,December;December
        }
    )


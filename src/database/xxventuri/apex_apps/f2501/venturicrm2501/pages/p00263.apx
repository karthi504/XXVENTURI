            type: databaseColumn
            databaseColumn: EFFICIENCY_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P263_EFFICIENCY_TYPE (
        type: radioGroup

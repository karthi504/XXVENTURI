    pageItem P80_DELIVERY (
        type: selectList
        label {
            label: "Delivery "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select description R,stock_code AS D from XXVENTURI.XXEBA_STOCK_CODES WHERE STOCK_CODE != 0 AND STATUS = 'Y' ORDER BY 1 ASC
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @quotations
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                lv_stockcode number;
                BEGIN
                BEGIN
                SELECT stock_code into lv_stockcode
                FROM
                  (SELECT rank() OVER (ORDER BY stock_code DESC) AS row_num,
                    stock_code 
                  FROM xxventuri.xxeba_stock_codes
                  WHERE stock_code != 0
                  AND status        = 'Y'
                  )
                WHERE row_num =1;
                END;
                RETURN lv_stockcode;
                END;
                
                ```
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_company_id         NUMBER;
                  v_no_of_rows NUMBER;
                BEGIN
                  SELECT PREFERENCE_VALUE
                  INTO v_company_id
                  FROM EBA_SALES_PREFERENCES
                  WHERE PREFERENCE_NAME = 'COMPANY_ID';
                  SELECT COUNT(*)
                  INTO v_no_of_rows
                  FROM EBA_SALES_DEAL_PRODUCTS
                  WHERE DEAL_ID =:P80_ID;
                  IF v_company_id       = 1 THEN
                    RETURN true;
                  ELSE
                    RETURN false;
                  END IF;
                EXCEPTION
                WHEN OTHERS THEN
                  RETURN false;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )


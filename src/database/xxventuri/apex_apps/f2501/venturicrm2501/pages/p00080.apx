    process file-insert-process (
        name: "File Insert process "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  p_url VARCHAR2(200);
                  p_report_name VARCHAR2(200);
                  p_report_format VARCHAR2(200);
                  p_datasoure VARCHAR2(200);
                  p_outfilename VARCHAR2(200);
                  p_report_language VARCHAR2(200);
                  p_encode VARCHAR2(200);
                  p_filename VARCHAR2(200);
                  lv_reference_number VARCHAR2(30);
                  lv_subject VARCHAR2(500);
                  lv_body_html CLOB;
                  p_p1 NUMBER;
                  p_p2 NUMBER;
                  p_p3 NUMBER;
                  p_p4 VARCHAR2(30);
                  p_p5 VARCHAR2(30);
                  p_p6 VARCHAR2(30);
                  p_p7 VARCHAR2(30);
                  p_p8 VARCHAR2(30);
                  p_p9 VARCHAR2(4000);
                  l_id NUMBER;
                  lv_filename VARCHAR2(100);
                  l_email_id   VARCHAR2(100) := :p80_person_mail;
                  p_qut_id NUMBER;
                  l_document BLOB;
                  lv_sales_person VARCHAR2(60);
                  lv_mobile_number VARCHAR2(30);
                  lv_manager_mail VARCHAR2(100);
                  lv_email_id VARCHAR2(300);
                  v_from_mail_alias VARCHAR2(200);
                  v_company_id number;
                  	 lv_v_body      CLOB;
                  lv_v_crlf  VARCHAR2(2) := chr(13)||chr(10);
                
                  lv_subject_doc varchar2(4000);
                 
                BEGIN
                
                      SELECT TRIM(CHAR_VALUE)
                        INTO p_url
                        FROM XXEBA_SALES_PARAMETERS_T
                       WHERE CODE = 'JASPER_REPORTS_URL' 
                         AND STATUS = 'Y';
                
                      
                      SELECT TRIM(CHAR_VALUE)
                        INTO p_datasoure
                        FROM XXEBA_SALES_PARAMETERS_T
                       WHERE CODE = 'DATA_SOURCE_NAME' 
                         AND STATUS = 'Y';
                     
                     SELECT TRIM(CHAR_VALUE)
                        INTO p_report_name
                        FROM XXEBA_SALES_PARAMETERS_T
                       WHERE CODE = 'QUOTE_REPORT_NAME' 
                         AND STATUS = 'Y';
                         
                     SELECT TRIM(CHAR_VALUE)
                       INTO v_from_mail_alias
                       FROM XXEBA_SALES_PARAMETERS_T
                       WHERE CODE = 'FROM_MAIL_ALIAS' 
                       AND STATUS = 'Y';    
                       
                    SELECT PREFERENCE_VALUE
                  INTO v_company_id
                  FROM EBA_SALES_PREFERENCES
                  WHERE PREFERENCE_NAME = 'COMPANY_ID';
                
                        select (case when :P80_MAIL_SUBJECT = 'Others' then 
                            :P80_OTHERS
                        else 
                            :P80_MAIL_SUBJECT
                        end ) as subject into lv_subject_doc from dual;
                  --raise_application_error(-20001, 'Test');
                 --p_url := 'http://13.127.204.122:8080/JasperReportsIntegration/';
                -- p_report_name := 'quotation_report_bgd_v1'; --  Quatation_msk_withheadera
                  p_report_format := 'pdf';
                 -- p_datasoure := 'prod1';
                  p_outfilename := NULL;
                  p_report_language := 'en_US';
                  p_encode := NULL;
                --  lv_filename := 'quation.pdf';
                  p_p1 := :p80_id;
                  p_p2 := :P80_MAIL_LOCATON_ID;
                  p_p3 := :p80_user_id;
                  p_p4 :=  REPLACE(:p80_contact_person_salutation,' ','_');
                  p_p6 := :p80_payment;
                  p_p7 := :p80_delivery;
                  p_p8 := :p80_salutations;
                  p_p9 := replace(:P80_SUBJECT,' ','%20');
                  
                    --p_p1 := 140525944224093380882513112004789482521;
                  --p_p2 := 140322162328483337550012870452746081452;
                  --p_p3 := 137299580992928658344444066683110435759;
                  --p_p4 := 'Richard';
                  --p_p6 := 'Immediate';
                  --p_p7 := '9';
                 -- p_p8 := 'Mr.';
                
                  
                  BEGIN
                  
                  IF v_company_id = 1 then
                    SELECT 'VT'||TO_CHAR(SYSDATE,'YYMM')||lpad(xxfs_pm_msk_qut_seq.nextval,4,0)
                      INTO lv_reference_number
                      FROM dual;
                  ELSIF   v_company_id = 2 then   
                     SELECT   'W/'||to_char(sysdate, 'YYYY')||'/'||flex_flag_01 
                      INTO lv_reference_number
                      FROM eba_sales_deals
                      WHERE ID = :P80_ID;
                  END IF;
                    EXCEPTION WHEN OTHERS THEN
                    xxfs_pm_error_log_pkg.record_log('ERROR','MSK_Tools_Quotation_Email',NULL,1); 
                  END;
                --raise_application_error (-20001,lv_reference_number);
                   BEGIN
                    SELECT r.rep_email
                      INTO lv_email_id
                      FROM eba_sales_salesreps r
                     WHERE ID = :p80_user_id;
                  EXCEPTION
                    WHEN OTHERS THEN
                     xxfs_pm_error_log_pkg.record_log('ERROR','MSK_Tools_Quotation_Email',NULL,4); 
                  END;
                  
                  lv_filename := 'Quotation_'||lv_reference_number||'.pdf';
                  --raise_application_error (-20001,lv_filename);
                  IF v_company_id = 1 then
                         xxfs_pm_msk_js_pkg.xxfs_lob_download_proc(p_url => p_url,
                                                               p_report_name => p_report_name,
                                                               p_report_format => p_report_format,
                                                               p_datasoure => p_datasoure,
                                                               p_outfilename => p_outfilename,
                                                               p_report_language => p_report_language,
                                                               p_encode => p_encode,
                                                               p_filename => lv_filename,
                                                               p_p1 => p_p1,
                                                               p_p2 => p_p2,
                                                               p_p3 => p_p3,
                                                               p_p4 => p_p4,
                                                               p_p5 => lv_reference_number,
                                                               p_p6 => p_p6,
                                                               p_p7 => p_p7,
                                                               p_p8 => p_p8,
                                                               p_p9 => p_p9,
                                                               p_qut_id => p_qut_id
                                                              );
                  ELSIF v_company_id = 2 then
                     xxfs_pm_msk_js_pkg.xxfs_lob_download_proc(p_url => p_url,
                                                               p_report_name => p_report_name,
                                                               p_report_format => p_report_format,
                                                               p_datasoure => p_datasoure,
                                                               p_outfilename => p_outfilename,
                                                               p_report_language => p_report_language,
                                                               p_encode => p_encode,
                                                               p_filename => lv_filename,
                                                               p_p1 => p_p1,
                                                               p_p2 => p_p8,
                                                               p_p3 => p_p4,
                                                               p_p4 => p_p4,
                                                               p_p5 => lv_reference_number,
                                                               p_p6 => p_p6,
                                                               p_p7 => p_p7,
                                                               p_p8 => p_p8,
                                                               p_p9 => p_p9,
                                                               p_qut_id => p_qut_id
                                                              );
                   END IF;
                   -- raise_application_error (-20001,p_qut_id);
                  
                  BEGIN
                    SELECT file_blob 
                      INTO l_document 
                      FROM eba_sales_files 
                     WHERE ID=p_qut_id;
                  EXCEPTION
                    WHEN OTHERS THEN
                     xxfs_pm_error_log_pkg.record_log('ERROR','MSK_Tools_Quotation_Email',NULL,2); 
                  END;
                    if v_company_id = 1 then
                    lv_subject := 'Quotation from Msk Venturi Tools (Ref.: '||lv_reference_number||')';
                    elsif v_company_id = 2 then
                    lv_subject := 'Project Proposal from Workaholic (Ref.: '||lv_reference_number||')';
                    end if;
                    --lv_filename := 'Quotation_'||LV_REFERENCE_NUMBER||'.pdf';
                  BEGIN
                    SELECT ess.rep_first_name||' '||ess.rep_last_name, 
                           ess.rep_cell_phone 
                      INTO lv_sales_person, 
                           lv_mobile_number
                      FROM eba_sales_salesreps ess
                     WHERE ess.ID = :p80_user_id
                       AND ROWNUM   = 1;
                    EXCEPTION
                    WHEN OTHERS THEN
                     xxfs_pm_error_log_pkg.record_log('ERROR','MSK_Tools_Quotation_Email',NULL,3); 
                  END;
                
                  BEGIN
                    SELECT (SELECT rep_email 
                              FROM eba_sales_salesreps m 
                             WHERE m.ID = r.rep_manager_id
                           )
                      INTO lv_manager_mail
                      FROM eba_sales_salesreps r
                     WHERE ID = :p80_user_id;
                  EXCEPTION
                    WHEN OTHERS THEN
                     xxfs_pm_error_log_pkg.record_log('ERROR','MSK_Tools_Quotation_Email',NULL,4); 
                  END;  
                  
                  IF v_company_id = 1 then 
                  lv_v_body :=  'To view the content of this message, please use an HTML enabled mail client.'      || lv_v_crlf;
                    lv_body_html:= '<html><body> Dear '||:p80_contact_person_salutation||','||'<br><br>'
                                   ||'Please find attached our competitive quotation.'||'<br><br>'
                                   ||'We request you to review and arrange to send us your valuable Purchase Order.'||'<br><br>'
                                   ||'Thanking you.'||'<br><br>'
                                   ||'Yours Truly,'
                                   ||'<br>'||lv_sales_person
                                   ||'<br>'||lv_mobile_number;
                  ELSIF v_company_id = 2 then
                     lv_body_html:= 'Dear '||:P80_SALUTATIONS||' '||:p80_contact_person_salutation||','||'<br><br>'
                                   ||'Please find attached our best Project Proposal.'||'<br><br>'
                                   ||'We request you to review and arrange to send us your valuable Purchase Order.'||'<br><br>'
                                   ||'Thanking you.'||'<br><br>'
                                   ||'Yours Truly,'
                                   ||'<br>'||lv_sales_person
                                   ||'<br>'||lv_mobile_number;
                  
                  
                  END IF;                 
                   xxfs_pm_error_log_pkg.record_log('Log',' - Before Mail',lv_body_html,4); 
                   
                    if lv_manager_mail is not null then
                        lv_email_id := lv_manager_mail||','||lv_email_id||','||:P80_PERSON_MAIL_CC;
                    end if;
                
                 --- commented to check NEW EMAIL Process   
                    l_id := apex_mail.send (p_to        => :p80_person_mail, 
                                            p_cc        => lv_email_id||','||:P80_PERSON_MAIL_CC,
                                            p_bcc       => 'richard.d@4iapps.com,rajan@venturitool.com',
                                            p_from       => v_from_mail_alias,
                                            p_subj       => lv_subject,
                                            p_body       => lv_v_body,
                                            p_body_html  => lv_body_html
                                           );
                   xxfs_pm_error_log_pkg.record_log('Log',' - After Mail',lv_body_html,4); 
                
                            apex_mail.add_attachment(p_mail_id    => l_id,
                                                     p_attachment => l_document,
                                                     p_filename   => lv_filename,
                                                     p_mime_type  => 'application/pdf'
                                                    );
                           xxfs_pm_error_log_pkg.record_log('Log',' - After Attachemnt',lv_filename,4); 
                       
                      apex_mail.push_queue(p_smtp_hostname => '4iapps-com.mail.protection.outlook.com', p_smtp_portno => 25);  
                      ---apex_mail.push_queue(P_SMTP_HOSTNAME => '213.199.154.87', P_SMTP_PORTNO => 25);  
                
                
                /*  New Email Process
                  send_venturi_mail(p_to  => :p80_person_mail,
                            p_cc          => 'richard.d@4iapps.com',
                            p_bcc         => 'drdalvi@gmail.com',
                            p_from        => 'CRM@venturitool.com',
                            p_subject     => lv_subject,
                            p_text_msg    => lv_body_html,
                            p_attach_name => lv_filename,
                            p_attach_mime => 'application/pdf',
                            p_attach_clob => blob_to_clob(l_document)  
                            );
                */
                
                  EXCEPTION
                 
                    WHEN UTL_HTTP.request_failed THEN
                       -- DBMS_OUTPUT.PUT_LINE(SQLERRM);
                       raise_application_error (-20001,'Please Contact your application adminstrator');
                    WHEN OTHERS THEN
                      --DBMS_OUTPUT.PUT_LINE(SQLERRM);
                      --raise_application_error (-20001,'Please Contact your application adminstrator');
                        raise_application_error(-20010,'CO Error ='||DBMS_UTILITY.FORMAT_ERROR_STACK||' ' ||DBMS_UTILITY.FORMAT_ERROR_BACKTRACE); 
                END;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Quotation Sent Successfully.
        }
        advanced {
            executionMappingIdentifier: 76818208304437261
        }
        serverSideCondition {
            type: request=Value
            value: SEND_MAIL
        }
        comments {
            comments:
                ```
                 IF v_company_id = 1 then 
                    lv_body_html:= 'Dear '||:p80_contact_person_salutation||','||'<br><br>'
                                   ||'Please find attached our competitive quotation.'||'<br><br>'
                                   ||'We request you to review and arrange to send us your valuable Purchase Order.'||'<br><br>'
                                   ||'Thanking you.'||'<br><br>'
                                   ||'Yours Truly,'
                                   ||'<br><br>'||lv_sales_person
                                   ||'<br><br>'||lv_mobile_number;
                  ELSIF v_company_id = 2 then
                     lv_body_html:= 'Dear '||:P80_SALUTATIONS||' '||:p80_contact_person_salutation||','||'<br><br>'
                                   ||'Please find attached our best Project Proposal.'||'<br><br>'
                                   ||'We request you to review and arrange to send us your valuable Purchase Order.'||'<br><br>'
                                   ||'Thanking you.'||'<br><br>'
                                   ||'Yours Truly,'
                                   ||'<br><br>'||lv_sales_person
                                   ||'<br><br>'||lv_mobile_number;
                  
                ```
        }
    )

    process init-page (
        name: Init page
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                insert into eba_sales_clicks (
                    entity_type,
                    opp_id,
                    app_username  
                ) values (
                    'OPPORTUNITY',
                    :P80_ID,
                    lower(:APP_USER)
                );
                
                delete from eba_sales_clicks 
                where view_timestamp < (sysdate - 90) 
                  and opp_id = :P80_ID;
                
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 76818593114437262
        }
    )


    button proposal-view (
        buttonName: PROPOSAL_VIEW
        label: View Proposal
        layout {
            sequence: 30
            region: @quotations
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:proposal('P80_ID','P80_URL','P80_DATA_SOURCE','P80_SALUTATIONS','P80_CONTACT_PERSON_SALUTATION')
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_company_id         NUMBER;
                  v_no_of_rows NUMBER;
                BEGIN
                  SELECT PREFERENCE_VALUE
                  INTO v_company_id
                  FROM EBA_SALES_PREFERENCES
                  WHERE PREFERENCE_NAME = 'COMPANY_ID';
                  SELECT COUNT(*)
                  INTO v_no_of_rows
                  FROM EBA_SALES_DEAL_PRODUCTS
                  WHERE DEAL_ID =:P80_ID;
                  IF v_company_id       = 2 AND v_no_of_rows >= 1 THEN
                    RETURN true;
                  ELSE
                    RETURN false;
                  END IF;
                EXCEPTION
                WHEN OTHERS THEN
                  RETURN false;
                END;
                ```
        }
    )


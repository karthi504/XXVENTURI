    region team-members (
        name: Team Members
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.id,null edit, r.rep_first_name || ' ' || r.rep_last_name team_member,
                  lower(r.rep_email) email,
                  r2.role_name role,
                  t.created,
                  lower(t.created_by) created_by
                from eba_sales_deal_team t
                join eba_sales_salesreps r
                  on r.id = t.rep_id
                join eba_sales_salesrep_roles r2
                  on r2.id = r.rep_role
                where t.deal_id = :P80_ID
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-dynamicHideShowRegion
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No team members assigned, click "+" icon to add a assign team members
        }
        componentAdvanced {
            stripHtml: true
        }


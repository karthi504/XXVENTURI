    process update-quote-submission (
        name: Update Quote Submission
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                 UPDATE eba_sales_deals SET QUOTE_TYPE_ID=:P80_QUOTE_TYPE_ID where ID=:P80_ID;
                END;
                ```
        }
        execution {
            sequence: 30
        }

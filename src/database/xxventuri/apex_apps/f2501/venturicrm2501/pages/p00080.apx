page 80 (
    name: Opportunity
    title: Opportunity
    appearance {
        pageTemplate: @marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    css {
        inline:
            ```css
            .t-Footer{
            	display:none;
            }
            
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <!DOCTYPE html>
            <html>
            
            <body>
                <script>
                   
            		function msk_Quotation (p_deal_id,p_url,p_datasource,p_location_id,p_user_id,p_contact_person,p_payment,p_delivery,p_salutations,p_subject,lv_reference_number)
            {
                var v_deal = document.getElementById(p_deal_id).value;
                var v_location = document.getElementById(p_location_id).value;              
                var v_user = document.getElementById(p_user_id).value;              
                var v_contact_person = document.getElementById(p_contact_person).value;   
                var v_payment = document.getElementById(p_payment).value;
                var v_delivery = document.getElementById(p_delivery).value;
                var v_salutations = document.getElementById(p_salutations).value;
                var v_subject = document.getElementById(p_subject).value;
                var v_datasource = document.getElementById(p_datasource).value;
                var v_url = document.getElementById(p_url).value;
                var v_reference_no = document.getElementById(lv_reference_number).value;
            
                window.open(""+v_url+"report?_repName=quotation_report_bgd_v1&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_deal+"&p2="+v_location+"&p3="+v_user+"&p4="+v_contact_person+"&p5="+v_reference_no+"&p6="+v_payment+"&p7="+v_delivery+"&p8="+v_salutations+"&p9="+v_subject+""); 
            
                /* window.open("http://182.72.176.221:8083/JasperReportsIntegration/report?_repName=quotation_report&_repFormat=pdf&_dataSource=prod2&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_deal+"&p2="+v_location+"");   */                     
            }
                    
            function proposal(p_deal_id,p_url,p_datasource,p_salutation,p_name) 
             {
                var v_order_id = document.getElementById(p_deal_id).value;
                var v_datasource = document.getElementById(p_datasource).value;
                var v_url = document.getElementById(p_url).value;
                var v_salutation = document.getElementById(p_salutation).value;
                var v_name = document.getElementById(p_name).value;
                  window.open(""+v_url+"report?_repName=workaholic_project_proposal&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p1="+v_order_id+"&p2="+v_salutation+"&p3="+v_name+"");       
             } 
                </script>
            </body>
            </html>
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Manage an opportunity's details, products, competitors, team members, links, attachments, and/or comments. You can also validate the opportunity.
    }

    region appointment (
        name: Appointment
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select NULL EDIT,CUSTOMER_ID,LEAD_ID,OPPORTUNITY_ID,APPOINTMENT_TYPE,APPOINTMENT_DATE,CONTACT_ADDRESS,APPOINTMENT_ID,
                APPOINTMENT_PURPOSE,CONTACT_PERSON_ID,CONTACT_LOCATION_ID,COMMENTS from XXEBA_SALES_APPOINTMENT where  OPPORTUNITY_ID= :P80_ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column APPOINTMENT_DATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Appointment Date
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-YYYY HH:MI PM
            }
        )

        column APPOINTMENT_ID (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column APPOINTMENT_PURPOSE (
            reportColumnQueryId: 9

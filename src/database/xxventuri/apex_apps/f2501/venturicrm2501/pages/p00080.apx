    pageItem P80_REFERENCE_NUMBER (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @quotations
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_company_id NUMBER;
                  lv_reference_number VARCHAR2(50);
                  BEGIN
                    BEGIN
                      SELECT PREFERENCE_VALUE
                      INTO v_company_id
                      FROM EBA_SALES_PREFERENCES
                      WHERE PREFERENCE_NAME = 'COMPANY_ID';
                    eXCEPTION WHEN OTHERS THEN
                    v_company_id:=NULL;
                    eND;
                
                  IF v_company_id = 1 then
                    SELECT 'VT'||TO_CHAR(SYSDATE,'YYMM')||lpad(xxfs_pm_msk_qut_seq.nextval,4,0)
                      INTO lv_reference_number
                      FROM dual;
                  ELSIF   v_company_id = 2 then   
                     SELECT   'W/'||to_char(sysdate, 'YYYY')||'/'||flex_flag_01 
                      INTO lv_reference_number
                      FROM eba_sales_deals
                      WHERE ID = :P80_ID;
                  END IF;
                
                  RETURN lv_reference_number;
                  eND;
                ```
        }
    )


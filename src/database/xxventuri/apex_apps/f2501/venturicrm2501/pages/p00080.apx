    region competition (
        name: Competition
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.competitor_name competitor, NULL EDIT,c.id,
                  dc.competition_desc,
                  dc.competitor_threat_id,
                  (
                    select competitor_threat 
                    from eba_sales_competitor_threats x 
                    where x.id = dc.competitor_threat_id
                  ) threat,
                  dc.created,
                  lower(dc.created_by) created_by
                from eba_sales_deal_competition dc
                join eba_sales_competitors c
                  on c.id = dc.competitor_id
                where dc.deal_id = :P80_ID
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                t-Region--noPadding
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: js-dynamicHideShowRegion
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                t-Report--stretch
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No competition identified, click "+" icon to add a competitor
        }
        componentAdvanced {
            stripHtml: true
        }


    dynamicAction edit-opportunity-dialog-closed (
        name: Edit Opportunity dialog closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.data && this.data.dialogPageId === 16
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('.t-Breadcrumb-item.is-active > span').text(this.data.P16_DEAL_NAME);
                    apex.message.showPageSuccess('Action Processed.');
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @opportunity-details
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction name-validations (
        name: Name Validations
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: button
            button: @quote-send-mail
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var persion = $('#P80_CONTACT_PERSON').val();
                    if(persion.trim().length == 0){
                        $('#P80_CONTACT_PERSON_error_placeholder').html('<span class="t-Form-error">Please fill out this field.</span>');
                    }
                    /*else{
                        apex.submit( 'REJECT');
                    }*/
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction personal-email-validation (
        name: Personal Email Validation
        execution {
            sequence: 160
        }
        when {
            event: click
            selectionType: button
            button: @quote-send-mail
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var mail = $('#P80_PERSON_MAIL').val();
                    var salutation = $('#P80_CONTACT_PERSON_SALUTATION').val();
                    var quote = $('#P80_QUOTE_TYPE_ID').val();
                    if(salutation.trim().length == 0){
                       // $('#P80_PERSON_MAIL_error_placeholder').html('');
                        $('#P80_CONTACT_PERSON_SALUTATION_error_placeholder').html('<span class="t-Form-error">Please fill out this field.</span>');
                    }
                    else
                    {
                        $('#P80_CONTACT_PERSON_SALUTATION_error_placeholder').html('');
                    }
                    if(mail.trim().length == 0){
                        // $('#P80_CONTACT_PERSON_SALUTATION_error_placeholder').html('');
                        $('#P80_PERSON_MAIL_error_placeholder').html('<span class="t-Form-error">Please fill out this field.</span>');
                    }
                    else
                    {
                        $('#P80_PERSON_MAIL_error_placeholder').html('');
                    }
                    
                    if(quote.trim().length == 0){
                        $('#P80_QUOTE_TYPE_ID_error_placeholder').html('<span class="t-Form-error">Please fill out this field.</span>');
                    }
                    else
                    {
                        $('#P80_QUOTE_TYPE_ID_error_placeholder').html('');
                    }
                    
                    if(salutation.trim().length >0 && mail.trim().length > 0 && quote.trim().length > 0){
                        apex.submit( 'SEND_MAIL');
                    }
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


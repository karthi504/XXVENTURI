                type: sqlQuery
                sqlQuery: "Select CONTACT_NAME As d,id AS  r from EBA_SALES_CUSTOMER_CONTACTS "
            }
            layout {
                sequence: 8
            }
        )

        column CUSTOMER_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column EDIT (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            link {
                target: {
                    page: 136
                    items: {
                        P136_APPOINTMENT_ID: #APPOINTMENT_ID#
                    }
                    clearCache: 136
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
        )

        column LEAD_ID (
            reportColumnQueryId: 3

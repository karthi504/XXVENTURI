page 32 (
    name: Location Details
    title: Location Details
    pageGroup: @accounts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript">
            <!--
            
             htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            //-->
            </script>
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region location (
        name: Location
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P32_CUSTOMER_ADDRESS1 (
        type: textField
        label {
            label: Address 1
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @location
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 87
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_ADDRESS1
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_ADDRESS2 (
        type: textField
        label {
            label: Address 2
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @location
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 87
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_ADDRESS2
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_CITY (
        type: selectList
        label {
            label: City
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select CITY_NAME as d,CITY_ID as r from XXEBA_SALES_CITIES_T where 
                STATE_ID=:P32_CUSTOMER_STATE_ID
                ```
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P32_CUSTOMER_STATE_ID
            itemsToSubmit: P32_CUSTOMER_STATE_ID
        }
        layout {
            sequence: 80
            region: @location
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: mnw180
        }
        source {
            type: databaseColumn
            databaseColumn: CITY_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_COUNTRY_ID (
        type: selectList
        label {
            label: Country
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select COUNTRY_NAME d, id as r from  EBA_SALES_COUNTRIES
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 60
            region: @location
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: mnw180
        }
        source {
            type: databaseColumn
            databaseColumn: COUNTRY_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        settings {
            resizable: false
            trimSpaces: none
        }
        layout {
            sequence: 100
            region: @location
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 75
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_DESCRIPTION
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @location
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_LOCATION_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @location
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 87
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_LOCATION_NAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_POSTAL_CODE (
        type: textField
        label {
            label: Postal Code
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @location
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 28
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_POSTAL_CODE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_STATE_ID (
        type: selectList
        label {
            label: State
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select STATE as d,id as r from EBA_SALES_STATES where COUNTRY_ID =:P32_CUSTOMER_COUNTRY_ID
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P32_CUSTOMER_COUNTRY_ID
            itemsToSubmit: P32_CUSTOMER_COUNTRY_ID
        }
        layout {
            sequence: 70
            region: @location
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: mnw190
        }
        source {
            type: databaseColumn
            databaseColumn: STATE_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_CUSTOMER_TERRITORY_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @location
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_TERRITORY_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @location
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create Location
        layout {
            sequence: 30
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P32_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 40
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 758850051916757457
        }
    )

    process fetch-row-from-eba-sales-customer-locations (
        name: Fetch Row from eba_sales_CUSTOMER_LOCATIONS
        type: autoRowFetch
        source {
            tableName: EBA_SALES_CUSTOMER_LOCATIONS
            pkColumn: ID
            pkItem: P32_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 4693201841323029382
        }
    )

    process process-row-of-eba-sales-customer-locations (
        name: Process Row of eba_sales_CUSTOMER_LOCATIONS
        type: autoRowProcessing
        target {
            tableName: EBA_SALES_CUSTOMER_LOCATIONS
            pkColumn: ID
            pkItem: P32_ID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table eba_sales_CUSTOMER_LOCATIONS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 4693202031649029385
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 30
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 4693202230041029386
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)


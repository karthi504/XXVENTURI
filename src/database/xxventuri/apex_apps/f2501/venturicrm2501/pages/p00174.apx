page 174 (
    name: Sales Person Target Report
    title: Sales Person Target Report
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "TARGET_ID", 
                "SALES_REP_ID",
                "TARGET_PERIOD",
                "TARGET_AMOUNT",Currency_Type
                from "#OWNER#"."XXEBA_SALES_PERSON_TARGET" 
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 179
                items: {
                    P179_TARGET_ID: #TARGET_ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 69339879218034794
        }

        column CURRENCY_TYPE (
            type: plainText
            heading {
                heading: "Currency "
            }
            layout {
                sequence: 32
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column SALES_REP_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Sales Reps
            }
            lov {
                lov: @xx-sales-rep-lov
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column TARGET_AMOUNT (
            type: plainText
            heading {
                heading: Target Amount
                alignment: center
            }
            layout {
                sequence: 22
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column TARGET_ID (
            type: hidden
            heading {
                heading: Target Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TARGET_PERIOD (
            type: plainTextBasedOnLov
            heading {
                heading: Target Period
            }
            lov {
                lov: @xx-target-periods
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 693439 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CURRENCY_TYPE (
                sequence: 4
            )

            displayColumn SALES_REP_ID (
                sequence: 1
            )

            displayColumn TARGET_AMOUNT (
                sequence: 3
            )

            displayColumn TARGET_PERIOD (
                sequence: 2
            )

        )

    )

    region sales-person-target-report (
        name: Sales Person Target Report
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1220
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Set Target
        layout {
            sequence: 30
            region: @sales-person-target-report
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 179
                clearCache: 179
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)


    button create-product-family (
        buttonName: CREATE_PRODUCT_FAMILY
        label: Create Product Group
        layout {
            sequence: 10
            region: @product-groups-3
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 34
                clearCache: 34
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @product-groups-3
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: [
                    &APP_PAGE_ID.
                    RIR
                ]
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-ig-on-create (
        name: Refresh IG on Create
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create-product-family
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @product-groups-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


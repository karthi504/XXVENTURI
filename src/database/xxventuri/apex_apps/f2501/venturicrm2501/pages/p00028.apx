    region product-groups-3 (
        name: Product Groups
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    id,
                    (
                        SELECT 
                            LISTAGG(rep_first_name || ' ' || rep_last_name, ',') 
                            WITHIN GROUP (ORDER BY rep_first_name)
                        FROM 
                            eba_sales_salesreps 
                        WHERE 
                            INSTR(':' || ds.sales_team || ':', ':' || id || ':') > 0
                    ) AS sales_team,
                    group_code,
                    product_family,
                    manager_id,
                    manager_limit,
                    margin_percentage,
                    description,
                    product_sku,
                    created,
                    created_by,
                    updated,
                    updated_by
                FROM 
                    eba_sales_product_families ds
                WHERE 
                    status = 'Y';
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1652146929935228019
        }


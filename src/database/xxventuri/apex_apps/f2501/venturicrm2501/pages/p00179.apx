page 179 (
    name: Sales Person Wise Target
    title: Sales Person Wise Target
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 650
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sales-person-target-details (
        name: " Sales Person Target details"
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P179_CURRENCY_TYPE (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: Select CURRENCY_CODE As d, CURRENCY_CODE  AS r from EBA_SALES_CURRENCIES
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @sales-person-target-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: CURRENCY_TYPE
            used: always
        }
        default {
            type: static
            staticValue: INR
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P179_SALES_REP_ID (
        type: selectList
        label {
            label: Sales Reps
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select REP_FIRST_NAME ||' '|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: "- Select - "
        }
        layout {
            sequence: 20
            region: @sales-person-target-details
            slot: regionBody
            alignment: left
            labelColumnSpan: 4
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: mnw180
        }
        source {
            type: databaseColumn
            databaseColumn: SALES_REP_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P179_TARGET_AMOUNT (
        type: numberField
        label {
            label: Target Amount
            alignment: left
        }
        settings {
            minValue: 0
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @sales-person-target-details
            slot: regionBody
            alignment: left
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 10
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: TARGET_AMOUNT
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P179_TARGET_ID (
        type: hidden
        layout {
            sequence: 10
            region: @sales-person-target-details
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: TARGET_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P179_TARGET_PERIOD (
        type: selectList
        label {
            label: Target Period
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select PERIOD_NAME as d,ID as r from EBA_SALES_SALES_PERIODS order by first_day
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @sales-person-target-details
            slot: regionBody
            alignment: left
            labelColumnSpan: 4
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: mnw180
        }
        source {
            type: databaseColumn
            databaseColumn: TARGET_PERIOD
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P179_TARGET_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P179_TARGET_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P179_TARGET_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 70748408426906827
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-xxeba-sales-person-target (
        name: Fetch Row from XXEBA_SALES_PERSON_TARGET
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_PERSON_TARGET
            pkColumn: TARGET_ID
            pkItem: P179_TARGET_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 70747144275906826
        }
    )

    process process-row-of-xxeba-sales-person-target (
        name: Process Row of XXEBA_SALES_PERSON_TARGET
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_PERSON_TARGET
            pkColumn: TARGET_ID
            pkItem: P179_TARGET_ID
            returnKeyIntoItem: P179_TARGET_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 70747556814906827
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 70748011629906827
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)


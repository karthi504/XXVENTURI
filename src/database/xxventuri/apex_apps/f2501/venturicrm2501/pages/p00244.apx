page 244 (
    name: File Upload
    title: File Upload
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region file-upload (
        name: File Upload
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P244_FILE_ATTACH (
        type: fileUpload
        label {
            label: File Attach
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            mimeTypeColumn: FILE_MIMETYPE
            filenameColumn: FILE_NAME
            charSetColumn: FILE_CHARSET
            bobLastUpdatedColumn: FILE_LAST_UPDATE
        }
        layout {
            sequence: 30
            region: @file-upload
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: FILE_ATTACH
            used: always
        }
    )

    pageItem P244_FILE_CHARSET (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @file-upload
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: FILE_CHARSET
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P244_FILE_LAST_UPDATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @file-upload
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: FILE_LAST_UPDATE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P244_FILE_MIMETYPE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @file-upload
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: FILE_MIMETYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P244_FILE_NAME (
        type: hidden
        layout {
            sequence: 40
            region: @file-upload
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: FILE_NAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P244_ID (
        type: numberField
        label {
            label: ID
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @file-upload
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P244_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 748736382267456711
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-sharepoint-test (
        name: Fetch Row from SHAREPOINT_TEST
        type: autoRowFetch
        source {
            tableName: SHAREPOINT_TEST
            pkColumn: ID
            pkItem: P244_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 748735226231456710
        }
    )

    process process-row-of-sharepoint-test (
        name: Process Row of SHAREPOINT_TEST
        type: autoRowProcessing
        target {
            tableName: SHAREPOINT_TEST
            pkColumn: ID
            pkItem: P244_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 748735610827456711
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 748735967698456711
        }
    )

)


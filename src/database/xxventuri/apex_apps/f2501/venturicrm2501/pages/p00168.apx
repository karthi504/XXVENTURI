page 168 (
    name: Bank Details
    title: Bank Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-xxeba-sales-cust-banks (
        name: Form on XXEBA_SALES_CUST_BANKS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P168_ACCOUNT_NUMBER (
        type: numberField
        label {
            label: Account Number
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @form-on-xxeba-sales-cust-banks
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 43
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ACCOUNT_NUMBER
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P168_ACCOUNT_TYPE (
        type: textField
        label {
            label: Account Type
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @form-on-xxeba-sales-cust-banks
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 43
        }
        validation {
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: ACCOUNT_TYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P168_BANK_NAME (
        type: selectList
        label {
            label: Bank Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select BANK_NAME as d,BANK_ID as r from XXEBA_SALES_BANKS_List
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form-on-xxeba-sales-cust-banks
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: mnw200
        }
        source {
            type: databaseColumn
            databaseColumn: BANK_NAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P168_BRANCH_LOCATION (
        type: textarea
        label {
            label: Branch Location
            alignment: left
        }
        layout {
            sequence: 70
            region: @form-on-xxeba-sales-cust-banks
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 37
            height: 3
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: BRANCH_LOCATION
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P168_CUSTOMER_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @form-on-xxeba-sales-cust-banks
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: CUSTOMER_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P168_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-xxeba-sales-cust-banks
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P168_IFSC_CODE (
        type: textField
        label {
            label: IFSC Code
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @form-on-xxeba-sales-cust-banks
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 43
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: IFSC_CODE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P168_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @form-on-xxeba-sales-cust-banks
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: STATUS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P168_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P168_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P168_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 70782764074843696
        }
        serverSideCondition {
            type: never
        }
    )

    process fetch-row-from-xxeba-sales-cust-banks (
        name: Fetch Row from XXEBA_SALES_CUST_BANKS
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_CUST_BANKS
            pkColumn: ID
            pkItem: P168_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 70781557060843695
        }
    )

    process process-row-of-xxeba-sales-cust-banks (
        name: Process Row of XXEBA_SALES_CUST_BANKS
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_CUST_BANKS
            pkColumn: ID
            pkItem: P168_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 70781879933843696
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 70782333240843696
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Goto 94
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 94
                action: resetPagination
            }
        }
    )

)


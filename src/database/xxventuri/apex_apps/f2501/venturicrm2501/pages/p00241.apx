page 241 (
    name: Efficiency Details
    title: Efficiency Details
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region add-edit-efficiency-details (
        name: Add/Edit Efficiency Details
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DETAILS_ID,              
                	EFFICIENCY_ID,       
                	COMPONENT_NAME,      
                    COMPONENT_SCORE,     
                	DATA_SOURCE,
                	STATUS,
                	CREATED_BY ,         
                	CREATION_DATE ,       
                	UPDATED_BY,          
                	UPDATE_DATE,DISPLAY_SEQUENCE from   XXEBA_SALES_EFFI_DETAILS_T   
                    where EFFICIENCY_ID=:P241_EFFICIENCY_ID
                    AND STATUS = 'Y'
                    
                  
                ```
            pageItemsToSubmit: P241_EFFICIENCY_ID
        }
        layout {
            sequence: 1240
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: IGFORM
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 101866528428052927
        }

        savedReport 153764 (

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 50
            region: @details
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 239
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button edit (
        buttonName: EDIT
        label: Edit Details
        layout {
            sequence: 60
            region: @details
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 70
            region: @details
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation max-score-validations (
        name: Max Score validations
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @add-edit-efficiency-details
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF to_number(:COMPONENT_SCORE) > to_number(:P241_MAX_SCORE) THEN
                        RETURN 'Total score exceeds max score.';
                    END IF;
                END;
                ```
        }
        error {
            associatedColumn: COMPONENT_SCORE
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process ig-flag-change-e (
        name: IG_FLAG_CHANGE_E
        type: executeCode
        source {
            plsqlCode: :P241_IG_FLAG:='E';
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 106106585475342749
        }
        serverSideCondition {
            whenButtonPressed: @edit
        }
    )

    process new-save-grid-data (
        name: New - Save Grid Data
        type: executeCode
        editableRegion: @add-edit-efficiency-details
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  IF :APEX$ROW_STATUS = 'C' THEN
                    INSERT
                    INTO XXEBA_SALES_EFFI_DETAILS_T
                      (
                        EFFICIENCY_ID,
                        COMPONENT_NAME,
                        COMPONENT_SCORE,
                        DATA_SOURCE,
                        STATUS,
                        DISPLAY_SEQUENCE
                      )
                      VALUES
                      (
                        :P241_EFFICIENCY_ID,
                        :COMPONENT_NAME,
                        :COMPONENT_SCORE,
                        :DATA_SOURCE,
                        :STATUS,
                        :DISPLAY_SEQUENCE
                      )
                    RETURNING DETAILS_ID
                    INTO :DETAILS_ID;
                    :P241_IG_FLAG:='L';
                    
                  ELSIF :APEX$ROW_STATUS = 'U' THEN
                    UPDATE XXEBA_SALES_EFFI_DETAILS_T
                    SET EFFICIENCY_ID=:P241_EFFICIENCY_ID,
                      COMPONENT_NAME =:COMPONENT_NAME,
                      COMPONENT_SCORE=:COMPONENT_SCORE,
                      DATA_SOURCE    =:DATA_SOURCE,
                      STATUS =:STATUS,
                      DISPLAY_SEQUENCE=:DISPLAY_SEQUENCE
                    WHERE DETAILS_ID = :DETAILS_ID ;
                    :P241_IG_FLAG:='L';
                    ELSIF :APEX$ROW_STATUS  = 'D' THEN
                    DELETE FROM XXEBA_SALES_EFFI_DETAILS_T WHERE DETAILS_ID = :DETAILS_ID ; 
                  END IF;
                  /* SELECT
                  SUM(COMPONENT_SCORE) into :P241_EFFI_TOTAL
                  FROM XXEBA_SALES_EFFI_DETAILS_T
                  WHERE EFFICIENCY_ID=:P241_EFFICIENCY_ID AND STATUS = 'Y';*/
                EXCEPTION
                WHEN OTHERS THEN
                  xxfs_pm_error_log_pkg.record_log('ERROR','Save Sales-Efficiency IG',NULL,:APP_PAGE_ID);
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 103277431503924985
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process update-efficiency-master (
        name: Update Efficiency Master
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Update XXEBA_SALES_EFFICIENCY_T 
                    SET ITEM_NAME =:P241_ITEM_NAME,
                        STATUS = :P241_STATUS
                  where EFFICIENCY_ID=:P241_EFFICIENCY_ID;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 106106659029342750
        }
    )

    branch (
        name: Go To 239
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 239
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)


page 3 (
    name: Account Details
    title: Account Details
    pageGroup: @accounts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            $(document).ready(function() {
                $("#P3_GSTNO").keypress(function(event) { 
                    var charCode = event.which || event.keyCode;
                    var currentVal = $(this).val();
                    var currentLength = currentVal.length;
            
                    // Check if the current length is less than 15
                    if (currentLength >= 15) {
                        event.preventDefault();
                        return;
                    }
            
                    // Validate each position based on the specified format
                    if (currentLength < 2) {
                        // First 2 characters must be numbers
                        if (!(charCode >= 48 && charCode <= 57)) {
                            event.preventDefault();
                        }
                    } else if (currentLength < 7) {
                        // Next 5 characters must be alphabets
                        if (!((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
                        }
                    } else if (currentLength < 11) {
                        // Next 4 characters must be numbers
                        if (!(charCode >= 48 && charCode <= 57)) {
                            event.preventDefault();
                        }
                    } else if (currentLength == 11) {
                        // Next character must be an alphabet
                        if (!((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
                        }
                    } else if (currentLength == 12) {
                        // Next character must be a number
                        if (!(charCode >= 48 && charCode <= 57)) {
                            event.preventDefault();
                        }
                    } else if (currentLength == 13) {
                        // Next character must be an alphabet
                        if (!((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
                        }
                    } else if (currentLength == 14) {
                        // Next character can be alphanumeric
                        if (!((charCode >= 48 && charCode <= 57) || 
                              (charCode >= 65 && charCode <= 90) || 
                              (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
                        }
                    }
                });
            
                // Prevent pasting if you also want to restrict pasting more than 15 characters or non-alphanumeric characters
                $("#P3_GSTNO").on('paste', function(event) {
                    var pasteData = (event.originalEvent || event).clipboardData.getData('text');
                    
                    if (pasteData.length > 15 || !/^[a-zA-Z0-9]*$/.test(pasteData)) {
                        event.preventDefault();
                        return;
                    }
            
                    // Additional check for the specific format
                    if (!/^[0-9]{2}[a-zA-Z]{5}[0-9]{4}[a-zA-Z][0-9][a-zA-Z][a-zA-Z0-9]$/.test(pasteData)) {
                        event.preventDefault();
                    }
                });
            });
            
            
            
            
            
            $(document).ready(function() {
                $("#P3_PAN_NUMBER").keypress(function(event) {
                    var charCode = event.which || event.keyCode;
            		var currentVal = $(this).val();
            		var currentLength = currentVal.length;
                    
                    // Check if the current length is less than 10
                    if ($(this).val().length >= 10) {
                        event.preventDefault();
                        return;
                    }
            		
            		if (currentLength <5)
            		{
            		 if (!((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122))) {
                            event.preventDefault();
            		}
            		}
            		else if (currentLength <9) 
            		{
            		 if (!(charCode >= 48 && charCode <= 57)) {
                            event.preventDefault();
                        }
            		}
            		
                    
                   else if (currentLength ==9) {
            	   if (!((charCode >= 65 && charCode <= 90) || // Uppercase A-Z
                          (charCode >= 97 && charCode <= 122)  // Lowercase a-z
            		
                          )) {
                        event.preventDefault();
                    }
            		}
                });
            
                // Optional: Prevent pasting if you also want to restrict pasting more than 10 characters
                $("#P3_PAN_NUMBER").on('paste', function(event) {
                    var pasteData = (event.originalEvent || event).clipboardData.getData('text');
                    
                    if (pasteData.length > 10 || !/^[a-zA-Z0-9]*$/.test(pasteData)) {
                        event.preventDefault();
                    }
                });
            });
            
            
            
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript">
            <!--
            
             htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            //-->
            </script>
            
            <script>
            function isNumberKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 31 && (charCode < 48 || charCode > 57))
                        return false;
            
                     return true;
                  }
            </script>
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region account (
        name: Account
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region classification (
        name: Classification
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-collapsed
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region need-more-information (
        name: Need More Information
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size480x320
            ]
        }
        advanced {
            htmlDomId: COMMENTS
            regionDisplaySelector: true
        }
    )

    pageItem P3_ANNUAL_PUR_POTENTIAL_AMT (
        type: displayOnly
        label {
            label: Annual Purchase Potential (Rs.)
            alignment: left
        }
        layout {
            sequence: 190
            region: @account
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT ANNUAL_PUR_POTENTIAL_AMT FROM XXEBA_SALES_ACC_PRODUCTS
                WHERE CUSTOMER_ID = :P3_ID;
                ```
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
            restrictedChars: webSafe
        }
    )


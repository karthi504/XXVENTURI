    validation account-deletion (
        name: Account Deletion
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Declare 
                lv_lead Number;
                lv_opp Number;
                lv_sales_order Number;
                lv_lead_msg varchar2(200);
                lv_opp_msg varchar2(200);
                lv_sales_order_msg varchar2(200);
                begin
                SELECT Count(*) into lv_lead from EBA_SALES_LEADS WHERE ACCOUNT_ID=:P3_ID ;
                SELECT Count(*) into lv_opp  from EBA_SALES_DEALS WHERE CUSTOMER_ID =:P3_ID ;
                SELECT Count(*) into lv_sales_order from  XXEBA_SALES_ORDER WHERE CUSTOMER_ID =:P3_ID;
                lv_lead_msg:= 'Sorry! Cannot delete this Account.'||' '||'Leads'||'['||lv_lead||']'||' '||'available for this Account.';
                lv_opp_msg := 'Sorry! Cannot delete this Account.'||' '||'Opportunities'||'['||lv_opp||']'||' '||'available for this Account.';
                lv_sales_order_msg :='Sorry! Cannot delete this Account.' ||' '||'Sales Orders'||'['||lv_sales_order||']'||' '||'available for this Account.';
                 if lv_lead > 0  then
                	 return lv_lead_msg;
                  elsif lv_opp > 0  then
                       return lv_opp_msg;
                    elsif lv_sales_order > 0  then
                       return lv_sales_order_msg;
                      end if;
                 end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    validation cell-number-validations (
        name: Cell Number validations
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                   if length(:P3_MOBILE_NUMBER) < 10  THEN
                        return 'Cell Number should contain  atleast 10 digit.';
                     end if;
                END;
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation gst-duplicate-validation (
        name: GST Duplicate Validation
        execution {
            sequence: 100
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_no_of_records NUMBER;
                BEGIN
                  SELECT COUNT(*)
                  INTO v_no_of_records
                  FROM EBA_SALES_customers
                  WHERE upper(trim(GST_NO)) = upper(trim(:P3_GSTNO))
                  AND (:P3_ID IS NULL OR id <> :P3_ID); -- exclude current record
                
                  
                  IF v_no_of_records  > 0 THEN
                    RETURN 'Sorry! This GST No. is already exists';
                  END IF;
                  
                END;
                ```
        }
    )


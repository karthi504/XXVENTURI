    process update-sales-rep-when-change-new-sales-rep (
        name: Update Sales Rep when change new sales rep
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    cursor crep is select default_rep_id from EBA_SALES_CUSTOMERS where id = :P3_ID;
                    rrep crep%rowtype;
                BEGIN
                
                open crep;
                fetch crep into rrep;
                close crep;
                
                IF rrep.default_rep_id != :P3_DEFAULT_REP_ID THEN
                    update EBA_SALES_DEALS  set SALESREP_ID_01 = :P3_DEFAULT_REP_ID
                     where id in  (select id from EBA_SALES_DEALS  where customer_id = :P3_ID)
                    and DEAL_PROBABILITY > 0 and DEAL_PROBABILITY < 100;
                    
                    update XXEBA_SALES_ORDER  set sales_rep = :P3_DEFAULT_REP_ID
                    where order_id in (select ORDER_ID from XXEBA_SALES_ORDER where customer_id = :P3_ID)
                    and nvl(UPDATED_IN_TALLY,'N') = 'N';
                
                END IF;
                 
                END;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 188707310264923554
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,Need_MORE_INFO
        }
    )


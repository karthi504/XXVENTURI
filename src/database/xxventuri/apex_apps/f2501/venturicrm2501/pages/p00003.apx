    pageItem P3_DEFAULT_REP_ID (
        type: plugin/select2
        label {
            label: Default Rep
            alignment: left
        }
        settings {
            width: 93.5%
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select REP_FIRST_NAME ||' '|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS where STATUS='Y'
                order by 1
                ```
            nullDisplayValue: - Select Rep -
        }
        layout {
            sequence: 150
            region: @account
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: DEFAULT_REP_ID
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Declare 
                lv_number  number;
                Begin
                lv_number :=:user_id;
                return lv_number;
                END;
                ```
        }
        security {
            encryptSessionState: false
            restrictedChars: webSafe
        }
    )


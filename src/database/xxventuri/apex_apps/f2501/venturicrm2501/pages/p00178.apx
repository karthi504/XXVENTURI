    region tally-stock (
        name: Tally Stock
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT UPPER(p.product_name) ,
                s.product_code,
                s.qty_in_stock,
                s.stock_in_uom,
                s.updated_date,
                s.batch_sequence
                FROM
                    xxeba_tally_stock_t  s,
                    eba_sales_products   p
                WHERE
                    s.product_code = p.ROW_KEY(+)
                   AND S.BATCH_SEQUENCE = (select MAX(s2.BATCH_SEQUENCE) from XXEBA_TALLY_STOCK_T s2)
                order by updated_date desc
                ```
        }
        layout {
            sequence: 40
            parentRegion: @tab-container
            slot: tabs
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 761861592225460203
        }


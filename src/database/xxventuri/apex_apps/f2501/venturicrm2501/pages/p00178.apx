page 178 (
    name: Price List
    title: Price List
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region price-list (
        name: Price List
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1220
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region standard (
        name: Standard
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DISTINCT UPPER(p.product_name) as product_code,
                p.id,
                  p.brand_id,
                  p.PRODUCT_PRICE,p.CURRENCY_TYPE,p.UNIT_OF_MEASURE,p.PRODUCT_COST,p.PRODUCT_CURRENCY_TYPE,
                  p.LEAD_TIME,
                  p.MINIMUM_ORDER_QUANTITY,
                  p.row_key, 
                  p.product_sku,
                  p.product_family_id,
                  p.CATALOGUE_NO,
                  p.product_description,
                  p.location,
                  (select sum(S.QTY_IN_STOCK) from XXEBA_TALLY_STOCK_T S where S.PRODUCT_CODE= P.ROW_KEY and 
                S.BATCH_SEQUENCE = (select MAX(BATCH_SEQUENCE)from XXEBA_TALLY_STOCK_T )) STOCK,
                  (select MAX(UPDATED_DATE) from XXEBA_TALLY_STOCK_T S where S.PRODUCT_CODE= P.ROW_KEY and 
                S.BATCH_SEQUENCE = (select MAX(BATCH_SEQUENCE)from XXEBA_TALLY_STOCK_T )) STOCK_LAST_UPDATED,
                  p.created,
                  p.created_by,
                  p.updated,
                  p.updated_by
                from eba_sales_products p
                where p.status = 'Y'
                -- where p.brand_id IN (1000,1001,1005,1028,1032,1033)
                and p.BRAND_ID NOT IN (1008,1027,1011,1006,1010,1012,1014,1031,1015,1023,1016)
                ORDER BY UPDATED DESC
                
                
                /*where p.STATUS='Y'
                AND p.id=p.id+0   -- P.CATALOGUE_NO
                */
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 149146466976558981
        }


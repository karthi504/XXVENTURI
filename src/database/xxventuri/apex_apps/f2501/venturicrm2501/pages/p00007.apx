    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation user-deletion-validation (
        name: User deletion validation
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Declare
                lv_count number;
                Begin 
                select count(*) into lv_count from EBA_SALES_CUSTOMERS 
                    where DEFAULT_REP_ID=:P7_ID
                      and status != 'X';
                IF lv_count > 0 THEN
                   return 'Sorry! User is mapped with multiple Accounts.';
                    end if;
                END;
                ```
        }
        error {
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )


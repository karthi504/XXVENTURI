page 7 (
    name: &REP_TITLE. Details
    title: &REP_TITLE. Details
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        height: 500
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            $('#weekly_box .days').click(function (){
                if ( $(this).hasClass("week_selected") ){
                    $('#P7_WORKING_DAYS').val($('#P7_WORKING_DAYS').val().replace($(this).attr('id')+',', ""));
                    $(this).removeClass('week_selected');
            }
            else{
                $('#P7_WORKING_DAYS').val($('#P7_WORKING_DAYS').val()+$(this).attr('id')+',');
               $(this).addClass('week_selected');
            } 
            });
            ```
        executeWhenPageLoads:
            ```javascript-browser
            if ($v('P7_ID') == ''){
                $('#P7_WORKING_DAYS').val('MON,TUE,WED,THU,FRI,');
            }
            
            var weeks = $v('P7_WORKING_DAYS').split(",");
            
            for(var i=0; i<weeks.length; i++){
                //alert(weeks[i]);
                 $('#'+weeks[i]).addClass('week_selected');
            }
            ```
    }
    css {
        inline:
            ```css
            .days {
                float: left;
                margin: 3px;
                width: 24px;
                text-align: center;
                border: 1px solid;
                border-radius: 50%;
                cursor: pointer;
            }
            
            #weekly_box{
                margin-top: -6px;
                margin-left: -10px;
            }
            
            .week_selected{
                background: #0585e0;
                color: #fff;
                font-weight: bold;
            }
            
             a {
                padding-top: 3px !important;
            }
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript">
            <!--
            
             htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            //-->
            </script>
            
            <script>
            function isCharKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 33 && (charCode < 65 || charCode > 91)&& (charCode < 97 || charCode > 122))
                        return false;
            
                     return true;
                  }
            function isNumberKey(evt)
                  {
                     var charCode = (evt.which) ? evt.which : event.keyCode
                     if (charCode > 31 && (charCode < 48 || charCode > 57))
                        return false;
            
                     return true;
                  }
            </script>
            ```
    }

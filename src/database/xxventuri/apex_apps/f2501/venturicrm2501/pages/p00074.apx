    pageItem P74_TEAM (
        type: displayOnly
        label {
            label: Extended Team
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 90
            region: @create-opportunity
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  t varchar2(32767) := null;
                  l_vc_arr2    APEX_APPLICATION_GLOBAL.VC_ARR2;
                  l_id number;
                begin
                  if :P72_TEAM is not null then
                      l_vc_arr2 := APEX_UTIL.STRING_TO_TABLE(:P72_TEAM);
                          FOR z IN 1..l_vc_arr2.count LOOP
                              l_id := l_vc_arr2(z);
                              for c1 in (select REP_EMAIL, rep_last_name, rep_first_name
                                         from eba_sales_salesreps
                                          where id = l_id) loop
                                  t := t||apex_escape.html(trim(lower(c1.rep_email)))||', ';
                              end loop;
                          END LOOP;
                  end if;
                  return RTRIM(t,', ');
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }

page 74 (
    name: Create Opportunity
    title: Create Opportunity
    pageGroup: @opportunities
    appearance {
        pageMode: modalDialog
        dialogTemplate: @wizard-modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @contribution-rights
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region button-container (
        name: Button container
        type: staticContent
        layout {
            sequence: 10
            slot: wizardButtons
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region create-opportunity (
        name: Create Opportunity
        type: staticContent
        layout {
            sequence: 10
            slot: wizardBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader
                t-Region--hiddenOverflow
            ]
        }
    )

    region create-opportunity-train (
        name: create opportunity train
        type: list
        source {
            list: @create-opportunity-train
        }
        layout {
            sequence: 10
            slot: wizardProgressBar
        }
        componentAppearance {
            listTemplate: @wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P74_ACCOUNT (
        type: displayOnly
        label {
            label: Account
            alignment: left
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: false
        }
        lov {
            type: sharedComponent
            lov: @accounts
        }
        layout {
            sequence: 30
            region: @create-opportunity
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: item
            item: P71_ACCOUNT
            used: always
        }
        serverSideCondition {
            type: item=value
            item: P71_NEW_OR_EXISTING
            value: EXISTING
        }
        security {
            encryptSessionState: false
        }
    )


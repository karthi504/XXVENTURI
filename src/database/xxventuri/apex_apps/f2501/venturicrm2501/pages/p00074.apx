    pageItem P74_PRODUCTS (
        type: displayOnly
        label {
            label: Products
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 110
            region: @create-opportunity
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  t            varchar2(32767) := null;
                  l_vc_arr2    APEX_APPLICATION_GLOBAL.VC_ARR2;
                  l_id         number;
                begin
                  if :P73_PRODUCTS is not null then
                      l_vc_arr2 := APEX_UTIL.STRING_TO_TABLE(:P73_PRODUCTS);
                          FOR z IN 1..l_vc_arr2.count LOOP
                              l_id := l_vc_arr2(z);
                              for c1 in (select PRODUCT_NAME
                                         from eba_sales_products
                                         where id = l_id) loop
                                  t := t||apex_escape.html(c1.PRODUCT_NAME)||', ';
                              end loop;
                          END LOOP;
                  end if;
                  return RTRIM(t,', ');
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )


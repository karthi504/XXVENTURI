page 127 (
    name: Brand Details
    title: Brand Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-xxeba-sales-brands (
        name: Form on XXEBA_SALES_BRANDS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P127_BRAND_ATTACHMENT (
        type: fileUpload
        label {
            label: Catalogue
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            mimeTypeColumn: BRAND_ATT_MIMETYPE
            filenameColumn: BRAND_ATT_FILENAME
            charSetColumn: BRAND_ATT_CHARSET
            bobLastUpdatedColumn: BRAND_ATT_LAST_UPDATE
        }
        layout {
            sequence: 110
            region: @form-on-xxeba-sales-brands
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_ATTACHMENT
            used: always
        }
    )

    pageItem P127_BRAND_CODE (
        type: textField
        label {
            label: Code Number
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @form-on-xxeba-sales-brands
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 25
        }
        validation {
            maxLength: 50
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_CODE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_BRAND_CURRENCY_TYPE (
        type: selectList
        label {
            label: "Currency "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: Select CURRENCY_CODE As d, CURRENCY_DESCRIPTION AS r from EBA_SALES_CURRENCIES
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @form-on-xxeba-sales-brands
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_CURRENCY_TYPE
            used: always
        }
        default {
            type: static
            staticValue: INR
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_BRAND_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-xxeba-sales-brands
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P127_BRAND_NAME (
        type: selectList
        label {
            label: Brand Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select BRAND_NAME as d,BRAND_NAME as r from XXEBA_SALES_PRODUCT_BRANDS
        }
        layout {
            sequence: 40
            region: @form-on-xxeba-sales-brands
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: style="min-width: 180px; "
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_NAME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_BRAND_PRICE (
        type: numberField
        label {
            label: Price
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @form-on-xxeba-sales-brands
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 20
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: BRAND_PRICE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_ENTITY_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @form-on-xxeba-sales-brands
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ENTITY_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_ENTITY_TYPE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @form-on-xxeba-sales-brands
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ENTITY_TYPE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_LEAD_TIME (
        type: numberField
        label {
            label: Lead Time (Days)
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 100
            region: @form-on-xxeba-sales-brands
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 25
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: LEAD_TIME
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_MINIMUM_ORDER_QTY (
        type: numberField
        label {
            label: Minimum Order Quantity
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 90
            region: @form-on-xxeba-sales-brands
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 25
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: MINIMUM_ORDER_QTY
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P127_UNIT_OF_MEASURE (
        type: selectList
        label {
            label: Unit of Measure
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select unit_name  as d,unit_name as r from XXEBA_SALES_Units
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 80
            region: @form-on-xxeba-sales-brands
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            cssClasses: mnw180
        }
        source {
            type: databaseColumn
            databaseColumn: UNIT_OF_MEASURE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P127_BRAND_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P127_BRAND_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: REQUEST
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 67253577094888818
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fetch-row-from-xxeba-sales-brands (
        name: Fetch Row from XXEBA_SALES_BRANDS
        type: autoRowFetch
        source {
            tableName: XXEBA_SALES_BRANDS
            pkColumn: BRAND_ID
            pkItem: P127_BRAND_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 67252427354888817
        }
    )

    process process-row-of-xxeba-sales-brands (
        name: Process Row of XXEBA_SALES_BRANDS
        type: autoRowProcessing
        target {
            tableName: XXEBA_SALES_BRANDS
            pkColumn: BRAND_ID
            pkItem: P127_BRAND_ID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 67252838857888818
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 67253173832888818
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)


        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_to_date date;
                begin
                select sysdate into v_to_date  from dual;
                
                return v_to_date;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button go (
        buttonName: GO
        label: Go
        layout {
            sequence: 50
            region: @engineer-efficiency
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--padTop
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction region-refresh (
        name: Region Refresh
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @go
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @engineer-efficiency
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


                FROM dual
                UNION
                SELECT 'Purchase Order Collection'                                                                                                    AS item,
                  'Annual Order'                                                                                                                      AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_PO_COLLECTION(:P253_SALES_REP,'Annual Order',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual

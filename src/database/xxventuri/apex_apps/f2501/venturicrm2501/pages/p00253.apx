    region engineer-efficiency (
        name: "Engineer Efficiency "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Finding New Customer'                                                                                                               AS item,
                  'Identification'                                                                                                                          AS sub_item,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:P253_SALES_REP,'Identification',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Finding New Customer'                                                                                                            AS item,
                  'First Order'                                                                                                                          AS sub_item,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:P253_SALES_REP,'First Order',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Finding New Customer'                                                                                                             AS item,
                  'Repeat Order'                                                                                                                          AS sub_item,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_FIND_NEW_CUSTOMER(:P253_SALES_REP,'Repeat Order',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Customer Visit'                                                                                                             AS item,
                  '100% Plan'                                                                                                                       AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:P253_SALES_REP,'100% Plan',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Customer Visit'                                                                                                            AS item,
                  '90% Plan'                                                                                                                       AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:P253_SALES_REP,'90% Plan',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Customer Visit'                                                                                                            AS item,
                  '75% Plan'                                                                                                                       AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:P253_SALES_REP,'75% Plan',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Customer Visit'                                                                                                        AS item,
                  '<50% Plan'                                                                                                                  AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_CUSTOMER_VISIT(:P253_SALES_REP,'<50%',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Quotation Submission'                                                                                                          AS item,
                  'Tooling Up'                                                                                                                         AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_QUOTE_SUBMISSION(:P253_SALES_REP,'Tooling Up',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Quotation Submission'                                                                                                       AS item,
                  'Project'                                                                                                                         AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_QUOTE_SUBMISSION(:P253_SALES_REP,'Project',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Negotiation'                                                                                                               AS item,
                  'New Product'                                                                                                                    AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(:P253_SALES_REP,'New Product',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION
                SELECT 'Negotiation'                                                                                                           AS item,
                  'Project'                                                                                                                    AS sub_item ,
                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_NEGOTIATION(:P253_SALES_REP,'Project',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage

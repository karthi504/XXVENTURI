                  XXEBA_SALES_ENGINEER_EFFI_PKG.XXEBA_SALES_MARGIN(:P253_SALES_REP,'>50%',TO_DATE(:P253_FROM_DATE,'DD-MM-YYYY'),TO_DATE(:P253_TO_DATE,'DD-MM-YYYY')) AS weightage
                FROM dual
                UNION

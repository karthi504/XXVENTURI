    validation date-validations (
        name: Date Validations
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF TO_DATE(:P253_TO_DATE,'DD-Mon-YYYY') < TO_DATE(:P253_FROM_DATE,'DD-Mon-YYYY') THEN
                  RETURN 'To Date should be Greater than From Date.';
                ELSE 
                  RETURN null;
                END IF;
                ```
            alwaysExecute: true
        }
        error {
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @go
        }
    )

)


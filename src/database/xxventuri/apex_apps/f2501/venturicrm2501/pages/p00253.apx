    pageItem P253_DEFAULT_DATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @engineer-efficiency
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select Last_Day(ADD_MONTHS(SYSDATE,-1))+1 as DEFAULT_DATE from dual;
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_FROM_DATE (
        type: datePickerJquery
        label {
            label: From
            alignment: left
        }
        settings {
            minDate: &P253_DEFAULT_DATE.
            maxDate: &P253_DEFAULT_DATE.
        }
        layout {
            sequence: 20
            region: @engineer-efficiency
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            formatMask: DD-Mon-YYYY
            width: 10
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_from_date date;
                begin
                select Last_Day(ADD_MONTHS(SYSDATE,-1))+1 into v_from_date  from dual;
                
                return v_from_date;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P253_SALES_REP (
        type: plugin/select2
        label {
            label: Sales Reps
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select REP_FIRST_NAME ||' '|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS where STATUS='Y' and USER_NAME <>'admin'
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @engineer-efficiency
            slot: regionBody
            alignment: left
            labelColumnSpan: 1

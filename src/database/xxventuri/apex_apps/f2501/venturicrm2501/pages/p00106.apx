page 106 (
    name: Contact Details
    title: Contact Details
    pageGroup: @accounts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script language="JavaScript" type="text/javascript">
            <!--
            
             htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            //-->
            </script>
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }
    config {
        buildOption: @contacts
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region contact-details (
        name: Contact Details
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P106_ANNIVERSARY_DAY (
        type: datePickerJquery
        label {
            label: Anniversary Date
            alignment: left
        }
        layout {
            sequence: 80
            region: @contact-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 7
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 15
        }
        source {
            type: databaseColumn
            databaseColumn: ANNIVERSARY_DAY
            used: always
        }
        security {
            encryptSessionState: false
        }
    )


    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create Contact
        layout {
            sequence: 30
            region: @buttons
            slot: belowBox
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P106_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 50
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P106_ID
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 10
            region: @buttons
            slot: belowBox
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P106_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction other-dept (
        name: other_dept
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P106_DEPARTMENT
        }
        clientSideCondition {
            type: item=value
            item: P106_DEPARTMENT
            value: Others
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P106_OTHER_DEPT
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P106_OTHER_DEPT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction p106-show-account (
        name: P106_SHOW_ACCOUNT
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P106_SHOW_ACCOUNT
        }
        clientSideCondition {
            type: item=value
            item: P106_SHOW_ACCOUNT
            value: Y
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P106_CUSTOMER_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P106_CUSTOMER_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P106_CONTACT_NAME
            showSuccessMessages: false
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 758393506509099585
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :REQUEST != 'DELETE'
                  or :P106_DELETE_BRANCH_PAGE_ID is null
                ```
        }
    )

    process delete-process (
        name: Delete Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  UPDATE EBA_SALES_CUSTOMER_CONTACTS SET STATUS ='X' WHERE ID=:P106_ID;
                EXCEPTION
                WHEN OTHERS THEN
                  raise_application_error(-20001,SQLERRM);
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 26668507442805447
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process fetch-row-from-eba-sales-customer-contacts (
        name: Fetch Row from eba_sales_CUSTOMER_CONTACTS
        type: autoRowFetch
        source {
            tableName: EBA_SALES_CUSTOMER_CONTACTS
            pkColumn: ID
            pkItem: P106_ID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 3096558977662740449
        }
    )

    process key-account-process (
        name: Key account Process
        type: executeCode
        source {
            plsqlCode: update EBA_SALES_CUSTOMER_CONTACTS set KEY_CONTACT ='N' where CUSTOMER_ID =:P106_CUSTOMER_ID and ID !=:P106_ID;
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 91186594037983131
        }
        serverSideCondition {
            type: item=value
            item: P106_KEY_CONTACT
            value: Y
        }
    )

    process others-department-process (
        name: "Others Department Process "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                --raise_application_error(-20010,:P106_DEPARTMENT);
                if :P106_DEPARTMENT = 'Others' then
                    Update EBA_SALES_CUSTOMER_CONTACTS SET  DEPARTMENT =:P106_OTHER_DEPT where ID=:P106_ID;
                end if;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 66284614164372213
        }
    )

    process process-row-of-eba-sales-customer-contacts (
        name: Process Row of eba_sales_CUSTOMER_CONTACTS
        type: autoRowProcessing
        target {
            tableName: EBA_SALES_CUSTOMER_CONTACTS
            pkColumn: ID
            pkItem: P106_ID
            returnKeyIntoItem: P106_ID
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Action Processed.
        }
        error {
            errorMessage: Unable to process row of table eba_sales_CUSTOMER_CONTACTS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 3096559191217740451
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 24
        }
        execution {
            sequence: 60
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 3096559404742740451
        }
    )

    branch (
        name: Branch to P106_DELETE_BRANCH_PAGE_ID on delete
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: &P106_DELETE_BRANCH_PAGE_ID.
                action: resetPagination
            }
        }
    )

)


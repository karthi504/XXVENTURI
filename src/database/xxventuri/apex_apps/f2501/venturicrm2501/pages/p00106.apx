    pageItem P106_TAGS (
        type: plugin/tagEntry
        label {
            label: Tags
            alignment: left
        }
        settings {
            validationFailureMessage: Tags may not contain the following characters: : ; \ / ? &
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select tag
                  from eba_sales_tags_type_sum
                 where content_type = 'CONTACT'
                
                ```
        }
        layout {
            sequence: 210
            region: @contact-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 70
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: TAGS
            used: always

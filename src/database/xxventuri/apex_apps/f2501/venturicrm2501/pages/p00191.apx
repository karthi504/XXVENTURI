page 191 (
    name: Complaint Details
    title: Complaint Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    htmlHeader {
        htmlHeader:
            ```html
            <!DOCTYPE html>
            <html>
              
                <body>
                    <script>  function printReport(p_customer_complaint,p_datasource,p_url) 
                     {
                         var v_customer_complaint = document.getElementById(p_customer_complaint).value;
                         var v_datasource = document.getElementById(p_datasource).value;
                         var v_url = document.getElementById(p_url).value;
                               window.open(""+v_url+"report?_repName=customer_complaint&_repFormat=pdf&_dataSource="+v_datasource+"&_outFilename=&_repLocale=en_US&_repEncoding=&p_complaint_id="+v_customer_complaint+""
            );   
                     }
                  </script>
                </body>
            </html>
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-xxeba-customer-complaints-t (
        name: Form on XXEBA_CUSTOMER_COMPLAINTS_T
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P191_ACCOUNT_ID (
        type: plugin/select2
        label {
            label: Account
            alignment: left
        }
        settings {
            width: 90%
            lazyLoading: attributeValue
            lazyAppendRowCount: 10
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.customer_name display_value,c.id return_value  from eba_sales_customers c
                where  c.status='A' 
                and(upper(c.DEFAULT_REP_ID) in (SELECT  upper(r.ID)                                
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME in( 'Administrator','Sales Co-Ordinator')) ---- as per the venturi team confirmation, sales Co-Ordinator role  added by bharath raju on 25-Aug-2023
                    )                 
                order by 1 
                ```
        }
        layout {
            sequence: 50
            region: @form-on-xxeba-customer-complaints-t
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        advanced {
            customAttributes: style="width:60%;"
        }
        source {
            type: databaseColumn
            databaseColumn: ACCOUNT_ID
            used: always
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                select c.customer_name display_value,c.id return_value  from eba_sales_customers c,eba_sales_verifications v
                where c.id=v.CUST_ID and c.status='Y' 
                and(upper(c.DEFAULT_REP_ID) in (SELECT  upper(r.ID)                                
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) 
                     or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME = 'Administrator')
                    )                 
                order by 1 
                ```
        }
    )

    pageItem P191_ASSIGNED_TO (
        type: plugin/select2
        label {
            label: Assigned To
            alignment: left
        }
        settings {
            width: 90%
            lazyLoading: attributeValue
            lazyAppendRowCount: 10
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select REP_FIRST_NAME ||' '|| REP_LAST_NAME  d, id r
                from EBA_SALES_SALESREPS
                where  (upper(ID) in (SELECT upper(r.ID)
                                                         FROM eba_sales_salesreps r
                                                        START WITH r.id = :USER_ID
                                                       CONNECT BY PRIOR r.id= r.REP_MANAGER_ID) or 
                    EXISTS(select 'Y' from EBA_SALES_SALESREPS R, EBA_SALES_SALESREP_ROLES SR where R.id = :USER_ID and SR.ID = R.REP_ROLE and SR.ROLE_NAME in('Administrator','Sales Co-Ordinator')))---- as per the venturi team confirmation, sales Co-Ordinator role  added by bharath raju on 25-Aug-2023
                order by 1
                ```
        }
        layout {
            sequence: 120
            region: @form-on-xxeba-customer-complaints-t
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ASSIGNED_TO
            used: always
        }
        default {
            type: static
            staticValue: &USER_ID.
        }
        security {
            encryptSessionState: false
        }
    )


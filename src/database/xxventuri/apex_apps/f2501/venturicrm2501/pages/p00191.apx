    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 30
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Register
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P191_COMPLAINT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P191_COMPLAINT_ID
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    button print (
        buttonName: PRINT
        label: Print
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P191_COMPLAINT_ID is not null and :P191_STATUS='N'
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction customer-complaint-report (
        name: Customer_Complaint_Report
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        repName           VARCHAR2(100);
                        parameters        VARCHAR2(200);
                        l_url             VARCHAR2(2000);
                        l_encoded_params  VARCHAR2(500);
                    BEGIN
                    
                        -- IF :P216_REPORT_TYPE = 'TRIAL' THEN
                        --     repName := 'trial_report';
                        
                        -- IF :P216_REPORT_TYPE = 'TRIAL' THEN
                        --     repName := 'trial_report';
                        -- ELSE repName := 'trial_report_test';
                        -- END IF;
                    
                    
                    -- IF :P216_PRODUCT_CLASS_ID =3 then
                    
                        repName := 'customer_complaint';
                    
                    -- ELSE    repName := 'trial_report_test';
                    -- END IF;
                    
                    
                    
                        parameters := '&p_complaint_id=' || :P191_COMPLAINT_ID;
                    
                        l_encoded_params := apex_util.url_encode(parameters);
                    
                        l_url := 'https://products.4iapps.com/ords/r/venturitool/venturicrm2501/print-jasper-report?p200_parameters=' ||
                                  l_encoded_params || 
                                  '&p200_report_name=' || repName || 
                                  '&session=' || :APP_SESSION;
                    
                        -- Set to output URL item (used in frontend)
                        :P191_URL := l_url;
                    
                    EXCEPTION
                        WHEN OTHERS THEN
                            xxfs_pm_error_log_pkg.record_log(
                                'ERROR', 
                                'REPORT_PROCESS'||l_url||repName, 
                                'Error generating report URL: ' || SQLERRM
                            );
                    END;
                    ```
                itemsToSubmit: P191_COMPLAINT_ID
                itemsToReturn: P191_URL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    window.open($v('P191_URL'),'_blank');
                    
                    //window.location.href = $v('P216_URL');
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: printReport('P191_COMPLAINT_ID','P191_DATA_SOURCE','P191_URL');
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction product-list (
        name: Product List
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P191_COMPLAINT_TYPE
        }
        clientSideCondition {
            type: item=value
            item: P191_COMPLAINT_TYPE
            value: Products
        }

        action native-hide (
            action: hide
            settings {
                hidePageItemsOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P191_PRODUCT_LIST
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            settings {
                showAllOnSameLine: true
            }
            affectedElements {
                selectionType: items
                items: P191_PRODUCT_LIST
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-product-class (
        name: Set Product Class
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P191_PRODUCT_CLASS
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select product_class_name from xxeba_product_class where id = :P191_PRODUCT_CLASS;
                    
                    ```
                itemsToSubmit: P191_PRODUCT_CLASS
            }
            affectedElements {
                selectionType: items
                items: P191_PRODUCT_CLASS
            }
            execution {
                sequence: 10
            }
        )

    )

    validation not-null-validations (
        name: Not Null Validations
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                    if :P191_COMPLAINT_TYPE = 'Products' then
                      if :P191_PRODUCT_LIST is null then
                        return 'Products list must have some value';
                    end if;
                   end if;
                end;
                ```
        }
        error {
            associatedItem: @P191_PRODUCT_LIST
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 40

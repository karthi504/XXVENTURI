page 242 (
    name: Verification Details
    title: Verification Details
    pageGroup: @accounts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @xxeba-admin-teamlead
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region button-bar (
        name: Button Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region form-items (
        name: form items
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @validation-details
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region introduction-text (
        name: Introduction text
        type: staticContent
        layout {
            sequence: 1
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region validation-details (
        name: Validation Details
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
    )

    pageItem P242_CUSTOMER_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @form-items
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P242_I_VALIDATE (
        type: checkboxGroup
        label {
            label: Check to validate
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:I Verify this info is accurate;VALIDATED
        }
        layout {
            sequence: 30
            region: @form-items
            slot: regionBody
            alignment: left
            labelColumnSpan: 0
        }
        appearance {
            template: @hidden
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P242_VERIFICATION_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @form-items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            width: 60
            height: 5
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select verify_comments from EBA_SALES_CUSTOMERS  where ID=:P242_CUSTOMER_ID
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P242_VERIFIED_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @form-items
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select team_lead_id from EBA_SALES_CUSTOMERS  where ID=:P242_CUSTOMER_ID
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @button-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Verify
        layout {
            sequence: 20
            region: @button-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P242_VERIFIED_BY
        }
    )

    dynamicAction cancel-clicked (
        name: Cancel clicked
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation details-validations (
        name: Details Validations
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                Declare 
                lv_c_count Number;
                lv_m_count Number;
                lv_l_count Number;
                lv_d_count Number;
                lv_a_count Number;
                lv_industry_type VARCHAR2(200);
                begin
                SELECT INDUSTRY_NAME  INTO lv_industry_type FROM eba_sales_industries where ID = (select INDUSTRY_ID from eba_sales_customers where ID=:P242_CUSTOMER_ID) ;
                SELECT Count(*) into lv_c_count FROM EBA_SALES_CUSTOMER_CONTACTS  WHERE CUSTOMER_ID =:P242_CUSTOMER_ID ;
                SELECT Count(*) into lv_m_count from XXEBA_SALES_CUST_MACHINERIES WHERE CUSTOMER_ID =:P242_CUSTOMER_ID ;
                SELECT Count(*) into lv_l_count from EBA_SALES_CUSTOMER_LOCATIONS WHERE CUSTOMER_ID =:P242_CUSTOMER_ID ;
                SELECT Count(*) into lv_d_count from XXEBA_SALES_CUSTOMER_DETAILS WHERE CUSTOMER_ID =:P242_CUSTOMER_ID ;
                SELECT Count(*) into lv_a_count from  XXEBA_SALES_ACC_PRODUCTS    WHERE CUSTOMER_ID =:P242_CUSTOMER_ID;
                    if lv_c_count= 0 then
                        return 'Please fill atleast one Contact for this Account.';
                   
                     ELSIF lv_m_count= 0 AND lv_industry_type <>'Reseller' then
                        return 'Please fill atleast one Machinery detail for this Account.';
                    
                     ELSIF lv_l_count= 0 then
                        return 'Please fill atleast one Location for this Account.';
                 
                      ELSIF lv_d_count= 0 then
                        return 'Please fill Additional Details for this Account.';
                   
                    ELSIF lv_a_count= 0 then
                        return 'Please fill atleast one Product for this Account.';
                    end if;
                 end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation p242-i-validate-is-not-null (
        name: P242_I_VALIDATE is not null
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P242_I_VALIDATE
        }
        error {
            errorMessage: Please check to validate.
        }
    )

    process close-dialog (
        name: close dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 119001713803109204
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process create-verification (
        name: Create verification
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 BEGIN
                  UPDATE EBA_SALES_CUSTOMERS
                  SET verified_on  =sysdate,
                    team_lead_id    =:USER_ID,
                    team_lead_comments=:P242_VERIFICATION_COMMENT,
                    status         ='N'
                  WHERE id         =:P242_CUSTOMER_ID;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Validation saved.
        }
        error {
            errorMessage: Unable to save validation.
        }
        advanced {
            executionMappingIdentifier: 119002070978109205
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process init-page (
        name: Init page
        type: executeCode
        source {
            plsqlCode: :P242_ENTITY_TYPE_LOWER := lower(:P242_ENTITY_TYPE);
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 119002514091109205
        }
    )

    branch (
        name: Go to 94
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 94
                action: resetPagination
            }
        }
    )

)


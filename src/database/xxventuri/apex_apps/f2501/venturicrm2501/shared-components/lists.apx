            imageIconCssClasses: fa-phone
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 106
                items: {
                    P106_CUSTOMER_ID: &P94_ID.
                    P106_SHOW_ACCOUNT: N

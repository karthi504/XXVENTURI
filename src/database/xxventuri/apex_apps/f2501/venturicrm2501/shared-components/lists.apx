            imageIconCssClasses: fa-map-marker
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 32
                items: {
                    P32_CUSTOMER_ID: &P94_ID.
                }
                clearCache: 32
            }
        }
    )

    entry add-products (
        label: Add Products
        icon {
            imageIconCssClasses: fa-cog
        }
        layout {
            sequence: 95
        }
        link {
            target: {
                page: 172
                items: {
                    P172_CUSTOMER_ID: &P94_ID.
                }
                clearCache: 172
            }
        }
    )

    entry additional-details (
        label: Additional Details
        icon {
            imageIconCssClasses: fa-layers
        }
        layout {
            sequence: 80
        }
        link {
            target: {
                page: 164
                items: {
                    P164_CUSTOMER_ID: &P94_ID.
                    P164_FLAG: A
                    P164_DETAILS_ID: &P94_CUSTOMER_DETAILS_ID.
                }
                clearCache: 164
            }
        }
    )

    entry bank-details (
        label: Bank Details
        icon {
            imageIconCssClasses: fa-credit-card
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 168
                items: {
                    P168_CUSTOMER_ID: &P94_ID.
                }
                clearCache: 168
            }
        }
    )

    entry competitor-products (
        label: Competitor Products
        icon {
            imageIconCssClasses: fa-cogs
        }
        layout {
            sequence: 96
        }
        link {
            target: {
                page: 235
                items: {
                    P235_CUSTOMER_ID: &P94_ID.
                }
                clearCache: 235
            }
        }
    )

    entry machineries (
        label: Machineries
        icon {
            imageIconCssClasses: fa-wrench
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 166
                items: {
                    P166_CUSTOMER_ID: &P94_ID.
                    P166_ID: &P94_MACHINERY_ID.
                }
                clearCache: 166
            }
        }
    )

    entry recommendations (
        label: Recommendations
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 90
        }
        link {
            target: {
                page: 164
                items: {
                    P164_CUSTOMER_ID: &P94_ID.
                    P164_FLAG: R
                    P164_DETAILS_ID: &P94_CUSTOMER_DETAILS_ID.
                }
                clearCache: 164
            }
        }
    )

    entry verifications (
        label: Verifications
        icon {
            imageIconCssClasses: fa-tasks
        }
        layout {
            sequence: 130
        }
        link {
            target: {
                page: 229
                items: {
                    P229_CUSTOMER_ID: &P94_ID.
                }
                clearCache: 229
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 'Y' from EBA_SALES_CUSTOMERS where STATUS IN('N') and ID=:P94_ID 
                
                
                ```
        }
        security {
            authorizationScheme: @xxeba-sales-coordinator
        }
    )

    entry verifications-2 (
        label: Verifications
        icon {
            imageIconCssClasses: fa-tasks
        }
        layout {
            sequence: 140
        }
        link {
            target: {
                page: 242
                items: {
                    P242_CUSTOMER_ID: &P94_ID.
                }
                clearCache: 242
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 'Y' from EBA_SALES_CUSTOMERS where STATUS IN('R','U','Y') and ID=:P94_ID 
                
                
                ```
        }
        security {
            authorizationScheme: @xxeba-admin-teamlead
        }
    )

)


            sequence: 55
            parentEntry: @app-username
        }
        link {
            target: {
                type: url
                url: #CUSTOMIZE_URL#
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: '#CUSTOMIZE_URL#' is not null
        }
    )

    entry help (

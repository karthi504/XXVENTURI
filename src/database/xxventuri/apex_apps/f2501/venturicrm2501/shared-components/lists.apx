list additional-administration-options (
    name: Additional Administration Options

    entry application-appearance (
        label: Application Appearance
        icon {
            imageIconCssClasses: fa-desktop
        }
        layout {
            sequence: 450
        }
        link {
            target: {
                page: 141
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Change user interface color scheme for all users.
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    entry application-error-log (
        label: Application Error Log
        icon {
            imageIconCssClasses: fa-file-o
        }
        layout {
            sequence: 435
        }
        link {
            target: {
                page: 175
            }
        }
        userDefinedAttributes {
            1: Report of all internal errors encountered within the application.
            2: reportIcon
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    entry closed-opportunities (
        label: Closed Opportunities
        icon {
            imageIconCssClasses: fa-pencil
        }
        layout {
            sequence: 420
        }
        link {
            target: {
                page: 81
            }
        }
        userDefinedAttributes {
            1: Opportunities that are won or lost (0 or 100% probability) cannot be edited. Set the status to something other then 0 or 100% to reenable edit capabilities.
            2: formIcon
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    entry email-templates (
        label: Email Templates
        icon {
            imageIconCssClasses: fa-envelope
        }
        layout {
            sequence: 460
        }
        link {
            target: {
                page: 518
                clearCache: 518
            }
        }
        userDefinedAttributes {
            1: Maintain email templates.
        }
    )

    entry fiscal-quarters (
        label: Fiscal Quarters
        icon {
            imageIconCssClasses: fa-calendar
        }
        layout {
            sequence: 200
        }
        isCurrent {
            type: pages
            pages: 12
        }
        link {
            target: {
                page: 12
            }
        }
        userDefinedAttributes {
            1: Manage the fiscal quarters used for reporting.  Companies have different quarter start and end dates, click here to manage those dates.
            2: formIcon
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    entry mass-mails (
        label: Mass Mails
        icon {
            imageIconCssClasses: fa-envelope-play
        }
        layout {
            sequence: 470
        }
        link {
            target: {
                page: 520
                clearCache: [
                    520
                    521
                    522
                    523
                ]
            }
        }
        userDefinedAttributes {
            1: To send mass mails to contacts.
        }
    )

    entry rename-application (
        label: Rename Application
        icon {
            imageIconCssClasses: fa-pencil
        }
        layout {
            sequence: 432
        }
        link {
            target: {
                page: 45
            }
        }
        userDefinedAttributes {
            1: Change the application name, displayed on the top left of each page, to one of your choosing.  By default, the application name is "&APP_NAME.".
            2: formIcon
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @xxeba-admin

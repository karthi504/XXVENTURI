list access-control (
    name: Access Control

    entry access-control-list (
        label: Access Control List
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 115
            }
        }
        userDefinedAttributes {
            1: Administrators can define the domain of users and assign each a role.
            2: userIcon
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    entry territory-access-control-list (
        label: Territory Access Control List
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 104
                clearCache: 104
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Manage application users by sales territory. Administrators can see all territories, contributors are limited to the assignments defined on these pages.
            2: formIcon
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

    entry username-format (
        label: Username Format
        icon {
            imageIconCssClasses: fa-at
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 15
                clearCache: 15
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Define the username format for new users in this application.
            2: formIcon
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @xxeba-admin
        }
    )

)

list actions-account (
    name: Actions - Account

    entry add-appointment (
        label: Add Appointment
        icon {
            imageIconCssClasses: fa-calendar
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 136
                items: {
                    P136_CUSTOMER_ID: &P94_ID.
                    P136_SOURCE_PAGE: 94
                }
                clearCache: 136
            }
        }
        serverSideCondition {
            type: never
        }
    )

    entry add-attachment (
        label: Add Attachment
        icon {
            imageIconCssClasses: fa-paperclip
        }
        layout {
            sequence: 100
        }
        link {
            target: {
                page: 99
                items: {
                    P99_ENTITY_TYPE: ACCOUNT
                    P99_ENTITY_ID: &P94_ID.
                }
                clearCache: 99
            }
        }

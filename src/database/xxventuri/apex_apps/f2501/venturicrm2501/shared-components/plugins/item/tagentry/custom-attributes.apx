customAttribute attribute_01 (
    apexlangName: tagFormatting
    attribute: 1
    name: Tag Formatting
    scope: app
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: NONE
    }
    help {
        helpText: Select how the case of the tags should be displayed, and saved.
    }

    entry lowercase (
        sequence: 20
        display: Lowercase
        return: LOWER
    )

    entry none (
        sequence: 10
        display: None
        return: NONE
    )

    entry uppercase (
        sequence: 30
        display: Uppercase
        return: UPPER
    )

)

customAttribute attribute_02 (
    apexlangName: validationFailureMessage
    attribute: 2
    name: Validation Failure Message
    appearance {
        sequence: 20
    }
    builder {
        translatable: true
    }
    default {
        value: Tags may not contain the following characters: : ; \ / ? &
    }
    help {
        helpText: Enter the validation message displayed when invalid characters are entered.
    }
)


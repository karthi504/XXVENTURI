plugin excel2collection (
    name: Excel2Collection
    staticId: COM.4IAPPS.APEX-PLUG-IN
    type: process
    component {
        supports: pageProcesses
    }
    source {
        plsqlCode:
            ```plsql
            function parse_excel
              ( p_process apex_plugin.t_process
              , p_plugin apex_plugin.t_plugin
              )
            return apex_plugin.t_process_exec_result
            is
              e_no_doc exception;
              e_not_format exception;
              t_rv apex_plugin.t_process_exec_result;
              t_time date := sysdate;
              t_what varchar2(100);
              t_file_id number;
              t_document blob;
              t_filename varchar2(32767);
              t_mimetype varchar2(1000);
              t_parse varchar2(32767);
              p_browse_item varchar2(32767);
              p_collection_name varchar2(32767);
              p_sheet_nrs varchar2(32767);
              p_separator varchar2(32767);
              p_enclosed_by varchar2(32767);
              p_encoding varchar2(32767);
            --
            
            cursor get_file_ext
            is 
            	select substr(t_filename, instr(t_filename, '.', -1) + 1) 
            	  from dual;  
              

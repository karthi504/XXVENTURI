customAttribute attribute_01 (
    apexlangName: minimumAspectRatio
    attribute: 1
    name: Minimum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 510
    }
    builder {
        displayWidth: 5
    }
    default {
        value: 1.333
    }
    help {
        helpText:
            ```
            <p>Enter the minimum aspect ratio that charts use to recommend a height. A maximum aspect ratio of 3 means that the chart's width should be no greater than 3 times its height. </p>
            <p>Note: This setting can be overridden by the 'Minimum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_01 (
    apexlangName: labelColumn
    attribute: 1
    name: Label Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText: Select the column from the region SQL Query that holds the labels for the chart.
    }
)

customAttribute attribute_02 (
    apexlangName: maximumAspectRatio
    attribute: 2
    name: Maximum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 520
    }
    builder {
        displayWidth: 5
    }
    default {
        value: 1.5
    }
    help {
        helpText:
            ```
            <p>Enter the maximum aspect ratio that charts use to recommend a height. A maximum aspect ratio of 3 means that the chart's width should be no greater than 3 times its height. </p>
            <p>Note: This setting can be overridden by the 'Maximum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: valueColumn
    attribute: 2
    name: Value Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    supports {
        dataTypes: number
    }
    help {
        helpText: Select the column from the region SQL Query that holds the values for the chart.
    }
)

customAttribute attribute_03 (
    apexlangName: colorsColumn
    attribute: 3
    name: Colors Column
    type: regionSqlQueryColumn
    appearance {
        sequence: 170
    }
    dependingOn {
        attribute: @attribute_15/component
        conditionType: =
        value: SQL
    }
    help {
        helpText:
            ```
            <p>Select the column from the region SQL Query that holds the color codes for the chart. The color can be set using hex values or as the name of the color.</p>
            <p>Note: If no column is entered then the color will automatically be calculated.</p>
            ```
    }
    examples {
        examples:
            ```
            <dl>
              <dt>Hexadecimal (hex) notation</dt><dd><pre>#FF3377</pre>;</dd>
              <dt>HTML colors</dt><dd><pre>blue</pre>.</dd>
            </dl>
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: linkTarget
    attribute: 4
    name: Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 30
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks a chart entry.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_05 (
    apexlangName: pieType
    attribute: 5
    name: Pie Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    default {
        value: STANDARD
    }
    help {
        helpText: Select the type of pie chart that should be displayed.
    }

    entry donut (
        sequence: 20
        display: Donut
        return: DONUT
    )

    entry rectangular (
        sequence: 40
        display: Rectangular
        return: RECT
    )

    entry standard (
        sequence: 10
        display: Standard
        return: STANDARD
    )

    entry tilted (
        sequence: 30
        display: Tilted
        return: TILTED
    )

)

customAttribute attribute_06 (
    apexlangName: width
    attribute: 6
    name: Width
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 70
    }
    builder {
        unit: px
        displayWidth: 5
    }
    help {
        helpText:
            ```
            <p>Enter the width of the pie chart you want to create. For example, setting the width to 100 will create a pie chart that is a maximum of 100 pixels wide and 100 pixels in height.</p>
            <p>Note: If no value is specified, the pie chart will consume all the space of the containing region. </p>
            ```
    }
)

customAttribute attribute_08 (
    apexlangName: displayOptions
    attribute: 8
    name: Display Options
    type: checkboxes
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    default {
        value: LABEL:VALUE
    }
    help {
        helpText: <p>Check which attributes are shown on the pie chart.</p>
    }

    entry label (
        sequence: 30
        display: Label
        return: LABEL
    )

    entry legend (
        sequence: 5
        display: Legend
        return: LEGEND
    )

    entry tooltip (
        sequence: 10
        display: Tooltip
        return: TOOLTIP
    )

    entry value (
        sequence: 40
        display: Value
        return: VALUE
    )

)

customAttribute attribute_09 (
    apexlangName: combineSlices
    attribute: 9
    name: Combine Slices
    type: yesNo
    appearance {
        sequence: 90
    }
    help {
        helpText: Select whether slices that are below a given percentage threshold can be combined into a single "other" slice.  For example, if the threshold is set to 10%, then any slice that is below 10% will be grouped into the "other" slice.
    }
)

customAttribute attribute_10 (
    apexlangName: combinedSliceThreshold
    attribute: 10
    name: Combined Slice Threshold
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 100
    }
    default {
        value: 10
    }
    dependingOn {
        attribute: @attribute_09/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter the threshold percentage which determines which slices to group together in an "other" slice.
    }

    entry 1 (
        sequence: 10
        display: 1%
        return: 1
    )

    entry 10 (
        sequence: 40
        display: 10%
        return: 10
    )

    entry 15 (
        sequence: 50
        display: 15%
        return: 15
    )

    entry 2 (
        sequence: 20
        display: 2%
        return: 2
    )

    entry 20 (
        sequence: 60
        display: 20%
        return: 20
    )

    entry 5 (
        sequence: 30
        display: 5%
        return: 5
    )

)

customAttribute attribute_11 (
    apexlangName: combinedSliceLabel
    attribute: 11
    name: Combined Slice Label
    validation {
        required: true
        maxLength: 20
    }
    appearance {
        sequence: 110
    }
    builder {
        translatable: true
        displayWidth: 20
    }
    default {
        value: Other
    }
    dependingOn {
        attribute: @attribute_09/component
        conditionType: =
        value: Y
    }
    help {
        helpText: Enter the label for the combined slice.
    }
)

customAttribute attribute_12 (
    apexlangName: combinedSliceLinkTarget
    attribute: 12
    name: Combined Slice Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 120
    }
    dependingOn {
        attribute: @attribute_09/component
        conditionType: =
        value: Y
    }
    help {
        helpText:
            ```
            <p>Enter a target page to be called when the user clicks the combined slice. </p>
            <p>Note: Leave the link blank if you do not want to make this clickable. </p>
            ```
    }
)

customAttribute attribute_13 (
    apexlangName: combinedSliceColor
    attribute: 13
    name: Combined Slice Color
    type: color
    appearance {
        sequence: 130
    }
    help {
        helpText:
            ```
            <p>Enter the color which should be used for the combined slice. The color can be entered as hex value or as the name of the color.</p>
            <p>Note: If no color is specified then it will be defaulted to gray.</p>
            ```
    }
    examples {
        examples:
            ```
            <dl>
              <dt>Hexadecimal (hex) notation</dt><dd><pre>#FF3377</pre>;</dd>
              <dt>HTML colors</dt><dd><pre>blue</pre>.</dd>
            </dl>
            ```
    }
)

customAttribute attribute_14 (
    apexlangName: innerRadius
    attribute: 14
    name: Inner Radius
    type: number
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 50
    }
    builder {
        displayWidth: 5
    }
    dependingOn {
        attribute: @attribute_05/component
        conditionType: =
        value: DONUT
    }
    help {
        helpText: Enter the radius of the hole inside the donut. Numbers between 0 and 1 are treated as percentages and numbers greater than 1 are treated as pixels
    }
)

customAttribute attribute_15 (
    apexlangName: colorScheme
    attribute: 15
    name: Color Scheme
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 150
    }
    default {
        value: MODERN
    }
    help {
        helpText: <p>Select the color scheme used to render the chart.</p>
    }

    entry custom (
        sequence: 60
        display: Custom
        return: CUSTOM
    )

    entry metro (
        sequence: 40
        display: Metro
        return: METRO
    )

    entry modern (
        sequence: 10
        display: Modern
        return: MODERN
    )

    entry modern2 (
        sequence: 20
        display: Modern 2
        return: MODERN2
    )

    entry solar (
        sequence: 30
        display: Solar
        return: SOLAR
    )

    entry sqlColumn (
        sequence: 50
        display: SQL Column
        return: SQL
    )

)

customAttribute attribute_16 (
    apexlangName: customColors
    attribute: 16
    name: Custom Colors
    validation {
        required: true
    }
    appearance {
        sequence: 160
    }
    dependingOn {
        attribute: @attribute_15/component
        conditionType: =
        value: CUSTOM
    }
    help {
        helpText: <p>Enter a list of CSS supported colors separated by colons.</p>
    }
)

customAttribute attribute_17 (
    apexlangName: minimumHeight
    attribute: 17
    name: Minimum Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 180
    }
    builder {
        unit: px
        displayWidth: 5
    }
    help {
        helpText: Enter the minimum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

customAttribute attribute_18 (
    apexlangName: maximumHeight
    attribute: 18
    name: Maximum Height
    type: integer
    appearance {
        sequence: 190
    }
    builder {
        displayWidth: 5
    }
    help {
        helpText: Enter the maximum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

customAttribute attribute_19 (
    apexlangName: valueFormatMask
    attribute: 19
    name: Value Format Mask
    appearance {
        sequence: 80
    }
    help {
        helpText: Enter the data format mask for the pie slices.
    }
)


customAttribute attribute_01 (
    apexlangName: allowCollapse
    attribute: 1
    name: Allow Collapse
    type: yesNo
    appearance {
        sequence: 10
    }
)

customAttribute attribute_02 (
    apexlangName: allowHtml
    attribute: 2
    name: Allow HTML
    type: yesNo
    appearance {
        sequence: 20
    }
    default {
        value: true
    }
)

customAttribute attribute_03 (
    apexlangName: nodeClass
    attribute: 3
    name: Node Class
    validation {
        maxLength: 100
    }
    appearance {
        sequence: 30
    }
    builder {
        displayWidth: 30
    }
)

customAttribute attribute_04 (
    apexlangName: size
    attribute: 4
    name: Size
    type: selectList
    appearance {
        sequence: 40
    }
    default {
        value: Medium
    }

    entry large (
        sequence: 30
        display: Large
        return: LArge
        advanced {
            quickPick: true
        }
    )

    entry medium (
        sequence: 20
        display: Medium
        return: Medium
        advanced {
            quickPick: true
        }
    )

    entry small (
        sequence: 10
        display: Small
        return: Small
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_05 (
    apexlangName: selectedNodeClass
    attribute: 5
    name: Selected Node Class
    appearance {
        sequence: 50
    }
)


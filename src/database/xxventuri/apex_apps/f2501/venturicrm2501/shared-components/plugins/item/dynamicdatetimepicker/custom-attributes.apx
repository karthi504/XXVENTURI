customAttribute attribute_12 (
    apexlangName: position
    attribute: 12
    name: Position
    type: selectList
    appearance {
        sequence: 120
    }
    default {
        value: Bottom Left
    }
    help {
        helpText:
            ```
            Position of date picker relative to text input. 
            <p>
             <ul>
             	
             	 <li>First value is name of main axis, and </li>
             	 <li>second value is whether the Date Picker is rendered as 
             	   <ul>
             	   	 	    <li>Left(Leftwards)</li>
             	   	 	    <li>Right(Rightwards)</li>
             	   	 	    <li>Up(Upwards)</li>
             	   	 	    <li>Bottom(Downwards)</li>
             	   	</ul>
             	 </li>
             </ul>
            </p>
            ```
    }
    examples {
        examples: Right Top will set date picker's position from right side upwards of text input.
    }

    entry bottomLeft (
        sequence: 10
        display: Bottom Left
        return: Bottom Left
    )

    entry bottomRight (
        sequence: 20
        display: Bottom Right
        return: Bottom Right
    )

    entry leftBottom (
        sequence: 80
        display: Left Bottom
        return: Left Top
    )

    entry leftTop (
        sequence: 70
        display: Left Top
        return: Left Bottom
    )

    entry rightBottom (
        sequence: 30
        display: Right Bottom
        return: Right Top
    )

    entry rightTop (
        sequence: 40
        display: Right Top
        return: Right Bottom
    )

    entry topLeft (
        sequence: 50
        display: Top Left
        return: Top Left
    )

    entry topRight (
        sequence: 60
        display: Top Right
        return: Top Right
    )

)

customAttribute attribute_13 (
    apexlangName: datepickerTitle
    attribute: 13
    name: DatePicker Title
    type: html
    appearance {
        sequence: 130
    }
    help {
        helpText:
            ```
            Content of datepicker's title depending on current view. 
            <p>There are three views in the Date Picker </p>
            <ul>
            	<li>Days view i.e when selecting days, </li>
            	<li>Months view i.e when selecting months and </li>
            	<li>Years view i.e when selecting years. </li>
            </ul>
            
            *Missing fields will be taken from default values. 
            
            <p>This setting can contain simple text, HTML with Styling and relevant, specific format mask. check out examples</p> 
            <b>*Never Hard Break i.e keyboard return in code.</b>
            ```
    }
    examples {
        examples:
            ```
            For days view: 
            <pre>"days":"<span style='color:red;background-color:yellow;font-size:2em'>Check In:MM, yyyy</span>" </pre>
            
            For months view: 
            
            <pre>"months":"<span style='color:red;background-color:yellow;font-size:2em'>Year:yyyy</span>" </pre>
            
            For years view: 
            
            <pre>"years":"<span style='color:red;background-color:yellow;font-size:2em'>Decade:yyyy1 - yyyy2</span>" </pre>
            
            All can be combined with comma as following
            <pre>"days":"<span style='color:red;background-color:yellow;font-size:2em'>Check In:MM, yyyy</span>","months":"<span style='color:white;background-color:green;font-size:2em'>Year:yyyy</span>","years":"<span style='color:yellow;background-color:green;font-size:2em'>Decade:yyyy1 - yyyy2</span>"</pre>
            ```
    }
)

customAttribute attribute_14 (
    apexlangName: options
    attribute: 14
    name: Options:
    type: checkboxes
    appearance {
        sequence: 140
    }
    default {
        value: 3:4:5:6:7:8:9:10:11
    }

    entry autoClose (
        sequence: 20
        display: Auto Close
        return: 2
        help {
            helpText: If checked, date picker will close after date selection.
        }
    )

    entry clearButton (
        sequence: 50
        display: Clear Button
        return: 5
        help {
            helpText: If checked, "Clear" button  will be visible.
        }
    )

    entry disableNavigationWhenOutOfRange (
        sequence: 120
        display: Disable Navigation When Out Of Range
        return: 12
        help {
            helpText: If checked, for dates less than minimum possible or more then maximum possible, navigation buttons ('forward', 'back') will be deactivated.
        }
    )

    entry keyboardNavigation (
        sequence: 30
        display: Keyboard Navigation
        return: 3
        help {
            helpText:
                ```
                If checked, then one can navigate through calendar by keyboard.
                <p>
                	Hot keys:</p>
                <pre>
                    <code>Ctrl + → | ↑</code>- move one month forwards
                    <code>Ctrl + ← | ↓</code>- move one month backwards
                    <code>Shift + → | ↑</code>- move one year forwards
                    <code>Shift + ← | ↓</code>- move one year backwards
                    <code>Alt + → | ↑</code>- move 10 years forwards
                    <code>Alt + ← | ↓</code>- move 10 years backwards
                    <code>Ctrl + Shift + ↑</code>- move to next view
                    <code>Esc</code>- hides date picker
                </pre>
                ```
        }
    )

    entry notEditiable (
        sequence: 130
        display: Not Editiable
        return: 13
        help {
            helpText: If checked, will make the Date Item(s) Read Only.
        }
    )

    entry selectDaysFromOtherMonthsDaysView (
        sequence: 70
        display: "Select Days from Other Months[Days' View]"
        return: 7
        help {
            helpText: If checked, the user can select days form other months.
        }
    )

    entry selectOtherYearsYearsView (
        sequence: 100
        display: "Select Other Years[Years' View]	"
        return: 10
        help {
            helpText: If checked, user can select years from other decades
        }
    )

    entry showDaysFromOtherMonthsDaysView (
        sequence: 60
        display: "Show Days from Other Months[Days' View]"
        return: 6
        help {
            helpText: If checked, days from other months will be visible.
        }
    )

    entry showOtherYearsYearsView (
        sequence: 90
        display: "Show other Years[Years' View]"
        return: 9
        help {
            helpText: If checked, years from other decades will be visible.
        }
    )

    entry todayButton (
        sequence: 40
        display: Today Button
        return: 4
        help {
            helpText: If checked,  "Today"  button will be visible.
        }
    )

    entry toggleSelected (
        sequence: 10
        display: Toggle Selected
        return: 1
        help {
            helpText:
                ```
                If checked, then clicking on selected cell will remove it from selection and its value from the item.
                <p> Do not use with Range Type Date Pickers.As the user wouldn't be able to select same date as From and To date. If the user wants to clear the date use the Clear Button.</p>
                ```
        }
    )

    entry transitionToSelectedMonthDaysView (
        sequence: 80
        display: "Transition to Selected Month[Days' View]"
        return: 8
        help {
            helpText: If checked, selecting days from other month, will move to that month.
        }
    )

    entry transitionToSelectedYearYearsView (
        sequence: 110
        display: "Transition to Selected Year[Years' View]"
        return: 11
        help {
            helpText: If checked, selecting year from other decade, will move to that decade.
        }
    )

)


customAttribute attribute_01 (
    apexlangName: checkedValue
    attribute: 1
    name: Checked Value
    validation {
        required: true
        maxLength: 255
    }
    appearance {
        sequence: 10
    }
    builder {
        displayWidth: 10
    }
    default {
        value: Y
    }
    help {
        helpText: Enter the value stored if the checkbox is checked.
    }
)

customAttribute attribute_02 (
    apexlangName: uncheckedValue
    attribute: 2
    name: Unchecked Value
    validation {
        maxLength: 255
    }
    appearance {
        sequence: 20
    }
    builder {
        displayWidth: 10
    }
    help {
        helpText:
            ```
            <p>Enter the value stored if the checkbox is unchecked. This attribute can also be left blank if you want to store NULL when the checkbox is left unchecked.</p>
            <p>Note: This value will also be used if the page item is populated with a value which doesn't match the "Checked Value" or "Unchecked Value".</p>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: checkboxLabel
    attribute: 3
    name: Checkbox Label
    appearance {
        sequence: 30
    }
    builder {
        translatable: true
        displayWidth: 40
    }
    help {
        helpText:
            ```
            <p>Enter the label to be displayed after the checkbox.</p>
            <p>Note: If you set this optional attribute, you should remove the text in the label attribute of the page item.</p>
            ```
    }
)


customAttribute attribute_01 (
    apexlangName: labelColumn
    attribute: 1
    name: Label Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText: Select the column from the region SQL Query that holds the labels for the chart.
    }
)

customAttribute attribute_02 (
    apexlangName: valueColumn
    attribute: 2
    name: Value Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    supports {
        dataTypes: number
    }
    help {
        helpText: Select the column from the region SQL Query that holds the values for the chart.
    }
)

customAttribute attribute_03 (
    apexlangName: colorsColumn
    attribute: 3
    name: Colors Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 110
    }
    dependingOn {
        attribute: @attribute_08/component
        conditionType: =
        value: SQL
    }
    help {
        helpText:
            ```
            <p>Select the column from the region SQL Query that holds the color codes for the chart. The color can be set using hex values or as the name of the color.</p>
            <p>Note: If no column is entered then the color will automatically be calculated.</p>
            ```
    }
    examples {
        examples:
            ```
            <dl>
              <dt>Hexadecimal (hex) notation</dt><dd><pre>#FF3377</pre>;</dd>
              <dt>HTML colors</dt><dd><pre>blue</pre>.</dd>
            </dl>
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: linkTarget
    attribute: 4
    name: Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 40
    }
    builder {
        includeColumnsInItemsPicker: true
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks a chart entry.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_05 (
    apexlangName: width
    attribute: 5
    name: "Width "
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 30
    }
    builder {
        unit: px
        displayWidth: 5
    }
    help {
        helpText:
            ```
            <p>Enter the width of the pie chart you want to create. For example, setting the width to 100 will create a pie chart that is a maximum of 100 pixels wide and 100 pixels in height.</p>
            <p>Note: If no value is specified, the pie chart will consume all the space of the containing region. </p>
            ```
    }
)

customAttribute attribute_06 (
    apexlangName: innerRadius
    attribute: 6
    name: "Inner Radius "
    type: integer
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    builder {
        unit: px
    }
    dependingOn {
        attribute: @attribute_11/component
        conditionType: =
        value: DONUT
    }
    help {
        helpText: Enter the radius of the hole inside the chart.
    }
)

customAttribute attribute_07 (
    apexlangName: displayOptions
    attribute: 7
    name: Display Options
    type: checkboxes
    appearance {
        sequence: 70
    }
    help {
        helpText: <p>Check which attributes are shown on the pie chart.</p>
    }

    entry labels (
        sequence: 30
        display: Labels
        return: LABELS
    )

    entry percentages (
        sequence: 40
        display: Percentages
        return: PERCENTAGES
    )

    entry tooltip (
        sequence: 10
        display: Tooltip
        return: TOOLTIP
    )

)

customAttribute attribute_08 (
    apexlangName: colorScheme
    attribute: 8
    name: Color Scheme
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 100
    }
    default {
        value: MODERN
    }
    help {
        helpText: <p>Select the color scheme used to render the chart.</p>
    }

    entry custom (
        sequence: 60
        display: Custom
        return: CUSTOM
    )

    entry metro (
        sequence: 40
        display: Metro
        return: METRO
    )

    entry modern (
        sequence: 10
        display: Modern
        return: MODERN
    )

    entry modern2 (
        sequence: 20
        display: Modern 2
        return: MODERN2
    )

    entry solar (
        sequence: 30
        display: Solar
        return: SOLAR
    )

    entry sqlColumn (
        sequence: 50
        display: SQL Column
        return: SQL
    )

    entry theme (
        sequence: 5
        display: Theme
        return: THEME
    )

)

customAttribute attribute_09 (
    apexlangName: customColors
    attribute: 9
    name: Custom Colors
    validation {
        required: true
    }
    appearance {
        sequence: 120
    }
    dependingOn {
        attribute: @attribute_08/component
        conditionType: =
        value: CUSTOM
    }
    help {
        helpText: <p>Enter a list of CSS supported colors separated by colons.</p>
    }
)

customAttribute attribute_10 (
    apexlangName: valueFormatMask
    attribute: 10
    name: Value Format Mask
    type: selectList
    appearance {
        sequence: 90
    }
    help {
        helpText: Select the data format mask for the pie slices.
    }

    entry 14435 (
        sequence: 10
        display: 14,435
        return: ,.0f
        help {
            helpText: Comma-separated thousands, integers
        }
    )

    entry 144352 (
        sequence: 20
        display: 14435
        return: .0f
        help {
            helpText: Integer
        }
    )

    entry 144353 (
        sequence: 60
        display: $14,435
        return: $,.0f
        help {
            helpText: Currency, comma-separated thousands, integer
        }
    )

    entry 144354 (
        sequence: 70
        display: $14435
        return: $.0f
        help {
            helpText: Currency, integer
        }
    )

    entry 1443549 (
        sequence: 30
        display: 14,435.49
        return: ,.2f
        help {
            helpText: Comma-separated thousands, 2 decimals
        }
    )

    entry 14435492 (
        sequence: 40
        display: 14435.49
        return: .2f
        help {
            helpText: 2 decimals
        }
    )

    entry 14435493 (
        sequence: 80
        display: $14,435.49
        return: $,.2f
        help {
            helpText: Currency, comma-separated thousands, 2 decimals
        }
    )

    entry 14435494 (
        sequence: 90
        display: $14435.49
        return: $.2f
        help {
            helpText: Currency, 2 decimals
        }
    )

    entry 144k (
        sequence: 50
        display: 14.4k
        return: .3s
        help {
            helpText: Precision 3, SI suffixes
        }
    )

    entry 144k2 (
        sequence: 100
        display: $14.4k
        return: $.3s
        help {
            helpText: Currency, precison 3, SI suffixes
        }
    )

    entry friendly (
        sequence: 110
        display: FRIENDLY
        return: friendly
        help {
            helpText: Automatically use SI units for thousands and millions
        }
    )

)

customAttribute attribute_11 (
    apexlangName: chartType
    attribute: 11
    name: Chart Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    default {
        value: PIE
    }
    help {
        helpText: Select whether to display a pie chart or donut chart.
    }

    entry donut (
        sequence: 20
        display: Donut
        return: DONUT
        help {
            helpText: A pie chart with a hole in the middle
        }
    )

    entry pie (
        sequence: 10
        display: Pie
        return: PIE
        help {
            helpText: A normal Pie Chart
        }
    )

)

customAttribute attribute_12 (
    apexlangName: legend
    attribute: 12
    name: Legend
    type: selectList
    componentLov {
        nullText: No Legend
    }
    appearance {
        sequence: 80
    }
    dependingOn {
        attribute: @attribute_07/component
        conditionType: isNotNull
    }
    help {
        helpText: Select the position of the legend when it is being displayed.
    }

    entry aboveChart (
        sequence: 10
        display: Above Chart
        return: TOP
    )

    entry belowChart (
        sequence: 20
        display: Below Chart
        return: BOTTOM
    )

)


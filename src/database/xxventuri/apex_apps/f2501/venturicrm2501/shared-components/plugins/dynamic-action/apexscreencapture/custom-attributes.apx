customAttribute attribute_10 (
    apexlangName: domUiSelector
    attribute: 10
    name: DOM UI Selector
    type: yesNo
    appearance {
        sequence: 5
    }
    help {
        helpText: Choose if a graphical selector should be used or not.
    }
)

customAttribute attribute_11 (
    apexlangName: domFilter
    attribute: 11
    name: DOM Filter
    appearance {
        sequence: 6
    }
    default {
        value: div
    }
    dependingOn {
        attribute: @attribute_10/component
        conditionType: =
        value: Y
    }
    help {
        helpText:
            ```
            A selector that an element should match in order to be outlined and clicked. Default is 'div'.<br>
            No value means no filter is enabled and all elements would be outlined.
            ```
    }
    examples {
        examples:
            ```
            for all divs: div<br>
            for all divs with a ID attribute: div[id]
            ```
    }
)

customAttribute attribute_12 (
    apexlangName: hideLabel

customAttribute attribute_07 (
    apexlangName: letterRendering
    attribute: 7
    name: Letter rendering
    type: selectList
    appearance {
        sequence: 70
    }
    default {
        value: false
    }
    help {
        helpText: Whether to render each letter separately
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)

customAttribute attribute_08 (
    apexlangName: allowTaint
    attribute: 8
    name: Allow taint
    type: selectList
    appearance {
        sequence: 80
    }
    default {
        value: false
    }
    help {
        helpText: Whether to allow cross-origin images to taint the canvas
    }

    entry false (
        sequence: 20
        display: False
        return: false
    )

    entry true (
        sequence: 10
        display: True
        return: true
    )

)


customAttribute attribute_15 (
    apexlangName: outputType
    attribute: 15
    name: Output Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 65
    }
    default {
        value: PNG
    }
    help {
        helpText: Mime-Type of the resulting screenshot image
    }

    entry jpeg (
        sequence: 20
        display: JPEG
        return: JPEG
    )

    entry pdf (
        sequence: 30
        display: PDF
        return: PDF
    )

    entry png (
        sequence: 10
        display: PNG
        return: PNG
    )

)


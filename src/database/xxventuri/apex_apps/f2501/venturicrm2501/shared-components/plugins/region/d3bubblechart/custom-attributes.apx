customAttribute attribute_01 (
    apexlangName: minimumAspectRatio
    attribute: 1
    name: Minimum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 510
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 5
    }
    default {
        value: 1.333
    }
    help {
        helpText:
            ```
            <p>Enter the minimum aspect ratio that charts use to recommend a height. A minimum aspect ratio of 1.333 means that the chart's width should be no less than 1.333 times its height. </p>
            <p>Note: This setting can be overridden by the 'Min Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: maximumAspectRatio
    attribute: 2
    name: Maximum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 520
    }
    builder {
        common: false
        showInWizard: false
    }
    default {
        value: 3
    }
    help {
        helpText:
            ```
            <p>Enter the maximum aspect ratio that charts use to recommend a height. A maximum aspect ratio of 3 means that the chart's width should be no greater than 3 times its height. </p>
            <p>Note: This setting can be overridden by the 'Maximum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: colorScheme
    attribute: 2
    name: Color Scheme
    type: selectList
    componentLov {
        nullText: Theme Default
    }
    appearance {
        sequence: 100
    }
    default {
        value: MODERN
    }
    help {
        helpText: <p>Select the color scheme used to render the chart.</p>
    }

    entry metro (
        sequence: 40
        display: Metro
        return: METRO
    )

    entry modern (
        sequence: 10
        display: Modern
        return: MODERN
    )

    entry modern2 (
        sequence: 20
        display: Modern 2
        return: MODERN2
    )

    entry solar (
        sequence: 30
        display: Solar
        return: SOLAR
    )

)


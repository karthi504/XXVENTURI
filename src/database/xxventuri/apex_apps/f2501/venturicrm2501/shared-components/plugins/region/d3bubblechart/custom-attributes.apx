)

customAttribute attribute_23 (
    apexlangName: legend
    attribute: 23
    name: Legend
    type: selectList
    componentLov {
        nullText: No Legend
    }
    appearance {
        sequence: 80
    }
    help {
        helpText: Select where the legend is displayed on the chart.
    }

    entry aboveChart (
        sequence: 10
        display: Above Chart
        return: TOP
    )

    entry belowChart (
        sequence: 20
        display: Below Chart
        return: BOTTOM
    )

)

customAttribute attribute_24 (
    apexlangName: configurationJson
    attribute: 24
    name: Configuration JSON
    type: textarea
    validation {
        required: true
    }
    appearance {
        sequence: 130
    }
    default {
        value:
            ```
            {
              "trdur":                       500,
              "bubble_padding":              1.5,
              "opacity_normal":              "0.8",
              "opacity_highlight":           "1.0",
              "circle_highlight_radiusplus": 5 
            }
            ```
    }
    help {
        helpText:
            ```
            This JSON contains some custom attributes for the chart plugin:
            - "trdur": Is the transition duration of the effects of the chart in milliseconds. 
            - "bubble_padding": Spacing between bubbles.
            - "opacity_normal": The regular opacity of the nodes.
            - "opacity_highlight": The opacity when the node is hovered.
            - "circle_highlight_radiusplus": Plus factor to increase the bubble on highlight.
            ```
    }
)

customAttribute attribute_25 (
    apexlangName: bubbleSorting
    attribute: 25
    name: Bubble Sorting
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 90
    }
    default {
        value: D3ASCENDING
    }
    help {
        helpText: Select how the bubbles are arranged on the chart.
    }

    entry ascending (
        sequence: 30
        display: Ascending
        return: ASCENDING
        help {
            helpText: Sorts bubble from the smallest size on the outside to the biggest in the center.
        }
    )

    entry d3Ascending (
        sequence: 10
        display: D3 Ascending
        return: D3ASCENDING
        help {
            helpText: D3 Ascending sorting function.
        }
    )

    entry d3Descending (
        sequence: 20
        display: D3 Descending
        return: D3DESCENDING
        help {
            helpText: D3 Descending sorting function.
        }
    )

    entry descending (
        sequence: 40
        display: Descending
        return: DESCENDING
        help {
            helpText: Sorts bubbles from the biggest size on the outside to the smallest in the center.
        }
    )

)


customAttribute attribute_18 (
    apexlangName: linkTarget
    attribute: 18
    name: Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 30
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks a chart entry.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_19 (
    apexlangName: tooltips
    attribute: 19
    name: Tooltips
    type: checkboxes
    appearance {
        sequence: 60
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText:
            ```
            <p>Check which attributes are shown on the tooltip for each data point. The 'Custom column' option allows you to specify text for each individual data point as an additional column in the region SQL Query.</p>
            <p>Note: Leave all options unchecked to disable the tooltip.</p>
            ```
    }

    entry customColumn (
        sequence: 20
        display: Custom column
        return: CUSTOM
    )

    entry showSeriesName (
        sequence: 10
        display: Show series name
        return: SERIES
    )

    entry showValue (
        sequence: 30
        display: Show Value
        return: VALUE
    )

)

customAttribute attribute_20 (
    apexlangName: tooltipColumn
    attribute: 20
    name: Tooltip Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    dependingOn {
        attribute: @attribute_19/component
        conditionType: inList
        list: [
            SERIES:CUSTOM:VALUE
            SERIES:CUSTOM
            CUSTOM:VALUE
            CUSTOM
        ]
    }
    help {
        helpText: Enter the column from the region SQL Query that holds the custom tooltip values.
    }
)

customAttribute attribute_21 (
    apexlangName: minimumHeight
    attribute: 21
    name: Minimum Height
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 110
    }
    builder {
        common: false
        showInWizard: false
        unit: px
        displayWidth: 5
    }
    help {
        helpText: Enter the minimum height, in pixels, of the chart. Chart width will adapt to the size of the region.
    }
)

